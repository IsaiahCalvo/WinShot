<Window x:Class="WinShot.Editor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinShot Editor" Background="{StaticResource ChromePopoverBrush}"
        MinWidth="980" MinHeight="520"
        AllowDrop="True" Drop="OnEditorDrop" DragOver="OnEditorDragOver"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        AutomationProperties.Name="WinShot annotation editor">
    <!-- Survey's canvas ground is #181c24 — the SAME token as the top bar and sub-row
         (PDFViewer.jsx:23583/23607), which is why its chrome reads as one surface.
         #0d0f14 is popovers/backdrop only, so it stays on the Window (Survey's `body`,
         styles.css:23) and never on a chrome band. -->
    <Grid Background="{StaticResource ChromeBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Survey's right rail is ONE uninterrupted 48px #12151c column, absolutely
             positioned top:0 height:100% under the top bar, broken by exactly one
             horizontal rule — its own footer's (SurveySpacesRail.jsx:1222-1231,
             AppShell.jsx:2836-2856/3011). Giving the rail its own root column and
             spanning rows 1-2 stops the bottom band's hairline from slicing across it. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="48"/>
        </Grid.ColumnDefinitions>

        <!-- Survey's top chrome is a full-bleed FLAT strip, not a floating pill:
             background #181c24, padding 8px 12px, no radius, no shadow, no margin.
             and no bottom border either — measured on the running app 2026-09-17, not
             assumed: its strip is 1400x44 at #181c24 with border-bottom 0px, and the
             48px rail below it (#12151c, border-left 1px #2a3140, no top border) runs
             its left rule straight up into that strip with nothing to meet.

             WinShot DELIBERATELY DIVERGES here. Isaiah, 2026-09-17: "The right rail dies
             into the top toolbar because the top toolbar has no bottom border... same
             hairline, same token (Border), consistent at every DPI." Chrome materials are
             WinShot's side of the Survey line — Survey wins mechanics, features and icons;
             WinShot wins palette, materials and type — so this is the rule working, not a
             port error. Do not "restore" it to Survey's borderless strip.

             All three chrome edges are now the one hairline in the one token: this bottom
             rule, the rail's left rule, and the bottom bar's top rule (EditorBottomBar,
             BorderThickness 0,1,0,0). Border is #1FFFFFFF, a 12%-white WASH, so the three
             paint to different values over their own surfaces by design — EditorChromeJoinTests
             scans the rendered pixels and checks each against that token composited over its
             own background, at 96/144/192 DPI. The 34px group bar overlays the canvas lower
             down and carries its own bottom rule, so nothing doubles. -->
        <Border x:Name="TopToolbar" Grid.Row="0" Grid.ColumnSpan="2" Margin="0" Padding="12,8" CornerRadius="0"
                BorderBrush="{StaticResource ChromeHairlineBrush}" BorderThickness="0,0,0,1"
                Background="{StaticResource ChromeBgBrush}"
                TextElement.Foreground="{StaticResource ChromeTextBrush}"
                SnapsToDevicePixels="True">
            <StackPanel>
                <!-- UseLayoutRounding, because the cluster is centred and the merge gave it a
                     fifth chip: an odd content width puts the centre on a half-DIP, and the
                     row is supposed to be the one thing in this toolbar that never moves.
                     Rounding to device pixels makes "never" exact instead of nearly. -->
                <Grid x:Name="ToolbarPrimaryRow" UseLayoutRounding="True">
                    <!-- Survey: the tool cluster is centred (justify-content: center); undo/redo
                         sit absolutely at the left, tool properties absolutely at the cluster's
                         right (left: 100%). Equal star side columns give the same geometry, so
                         the tools never shift when either side changes width. -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnUndo" Style="{StaticResource SurveyDefaultButton}"
                                ToolTip="Undo" Click="OnUndo" IsEnabled="False"
                                AutomationProperties.Name="Undo" AutomationProperties.HelpText="Undo the last action. Shortcut Ctrl+Z.">
                            <Viewbox Width="14" Height="14"><ContentControl Content="{StaticResource SurveyIcon.Undo}"/></Viewbox>
                        </Button>
                        <Button x:Name="BtnRedo" Style="{StaticResource SurveyDefaultButton}"
                                ToolTip="Redo" Click="OnRedo" IsEnabled="False"
                                AutomationProperties.Name="Redo" AutomationProperties.HelpText="Redo the last action. Shortcut Ctrl+Y.">
                            <Viewbox Width="14" Height="14"><ContentControl Content="{StaticResource SurveyIcon.Redo}"/></Viewbox>
                        </Button>
                        <Rectangle Style="{StaticResource ToolbarDivider}"/>
                        <Button x:Name="CropUtilityBtn" Style="{StaticResource CompactToolIconButton}"
                                Click="OnCropClick" ToolTip="Crop"
                                AutomationProperties.Name="Crop and resize"
                                AutomationProperties.HelpText="Crop the image. Does not deselect Pan or Select. Shortcut C."
                                Content="{StaticResource SurveyIcon.Crop}"/>
                        <Button x:Name="RotateCwBtn" Style="{StaticResource CompactToolIconButton}"
                                ToolTip="Rotate 90° clockwise" Click="OnRotateCw"
                                AutomationProperties.Name="Rotate clockwise"
                                AutomationProperties.HelpText="Rotate the source image 90 degrees clockwise.">
                            <Viewbox Width="18" Height="18"><ContentControl Content="{StaticResource SurveyIcon.Rotate}"/></Viewbox>
                        </Button>
                        <!-- Survey's "more" overflow is gone. Everything it held now has a
                             visible home: rotate/flip/image size on the crop bar, add image,
                             add background, add capture, extract text and the GIF export in
                             the Image group's strip. Nothing in this editor hides behind an
                             overflow popup. -->
                    </StackPanel>

                    <!-- Survey's pan/select pair is `btn btn-icon`, a 28x28 rounded square with a
                         16px glyph, wrapped in a 6px-gap block that a 1px x 20px #5a6473 divider
                         closes (AppShell.jsx:1520-1632). That block is NOT part of the centred
                         flex: it hangs off the cluster at `position:absolute; right:100%` with
                         `paddingRight: 8px` (AppShell.jsx:1468-1477), mirroring the properties
                         block at `left:100%` (:1734-1742), so only the category chips are centred.
                         Survey's two gaps around the divider: Select edge -> divider = block gap 6
                         + divider margin 4 = 10px; divider -> first chip = divider margin 4 +
                         block paddingRight 8 = 12px (the block is absolute so it skips the
                         cluster's own 6px gap, and the chips carry no margin of their own).
                         Right margin 5 = 12 less the divider's 4px and the chip's 3px. -->
                    <StackPanel x:Name="PanSelectPanel" Grid.Column="0" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0">
                        <RadioButton x:Name="PanToolBtn" Style="{StaticResource SurveyIconToggle}" GroupName="Tool"
                                     Tag="Pan" Checked="OnToolChecked" ToolTip="Pan"
                                     AutomationProperties.Name="Pan"
                                     AutomationProperties.HelpText="Drag to move the view. Middle-drag or hold Space works with any tool."
                                     Content="{StaticResource SurveyIcon.Pan}"/>
                        <RadioButton x:Name="SelectToolBtn" Style="{StaticResource SurveyIconToggle}" GroupName="Tool"
                                     Tag="Select" Checked="OnToolChecked" IsChecked="True"
                                     ToolTip="Select" AutomationProperties.Name="Select"
                                     AutomationProperties.HelpText="Select annotations, drag a marquee, move, resize, or delete. Shortcut V."
                                     Content="{StaticResource SurveyIcon.Cursor}"/>
                        <!-- Local margin beats the shared ToolbarDivider setter (Theme.xaml:967)
                             so its other uses keep 4,0: Select's own 3px + 7 = Survey's 10px. -->
                        <Rectangle Style="{StaticResource ToolbarDivider}" Margin="7,0,4,0"/>
                    </StackPanel>

                    <Grid Grid.Column="1">
                    <StackPanel x:Name="ToolPanel" Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Margin="0">
                        <Button x:Name="DrawGroupBtn" Style="{StaticResource ToolIconButton}"
                                Click="OnDrawGroupClick" Tag="Draw" ToolTip="Draw"
                                AutomationProperties.Name="Draw"
                                AutomationProperties.HelpText="Pen, highlighter, and eraser. Shortcut P or H."
                                Content="{StaticResource SurveyIcon.DrawGroup}"/>

                        <Button x:Name="ShapeGroupBtn" Style="{StaticResource ToolIconButton}"
                                Click="OnShapeGroupClick" Tag="Shapes" ToolTip="Shapes"
                                AutomationProperties.Name="Shapes"
                                AutomationProperties.HelpText="Rectangle, ellipse, line, arrow, and counter."
                                Content="{StaticResource SurveyIcon.Shapes}"/>

                        <Button x:Name="TextGroupBtn" Style="{StaticResource ToolIconButton}"
                                Click="OnTextGroupClick" Tag="Text" ToolTip="Text"
                                AutomationProperties.Name="Text"
                                AutomationProperties.HelpText="Text box and callout."
                                Content="{StaticResource SurveyIcon.TextGroup}"/>

                        <Button x:Name="EffectsGroupBtn" Style="{StaticResource ToolIconButton}"
                                Click="OnEffectsGroupClick" Tag="Effects" ToolTip="Effects"
                                AutomationProperties.Name="Effects"
                                AutomationProperties.HelpText="Redact, spotlight, and magnify."
                                Content="{StaticResource SurveyIcon.Effects}"/>

                        <Button x:Name="ImageGroupBtn" Style="{StaticResource ToolIconButton}"
                                Click="OnImageGroupClick" Tag="Image" ToolTip="Image"
                                Content="{StaticResource SurveyIcon.Crop}"
                                AutomationProperties.Name="Image tools"
                                AutomationProperties.HelpText="Crop, add an image or another capture, add a background, extract text, export a before/after GIF."/>


                        <RadioButton x:Name="CurvedArrowToolBtn" Style="{StaticResource SurveyIconToggle}" GroupName="Tool"
                                     Tag="CurvedArrow" Checked="OnToolChecked" Visibility="Collapsed"
                                     ToolTip="Curved arrow" AutomationProperties.Name="Curved arrow"
                                     AutomationProperties.HelpText="Line and arrow already bend from the midpoint handle."/>

                    </StackPanel>
                    </Grid>

                    <!-- Survey's props block is `position:absolute; left:100%` — it hangs off
                         the cluster's right edge and takes part in NO layout, which is what
                         keeps the centred cluster still whatever the armed tool asks for.
                         A Canvas is WPF's spelling of that: it measures to (0,0) however wide
                         its children are, so the props never reach the star column's width.

                         It used to be spelled `Width="0"` on this StackPanel, and that is what
                         took every formatting control away. A horizontal StackPanel's
                         ArrangeOverride GROWS its arrange size to the measured extent of its
                         children (328 DIP here); ArrangeCore then compares that ink size to the
                         explicit Width, finds 328 > 0, and applies a zero-width LAYOUT CLIP.
                         The controls still measured, still arranged, still answered IsVisible —
                         and painted 52 ink pixels instead of 4411. A Canvas does not clip,
                         because its ArrangeOverride returns the slot it was given instead of
                         growing to its content. Measured both ways by EditorPropsProbe.

                         Letting the props take part in layout instead is not an option either:
                         the two side columns are `*`, and at 150% DPI layout rounding splits
                         them 576.00 / 575.33, so a props cluster wide enough to matter moves the
                         centred row by one device pixel — the 0.67 DIP ToolRowStabilitySmoke
                         catches. Zero width is the fix; zero width WITH a clip was the bug.

                         The inner Grid exists only to hand the row's height down so the controls
                         can still centre vertically: a Canvas ignores a child's VerticalAlignment. -->
                    <Canvas Grid.Column="2" Width="0" HorizontalAlignment="Left"
                            VerticalAlignment="Stretch">
                    <Grid Height="{Binding ActualHeight, ElementName=ToolbarPrimaryRow}">
                    <StackPanel HorizontalAlignment="Left"
                                Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel x:Name="SecondaryToolPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,8,0">
                            <Rectangle Style="{StaticResource ToolbarDivider}"/>
                            <StackPanel x:Name="EditorColorBar" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <StackPanel x:Name="ColorPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                                        <!-- `.ctx-color-swatch` (styles.css:1613-1637): a full 24px disc on
                                                             white, an 8px #e8e2d4 checkerboard so translucent colours read
                                                             correctly, the live colour on top, and a 1px 22%-white OUTER
                                                             ring. Two extra variants (AppShell.jsx:2016-2124): a 2px
                                                             stroke-colour ring for rect/ellipse/text/callout, and a centred
                                                             bold "1" for the counter. -->
                                                        <Button x:Name="ColorWellBtn" Style="{StaticResource ColorSwatchWell}" Margin="4,0,2,0"
                                                                Click="OnCustomSwatchClick" ToolTip="Color"
                                                                AutomationProperties.Name="Color"
                                                                AutomationProperties.HelpText="Open the color picker.">
                                                            <Grid Width="24" Height="24">
                                                                <Ellipse Fill="#FFFFFFFF"/>
                                                                <Ellipse>
                                                                    <Ellipse.Fill>
                                                                        <DrawingBrush TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute"
                                                                                      Stretch="None">
                                                                            <DrawingBrush.Drawing>
                                                                                <GeometryDrawing Brush="{StaticResource ChromeTextBrush}"
                                                                                                 Geometry="M0,0 H4 V4 H0 Z M4,4 H8 V8 H4 Z"/>
                                                                            </DrawingBrush.Drawing>
                                                                        </DrawingBrush>
                                                                    </Ellipse.Fill>
                                                                </Ellipse>
                                                                <Ellipse x:Name="CurrentColorIndicator" Fill="{StaticResource AnnotationRedBrush}"/>
                                                                <Ellipse x:Name="ColorWellStrokeRing" Visibility="Collapsed"
                                                                         Stroke="{StaticResource AnnotationRedBrush}" StrokeThickness="2" Margin="1"/>
                                                                <Ellipse Stroke="#38FFFFFF" StrokeThickness="1"/>
                                                                <TextBlock x:Name="ColorWellCounterGlyph" Text="1" Visibility="Collapsed"
                                                                           FontFamily="{StaticResource SurveyArialFont}" FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                                                           Foreground="{StaticResource AnnotationRedBrush}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Button>
                                                        <TextBlock x:Name="ColorWellLabel" Text="Color" Style="{StaticResource FieldLabel}" Visibility="Collapsed"/>
                                                        <WrapPanel Visibility="Collapsed">
                                                        <RadioButton Style="{StaticResource ColorSwatch}" GroupName="Color" Background="#FF453A" ToolTip="Red" Checked="OnColorChecked" IsChecked="True" AutomationProperties.Name="Red"/>
                                                        <RadioButton Style="{StaticResource ColorSwatch}" GroupName="Color" Background="#FF9500" ToolTip="Orange" Checked="OnColorChecked" AutomationProperties.Name="Orange"/>
                                                        <RadioButton Style="{StaticResource ColorSwatch}" GroupName="Color" Background="#FFCC00" ToolTip="Yellow" Checked="OnColorChecked" AutomationProperties.Name="Yellow"/>
                                                        <RadioButton Style="{StaticResource ColorSwatch}" GroupName="Color" Background="#34C759" ToolTip="Green" Checked="OnColorChecked" AutomationProperties.Name="Green"/>
                                                        <RadioButton Style="{StaticResource ColorSwatch}" GroupName="Color" Background="#0A84FF" ToolTip="Blue" Checked="OnColorChecked" AutomationProperties.Name="Blue"/>
                                                        <RadioButton Style="{StaticResource ColorSwatch}" GroupName="Color" Background="#AF52DE" ToolTip="Purple" Checked="OnColorChecked" AutomationProperties.Name="Purple"/>
                                                        <RadioButton Style="{StaticResource ColorSwatch}" GroupName="Color" Background="#000000" ToolTip="Black" Checked="OnColorChecked" AutomationProperties.Name="Black"/>
                                                        <RadioButton Style="{StaticResource ColorSwatch}" GroupName="Color" Background="#FFFFFF" ToolTip="White" Checked="OnColorChecked" AutomationProperties.Name="White"/>
                                                        <RadioButton x:Name="CustomSwatch" Style="{StaticResource ColorSwatch}" GroupName="Color"
                                                                     ToolTip="Custom color" Checked="OnColorChecked" Click="OnCustomSwatchClick"
                                                                     AutomationProperties.Name="Custom color"
                                                                     AutomationProperties.HelpText="Open the local palette or enter a hex color.">
                                                            <RadioButton.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#FF3B30" Offset="0"/><GradientStop Color="#FFCC00" Offset="0.25"/>
                                                                    <GradientStop Color="#34C759" Offset="0.5"/><GradientStop Color="#0A84FF" Offset="0.75"/>
                                                                    <GradientStop Color="#AF52DE" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </RadioButton.Background>
                                                        </RadioButton>
                                                        <Popup x:Name="ColorPickerPopup" PlacementTarget="{Binding ElementName=ColorWellBtn}"
                                                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                                            <Border Background="{StaticResource ChromePopoverBrush}" BorderBrush="{StaticResource ChromeControlBrush}"
                                                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,6,36,36"
                                                                    Effect="{StaticResource ChromePopoverShadow}">
                                                                <StackPanel Width="260">
                                                                    <StackPanel.Resources>
                                                                        <!-- Survey's segmented grid/spectrum toggle (CompactColorPicker.jsx:322-365):
                                                                             a #2a3140 pill whose active half fills #5a6473. -->
                                                                        <Style x:Key="PickerModeToggle" TargetType="RadioButton">
                                                                            <Setter Property="Cursor" Value="Hand"/>
                                                                            <Setter Property="Template">
                                                                                <Setter.Value>
                                                                                    <ControlTemplate TargetType="RadioButton">
                                                                                        <Border x:Name="Chip" Background="Transparent" CornerRadius="2" Padding="4">
                                                                                            <ContentPresenter/>
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                            <Trigger Property="IsChecked" Value="True">
                                                                                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource ChromeControlBrush}"/>
                                                                                            </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                    </ControlTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </Style>
                                                                    </StackPanel.Resources>
                                                                    <!-- Survey's header row (CompactColorPicker.jsx:318-366): the word "Color"
                                                                         and the two-button mode pill. The picker is MODAL between presets and
                                                                         spectrum, never both at once (:367, :430). -->
                                                                    <DockPanel Margin="0,0,0,12">
                                                                        <TextBlock Text="Color" FontSize="{StaticResource TextBodyLg}" FontWeight="SemiBold" Foreground="{StaticResource ChromeTextBrush}"
                                                                                   VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                                                        <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="{StaticResource ChromeHairlineBrush}"
                                                                                CornerRadius="4" Padding="2">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <RadioButton x:Name="PickerGridModeBtn" GroupName="PickerMode" IsChecked="True"
                                                                                             Style="{StaticResource PickerModeToggle}" Checked="OnPickerModeChecked"
                                                                                             ToolTip="Preset colors" AutomationProperties.Name="Preset colors">
                                                                                    <UniformGrid Width="12" Height="12" Columns="2" Rows="2">
                                                                                        <Rectangle Fill="White" Margin="0,0,1,1"/>
                                                                                        <Rectangle Fill="White" Margin="1,0,0,1"/>
                                                                                        <Rectangle Fill="White" Margin="0,1,1,0"/>
                                                                                        <Rectangle Fill="White" Margin="1,1,0,0"/>
                                                                                    </UniformGrid>
                                                                                </RadioButton>
                                                                                <RadioButton x:Name="PickerSpectrumModeBtn" GroupName="PickerMode" Margin="4,0,0,0"
                                                                                             Style="{StaticResource PickerModeToggle}" Checked="OnPickerModeChecked"
                                                                                             ToolTip="Color spectrum" AutomationProperties.Name="Color spectrum">
                                                                                    <Path Width="12" Height="12" Stretch="Uniform" Fill="White"
                                                                                          Data="M8 2L10 6L14 8L10 10L8 14L6 10L2 8L6 6L8 2Z"/>
                                                                                </RadioButton>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DockPanel>
                                                                    <StackPanel x:Name="FillStrokeTabPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,0,8">
                                                                            <RadioButton x:Name="StrokeWellBtn" Style="{StaticResource StripTab}" GroupName="ColorWell" Tag="Stroke"
                                                                                         Content="Border" IsChecked="True"
                                                                                         Checked="OnColorWellChecked" AutomationProperties.Name="Border color"
                                                                                         AutomationProperties.HelpText="Edit the stroke or border color and opacity."/>
                                                                            <RadioButton x:Name="FillWellBtn" Style="{StaticResource StripTab}" GroupName="ColorWell" Tag="Fill"
                                                                                         Content="Fill"
                                                                                         Checked="OnColorWellChecked" AutomationProperties.Name="Fill color"
                                                                                         AutomationProperties.HelpText="Edit the fill color and opacity independently of the border."/>
                                                                    </StackPanel>
                                                                    <!-- Survey keeps the eyedropper with the colour it samples for. -->
                                                                    <RadioButton x:Name="EyedropperToolBtn" Style="{StaticResource StripToolButton}" GroupName="Tool"
                                                                                 Tag="Eyedropper" Checked="OnToolChecked" Click="OnPickerEyedropper" ToolTip="Eyedropper"
                                                                                 Width="Auto" HorizontalAlignment="Left" Margin="0,0,0,8" Padding="6,0"
                                                                                 AutomationProperties.Name="Eyedropper"
                                                                                 AutomationProperties.HelpText="Sample a source pixel and make it the current annotation color.">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <ContentPresenter Content="{StaticResource SurveyIcon.Eyedropper}" VerticalAlignment="Center"/>
                                                                            <TextBlock Text="Pick from image" FontSize="{StaticResource TextBody}" Margin="8,0,4,0" VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </RadioButton>
                                                                    <UniformGrid x:Name="ColorPickerGrid" Columns="8"/>

                                                                    <!-- Save stays docked right so saving the FIRST colour cannot move the
                                                                         button out from under the pointer; the row it creates eases in. -->
                                                                    <DockPanel Margin="0,12,0,0" LastChildFill="True">
                                                                        <Button x:Name="SaveColorBtn" DockPanel.Dock="Right" VerticalAlignment="Bottom"
                                                                                Style="{StaticResource CompactToolIconButton}" Content="&#xE710;" Click="OnSaveColor"
                                                                                ToolTip="Save this color" AutomationProperties.Name="Save color"
                                                                                AutomationProperties.HelpText="Keep the current color in My colors."/>
                                                                        <StackPanel x:Name="SavedColorsSection" Visibility="Collapsed">
                                                                            <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
                                                                            <TextBlock x:Name="SavedColorsHeading" Text="My colors" Style="{StaticResource FieldLabel}" Margin="2,0,2,4"/>
                                                                            <UniformGrid x:Name="SavedColorsGrid" Columns="8" Width="216" HorizontalAlignment="Left"/>
                                                                        </StackPanel>
                                                                    </DockPanel>
                                                                    <!-- Survey's spectrum branch (CompactColorPicker.jsx:430-527): a full-width
                                                                         150px SV box over a labelled hue row. It replaces the preset grid; the two
                                                                         are never on screen together. -->
                                                                    <StackPanel x:Name="ColorPickerSpectrum" Visibility="Collapsed">
                                                                        <Canvas x:Name="ColorPickerSv" Width="236" Height="150" Cursor="Cross"
                                                                                Background="Transparent"
                                                                                MouseDown="OnColorPickerSvDown" MouseMove="OnColorPickerSvMove" MouseUp="OnColorPickerSvUp"
                                                                                AutomationProperties.Name="Color spectrum"
                                                                                AutomationProperties.HelpText="Drag to pick saturation and brightness.">
                                                                            <Rectangle x:Name="SvHueRect" Width="236" Height="150" RadiusX="4" RadiusY="4"
                                                                                       Fill="#FFFF0000" IsHitTestVisible="False"/>
                                                                            <Rectangle Width="236" Height="150" RadiusX="4" RadiusY="4" IsHitTestVisible="False">
                                                                                <Rectangle.Fill>
                                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                                        <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                                                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                                                    </LinearGradientBrush>
                                                                                </Rectangle.Fill>
                                                                            </Rectangle>
                                                                            <Rectangle Width="236" Height="150" RadiusX="4" RadiusY="4" IsHitTestVisible="False">
                                                                                <Rectangle.Fill>
                                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                        <GradientStop Color="#00000000" Offset="0"/>
                                                                                        <GradientStop Color="#FF000000" Offset="1"/>
                                                                                    </LinearGradientBrush>
                                                                                </Rectangle.Fill>
                                                                            </Rectangle>
                                                                            <Ellipse x:Name="SvCursor" Width="10" Height="10" Stroke="White" StrokeThickness="2"
                                                                                     IsHitTestVisible="False"/>
                                                                        </Canvas>
                                                                        <!-- HUE caption, 12px bar and the degree readout Survey shows on the right (:482-527). -->
                                                                        <DockPanel Margin="0,12,0,0">
                                                                            <TextBlock Text="HUE" FontSize="{StaticResource TextMicro}" Foreground="{StaticResource ChromeTextMutedBrush}" Width="20"
                                                                                       VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                                                            <TextBlock x:Name="PickerHueValue" FontSize="{StaticResource TextCaption}" Foreground="{StaticResource ChromeTextBrush}" Width="24"
                                                                                       TextAlignment="Right" VerticalAlignment="Center" DockPanel.Dock="Right"/>
                                                                            <Canvas x:Name="ColorPickerHue" Width="176" Height="12" Margin="8,0" Cursor="Hand"
                                                                                    Background="Transparent"
                                                                                    MouseDown="OnColorPickerHueDown" MouseMove="OnColorPickerHueMove" MouseUp="OnColorPickerHueUp"
                                                                                    AutomationProperties.Name="Hue"
                                                                                    AutomationProperties.HelpText="Drag to pick hue.">
                                                                                <Rectangle Width="176" Height="12" RadiusX="6" RadiusY="6">
                                                                                    <Rectangle.Fill>
                                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                                            <GradientStop Color="#FFFF0000" Offset="0"/>
                                                                                            <GradientStop Color="#FFFFFF00" Offset="0.17"/>
                                                                                            <GradientStop Color="#FF00FF00" Offset="0.33"/>
                                                                                            <GradientStop Color="#FF00FFFF" Offset="0.50"/>
                                                                                            <GradientStop Color="#FF0000FF" Offset="0.67"/>
                                                                                            <GradientStop Color="#FFFF00FF" Offset="0.83"/>
                                                                                            <GradientStop Color="#FFFF0000" Offset="1"/>
                                                                                        </LinearGradientBrush>
                                                                                    </Rectangle.Fill>
                                                                                </Rectangle>
                                                                                <Ellipse x:Name="HueCursor" Width="12" Height="12" Fill="White"
                                                                                         IsHitTestVisible="False" Canvas.Top="0"/>
                                                                            </Canvas>
                                                                        </DockPanel>
                                                                    </StackPanel>
                                                                    <DockPanel Margin="0,12,0,0">
                                                                        <TextBlock Text="Opacity" Style="{StaticResource FieldLabel}" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                                                                        <TextBlock x:Name="PickerOpacityValue" Text="100%" Style="{StaticResource ValueLabel}"
                                                                                   DockPanel.Dock="Right" MinWidth="38" TextAlignment="Right"/>
