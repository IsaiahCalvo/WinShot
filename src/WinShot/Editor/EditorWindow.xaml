                                                        <RadioButton x:Name="FillNoneBtn" Style="{StaticResource SurveyIconToggle}" GroupName="Fill" Tag="None" Content="{StaticResource SurveyIcon.FillNone}" ToolTip="No fill"
                                                                     Checked="OnFillChecked" IsChecked="True" AutomationProperties.Name="No fill"
                                                                     AutomationProperties.HelpText="Draw shapes with an outline and no fill."/>
                                                        <RadioButton x:Name="FillQuarterBtn" Style="{StaticResource SurveyIconToggle}" GroupName="Fill" Tag="Quarter" Content="{StaticResource SurveyIcon.FillQuarter}" ToolTip="25% fill"
                                                                     Checked="OnFillChecked" AutomationProperties.Name="25 percent fill"
                                                                     AutomationProperties.HelpText="Draw shapes with a translucent 25 percent fill."/>
                                                        <RadioButton x:Name="FillSolidBtn" Style="{StaticResource SurveyIconToggle}" GroupName="Fill" Tag="Solid" Content="{StaticResource SurveyIcon.FillSolid}" ToolTip="Solid fill"
                                                                     Checked="OnFillChecked" AutomationProperties.Name="Solid fill"
                                                                     AutomationProperties.HelpText="Draw shapes with a solid fill."/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Eraser mode lives in the tool's own split menu (Draw sub-row),
                                                         exactly as Survey mounts it — there is no top-row combo. -->

                                                    <!-- Survey's LINE STYLE dropdown owns solid/dashed/dotted/cloud. The one thing it has
                                                         no vocabulary for is the hand-drawn line QUALITY, which is orthogonal to the dash:
                                                         a sketchy outline can still be dotted. So this is the only survivor of WinShot's
                                                         own outline popover — one checkbox, next to the dropdown it qualifies. -->
                                                    <StackPanel x:Name="StrokePanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,8,0">
                                                        <CheckBox x:Name="SketchCheck" Style="{StaticResource DarkCheckBox}" Content="Hand-drawn"
                                                                  VerticalAlignment="Center" Click="OnSketchClick"
                                                                  ToolTip="Draw the line with a sketched wobble instead of a ruled one"
                                                                  AutomationProperties.Name="Hand-drawn outline"
                                                                  AutomationProperties.HelpText="Draw with a sketched, hand-drawn line instead of a ruled one."/>
                                                    </StackPanel>

                                                    <StackPanel x:Name="RedactStylePanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,8,0">
                                                        <!-- Survey's own format controls are all dropdowns of this shape, so the four
                                                             ways a redaction can hide something is one too, rather than the glyph
                                                             popover WinShot used before the two toolbars converged. -->
                                                        <ComboBox x:Name="RedactStyleBox" Style="{StaticResource SurveyDropdown}" Tag="HIDE WITH" SelectedIndex="0"
                                                                  SelectionChanged="OnRedactStyleChanged" MinWidth="120"
                                                                  ToolTip="Redaction style" AutomationProperties.Name="Redaction style"
                                                                  AutomationProperties.HelpText="Choose pixelate, blur (secure), blur (smooth) or black out. The style can be changed after the mark is drawn.">
                                                            <ComboBoxItem Content="Pixelate" Tag="Pixelate"/>
                                                            <ComboBoxItem Content="Blur (secure)" Tag="BlurSecure"/>
                                                            <ComboBoxItem Content="Blur (smooth)" Tag="BlurSmooth"/>
                                                            <ComboBoxItem Content="Black out" Tag="BlackOut"/>
                                                        </ComboBox>
                                                        <!-- Text only belongs to the STYLE, not the strength: "black out only the words"
                                                             is one of the four things this row exists for, and living inside the strength
                                                             group made it vanish for the one style that has no strength. -->
                                                        <CheckBox x:Name="RedactTextOnlyCheck" Style="{StaticResource DarkCheckBox}" Content="Text only"
                                                                  Margin="12,0,0,0" VerticalAlignment="Center"
                                                                  ToolTip="Cover only the words in the region, leaving pictures visible"
                                                                  AutomationProperties.Name="Redact text only"
                                                                  AutomationProperties.HelpText="Read the region and cover each word it finds, leaving photos and graphics visible."/>
                                                    </StackPanel>

                                                    <!-- Continuous, and gone entirely for Black Out — there is no such thing as a stronger
                                                         or weaker black rectangle. -->
                                                    <StackPanel x:Name="RedactStrengthPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,8,0">
                                                        <Slider x:Name="RedactStrengthSlider" Style="{StaticResource DarkSlider}" Width="110"
                                                                Minimum="1" Maximum="100" Value="45" SmallChange="1" LargeChange="10"
                                                                ValueChanged="OnRedactStrengthChanged" PreviewMouseUp="OnRedactStrengthReleased"
                                                                LostMouseCapture="OnRedactStrengthReleased" KeyUp="OnRedactStrengthReleased"
                                                                ToolTip="Redaction strength" AutomationProperties.Name="Redaction strength"
                                                                AutomationProperties.HelpText="How coarse the mosaic or how wide the blur is."/>
                                                        <TextBlock x:Name="RedactStrengthValue" Text="45" Style="{StaticResource ValueLabel}" MinWidth="28"
                                                                   TextAlignment="Right" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <StackPanel x:Name="MagnifyPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,8,0">
                                                        <TextBlock x:Name="MagnifyValueLabel" Style="{StaticResource ValueLabel}"
                                                                   VerticalAlignment="Center" Margin="0,0,6,0" MinWidth="30"/>
                                                        <Slider x:Name="MagnifySlider" Style="{StaticResource DarkSlider}" Width="92"
                                                                Minimum="1.5" Maximum="8" Value="2" SmallChange="0.5" LargeChange="1"
                                                                ValueChanged="OnMagnifyChanged" PreviewMouseUp="OnMagnifyReleased"
                                                                LostMouseCapture="OnMagnifyReleased"
                                                                ToolTip="How much the callout magnifies"
                                                                AutomationProperties.Name="Magnification"
                                                                AutomationProperties.HelpText="How much of the picture the callout blows up, from 1.5 to 8 times."/>
                                                    </StackPanel>

                                                    <StackPanel x:Name="CropToolsPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,8,0">
                                                        <Rectangle Style="{StaticResource ToolbarDivider}"/>
                                                        <Button x:Name="RotateCcwBtn" Style="{StaticResource CompactToolIconButton}"
                                                            ToolTip="Rotate 90° counter-clockwise" Click="OnRotateCcw"
                                                            RenderTransformOrigin="0.5,0.5"
                                                            AutomationProperties.Name="Rotate counter-clockwise"
                                                            AutomationProperties.HelpText="Rotate the source image 90 degrees counter-clockwise."
                                                            Content="{StaticResource SurveyIcon.Rotate}">
                                                        <Button.RenderTransform><ScaleTransform ScaleX="-1"/></Button.RenderTransform>
                                                    </Button>
                                                    <Button x:Name="FlipHorizontalBtn" Style="{StaticResource CompactToolIconButton}" Content="{StaticResource SurveyIcon.FlipH}"
                                                                ToolTip="Flip horizontal" Click="OnFlipHorizontal" AutomationProperties.Name="Flip horizontal"
                                                                AutomationProperties.HelpText="Flip the source image from left to right."/>
                                                        <Button x:Name="FlipVerticalBtn" Style="{StaticResource CompactToolIconButton}" Content="{StaticResource SurveyIcon.FlipV}"
                                                                ToolTip="Flip vertical" Click="OnFlipVertical" AutomationProperties.Name="Flip vertical"
                                                                AutomationProperties.HelpText="Flip the source image from top to bottom."/>
                                                        <Button x:Name="ResizeImageBtn" Style="{StaticResource PillButtonSecondary}"
                                                                Click="OnResizeImage" ToolTip="Image size…" AutomationProperties.Name="Image size"
                                                                AutomationProperties.HelpText="Open local source-image resize controls.">
                                                            <TextBlock x:Name="ImageSizeLabel" Text="Image size"/>
                                                        </Button>
                                                        <CheckBox x:Name="SnapToEdgesCheck" Style="{StaticResource DarkCheckBox}" Content="Snap"
                                                                  IsChecked="True" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                  ToolTip="Snap crop edges to the image edge — hold Ctrl to override"
                                                                  AutomationProperties.Name="Snap to edges"
                                                                  AutomationProperties.HelpText="Snap crop edges to the image edge. Hold Ctrl while dragging to override."/>
                                                    </StackPanel>


                                                    <StackPanel x:Name="OpacityPanel" Visibility="Collapsed" Margin="0,0,6,0">
                                                        <DockPanel Margin="0,0,6,0">
                                                        <TextBlock Text="Opacity" Style="{StaticResource FieldLabel}" DockPanel.Dock="Left"/>
                                                        <TextBlock x:Name="OpacityValue" Text="100%" Style="{StaticResource ValueLabel}" MinWidth="38"
                                                                   TextAlignment="Right" HorizontalAlignment="Right"/>
                                                        </DockPanel>
                                                        <Slider x:Name="OpacitySlider" Style="{StaticResource DarkSlider}" Minimum="0" Maximum="100" Value="100"
                                                                SmallChange="5" LargeChange="25" TickFrequency="25" IsSnapToTickEnabled="False"
                                                                ValueChanged="OnOpacityChanged" PreviewMouseUp="OnOpacitySliderReleased" LostMouseCapture="OnOpacitySliderReleased"
                                                                KeyUp="OnOpacitySliderReleased" ToolTip="Annotation opacity" AutomationProperties.Name="Annotation opacity"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                </StackPanel>
                        <Button x:Name="FormatOverflowBtn" Style="{StaticResource CompactToolIconButton}" Content="{StaticResource SurveyIcon.More}"
                                Click="OnFormatOverflowClick" ToolTip="More format"
                                Visibility="Collapsed"
                                AutomationProperties.Name="More format"
                                AutomationProperties.HelpText="Font, line style, and other format controls that do not fit on the row."/>
                        <Popup x:Name="FormatOverflowPopup" PlacementTarget="{Binding ElementName=FormatOverflowBtn}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="{StaticResource ChromePopoverBrush}" BorderBrush="{StaticResource ChromeControlBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,6,36,36"
                                    Effect="{StaticResource ChromePopoverShadow}">
                                <StackPanel x:Name="FormatOverflowPanel" Orientation="Horizontal"/>
                            </Border>
                        </Popup>
                        </StackPanel>
                    </StackPanel>
                    </Grid>
                    </Canvas>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="0">
            <!-- Survey's #chrome-sub-toolbar-host is `position:absolute; top:0` inside the
                 centre column so the sub-row OVERLAYS the canvas without pushing it down —
                 "the viewer underneath keeps its full height" (AppShell.jsx:2727-2740).
                 One row, EditorGroupBar declared after Viewport so it paints on top. -->
                <Grid x:Name="Viewport" Background="{StaticResource ChromeBgBrush}" ClipToBounds="True"
              MouseWheel="OnViewportMouseWheel" MouseDown="OnViewportMouseDown" MouseMove="OnViewportMouseMove"
              MouseUp="OnViewportMouseUp" MouseRightButtonUp="OnViewportRightClick"
              AutomationProperties.Name="Annotation canvas"
              AutomationProperties.HelpText="Source-resolution image canvas. Hold Space or middle-drag to pan; Ctrl+mouse wheel zooms.">
            <Canvas x:Name="SurfaceHost">
                <!-- Survey's page carries `box-shadow: 0 2px 14px rgba(0,0,0,0.45)` and NO border
                     ring; the desktop page div leaves boxShadow undefined so the canvas shadow is
                     the only edge treatment (PdfjsViewerContainer.jsx:351, :2236-2238). -->
                <Border x:Name="CaptureShadow" IsHitTestVisible="False" Visibility="Collapsed"
                        Background="#FF000000">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270"
                                          Opacity="0.45" Color="#FF000000" RenderingBias="Performance"/>
                    </Border.Effect>
                </Border>
                <Grid x:Name="EditorSurface" HorizontalAlignment="Left" VerticalAlignment="Top"
                      Background="Transparent" Cursor="Cross" RenderTransformOrigin="0,0">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ViewScale"/>
                            <TranslateTransform x:Name="ViewTranslate"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Grid x:Name="CanvasHost">
                        <StackPanel x:Name="BaseTiles" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Canvas x:Name="AnnotationCanvas" Background="Transparent" ClipToBounds="True"/>
                    </Grid>
                    <Canvas x:Name="InteractionCanvas" IsHitTestVisible="False" ClipToBounds="True">
                        <Path x:Name="CropDim" Fill="{StaticResource GuideStrokeShadowBrush}" Visibility="Collapsed"/>
                        <Rectangle x:Name="DragRect" Stroke="{StaticResource InfoBrush}" StrokeThickness="1.5"
                                   StrokeDashArray="4 3" Fill="{StaticResource AccentWashBrush}" Visibility="Collapsed"/>
                        <!-- Survey SVGSelectionOverlay.jsx:129-147: #4a90e2, strokeWidth 2,
                             strokeDasharray '4,4' in absolute px. WPF dash units are multiples
                             of StrokeThickness, so "2 2" at a 2px stroke is the same 4/4 rhythm. -->
                        <Rectangle x:Name="SelectionRect" Stroke="{StaticResource InfoBrush}" StrokeThickness="2"
                                   StrokeDashArray="2 2" Visibility="Collapsed"/>
                        <Ellipse x:Name="CurveHandle" Width="10" Height="10" Fill="{StaticResource InfoBrush}"
                                 Stroke="White" StrokeThickness="1.5" Visibility="Collapsed"/>
                        <!-- Survey's hover halo (SVGAnnotationLayer.jsx:4415-4421 etc.): the mark's
                             OWN geometry restroked in #4a90e2 at 0.4 opacity, so a pre-click
                             preview traces the shape instead of boxing it. -->
                        <Path x:Name="HoverHalo" Stroke="{StaticResource InfoBrush}" Opacity="0.4" Fill="{x:Null}"
                              StrokeLineJoin="Round" Visibility="Collapsed"/>
                        <!-- An arrow's own silhouette, thickened and translucent: the shape
                             says what is selected, where a dashed box around a diagonal
                             line never did. -->
                        <Path x:Name="ArrowSelectionGlow" Visibility="Collapsed" IsHitTestVisible="False"/>
                        <!-- Rubber band. Stroke/fill are set per drag: blue solid dragging
                             right (window), green dashed dragging left (crossing). -->
                        <Rectangle x:Name="MarqueeRect" StrokeThickness="1" Visibility="Collapsed"/>
                        <!-- Union frame around a marquee group; softer than a single selection. -->
                        <Rectangle x:Name="GroupRect" Stroke="{StaticResource InfoBrush}" StrokeThickness="1.5"
                                   StrokeDashArray="4 3" Opacity="0.6" Visibility="Collapsed"/>
                        <!-- What a selected magnifier callout is looking at. Hollow, so the
                             pixels it is pointing at stay visible under it, and joined to
                             the bubble by a leader so the pair reads as one mark. -->
                        <Line x:Name="MagnifierLeader" Stroke="{StaticResource InfoBrush}" StrokeThickness="1"
                              StrokeDashArray="3 3" Opacity="0.8" Visibility="Collapsed"/>
                        <Ellipse x:Name="MagnifierFocusHandle" Width="12" Height="12"
                                 Stroke="{StaticResource InfoBrush}" StrokeThickness="2"
                                 Fill="Transparent" Visibility="Collapsed"/>
                        <Canvas x:Name="HandleLayer" Visibility="Collapsed"/>
                        <Border x:Name="EyedropSwatch" Visibility="Collapsed" Background="{StaticResource FloatingBgBrush}"
                                CornerRadius="4" Padding="5" RenderTransformOrigin="0,0">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle x:Name="EyedropColorRect" Width="14" Height="14" RadiusX="2" RadiusY="2"
                                           Stroke="#88FFFFFF" StrokeThickness="1"/>
                                <TextBlock x:Name="EyedropHexText" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="{StaticResource TextCaption}" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Magnified eyedropper loupe: the selector's nearest-neighbour grid,
                             pointed at the source bitmap instead of the screen. -->
                        <Canvas x:Name="EyedropLoupe" Visibility="Collapsed" IsHitTestVisible="False"/>
                        <!-- Rule-of-thirds guides inside the crop rectangle. Two-tone: a dark
                             hairline one screen pixel under a light one, so the guides read
                             over a white region as well as a dark one. -->
                        <Canvas x:Name="CropGuides" Visibility="Collapsed" IsHitTestVisible="False">
                            <Line x:Name="ThirdV1Shadow" Stroke="{StaticResource GuideStrokeShadowBrush}"/>
                            <Line x:Name="ThirdV2Shadow" Stroke="{StaticResource GuideStrokeShadowBrush}"/>
                            <Line x:Name="ThirdH1Shadow" Stroke="{StaticResource GuideStrokeShadowBrush}"/>
                            <Line x:Name="ThirdH2Shadow" Stroke="{StaticResource GuideStrokeShadowBrush}"/>
                            <Line x:Name="ThirdV1" Stroke="{StaticResource GuideStrokeBrush}"/>
                            <Line x:Name="ThirdV2" Stroke="{StaticResource GuideStrokeBrush}"/>
                            <Line x:Name="ThirdH1" Stroke="{StaticResource GuideStrokeBrush}"/>
                            <Line x:Name="ThirdH2" Stroke="{StaticResource GuideStrokeBrush}"/>
                        </Canvas>
                    </Canvas>
                </Grid>
            </Canvas>
            <!-- Where you are in a zoomed-in image. Indicators, never controls: the
                 editor pans an infinite canvas, so there is no track to drag. -->
            <Canvas x:Name="ScrollOverlay" IsHitTestVisible="False" Opacity="0">
                <!-- The ground under these is the user's screenshot, not a theme surface, so
                     a light bar alone composites to nothing over a white region. Same pairing
                     the thirds guides use: a dark bar one pixel down-right, under the light one. -->
                <Rectangle x:Name="ScrollBarHShadow" RadiusX="2" RadiusY="2" Visibility="Collapsed"
                           Fill="{StaticResource GuideStrokeShadowBrush}"/>
                <Rectangle x:Name="ScrollBarVShadow" RadiusX="2" RadiusY="2" Visibility="Collapsed"
                           Fill="{StaticResource GuideStrokeShadowBrush}"/>
                <Rectangle x:Name="ScrollBarH" RadiusX="2" RadiusY="2" Visibility="Collapsed"
                           Fill="{StaticResource TextSecondaryBrush}"/>
                <Rectangle x:Name="ScrollBarV" RadiusX="2" RadiusY="2" Visibility="Collapsed"
                           Fill="{StaticResource TextSecondaryBrush}"/>
            </Canvas>

            <Canvas x:Name="OverlayCanvas">
                <!-- Survey's eraser ring (FabricEraserCanvas.jsx:2435-2450): rgba(255,255,255,.18)
                     fill, 1px rgba(17,24,39,.9) border, 1px rgba(255,255,255,.72) outer halo.
                     Both rings stay hairlines at any zoom; only the diameter scales. -->
                <Ellipse x:Name="EraserCursorHalo" Width="22" Height="22" IsHitTestVisible="False" Visibility="Collapsed"
                         Fill="Transparent" Stroke="#B8FFFFFF" StrokeThickness="1"/>
                <Ellipse x:Name="EraserCursor" Width="20" Height="20" IsHitTestVisible="False" Visibility="Collapsed"
                         Fill="#2EFFFFFF" Stroke="#E6000000" StrokeThickness="1"/>
                <!-- Survey RotationInputField.jsx:563-640: 60x28, bg #181c24, radius 6,
                     boxShadow '0 4px 12px rgba(0,0,0,0.3)', 1px border #2a3140 that swaps to
                     #4A9EFF on focus (the only focus affordance — the input's outline is none),
                     centred 13px/500 value in #e8e2d4 with a 12px #8d96a6 degree suffix, gap 4. -->
                <Border x:Name="RotationPill" Width="60" Height="28" Background="{StaticResource ChromeBgBrush}"
                        BorderBrush="{StaticResource ChromeHairlineBrush}"
                        BorderThickness="1" CornerRadius="6" Visibility="Collapsed"
                        AutomationProperties.Name="Rotation angle">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBox x:Name="RotationInput" Width="32" Height="20" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource ChromeTextBrush}" CaretBrush="{StaticResource ChromeTextBrush}"
                                 FontSize="{StaticResource TextBodyLg}" FontWeight="Medium" TextAlignment="Center" Padding="0" VerticalContentAlignment="Center"
                                 PreviewTextInput="OnRotationInputText" PreviewKeyDown="OnRotationInputKey"
                                 GotKeyboardFocus="OnRotationInputFocus" LostKeyboardFocus="OnRotationInputBlur"
                                 AutomationProperties.Name="Rotation degrees"/>
                        <TextBlock Text="°" Foreground="{StaticResource ChromeTextMutedBrush}" FontSize="{StaticResource TextBody}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Canvas>
        </Grid>
                <!-- PDFViewer.jsx:32014-32032: 34px, #181c24, 1px #2a3140 bottom
                     hairline, border-box (so the hairline eats into the 34). Survey
                     PORTALS this strip in only while a category is open
                     (PDFViewer.jsx:32015 `activeCategoryDropdown &&`), so it starts
                     collapsed and UpdateContextPanels mounts/unmounts it. -->
                <Border x:Name="EditorGroupBar" HorizontalAlignment="Stretch" VerticalAlignment="Top"
                        Height="34" Visibility="Collapsed"
                        Margin="0" Padding="0" CornerRadius="0"
                        Background="{StaticResource ChromeBgBrush}"
                        BorderBrush="{StaticResource ChromeHairlineBrush}" BorderThickness="0,0,0,1"
                        AutomationProperties.Name="Group tools"
                        AutomationProperties.HelpText="Tools in the selected Draw, Shapes, or Text group.">
                    <!-- Survey's sub-row centres on the WINDOW, not on the canvas: it is centred
                         (PDFViewer.jsx:32026 `justifyContent:'center'`) inside the centre column,
                         and that column is symmetric because BOTH rails are 48px (AppShell.jsx:2692
                         left, :2841 right). WinShot has only the right rail, so centring inside the
                         canvas column would land 24px left of the top bar's own centred cluster
                         (AppShell.jsx:1344). A 48px left margin restores the symmetry:
                         48 + (W-48-48)/2 = W/2. EditorGroupBar itself stays Stretch so its bottom
                         hairline still terminates into the rail's left hairline, as Survey's does. -->
                    <Grid Margin="48,0,0,0">
                    <!-- Survey's category portal suppresses itself while a rich-text editor
                         is live and the formatting strip takes the sub-row instead
                         (AppShell.jsx:1756-1772). -->
                    <Border x:Name="EditorRichTextHost" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed"/>
                    <Border x:Name="EditorGroupToolsHost" HorizontalAlignment="Center" Visibility="Collapsed">
                    <StackPanel x:Name="EditorGroupTools" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel x:Name="DrawGroupPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <RadioButton x:Name="FreehandToolBtn" Style="{StaticResource StripToolButton}" Margin="4,0" GroupName="Tool"
                                     Tag="Freehand" Checked="OnToolChecked" ToolTip="Pen"
                                     AutomationProperties.Name="Pen"
                                     AutomationProperties.HelpText="Draw a smoothed freehand line. Shortcut P."
                                     Content="{StaticResource SurveyIcon.Pen}"/>
                        <RadioButton x:Name="HighlighterToolBtn" Style="{StaticResource StripToolButton}" Margin="4,0" GroupName="Tool"
                                     Tag="Highlighter" Checked="OnToolChecked" ToolTip="Highlighter"
                                     AutomationProperties.Name="Highlighter"
                                     AutomationProperties.HelpText="Draw a translucent freehand highlight. Shortcut H."
                                     Content="{StaticResource SurveyIcon.Highlighter}"/>
                        <!-- Survey's eraser carries its mode menu INSIDE the button: a 12px
                             #8d96a6 chevron offset +12px from centre opens a 142px popup with
                             an "Eraser Type" header and the two modes
                             (PDFViewer.jsx:32095-32135, 32150-32274). -->
                        <Grid Margin="4,0">
                            <RadioButton x:Name="EraserToolBtn" Style="{StaticResource StripToolButton}" GroupName="Tool"
                                         Tag="Eraser" Checked="OnToolChecked" ToolTip="Partial erase"
                                         AutomationProperties.Name="Partial erase"
                                         AutomationProperties.HelpText="Partial erase subtracts from pen and highlighter ink and deletes any other annotation whole. Full stroke erase deletes every annotation the eraser hits. Shortcut E; Shift+E forces partial erase."
                                         Content="{StaticResource SurveyIcon.Eraser}"/>
                            <Button x:Name="EraserCaretBtn" Click="OnEraserCaretClick" Padding="2" Width="16" Height="16"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0,0,0"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Foreground="{StaticResource ChromeTextMutedBrush}"
                                    ToolTip="Eraser type" AutomationProperties.Name="Eraser type">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Viewbox Width="12" Height="12"><ContentControl Content="{StaticResource SurveyIcon.ChevronDown}"/></Viewbox>
                            </Button>
                            <Popup x:Name="EraserModePopup" PlacementTarget="{Binding ElementName=EraserToolBtn}"
                                   Placement="Bottom" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True">
                                <Border MinWidth="142" Padding="4" CornerRadius="6" BorderThickness="1"
                                        Background="{StaticResource ChromePopoverBrush}" BorderBrush="{StaticResource ChromeHairlineBrush}"
                                        Margin="0,0,24,24">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.6"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="ERASER TYPE" Padding="8,4" Margin="0,0,0,4"
                                                   FontFamily="{StaticResource SurveyArialFont}" FontSize="{StaticResource TextMicro}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource ChromeTextMutedBrush}"/>
                                        <Border Height="1" Background="{StaticResource ChromeHairlineBrush}" Margin="0,0,0,4"/>
                                        <Button x:Name="EraserPartialItem" Style="{StaticResource EraserModeRow}" Tag="Partial"
                                                Content="Partial erase" Click="OnEraserModeRowClick"
                                                AutomationProperties.Name="Partial erase"/>
                                        <Button x:Name="EraserFullItem" Style="{StaticResource EraserModeRow}" Tag="Full"
                                                Content="Full stroke erase" Click="OnEraserModeRowClick"
                                                AutomationProperties.Name="Full stroke erase"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>
                    <StackPanel x:Name="ShapeGroupPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <RadioButton x:Name="RectangleToolBtn" Style="{StaticResource StripToolButton}" Margin="4,0" GroupName="Tool"
                                     Tag="Rectangle" Checked="OnToolChecked"
                                     ToolTip="Rectangle" AutomationProperties.Name="Rectangle"
                                     AutomationProperties.HelpText="Draw a rectangle. Fill and border are independent. Shortcut R."
                                     Content="{StaticResource SurveyIcon.Rect}"/>
                        <RadioButton x:Name="EllipseToolBtn" Style="{StaticResource StripToolButton}" Margin="4,0" GroupName="Tool"
                                     Tag="Ellipse" Checked="OnToolChecked" ToolTip="Ellipse"
                                     AutomationProperties.Name="Ellipse" AutomationProperties.HelpText="Draw an ellipse."
                                     Content="{StaticResource SurveyIcon.Ellipse}"/>
                        <RadioButton x:Name="LineToolBtn" Style="{StaticResource StripToolButton}" Margin="4,0" GroupName="Tool"
                                     Tag="Line" Checked="OnToolChecked" ToolTip="Line"
                                     AutomationProperties.Name="Line" AutomationProperties.HelpText="Draw a straight line. Shortcut L."
                                     Content="{StaticResource SurveyIcon.Line}"/>
                        <RadioButton x:Name="ArrowToolBtn" Style="{StaticResource StripToolButton}" Margin="4,0" GroupName="Tool"
                                     Tag="Arrow" Checked="OnToolChecked" ToolTip="Arrow"
                                     AutomationProperties.Name="Arrow" AutomationProperties.HelpText="Draw an arrow. Six Survey arrowheads. Shortcut A."
                                     Content="{StaticResource SurveyIcon.Arrow}"/>
                        <RadioButton x:Name="StepToolBtn" Style="{StaticResource StripToolButton}" Margin="4,0" GroupName="Tool"
                                     Tag="Step" Checked="OnToolChecked" ToolTip="Counter"
                                     AutomationProperties.Name="Counter"
                                     AutomationProperties.HelpText="Place sequential number or letter badges. Shortcut S."
                                     Content="{StaticResource SurveyIcon.Counter}"/>
                    </StackPanel>
                    <StackPanel x:Name="TextGroupPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <RadioButton x:Name="TextToolBtn" Style="{StaticResource StripToolButton}" Margin="4,0" GroupName="Tool"
                                     Tag="Text" Checked="OnToolChecked" ToolTip="Text"
                                     AutomationProperties.Name="Text"
                                     AutomationProperties.HelpText="Place styled text. Enter commits and Escape cancels. Shortcut T."
                                     Content="{StaticResource SurveyIcon.TextBox}"/>
                        <RadioButton x:Name="CalloutToolBtn" Style="{StaticResource StripToolButton}" Margin="4,0" GroupName="Tool"
                                     Tag="Callout" Checked="OnToolChecked" ToolTip="Callout"
                                     AutomationProperties.Name="Callout"
                                     AutomationProperties.HelpText="Drag from the arrow tip to the text box. Shortcut Q."
                                     Content="{StaticResource SurveyIcon.Callout}"/>
                    </StackPanel>
                    <!-- Survey's Effects group. Its two separate Pixelate and Blur tools are
                         gone: they are two of the four STYLES of the one re-editable redaction
                         mark, which can be moved, resized and restyled after it is drawn. -->
                    <StackPanel x:Name="EffectsGroupPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <RadioButton x:Name="RedactToolBtn" Style="{StaticResource StripToolButton}" Margin="4,0" GroupName="Tool"
                                     Tag="Redact" Content="&#xE7E6;" Checked="OnToolChecked" ToolTip="Redact (X)"
                                     AutomationProperties.Name="Redact"
                                     AutomationProperties.HelpText="Cover a dragged region with a movable, re-styleable redaction. Shortcut X."/>
                        <RadioButton x:Name="SpotlightToolBtn" Style="{StaticResource StripToolButton}" Margin="4,0" GroupName="Tool"
                                     Tag="Spotlight" Checked="OnToolChecked" ToolTip="Spotlight"
                                     AutomationProperties.Name="Spotlight"
                                     AutomationProperties.HelpText="Dim the image outside a dragged rectangular focus area."
                                     Content="{StaticResource SurveyIcon.Spotlight}"/>
                        <RadioButton x:Name="MagnifierToolBtn" Style="{StaticResource StripToolButton}" Margin="4,0" GroupName="Tool"
                                     Tag="Magnifier" Content="&#xE71E;" Checked="OnToolChecked" ToolTip="Magnify (M)"
                                     AutomationProperties.Name="Magnify"
                                     AutomationProperties.HelpText="Drag a bubble that shows a piece of the picture blown up. Drag its ring to aim it somewhere else. Shortcut M."/>
                    </StackPanel>

                    <!-- The fifth group: the one-shot things that act on the IMAGE rather
                         than adding a mark. Survey has no counterpart — its equivalents are
                         scattered through the "more" menu — but a group is where a WinShot
                         user already looks for a tool, and it keeps the top row from
                         growing a second overflow. -->
                    <StackPanel x:Name="ImageGroupPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <RadioButton x:Name="CropToolBtn" Style="{StaticResource StripToolButton}" Margin="4,0" GroupName="Tool"
                                     Tag="Crop" Content="{StaticResource SurveyIcon.Crop}" Checked="OnToolChecked"
                                     ToolTip="Crop &amp; resize (C)"
                                     AutomationProperties.Name="Crop and resize"
                                     AutomationProperties.HelpText="Crop the image. Rotate, flip and Image size live on the crop bar. Shortcut C."/>
                        <Button x:Name="AddImageBtn" Style="{StaticResource CompactToolIconButton}" Margin="4,0" Content="&#xEE71;"
                                Click="OnAddImage" ToolTip="Add screenshot or image… (I)"
                                AutomationProperties.Name="Add screenshot or image"
                                AutomationProperties.HelpText="Insert one or more local image files as movable annotations. Shortcut I."/>
                        <Button x:Name="AddCaptureBtn" Style="{StaticResource CompactToolIconButton}" Margin="4,0" Content="&#xE722;"
                                Click="OnAddCapture" ToolTip="Add capture…"
                                AutomationProperties.Name="Add capture"
                                AutomationProperties.HelpText="Hide the editor, take another region capture, and add it to this canvas."/>
                        <Button x:Name="AddBackgroundBtn" Style="{StaticResource CompactToolIconButton}" Margin="4,0" Content="&#xE790;"
                                Click="OnAddBackground" ToolTip="Add background (B)"
                                AutomationProperties.Name="Add background"
                                AutomationProperties.HelpText="Open the local background composer with the current edited image. Shortcut B."/>
                        <Button x:Name="OcrRegionBtn" Style="{StaticResource CompactToolIconButton}" Margin="4,0" Content="&#xE8E9;"
                                Click="OnExtractText" ToolTip="Extract text"
                                AutomationProperties.Name="Extract text"
                                AutomationProperties.HelpText="Read the text in the crop region, or the whole image, and copy it to the clipboard."/>
                        <!-- Appears only once there is an added image to flip between. A
                             before/after GIF of one frame is a PNG. -->
                        <Button x:Name="ExportGifBtn" Style="{StaticResource CompactToolIconButton}" Margin="4,0" Content="&#xE786;"
                                Click="OnExportGif" ToolTip="Export before/after GIF…"
                                Visibility="Collapsed"
                                AutomationProperties.Name="Export before and after GIF"
                                AutomationProperties.HelpText="Save a two-frame animation flipping between the picture without the added images and with them."/>
                    </StackPanel>
                    </StackPanel>
                    </Border>
                    </Grid>
                </Border>
        </Grid>

        <!-- Survey chrome is FLAT and full-bleed: no radius, no border ring, no shadow,
             no margin. Survey uses two chrome tokens with fixed roles: #181c24 is the
             material for every band that SPANS the viewer width (top bar AppShell.jsx:1343,
             sub-row PDFViewer.jsx:32021), and #12151c is reserved for the vertical rail /
             panel surface and anything hosted inside it (rail hosts AppShell.jsx:2697/2847,
             SurveySpacesRail.jsx:1229, panel footer AppShell.jsx:3093). This band spans the
             viewer width, so it is #181c24 with a 1px #2a3140 top rule — the same material
             as the top bar, which is what makes the chrome read as one system. -->
        <Border x:Name="EditorBottomBar" Grid.Row="2" Grid.Column="0"
                Margin="0" Padding="12,6" CornerRadius="0"
                Background="{StaticResource ChromeBgBrush}"
                BorderBrush="{StaticResource ChromeHairlineBrush}" BorderThickness="0,1,0,0"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Button x:Name="BtnSave" Style="{StaticResource CompactToolIconButton}" Click="OnSave"
                            ToolTip="Save as... (Ctrl+Shift+S)" AutomationProperties.Name="Save as"
                            AutomationProperties.HelpText="Choose a local export file. Shortcut Ctrl+Shift+S."
                            Content="{StaticResource SurveyIcon.Download}"/>
                    <Button x:Name="BtnDone" Style="{StaticResource SurveyPrimaryButton}" Margin="6,0,0,0"
                            Content="Done" Click="OnDone" ToolTip="Copy and close"
                            AutomationProperties.Name="Done"
                            AutomationProperties.HelpText="Copy the edited image to the clipboard and close the editor."/>
                </StackPanel>

                <Button x:Name="BtnDragOut" Grid.Column="1" Style="{StaticResource SurveyDefaultButton}"
                        Margin="0" Padding="10,4"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="SizeAll"
                        PreviewMouseLeftButtonDown="OnDragOutMouseDown" PreviewMouseMove="OnDragOutMouseMove"
                        ToolTip="Drag this image into another app" AutomationProperties.Name="Drag and drop"
                        AutomationProperties.HelpText="Press and drag to drop the edited image as a file into another application.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE700;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource TextBody}"
                                   VerticalAlignment="Center" Opacity="0.7" Margin="0,0,8,0"/>
                        <!-- Every `.btn` label in Survey chrome is weight 500 (styles.css:77-81). -->
                        <TextBlock Text="Drag &amp; Drop" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="{StaticResource TextBodyLg}" FontWeight="Medium"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Name="BtnPin" Style="{StaticResource CompactToolIconButton}" Content="&#xE718;" ToolTip="Pin to screen"
                            Click="OnPin" AutomationProperties.Name="Pin to screen"
                            AutomationProperties.HelpText="Open the edited image in a local always-on-top pin window."/>
                    <Button x:Name="BtnCopy" Style="{StaticResource CompactToolIconButton}" Content="&#xE8C8;"
                            ToolTip="Copy to clipboard (Ctrl+C)" Click="OnCopy" AutomationProperties.Name="Copy"
                            AutomationProperties.HelpText="Copy the source-resolution edited image. Shortcut Ctrl+C."/>
                    <Button x:Name="BtnCenter" Style="{StaticResource CompactToolIconButton}" Content="&#xE9A6;"
                            ToolTip="Fit &amp; center (Ctrl+0)" Click="OnCenterView" AutomationProperties.Name="Fit and center"
                            AutomationProperties.HelpText="Fit and center the whole image. Shortcut Ctrl+0."/>
                </StackPanel>
            </Grid>
        </Border>

            <!-- Survey's collapsed right rail (48px): zoom in, click-to-type percentage, zoom
                 out, divider, then the fit trigger whose menu flies out to the left. -->
            <Border x:Name="ZoomRail" Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Background="{StaticResource ChromeRailBrush}"
                    BorderBrush="{StaticResource ChromeHairlineBrush}" BorderThickness="1,0,0,0"
                    AutomationProperties.Name="Zoom rail">
                <!-- Survey's rail footer: zoom / fit live at the BOTTOM of the rail,
                     over a 1px #2a3140 top rule with 8px vertical padding
                     (AppShell.jsx:3011). Every rail tooltip flies out LEFT so it
                     clears the 48px rail instead of clipping (Tooltip.jsx:69-71). -->
                <Border VerticalAlignment="Bottom" BorderBrush="{StaticResource ChromeHairlineBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                    <StackPanel HorizontalAlignment="Center">
                        <Button x:Name="BtnZoomIn" Style="{StaticResource RailButton}" Click="OnZoomIn"
                                ToolTip="Zoom in" AutomationProperties.Name="Zoom in"
                                ToolTipService.Placement="Left" ToolTipService.HorizontalOffset="-8"
                                AutomationProperties.HelpText="Zoom in one step about the centre of the view.">
                            <Viewbox Width="14" Height="14"><ContentControl Content="{StaticResource SurveyIcon.Plus}"/></Viewbox>
                        </Button>
                        <TextBox x:Name="ZoomBox" Style="{StaticResource RailZoomBox}" Text="100%"
                                 ToolTip="Zoom level — click to type a percentage" AutomationProperties.Name="Zoom level"
                                 ToolTipService.Placement="Left" ToolTipService.HorizontalOffset="-8"
                                 PreviewTextInput="OnZoomBoxTextInput" PreviewKeyDown="OnZoomBoxKeyDown"
                                 TextChanged="OnZoomBoxTextChanged" DataObject.Pasting="OnZoomBoxPasting"
                                 GotKeyboardFocus="OnZoomBoxFocus" LostKeyboardFocus="OnZoomBoxBlur"/>
                        <Button x:Name="BtnZoomOut" Style="{StaticResource RailButton}" Click="OnZoomOut"
                                ToolTip="Zoom out" AutomationProperties.Name="Zoom out"
                                ToolTipService.Placement="Left" ToolTipService.HorizontalOffset="-8"
                                AutomationProperties.HelpText="Zoom out one step about the centre of the view.">
                            <Viewbox Width="14" Height="14"><ContentControl Content="{StaticResource SurveyIcon.Minus}"/></Viewbox>
                        </Button>
                        <Rectangle Width="24" Height="1" Fill="{StaticResource ChromeHairlineBrush}" Margin="0,4"/>
                        <!-- AppShell.jsx:3066-3081: a 36x28 cell with the chevron PINNED to
                             the left edge on its own 12-unit canvas at 1.8 stroke, and the
                             fit glyph independently centred at 16px. Both inherit the
                             button Foreground, which swaps #e8e2d4 / #8d96a6 by fit mode. -->
                        <Button x:Name="FitMenuBtn" Style="{StaticResource RailFitButton}" Height="28" Click="OnFitMenuClick"
                                ToolTip="Page fit: Fit page" AutomationProperties.Name="Fit options"
                                ToolTipService.Placement="Left" ToolTipService.HorizontalOffset="-8"
                                AutomationProperties.HelpText="Choose fit page, fit width, or fit height.">
                            <Grid>
                                <Canvas Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0">
                                    <Path Data="M7.5,2.5 L4,6 L7.5,9.5" StrokeThickness="1.8"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Canvas>
                                <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentControl x:Name="FitModeIcon" Content="{StaticResource SurveyIcon.FitPage}"/>
                                </Viewbox>
                            </Grid>
                        </Button>
                        <!-- Custom placement, not Left: Survey aligns this menu's BOTTOM with
                             the trigger's bottom and Left aligns tops. See PlaceFitMenu. -->
                        <Popup x:Name="FitMenuPopup" PlacementTarget="{Binding ElementName=FitMenuBtn}"
                               Placement="Custom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <!-- AppShell.jsx:2984-2999: rgb(30,30,30) on 1px #2a3140,
                                 radius 2, 0 10px 24px rgba(0,0,0,0.45), padding 2. -->
                            <Border Background="{StaticResource ChromePopoverBrush}" BorderBrush="{StaticResource ChromeHairlineBrush}"
                                    BorderThickness="1" CornerRadius="2" Padding="2" Margin="0"
                                    MinWidth="140">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="24" ShadowDepth="10" Direction="270" Opacity="0.45"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Button x:Name="FitPageItem" Style="{StaticResource MenuRowButton}" Click="OnFitPage" AutomationProperties.Name="Fit page">
                                        <StackPanel Orientation="Horizontal">
                                            <ContentControl Content="{StaticResource SurveyIcon.FitPage}" Width="16" Height="16"/>
                                            <TextBlock Text="Fit page" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="FitWidthItem" Style="{StaticResource MenuRowButton}" Click="OnFitWidth" AutomationProperties.Name="Fit width">
                                        <StackPanel Orientation="Horizontal">
                                            <ContentControl Content="{StaticResource SurveyIcon.FitWidth}" Width="16" Height="16"/>
                                            <TextBlock Text="Fit width" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="FitHeightItem" Style="{StaticResource MenuRowButton}" Click="OnFitHeight" AutomationProperties.Name="Fit height">
                                        <StackPanel Orientation="Horizontal">
                                            <ContentControl Content="{StaticResource SurveyIcon.FitHeight}" Width="16" Height="16"/>
                                            <TextBlock Text="Fit height" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Border>
            </Border>
    </Grid>
</Window>
