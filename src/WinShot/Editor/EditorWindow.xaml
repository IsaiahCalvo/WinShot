                                                             42x20 input on #3a4252, radius 5, 12px, centred, >= 1. -->
                                                        <TextBlock Text="Start" Margin="0,0,4,0" VerticalAlignment="Center"
                                                                   FontFamily="{StaticResource SurveyArialFont}" FontSize="{StaticResource TextCaption}"
                                                                   Foreground="{StaticResource ChromeTextMutedBrush}"/>
                                                        <Border Width="42" Height="20" CornerRadius="5" BorderThickness="1" Margin="0,0,6,0"
                                                                Background="{StaticResource ChromeControlBrush}" BorderBrush="Transparent">
                                                            <TextBox x:Name="StepStartInput" Style="{StaticResource SizeFieldInput}"
