<Window x:Class="WinShot.Editor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinShot Editor" Background="{StaticResource WindowBgBrush}"
        MinWidth="980" MinHeight="520"
        AllowDrop="True" Drop="OnEditorDrop" DragOver="OnEditorDragOver"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        AutomationProperties.Name="WinShot annotation editor">
    <Grid Background="{StaticResource WindowBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="TopToolbar" Grid.Row="0" Style="{StaticResource FloatingToolbar}" Margin="12,12,12,6">
            <StackPanel>
                <Grid x:Name="ToolbarPrimaryRow">
                    <!-- Survey: the tool cluster is centred (justify-content: center); undo/redo
                         sit absolutely at the left, tool properties absolutely at the cluster's
                         right (left: 100%). Equal star side columns give the same geometry, so
                         the tools never shift when either side changes width. -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnUndo" Style="{StaticResource SurveyDefaultButton}"
                                ToolTip="Undo (Ctrl+Z)" Click="OnUndo" IsEnabled="False"
                                AutomationProperties.Name="Undo" AutomationProperties.HelpText="Undo the last action. Shortcut Ctrl+Z.">
                            <Viewbox Width="14" Height="14"><ContentControl Content="{StaticResource SurveyIcon.Undo}"/></Viewbox>
                        </Button>
                        <Button x:Name="BtnRedo" Style="{StaticResource SurveyDefaultButton}"
                                ToolTip="Redo (Ctrl+Y)" Click="OnRedo" IsEnabled="False"
                                AutomationProperties.Name="Redo" AutomationProperties.HelpText="Redo the last action. Shortcut Ctrl+Y.">
                            <Viewbox Width="14" Height="14"><ContentControl Content="{StaticResource SurveyIcon.Redo}"/></Viewbox>
                        </Button>
                        <Rectangle Style="{StaticResource ToolbarDivider}"/>
                        <Button x:Name="CropUtilityBtn" Style="{StaticResource CompactToolIconButton}" Content="&#xE7A8;"
                                Click="OnCropClick" ToolTip="Crop (C)"
                                AutomationProperties.Name="Crop and resize"
                                AutomationProperties.HelpText="Crop the image. Does not deselect Pan or Select. Shortcut C."/>
                        <Button x:Name="RotateCwBtn" Style="{StaticResource CompactToolIconButton}" Content="&#xE7AD;"
                                RenderTransformOrigin="0.5,0.5" ToolTip="Rotate 90° clockwise" Click="OnRotateCw"
                                AutomationProperties.Name="Rotate clockwise"
                                AutomationProperties.HelpText="Rotate the source image 90 degrees clockwise.">
                            <Button.RenderTransform><ScaleTransform ScaleX="-1"/></Button.RenderTransform>
                        </Button>
                        <Button x:Name="MoreChromeBtn" Style="{StaticResource CompactToolIconButton}" Content="{StaticResource SurveyIcon.More}"
                                Click="OnMoreChromeClick" ToolTip="More"
                                AutomationProperties.Name="More image tools"
                                AutomationProperties.HelpText="Rotate the other way, flip, resize, add image, or add a background."/>
                        <Popup x:Name="MoreChromePopup" PlacementTarget="{Binding ElementName=MoreChromeBtn}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="{StaticResource RadiusInput}" Padding="6" Margin="0,4,12,12"
                                    Effect="{StaticResource FloatingShadow}" MinWidth="220">
                                <StackPanel>
                                    <Button x:Name="RotateCcwBtn" Style="{StaticResource ChromeMenuItem}" Click="OnRotateCcw"
                                            ToolTip="Rotate 90° counter-clockwise"
                                            AutomationProperties.Name="Rotate counter-clockwise"
                                            AutomationProperties.HelpText="Rotate the source image 90 degrees counter-clockwise.">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7AD;" FontFamily="{StaticResource IconFont}" FontSize="14" Width="22" VerticalAlignment="Center"/>
                                            <TextBlock Text="Rotate counter-clockwise" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="FlipHorizontalBtn" Style="{StaticResource ChromeMenuItem}" Click="OnFlipHorizontal"
                                            ToolTip="Flip horizontal" AutomationProperties.Name="Flip horizontal"
                                            AutomationProperties.HelpText="Flip the source image from left to right.">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE13C;" FontFamily="{StaticResource IconFont}" FontSize="14" Width="22" VerticalAlignment="Center"/>
                                            <TextBlock Text="Flip horizontal" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="FlipVerticalBtn" Style="{StaticResource ChromeMenuItem}" Click="OnFlipVertical"
                                            ToolTip="Flip vertical" AutomationProperties.Name="Flip vertical"
                                            AutomationProperties.HelpText="Flip the source image from top to bottom.">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE174;" FontFamily="{StaticResource IconFont}" FontSize="14" Width="22" VerticalAlignment="Center"/>
                                            <TextBlock Text="Flip vertical" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ResizeImageBtn" Style="{StaticResource ChromeMenuItem}" Click="OnResizeImage"
                                            ToolTip="Resize the image…" AutomationProperties.Name="Resize image"
                                            AutomationProperties.HelpText="Open local source-image resize controls.">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE740;" FontFamily="{StaticResource IconFont}" FontSize="14" Width="22" VerticalAlignment="Center"/>
                                            <TextBlock Text="Resize image…" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="AddImageBtn" Style="{StaticResource ChromeMenuItem}" Click="OnAddImage"
                                            ToolTip="Add screenshot or image…"
                                            AutomationProperties.Name="Add screenshot or image"
                                            AutomationProperties.HelpText="Insert one or more local image files as movable annotations.">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xEE71;" FontFamily="{StaticResource IconFont}" FontSize="14" Width="22" VerticalAlignment="Center"/>
                                            <TextBlock Text="Add image…" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="AddBackgroundBtn" Style="{StaticResource ChromeMenuItem}" Click="OnAddBackground"
                                            ToolTip="Add background" AutomationProperties.Name="Add background"
                                            AutomationProperties.HelpText="Open the local background composer with the current edited image.">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE790;" FontFamily="{StaticResource IconFont}" FontSize="14" Width="22" VerticalAlignment="Center"/>
                                            <TextBlock Text="Add background" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <Grid Grid.Column="1">
                    <StackPanel x:Name="ToolPanel" Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Margin="0">
                        <RadioButton x:Name="PanToolBtn" Style="{StaticResource ToolButton}" GroupName="Tool"
                                     Tag="Pan" Checked="OnToolChecked" ToolTip="Pan"
                                     AutomationProperties.Name="Pan"
                                     AutomationProperties.HelpText="Drag to move the view. Middle-drag or hold Space works with any tool."
                                     Content="{StaticResource SurveyIcon.Pan}"/>
                        <RadioButton x:Name="SelectToolBtn" Style="{StaticResource ToolButton}" GroupName="Tool"
                                     Tag="Select" Checked="OnToolChecked" IsChecked="True"
                                     ToolTip="Cursor (V)" AutomationProperties.Name="Cursor"
                                     AutomationProperties.HelpText="Select annotations, drag a marquee, move, resize, or delete. Shortcut V."
                                     Content="{StaticResource SurveyIcon.Cursor}"/>

                        <Button x:Name="DrawGroupBtn" Style="{StaticResource ToolIconButton}"
                                Click="OnDrawGroupClick" Tag="Draw" ToolTip="Draw"
                                AutomationProperties.Name="Draw"
                                AutomationProperties.HelpText="Pen, highlighter, and eraser. Shortcut P or H."
                                Content="{StaticResource SurveyIcon.Pen}"/>

                        <Button x:Name="ShapeGroupBtn" Style="{StaticResource ToolIconButton}"
                                Click="OnShapeGroupClick" Tag="Shape" ToolTip="Shapes"
                                AutomationProperties.Name="Shapes"
                                AutomationProperties.HelpText="Rectangle, ellipse, line, arrow, and counter."
                                Content="{StaticResource SurveyIcon.Rect}"/>

                        <Button x:Name="TextGroupBtn" Style="{StaticResource ToolIconButton}"
                                Click="OnTextGroupClick" Tag="Text" ToolTip="Text"
                                AutomationProperties.Name="Text"
                                AutomationProperties.HelpText="Text box and callout."
                                Content="{StaticResource SurveyIcon.Text}"/>

                        <Button x:Name="EffectsGroupBtn" Style="{StaticResource ToolIconButton}"
                                Click="OnEffectsGroupClick" Tag="Effects" ToolTip="Effects"
                                AutomationProperties.Name="Effects"
                                AutomationProperties.HelpText="Pixelate, spotlight, and blur."
                                Content="{StaticResource SurveyIcon.Effects}"/>


                        <RadioButton x:Name="CurvedArrowToolBtn" Style="{StaticResource ToolButton}" GroupName="Tool"
                                     Tag="CurvedArrow" Checked="OnToolChecked" Visibility="Collapsed"
                                     ToolTip="Curved arrow" AutomationProperties.Name="Curved arrow"
                                     AutomationProperties.HelpText="Line and arrow already bend from the midpoint handle."/>

                    </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel x:Name="SecondaryToolPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,8,0">
                            <Rectangle Style="{StaticResource ToolbarDivider}"/>
                            <StackPanel x:Name="EditorColorBar" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <StackPanel x:Name="ColorPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                                        <Button x:Name="ColorWellBtn" Style="{StaticResource CompactToolIconButton}" Width="24" Height="24" Margin="4,0,2,0"
                                                                Click="OnCustomSwatchClick" ToolTip="Color"
                                                                AutomationProperties.Name="Color"
                                                                AutomationProperties.HelpText="Open the color picker.">
                                                            <Ellipse x:Name="CurrentColorIndicator" Width="20" Height="20" Fill="{StaticResource AnnotationRedBrush}"
                                                                     Stroke="{StaticResource BorderStrongBrush}" StrokeThickness="2"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Button>
                                                        <TextBlock x:Name="ColorWellLabel" Text="Color" Style="{StaticResource FieldLabel}" Visibility="Collapsed"/>
                                                        <WrapPanel Visibility="Collapsed">
                                                        <RadioButton Style="{StaticResource ColorSwatch}" GroupName="Color" Background="#FF453A" ToolTip="Red" Checked="OnColorChecked" IsChecked="True" AutomationProperties.Name="Red"/>
                                                        <RadioButton Style="{StaticResource ColorSwatch}" GroupName="Color" Background="#FF9500" ToolTip="Orange" Checked="OnColorChecked" AutomationProperties.Name="Orange"/>
                                                        <RadioButton Style="{StaticResource ColorSwatch}" GroupName="Color" Background="#FFCC00" ToolTip="Yellow" Checked="OnColorChecked" AutomationProperties.Name="Yellow"/>
                                                        <RadioButton Style="{StaticResource ColorSwatch}" GroupName="Color" Background="#34C759" ToolTip="Green" Checked="OnColorChecked" AutomationProperties.Name="Green"/>
                                                        <RadioButton Style="{StaticResource ColorSwatch}" GroupName="Color" Background="#0A84FF" ToolTip="Blue" Checked="OnColorChecked" AutomationProperties.Name="Blue"/>
                                                        <RadioButton Style="{StaticResource ColorSwatch}" GroupName="Color" Background="#AF52DE" ToolTip="Purple" Checked="OnColorChecked" AutomationProperties.Name="Purple"/>
                                                        <RadioButton Style="{StaticResource ColorSwatch}" GroupName="Color" Background="#000000" ToolTip="Black" Checked="OnColorChecked" AutomationProperties.Name="Black"/>
                                                        <RadioButton Style="{StaticResource ColorSwatch}" GroupName="Color" Background="#FFFFFF" ToolTip="White" Checked="OnColorChecked" AutomationProperties.Name="White"/>
                                                        <RadioButton x:Name="CustomSwatch" Style="{StaticResource ColorSwatch}" GroupName="Color"
                                                                     ToolTip="Custom color" Checked="OnColorChecked" Click="OnCustomSwatchClick"
                                                                     AutomationProperties.Name="Custom color"
                                                                     AutomationProperties.HelpText="Open the local palette or enter a hex color.">
                                                            <RadioButton.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#FF3B30" Offset="0"/><GradientStop Color="#FFCC00" Offset="0.25"/>
                                                                    <GradientStop Color="#34C759" Offset="0.5"/><GradientStop Color="#0A84FF" Offset="0.75"/>
                                                                    <GradientStop Color="#AF52DE" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </RadioButton.Background>
                                                        </RadioButton>
                                                        <Popup x:Name="ColorPickerPopup" PlacementTarget="{Binding ElementName=ColorWellBtn}"
                                                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                                            <Border Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                                    BorderThickness="1" CornerRadius="{StaticResource RadiusInput}" Padding="10" Margin="0,4,12,12"
                                                                    Effect="{StaticResource FloatingShadow}">
                                                                <StackPanel Width="248">
                                                                    <StackPanel x:Name="FillStrokeTabPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,0,8">
                                                                            <RadioButton x:Name="StrokeWellBtn" Style="{StaticResource StripTab}" GroupName="ColorWell" Tag="Stroke"
                                                                                         Content="Border" IsChecked="True"
                                                                                         Checked="OnColorWellChecked" AutomationProperties.Name="Border color"
                                                                                         AutomationProperties.HelpText="Edit the stroke or border color and opacity."/>
                                                                            <RadioButton x:Name="FillWellBtn" Style="{StaticResource StripTab}" GroupName="ColorWell" Tag="Fill"
                                                                                         Content="Fill"
                                                                                         Checked="OnColorWellChecked" AutomationProperties.Name="Fill color"
                                                                                         AutomationProperties.HelpText="Edit the fill color and opacity independently of the border."/>
                                                                    </StackPanel>
                                                                    <!-- Survey keeps the eyedropper with the colour it samples for. -->
                                                                    <RadioButton x:Name="EyedropperToolBtn" Style="{StaticResource StripToolButton}" GroupName="Tool"
                                                                                 Tag="Eyedropper" Checked="OnToolChecked" ToolTip="Eyedropper"
                                                                                 Width="Auto" HorizontalAlignment="Left" Margin="0,0,0,8" Padding="6,0"
                                                                                 AutomationProperties.Name="Eyedropper"
                                                                                 AutomationProperties.HelpText="Sample a source pixel and make it the current annotation color.">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <ContentPresenter Content="{StaticResource SurveyIcon.Eyedropper}" VerticalAlignment="Center"/>
                                                                            <TextBlock Text="Pick from image" FontSize="12" Margin="8,0,4,0" VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </RadioButton>
                                                                    <UniformGrid x:Name="ColorPickerGrid" Columns="8"/>
                                                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,8"/>
                                                                    <Canvas x:Name="ColorPickerSv" Width="232" Height="110" Margin="0,0,8,0" Cursor="Cross"
                                                                            Background="Transparent"
                                                                            MouseDown="OnColorPickerSvDown" MouseMove="OnColorPickerSvMove" MouseUp="OnColorPickerSvUp"
                                                                            AutomationProperties.Name="Color spectrum"
                                                                            AutomationProperties.HelpText="Drag to pick saturation and brightness.">
                                                                        <Rectangle x:Name="SvHueRect" Width="232" Height="110" RadiusX="6" RadiusY="6"
                                                                                   Fill="#FFFF0000" IsHitTestVisible="False"/>
                                                                        <Rectangle Width="232" Height="110" RadiusX="6" RadiusY="6" IsHitTestVisible="False">
                                                                            <Rectangle.Fill>
                                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                                                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                                                </LinearGradientBrush>
                                                                            </Rectangle.Fill>
                                                                        </Rectangle>
                                                                        <Rectangle Width="232" Height="110" RadiusX="6" RadiusY="6" IsHitTestVisible="False">
                                                                            <Rectangle.Fill>
                                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                    <GradientStop Color="#00000000" Offset="0"/>
                                                                                    <GradientStop Color="#FF000000" Offset="1"/>
                                                                                </LinearGradientBrush>
                                                                            </Rectangle.Fill>
                                                                        </Rectangle>
                                                                        <Ellipse x:Name="SvCursor" Width="10" Height="10" Stroke="White" StrokeThickness="2"
                                                                                 IsHitTestVisible="False"/>
                                                                    </Canvas>
                                                                    <Canvas x:Name="ColorPickerHue" Width="232" Height="12" Margin="0,0,8,0" Cursor="Hand"
                                                                            Background="Transparent"
                                                                            MouseDown="OnColorPickerHueDown" MouseMove="OnColorPickerHueMove" MouseUp="OnColorPickerHueUp"
                                                                            AutomationProperties.Name="Hue"
                                                                            AutomationProperties.HelpText="Drag to pick hue.">
                                                                        <Rectangle Width="232" Height="12" RadiusX="4" RadiusY="4">
                                                                            <Rectangle.Fill>
                                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                                    <GradientStop Color="#FFFF0000" Offset="0"/>
                                                                                    <GradientStop Color="#FFFFFF00" Offset="0.17"/>
                                                                                    <GradientStop Color="#FF00FF00" Offset="0.33"/>
                                                                                    <GradientStop Color="#FF00FFFF" Offset="0.50"/>
                                                                                    <GradientStop Color="#FF0000FF" Offset="0.67"/>
                                                                                    <GradientStop Color="#FFFF00FF" Offset="0.83"/>
                                                                                    <GradientStop Color="#FFFF0000" Offset="1"/>
                                                                                </LinearGradientBrush>
                                                                            </Rectangle.Fill>
                                                                        </Rectangle>
                                                                        <Ellipse x:Name="HueCursor" Width="10" Height="10" Stroke="White" StrokeThickness="2"
                                                                                 Fill="Transparent" IsHitTestVisible="False" Canvas.Top="1"/>
                                                                    </Canvas>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                        <Rectangle x:Name="ColorPickerPreview" Grid.Column="0" Width="22" Height="22" RadiusX="4" RadiusY="4"
                                                                                   Stroke="{StaticResource BorderStrongBrush}" StrokeThickness="1"/>
                                                                        <TextBox x:Name="ColorPickerHex" Grid.Column="1" Style="{StaticResource DarkTextBox}" Margin="8,0"
                                                                                 Text="#FF3B30" KeyDown="OnColorPickerHexKeyDown" TextChanged="OnColorPickerHexChanged"
                                                                                 ToolTip="Type a hex color" AutomationProperties.Name="Hex color"/>
                                                                        <Button x:Name="ColorPickerApply" Grid.Column="2" Style="{StaticResource PillButtonPrimary}"
                                                                                Content="Apply" Click="OnColorPickerApply" AutomationProperties.Name="Apply color"/>
                                                                    </Grid>
                                                                    <DockPanel Margin="0,8,0,0">
                                                                        <TextBlock Text="Opacity" Style="{StaticResource FieldLabel}" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                                                                        <TextBlock x:Name="PickerOpacityValue" Text="100%" Style="{StaticResource ValueLabel}"
                                                                                   DockPanel.Dock="Right" MinWidth="38" TextAlignment="Right"/>
                                                                        <Slider x:Name="PickerOpacitySlider" Style="{StaticResource DarkSlider}" Minimum="0" Maximum="100" Value="100"
                                                                                SmallChange="1" LargeChange="10"
                                                                                ValueChanged="OnPickerOpacityChanged"
                                                                                AutomationProperties.Name="Picker opacity"/>
                                                                    </DockPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </Popup>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </StackPanel>
                            <Grid x:Name="SizeEffectHost" MinWidth="52" VerticalAlignment="Center" Margin="0,0,8,0">
                            <StackPanel x:Name="ThicknessPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                                        <TextBlock x:Name="ThicknessLabel" Text="Stroke" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" Visibility="Collapsed"/>
                                                        <ComboBox x:Name="SizeBox" Style="{StaticResource DarkComboBox}"
                                                                  SelectionChanged="OnSizeBoxChanged"
                                                                  AutomationProperties.Name="Annotation size"
                                                                  AutomationProperties.HelpText="Survey size presets. Stroke tools use 1–50; text uses 8–72."/>
                                                    </StackPanel>
                                                    <StackPanel x:Name="EffectStrengthPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                                        <TextBlock x:Name="EffectStrengthLabel" Text="Blur" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" Visibility="Collapsed"/>
                                                        <ComboBox x:Name="EffectStrengthBox" Style="{StaticResource DarkComboBox}" SelectedIndex="1"
                                                                  SelectionChanged="OnEffectStrengthChanged" AutomationProperties.Name="Effect strength"
                                                                  AutomationProperties.HelpText="Light, medium, or strong blur or pixelate.">
                                                            <ComboBoxItem Content="Light" Tag="Light"/>
                                                            <ComboBoxItem Content="Medium" Tag="Medium"/>
                                                            <ComboBoxItem Content="Strong" Tag="Strong"/>
                                                        </ComboBox>
                                                    </StackPanel>
                            </Grid>
                    <StackPanel x:Name="EditorFormatBar" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <StackPanel x:Name="CropPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,8,0">
                                                        <Button Style="{StaticResource PillButtonPrimary}" Content="Apply crop" Click="OnApplyCrop"
                                                                Margin="0,0,6,0"
                                                                AutomationProperties.Name="Apply crop"/>
                                                        <Button x:Name="CropCancelBtn" Style="{StaticResource PillButtonSecondary}" Content="Don't crop" Click="OnCancelCrop"
                                                                AutomationProperties.Name="Don't crop"/>
                                                    </StackPanel>
                                                <StackPanel x:Name="ContextPanel" Orientation="Horizontal" VerticalAlignment="Center">
                                                    

                                                    <StackPanel x:Name="ArrowStylePanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,8,0">
                                                        <ComboBox x:Name="ArrowStyleBox" Style="{StaticResource DarkComboBox}" SelectedIndex="1"
                                                                  SelectionChanged="OnArrowStyleChanged" AutomationProperties.Name="Arrowhead">
                                                            <ComboBoxItem Content="None" Tag="none"/>
                                                            <ComboBoxItem Content="Solid triangle" Tag="solidTriangle"/>
                                                            <ComboBoxItem Content="V-shape" Tag="vShape"/>
                                                            <ComboBoxItem Content="Open circle" Tag="openCircle"/>
                                                            <ComboBoxItem Content="Open triangle" Tag="openTriangle"/>
                                                            <ComboBoxItem Content="Horizontal line" Tag="horizontalLine"/>
                                                            <ComboBoxItem Content="Double" Tag="Double"/>
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <StackPanel x:Name="LineStylePanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,8,0">
                                                        <ComboBox x:Name="LineStyleBox" Style="{StaticResource DarkComboBox}" SelectedIndex="0"
                                                                  SelectionChanged="OnLineStyleChanged" AutomationProperties.Name="Line style">
                                                            <ComboBoxItem Content="Solid" Tag="solid"/>
                                                            <ComboBoxItem Content="Dashed" Tag="dashed"/>
                                                            <ComboBoxItem Content="Dotted" Tag="dotted"/>
                                                            <ComboBoxItem x:Name="CloudStyleItem" Content="Cloud" Tag="cloud"/>
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <StackPanel x:Name="TextStylePanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,8,0">
                                                        <StackPanel x:Name="TextFormatButtons" Orientation="Horizontal" Margin="0,0,6,0">
                                                        <Button x:Name="BoldBtn" Style="{StaticResource CompactFormatButton}" FontWeight="Bold"
                                                                Click="OnTextBoldClick" ToolTip="Bold" AutomationProperties.Name="Bold"
                                                                AutomationProperties.HelpText="Toggle bold on new and selected text.">
                                                            <TextBlock Text="B" FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"/>
                                                        </Button>
                                                        <Button x:Name="ItalicBtn" Style="{StaticResource CompactFormatButton}"
                                                                Click="OnTextItalicClick" ToolTip="Italic" AutomationProperties.Name="Italic"
                                                                AutomationProperties.HelpText="Toggle italic on new and selected text.">
                                                            <TextBlock Text="I" FontFamily="Segoe UI" FontSize="13" FontStyle="Italic" FontWeight="SemiBold"/>
                                                        </Button>
                                                        <Button x:Name="UnderlineBtn" Style="{StaticResource CompactFormatButton}"
                                                                Click="OnTextUnderlineClick" ToolTip="Underline" AutomationProperties.Name="Underline"
                                                                AutomationProperties.HelpText="Toggle underline on new and selected text.">
                                                            <TextBlock Text="U" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" TextDecorations="Underline"/>
                                                        </Button>
                                                        <Button x:Name="StrikeBtn" Style="{StaticResource CompactFormatButton}"
                                                                Click="OnTextStrikeClick" ToolTip="Strikethrough" AutomationProperties.Name="Strikethrough"
                                                                AutomationProperties.HelpText="Toggle strikethrough on new and selected text.">
                                                            <TextBlock Text="S" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" TextDecorations="Strikethrough"/>
                                                        </Button>
                                                        </StackPanel>
                                                        <Button x:Name="AlignMenuBtn" Style="{StaticResource CompactFormatButton}"
                                                                Click="OnAlignMenuClick" ToolTip="Text alignment"
                                                                AutomationProperties.Name="Text alignment"
                                                                AutomationProperties.HelpText="Choose horizontal and vertical alignment from a 3 by 3 grid.">
                                                            <UniformGrid x:Name="AlignTriggerGrid" Columns="3" Width="16" Height="16">
                                                                <Rectangle Width="4" Height="4" Margin="1" RadiusX="0.5" Fill="{StaticResource TextSecondaryBrush}" Tag="left|top"/>
                                                                <Rectangle Width="4" Height="4" Margin="1" RadiusX="0.5" Fill="{StaticResource TextSecondaryBrush}" Tag="center|top"/>
                                                                <Rectangle Width="4" Height="4" Margin="1" RadiusX="0.5" Fill="{StaticResource TextSecondaryBrush}" Tag="right|top"/>
                                                                <Rectangle Width="4" Height="4" Margin="1" RadiusX="0.5" Fill="{StaticResource TextSecondaryBrush}" Tag="left|middle"/>
                                                                <Rectangle Width="4" Height="4" Margin="1" RadiusX="0.5" Fill="{StaticResource TextSecondaryBrush}" Tag="center|middle"/>
                                                                <Rectangle Width="4" Height="4" Margin="1" RadiusX="0.5" Fill="{StaticResource TextSecondaryBrush}" Tag="right|middle"/>
                                                                <Rectangle Width="4" Height="4" Margin="1" RadiusX="0.5" Fill="{StaticResource TextSecondaryBrush}" Tag="left|bottom"/>
                                                                <Rectangle Width="4" Height="4" Margin="1" RadiusX="0.5" Fill="{StaticResource TextSecondaryBrush}" Tag="center|bottom"/>
                                                                <Rectangle Width="4" Height="4" Margin="1" RadiusX="0.5" Fill="{StaticResource TextSecondaryBrush}" Tag="right|bottom"/>
                                                            </UniformGrid>
                                                        </Button>
                                                        <Popup x:Name="AlignPopup" PlacementTarget="{Binding ElementName=AlignMenuBtn}"
                                                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                                            <Border Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                                    BorderThickness="1" CornerRadius="{StaticResource RadiusInput}" Padding="8" Margin="0,4,12,12"
                                                                    Effect="{StaticResource FloatingShadow}">
                                                                <UniformGrid x:Name="AlignGrid" Columns="3" Width="84" Height="84">
                                                                    <Button Style="{StaticResource AlignCellButton}" Tag="left|top" Click="OnAlignCellClick" ToolTip="Top left">
                                                                        <Grid Width="16" Height="16"><Rectangle Width="10" Height="8" Fill="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"/></Grid>
                                                                    </Button>
                                                                    <Button Style="{StaticResource AlignCellButton}" Tag="center|top" Click="OnAlignCellClick" ToolTip="Top center">
                                                                        <Grid Width="16" Height="16"><Rectangle Width="10" Height="8" Fill="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Top"/></Grid>
                                                                    </Button>
                                                                    <Button Style="{StaticResource AlignCellButton}" Tag="right|top" Click="OnAlignCellClick" ToolTip="Top right">
                                                                        <Grid Width="16" Height="16"><Rectangle Width="10" Height="8" Fill="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Top"/></Grid>
                                                                    </Button>
                                                                    <Button Style="{StaticResource AlignCellButton}" Tag="left|middle" Click="OnAlignCellClick" ToolTip="Middle left">
                                                                        <Grid Width="16" Height="16"><Rectangle Width="10" Height="8" Fill="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/></Grid>
                                                                    </Button>
                                                                    <Button Style="{StaticResource AlignCellButton}" Tag="center|middle" Click="OnAlignCellClick" ToolTip="Middle center">
                                                                        <Grid Width="16" Height="16"><Rectangle Width="10" Height="8" Fill="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                                                                    </Button>
                                                                    <Button Style="{StaticResource AlignCellButton}" Tag="right|middle" Click="OnAlignCellClick" ToolTip="Middle right">
                                                                        <Grid Width="16" Height="16"><Rectangle Width="10" Height="8" Fill="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                                                                    </Button>
                                                                    <Button Style="{StaticResource AlignCellButton}" Tag="left|bottom" Click="OnAlignCellClick" ToolTip="Bottom left">
                                                                        <Grid Width="16" Height="16"><Rectangle Width="10" Height="8" Fill="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom"/></Grid>
                                                                    </Button>
                                                                    <Button Style="{StaticResource AlignCellButton}" Tag="center|bottom" Click="OnAlignCellClick" ToolTip="Bottom center">
                                                                        <Grid Width="16" Height="16"><Rectangle Width="10" Height="8" Fill="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom"/></Grid>
                                                                    </Button>
                                                                    <Button Style="{StaticResource AlignCellButton}" Tag="right|bottom" Click="OnAlignCellClick" ToolTip="Bottom right">
                                                                        <Grid Width="16" Height="16"><Rectangle Width="10" Height="8" Fill="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid>
                                                                    </Button>
                                                                </UniformGrid>
                                                            </Border>
                                                        </Popup>
                                                        <ComboBox x:Name="AlignBox" Style="{StaticResource DarkComboBox}" Margin="0,0,6,0"
                                                                  SelectedIndex="0" Visibility="Collapsed"
                                                                  SelectionChanged="OnTextAlignChanged" AutomationProperties.Name="Text align">
                                                            <ComboBoxItem Content="Left" Tag="left"/>
                                                            <ComboBoxItem Content="Center" Tag="center"/>
                                                            <ComboBoxItem Content="Right" Tag="right"/>
                                                        </ComboBox>
                                                        <ComboBox x:Name="VerticalAlignBox" Style="{StaticResource DarkComboBox}"
                                                                  SelectedIndex="0" Visibility="Collapsed"
                                                                  SelectionChanged="OnVerticalAlignChanged" AutomationProperties.Name="Vertical align"
                                                                  AutomationProperties.HelpText="Top, middle, or bottom align inside a sized text box.">
                                                            <ComboBoxItem Content="Top" Tag="top"/>
                                                            <ComboBoxItem Content="Middle" Tag="middle"/>
                                                            <ComboBoxItem Content="Bottom" Tag="bottom"/>
                                                        </ComboBox>
                                                        <ComboBox x:Name="FontSizeBox" Style="{StaticResource DarkComboBox}" Margin="0,0,6,0"
                                                                  SelectionChanged="OnFontSizeBoxChanged" AutomationProperties.Name="Font size"
                                                                  AutomationProperties.HelpText="Font size for text and callout labels."/>
                                                        <ComboBox x:Name="FontFamilyBox" Style="{StaticResource DarkComboBox}" Margin="0,0,6,0"
                                                                  SelectionChanged="OnFontFamilyChanged" AutomationProperties.Name="Font"/>
                                                    </StackPanel>

                                                    <StackPanel x:Name="CropRatioPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,8,0">
                                                        <ComboBox x:Name="CropRatioBox" Style="{StaticResource DarkComboBox}" SelectedIndex="0"
                                                                  SelectionChanged="OnCropRatioChanged" AutomationProperties.Name="Crop ratio">
                                                            <ComboBoxItem Content="Free" Tag=""/><ComboBoxItem Content="1:1" Tag="1:1"/><ComboBoxItem Content="4:3" Tag="4:3"/>
                                                            <ComboBoxItem Content="16:9" Tag="16:9"/><ComboBoxItem Content="9:16" Tag="9:16"/>
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <StackPanel x:Name="StepModePanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,8,0">
                                                        <ComboBox x:Name="StepModeBox" Style="{StaticResource DarkComboBox}" SelectedIndex="0" Margin="0,0,6,0"
                                                                  SelectionChanged="OnStepModeChanged"
                                                                  AutomationProperties.Name="Counter mode"
                                                                  AutomationProperties.HelpText="Number badges or letter badges.">
                                                            <ComboBoxItem Content="Numbers" Tag="Number"/>
                                                            <ComboBoxItem Content="Letters" Tag="Letter"/>
                                                        </ComboBox>
                                                        <Button Style="{StaticResource PillButtonSecondary}" Content="Reset" ToolTip="Reset counter"
                                                                Click="OnResetStepCounter" AutomationProperties.Name="Reset counter"/>
                                                    </StackPanel>

                                                    <StackPanel x:Name="FillPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,8,0">
                                                        <TextBlock Text="Fill" Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/>
                                                        <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="FillNoneBtn" Style="{StaticResource ToolButton}" GroupName="Fill" Tag="None" Content="&#xE739;" ToolTip="No fill"
                                                                     Checked="OnFillChecked" IsChecked="True" AutomationProperties.Name="No fill"
                                                                     AutomationProperties.HelpText="Draw shapes with an outline and no fill."/>
                                                        <RadioButton x:Name="FillQuarterBtn" Style="{StaticResource ToolButton}" GroupName="Fill" Tag="Quarter" Content="&#xE7E6;" ToolTip="25% fill"
                                                                     Checked="OnFillChecked" AutomationProperties.Name="25 percent fill"
                                                                     AutomationProperties.HelpText="Draw shapes with a translucent 25 percent fill."/>
                                                        <RadioButton x:Name="FillSolidBtn" Style="{StaticResource ToolButton}" GroupName="Fill" Tag="Solid" Content="&#xE73B;" ToolTip="Solid fill"
                                                                     Checked="OnFillChecked" AutomationProperties.Name="Solid fill"
                                                                     AutomationProperties.HelpText="Draw shapes with a solid fill."/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <StackPanel x:Name="EraserModePanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,8,0">
                                                        <ComboBox x:Name="EraserModeBox" Style="{StaticResource DarkComboBox}" SelectedIndex="0"
                                                                  SelectionChanged="OnEraserModeChanged"
                                                                  AutomationProperties.Name="Eraser mode"
                                                                  AutomationProperties.HelpText="Partial subtracts from pen and highlighter ink. Full deletes any annotation the eraser hits.">
                                                            <ComboBoxItem Content="Partial erase" Tag="Partial"/>
                                                            <ComboBoxItem Content="Full erase" Tag="Full"/>
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <StackPanel x:Name="OpacityPanel" Visibility="Collapsed" Margin="0,0,6,0">
                                                        <DockPanel Margin="0,0,6,0">
                                                        <TextBlock Text="Opacity" Style="{StaticResource FieldLabel}" DockPanel.Dock="Left"/>
                                                        <TextBlock x:Name="OpacityValue" Text="100%" Style="{StaticResource ValueLabel}" MinWidth="38"
                                                                   TextAlignment="Right" HorizontalAlignment="Right"/>
                                                        </DockPanel>
                                                        <Slider x:Name="OpacitySlider" Style="{StaticResource DarkSlider}" Minimum="0" Maximum="100" Value="100"
                                                                SmallChange="5" LargeChange="25" TickFrequency="25" IsSnapToTickEnabled="False"
                                                                ValueChanged="OnOpacityChanged" PreviewMouseUp="OnOpacitySliderReleased" LostMouseCapture="OnOpacitySliderReleased"
                                                                KeyUp="OnOpacitySliderReleased" ToolTip="Annotation opacity" AutomationProperties.Name="Annotation opacity"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                </StackPanel>
                        <Button x:Name="FormatOverflowBtn" Style="{StaticResource CompactToolIconButton}" Content="&#xE10C;"
                                Click="OnFormatOverflowClick" ToolTip="More format"
                                Visibility="Collapsed"
                                AutomationProperties.Name="More format"
                                AutomationProperties.HelpText="Font, line style, and other format controls that do not fit on the row."/>
                        <Popup x:Name="FormatOverflowPopup" PlacementTarget="{Binding ElementName=FormatOverflowBtn}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="{StaticResource RadiusInput}" Padding="8" Margin="0,4,12,12"
                                    Effect="{StaticResource FloatingShadow}">
                                <StackPanel x:Name="FormatOverflowPanel" Orientation="Horizontal"/>
                            </Border>
                        </Popup>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="48"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
                <Grid x:Name="Viewport" Grid.Row="1" Background="{StaticResource SurfaceBrush}" ClipToBounds="True"
              MouseWheel="OnViewportMouseWheel" MouseDown="OnViewportMouseDown" MouseMove="OnViewportMouseMove"
              MouseUp="OnViewportMouseUp" MouseRightButtonUp="OnViewportRightClick"
              AutomationProperties.Name="Annotation canvas"
              AutomationProperties.HelpText="Source-resolution image canvas. Hold Space or middle-drag to pan; Ctrl+mouse wheel zooms.">
            <Canvas x:Name="SurfaceHost">
                <Border x:Name="CaptureShadow" IsHitTestVisible="False" Visibility="Collapsed"
                        Background="#FF000000"
                        BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="10" Direction="270"
                                          Opacity="0.80" Color="#FF000000" RenderingBias="Performance"/>
                    </Border.Effect>
                </Border>
                <Grid x:Name="EditorSurface" HorizontalAlignment="Left" VerticalAlignment="Top"
                      Background="Transparent" Cursor="Cross" RenderTransformOrigin="0,0">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ViewScale"/>
                            <TranslateTransform x:Name="ViewTranslate"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Grid x:Name="CanvasHost">
                        <StackPanel x:Name="BaseTiles" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Canvas x:Name="AnnotationCanvas" Background="Transparent" ClipToBounds="True"/>
                    </Grid>
                    <Canvas x:Name="InteractionCanvas" IsHitTestVisible="False" ClipToBounds="True">
                        <Path x:Name="CropDim" Fill="#66000000" Visibility="Collapsed"/>
                        <Rectangle x:Name="DragRect" Stroke="{StaticResource InfoBrush}" StrokeThickness="1.5"
                                   StrokeDashArray="4 3" Fill="#114DA3FF" Visibility="Collapsed"/>
                        <Rectangle x:Name="SelectionRect" Stroke="{StaticResource InfoBrush}" StrokeThickness="1.5"
                                   StrokeDashArray="4 3" Visibility="Collapsed"/>
                        <Ellipse x:Name="CurveHandle" Width="10" Height="10" Fill="{StaticResource InfoBrush}"
                                 Stroke="White" StrokeThickness="1.5" Visibility="Collapsed"/>
                        <Canvas x:Name="HandleLayer" Visibility="Collapsed"/>
                        <Border x:Name="EyedropSwatch" Visibility="Collapsed" Background="{StaticResource FloatingBgBrush}"
                                CornerRadius="4" Padding="5" RenderTransformOrigin="0,0">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle x:Name="EyedropColorRect" Width="14" Height="14" RadiusX="2" RadiusY="2"
                                           Stroke="#88FFFFFF" StrokeThickness="1"/>
                                <TextBlock x:Name="EyedropHexText" Foreground="White" FontSize="11" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </Canvas>
                </Grid>
            </Canvas>
            <Canvas x:Name="OverlayCanvas">
                <Ellipse x:Name="EraserCursor" Width="20" Height="20" IsHitTestVisible="False" Visibility="Collapsed"
                         Fill="#33808080" Stroke="#99646464" StrokeThickness="2"/>
                <Border x:Name="RotationPill" Width="60" Height="28" Background="#FF181C24" BorderBrush="#FF2A3140"
                        BorderThickness="1" CornerRadius="6" Visibility="Collapsed"
                        AutomationProperties.Name="Rotation angle">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.35"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBox x:Name="RotationInput" Width="32" Height="20" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextPrimaryBrush}" CaretBrush="{StaticResource TextPrimaryBrush}"
                                 FontSize="13" FontWeight="Medium" TextAlignment="Right" Padding="0" VerticalContentAlignment="Center"
                                 PreviewTextInput="OnRotationInputText" PreviewKeyDown="OnRotationInputKey"
                                 GotKeyboardFocus="OnRotationInputFocus" LostKeyboardFocus="OnRotationInputBlur"
                                 AutomationProperties.Name="Rotation degrees"/>
                        <TextBlock Text="°" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="2,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Canvas>
        </Grid>
                <Border x:Name="EditorGroupBar" Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Margin="0" Padding="0,2" CornerRadius="0"
                        Background="{StaticResource WindowBgBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0"
                        AutomationProperties.Name="Group tools"
                        AutomationProperties.HelpText="Tools in the selected Draw, Shapes, or Text group.">
                    <Border x:Name="EditorGroupToolsHost" HorizontalAlignment="Center" Visibility="Collapsed">
                    <StackPanel x:Name="EditorGroupTools" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel x:Name="DrawGroupPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <RadioButton x:Name="FreehandToolBtn" Style="{StaticResource StripToolButton}" Margin="4,0" GroupName="Tool"
                                     Tag="Freehand" Checked="OnToolChecked" ToolTip="Pen (P)"
                                     AutomationProperties.Name="Pen"
                                     AutomationProperties.HelpText="Draw a smoothed freehand line. Shortcut P."
                                     Content="{StaticResource SurveyIcon.Pen}"/>
                        <RadioButton x:Name="HighlighterToolBtn" Style="{StaticResource StripToolButton}" Margin="4,0" GroupName="Tool"
                                     Tag="Highlighter" Checked="OnToolChecked" ToolTip="Highlighter (H)"
                                     AutomationProperties.Name="Highlighter"
                                     AutomationProperties.HelpText="Draw a translucent freehand highlight. Shortcut H."
                                     Content="{StaticResource SurveyIcon.Highlighter}"/>
                        <RadioButton x:Name="EraserToolBtn" Style="{StaticResource StripToolButton}" Margin="4,0" GroupName="Tool"
                                     Tag="Eraser" Checked="OnToolChecked" ToolTip="Eraser"
                                     AutomationProperties.Name="Eraser"
                                     AutomationProperties.HelpText="Partial erase subtracts from pen and highlighter ink. Full erase deletes the annotation under the stroke."
                                     Content="{StaticResource SurveyIcon.Eraser}"/>
                    </StackPanel>
                    <StackPanel x:Name="ShapeGroupPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <RadioButton x:Name="RectangleToolBtn" Style="{StaticResource StripToolButton}" Margin="4,0" GroupName="Tool"
                                     Tag="Rectangle" Checked="OnToolChecked"
                                     ToolTip="Rectangle (R)" AutomationProperties.Name="Rectangle"
                                     AutomationProperties.HelpText="Draw a rectangle. Fill and border are independent. Shortcut R."
                                     Content="{StaticResource SurveyIcon.Rect}"/>
                        <RadioButton x:Name="EllipseToolBtn" Style="{StaticResource StripToolButton}" Margin="4,0" GroupName="Tool"
                                     Tag="Ellipse" Checked="OnToolChecked" ToolTip="Ellipse (E)"
                                     AutomationProperties.Name="Ellipse" AutomationProperties.HelpText="Draw an ellipse. Shortcut E."
                                     Content="{StaticResource SurveyIcon.Ellipse}"/>
                        <RadioButton x:Name="LineToolBtn" Style="{StaticResource StripToolButton}" Margin="4,0" GroupName="Tool"
                                     Tag="Line" Checked="OnToolChecked" ToolTip="Line (L)"
                                     AutomationProperties.Name="Line" AutomationProperties.HelpText="Draw a straight line. Shortcut L."
                                     Content="{StaticResource SurveyIcon.Line}"/>
                        <RadioButton x:Name="ArrowToolBtn" Style="{StaticResource StripToolButton}" Margin="4,0" GroupName="Tool"
                                     Tag="Arrow" Checked="OnToolChecked" ToolTip="Arrow (A)"
                                     AutomationProperties.Name="Arrow" AutomationProperties.HelpText="Draw an arrow. Six Survey arrowheads. Shortcut A."
                                     Content="{StaticResource SurveyIcon.Arrow}"/>
                        <RadioButton x:Name="StepToolBtn" Style="{StaticResource StripToolButton}" Margin="4,0" GroupName="Tool"
                                     Tag="Step" Checked="OnToolChecked" ToolTip="Counter (S)"
                                     AutomationProperties.Name="Counter"
                                     AutomationProperties.HelpText="Place sequential number or letter badges. Shortcut S."
                                     Content="{StaticResource SurveyIcon.Counter}"/>
                    </StackPanel>
                    <StackPanel x:Name="TextGroupPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <RadioButton x:Name="TextToolBtn" Style="{StaticResource StripToolButton}" Margin="4,0" GroupName="Tool"
                                     Tag="Text" Checked="OnToolChecked" ToolTip="Text (T)"
                                     AutomationProperties.Name="Text"
                                     AutomationProperties.HelpText="Place styled text. Enter commits and Escape cancels. Shortcut T."
                                     Content="{StaticResource SurveyIcon.Text}"/>
                        <RadioButton x:Name="CalloutToolBtn" Style="{StaticResource StripToolButton}" Margin="4,0" GroupName="Tool"
                                     Tag="Callout" Checked="OnToolChecked" ToolTip="Callout (Q)"
                                     AutomationProperties.Name="Callout"
                                     AutomationProperties.HelpText="Drag from the arrow tip to the text box. Shortcut Q."
                                     Content="{StaticResource SurveyIcon.Callout}"/>
                    </StackPanel>
                    <StackPanel x:Name="EffectsGroupPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <RadioButton x:Name="PixelateToolBtn" Style="{StaticResource StripToolButton}" Margin="4,0" GroupName="Tool"
                                     Tag="Pixelate" Checked="OnToolChecked" ToolTip="Pixelate"
                                     AutomationProperties.Name="Pixelate"
                                     AutomationProperties.HelpText="Apply a randomized local mosaic redaction to a dragged region."
                                     Content="{StaticResource SurveyIcon.Pixelate}"/>
                        <RadioButton x:Name="SpotlightToolBtn" Style="{StaticResource StripToolButton}" Margin="4,0" GroupName="Tool"
                                     Tag="Spotlight" Checked="OnToolChecked" ToolTip="Spotlight"
                                     AutomationProperties.Name="Spotlight"
                                     AutomationProperties.HelpText="Dim the image outside a dragged rectangular focus area."
                                     Content="{StaticResource SurveyIcon.Spotlight}"/>
                        <RadioButton x:Name="BlurToolBtn" Style="{StaticResource StripToolButton}" Margin="4,0" GroupName="Tool"
                                     Tag="Blur" Checked="OnToolChecked" ToolTip="Blur (B)"
                                     AutomationProperties.Name="Blur"
                                     AutomationProperties.HelpText="Apply a smooth local blur to a dragged region. Shortcut B."
                                     Content="{StaticResource SurveyIcon.Blur}"/>
                    </StackPanel>
                    </StackPanel>
                    </Border>
                </Border>
            <!-- Survey's collapsed right rail (48px): zoom in, click-to-type percentage, zoom
                 out, divider, then the fit trigger whose menu flies out to the left. -->
            <Border x:Name="ZoomRail" Grid.Column="1" Grid.RowSpan="2" Background="{StaticResource WindowBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0"
                    AutomationProperties.Name="Zoom rail">
                <!-- Survey's rail footer: zoom / fit live at the BOTTOM of the rail. -->
                <Border VerticalAlignment="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                    <StackPanel HorizontalAlignment="Center">
                        <Button x:Name="BtnZoomIn" Style="{StaticResource RailButton}" Click="OnZoomIn"
                                ToolTip="Zoom in" AutomationProperties.Name="Zoom in"
                                AutomationProperties.HelpText="Zoom in one step about the centre of the view.">
                            <Viewbox Width="14" Height="14"><ContentControl Content="{StaticResource SurveyIcon.Plus}"/></Viewbox>
                        </Button>
                        <TextBox x:Name="ZoomBox" Style="{StaticResource RailZoomBox}" Text="100%"
                                 ToolTip="Zoom level. Click to type a percentage." AutomationProperties.Name="Zoom level"
                                 PreviewTextInput="OnZoomBoxTextInput" PreviewKeyDown="OnZoomBoxKeyDown"
                                 GotKeyboardFocus="OnZoomBoxFocus" LostKeyboardFocus="OnZoomBoxBlur"/>
                        <Button x:Name="BtnZoomOut" Style="{StaticResource RailButton}" Click="OnZoomOut"
                                ToolTip="Zoom out" AutomationProperties.Name="Zoom out"
                                AutomationProperties.HelpText="Zoom out one step about the centre of the view.">
                            <Viewbox Width="14" Height="14"><ContentControl Content="{StaticResource SurveyIcon.Minus}"/></Viewbox>
                        </Button>
                        <Rectangle Width="24" Height="1" Fill="{StaticResource BorderBrush}" Margin="0,4"/>
                        <Button x:Name="FitMenuBtn" Style="{StaticResource RailButton}" Width="36" Height="28" Click="OnFitMenuClick"
                                ToolTip="Fit page" AutomationProperties.Name="Fit options"
                                AutomationProperties.HelpText="Choose fit page, fit width, or fit height.">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl x:Name="FitModeIcon" Content="{StaticResource SurveyIcon.FitPage}" Width="15" Height="15" VerticalAlignment="Center"/>
                                <ContentControl Content="{StaticResource SurveyIcon.ChevronLeft}" Width="10" Height="10" VerticalAlignment="Center" Opacity="0.7"/>
                            </StackPanel>
                        </Button>
                        <Popup x:Name="FitMenuPopup" PlacementTarget="{Binding ElementName=FitMenuBtn}"
                               Placement="Left" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="{StaticResource RadiusInput}" Padding="2" Margin="12,0,6,12"
                                    MinWidth="140" Effect="{StaticResource FloatingShadow}">
                                <StackPanel>
                                    <Button x:Name="FitPageItem" Style="{StaticResource MenuRowButton}" Click="OnFitPage" AutomationProperties.Name="Fit page">
                                        <StackPanel Orientation="Horizontal">
                                            <ContentControl Content="{StaticResource SurveyIcon.FitPage}" Width="16" Height="16"/>
                                            <TextBlock Text="Fit page" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="FitWidthItem" Style="{StaticResource MenuRowButton}" Click="OnFitWidth" AutomationProperties.Name="Fit width">
                                        <StackPanel Orientation="Horizontal">
                                            <ContentControl Content="{StaticResource SurveyIcon.FitWidth}" Width="16" Height="16"/>
                                            <TextBlock Text="Fit width" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="FitHeightItem" Style="{StaticResource MenuRowButton}" Click="OnFitHeight" AutomationProperties.Name="Fit height">
                                        <StackPanel Orientation="Horizontal">
                                            <ContentControl Content="{StaticResource SurveyIcon.FitHeight}" Width="16" Height="16"/>
                                            <TextBlock Text="Fit height" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <Border x:Name="EditorBottomBar" Grid.Row="2" Style="{StaticResource BottomUtilityBar}"
                Margin="12,6,12,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Button x:Name="BtnSave" Style="{StaticResource CircleActionButton}" Click="OnSave"
                            ToolTip="Save as... (Ctrl+Shift+S)" AutomationProperties.Name="Save as"
                            AutomationProperties.HelpText="Choose a local export file. Shortcut Ctrl+Shift+S."
                            Content="{StaticResource SurveyIcon.Download}"/>
                    <Button x:Name="BtnDone" Style="{StaticResource PillButtonPrimary}" Margin="6,0,0,0"
                            Content="Done" Click="OnDone" ToolTip="Copy and close"
                            AutomationProperties.Name="Done"
                            AutomationProperties.HelpText="Copy the edited image to the clipboard and close the editor."/>
                </StackPanel>

                <Button x:Name="BtnDragOut" Grid.Column="1" Style="{StaticResource PillButtonSecondary}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="SizeAll"
                        PreviewMouseLeftButtonDown="OnDragOutMouseDown" PreviewMouseMove="OnDragOutMouseMove"
                        ToolTip="Drag this image into another app" AutomationProperties.Name="Drag and drop"
                        AutomationProperties.HelpText="Press and drag to drop the edited image as a file into another application.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE700;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   VerticalAlignment="Center" Opacity="0.7" Margin="0,0,8,0"/>
                        <TextBlock Text="Drag &amp; Drop" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Name="BtnPin" Style="{StaticResource CircleActionButton}" Content="&#xE718;" ToolTip="Pin to screen"
                            Click="OnPin" AutomationProperties.Name="Pin to screen"
                            AutomationProperties.HelpText="Open the edited image in a local always-on-top pin window."/>
                    <Button x:Name="BtnCopy" Style="{StaticResource CircleActionButton}" Content="&#xE8C8;"
                            ToolTip="Copy to clipboard (Ctrl+C)" Click="OnCopy" AutomationProperties.Name="Copy"
                            AutomationProperties.HelpText="Copy the source-resolution edited image. Shortcut Ctrl+C."/>
                    <Button x:Name="BtnCenter" Style="{StaticResource CircleActionButton}" Content="&#xE9A6;"
                            ToolTip="Fit &amp; center (Ctrl+0)" Click="OnCenterView" AutomationProperties.Name="Fit and center"
                            AutomationProperties.HelpText="Fit and center the whole image. Shortcut Ctrl+0."/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
