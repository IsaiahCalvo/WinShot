<Window x:Class="WinShot.Editor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinShot Editor" Background="{StaticResource WindowBgBrush}"
        MinWidth="1152" MinHeight="520"
        AllowDrop="True" Drop="OnEditorDrop" DragOver="OnEditorDragOver"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        AutomationProperties.Name="WinShot annotation editor">
    <Grid Background="{StaticResource WindowBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ONE toolbar row. Left to right: undo/redo · the two pointer tools ·
             five tool categories · the active tool's own controls; Save as… and
             Done stay docked right so the finish line never moves. The tools a
             category holds live in the 34 DIP sub-row below, which floats over
             the canvas instead of pushing it down. -->
        <Border x:Name="TopToolbar" Grid.Row="0" Style="{StaticResource FloatingToolbar}" Margin="12,12,12,6">
            <!-- ClipToBounds because a DockPanel does not clip its fill child: on a display
                 that cannot hold 1152 DIP the window's minimum is lowered to fit (see
                 ClampMinimumsTo), and an unclipped context row arranged its buttons from
                 x=0 outward straight over the Save as… / Done pair docked to its right.
                 The pair is also given the higher ZIndex, so it stays on top of anything
                 that reaches it. -->
            <DockPanel x:Name="ToolbarPrimaryRow" ClipToBounds="True">
                <StackPanel DockPanel.Dock="Right" Panel.ZIndex="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel x:Name="CropPanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                        <!-- Primary last, like every other button pair in the app. -->
                        <Button Style="{StaticResource PillButtonSecondary}" Content="Cancel" Click="OnCancelCrop"
                                AutomationProperties.Name="Cancel crop"/>
                        <Button Style="{StaticResource PillButtonPrimary}" Content="Apply crop" Click="OnApplyCrop"
                                AutomationProperties.Name="Apply crop"/>
                    </StackPanel>
                    <Rectangle Style="{StaticResource ToolbarDivider}" Margin="2,0,8,0"/>
                    <Button x:Name="BtnSave" Style="{StaticResource PillButtonSecondary}"
                            Content="Save as…" Click="OnSave" ToolTip="Save as… (Ctrl+Shift+S)"
                            AutomationProperties.Name="Save as"
                            AutomationProperties.HelpText="Choose a local export file. Shortcut Ctrl+Shift+S."/>
                    <Button x:Name="BtnDone" Style="{StaticResource PillButtonPrimary}"
                            Content="Done" Click="OnClose" ToolTip="Finish and close the editor"
                            AutomationProperties.Name="Done"
                            AutomationProperties.HelpText="Finish editing and close this window."/>
                </StackPanel>

                <StackPanel x:Name="ToolPanel" DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnUndo" Style="{StaticResource ToolIconButton}" Content="&#xE7A7;"
                            ToolTip="Undo (Ctrl+Z)" Click="OnUndo" IsEnabled="False"
                            AutomationProperties.Name="Undo" AutomationProperties.HelpText="Undo the last action. Shortcut Ctrl+Z."/>
                    <Button x:Name="BtnRedo" Style="{StaticResource ToolIconButton}" Content="&#xE7A6;"
                            ToolTip="Redo (Ctrl+Y)" Click="OnRedo" IsEnabled="False"
                            AutomationProperties.Name="Redo" AutomationProperties.HelpText="Redo the last action. Shortcut Ctrl+Y."/>
                    <Rectangle Style="{StaticResource ToolbarDivider}"/>

                    <RadioButton x:Name="SelectToolBtn" Style="{StaticResource ToolButton}" GroupName="Tool"
                                 Tag="Select" Content="&#xE8B0;" Checked="OnToolChecked" IsChecked="True"
                                 ToolTip="Cursor (V)" AutomationProperties.Name="Cursor"
                                 AutomationProperties.HelpText="Select, move, resize, reorder, or delete annotations. Shortcut V."/>
                    <Button x:Name="SelectModeButton" Style="{StaticResource FieldChevronButton}" Height="24"
                            Content="&#xE70D;" Click="OnSelectModeClick" ToolTip="Rubber-band selection mode"
                            AutomationProperties.Name="Selection mode"
                            AutomationProperties.HelpText="Choose how a rubber band picks marks: by drag direction, fully enclosed only, or anything it touches."/>
                    <Popup x:Name="SelectModePopup" PlacementTarget="{Binding ElementName=SelectModeButton}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Style="{StaticResource PopoverSurface}">
                            <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                            <StackPanel x:Name="SelectModeList" Width="216"/>
                        </Border>
                    </Popup>
                    <RadioButton x:Name="PanToolBtn" Style="{StaticResource ToolButton}" GroupName="Tool"
                                 Tag="Pan" Content="&#xE7C2;" Checked="OnToolChecked" ToolTip="Pan"
                                 AutomationProperties.Name="Pan"
                                 AutomationProperties.HelpText="Drag to move the view. Middle-drag or hold Space works with any tool."/>
                    <Rectangle Style="{StaticResource ToolbarDivider}"/>

                    <StackPanel x:Name="CategoryPanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="CategoryDrawBtn" Style="{StaticResource ToolButton}" GroupName="Category"
                                     Tag="Draw" Content="&#xE70F;" Checked="OnCategoryChecked" ToolTip="Draw (P)"
                                     AutomationProperties.Name="Draw tools"
                                     AutomationProperties.HelpText="Show the pen, highlighter and eyedropper."/>
                        <RadioButton x:Name="CategoryShapesBtn" Style="{StaticResource ToolButton}" GroupName="Category"
                                     Tag="Shapes" Content="&#xE739;" Checked="OnCategoryChecked" ToolTip="Shapes (R)"
                                     AutomationProperties.Name="Shape tools"
                                     AutomationProperties.HelpText="Show rectangle, ellipse, line, arrow and counter."/>
                        <RadioButton x:Name="CategoryTextBtn" Style="{StaticResource ToolButton}" GroupName="Category"
                                     Tag="Text" Content="&#xE8D2;" Checked="OnCategoryChecked" ToolTip="Text (T)"
                                     AutomationProperties.Name="Text tools"
                                     AutomationProperties.HelpText="Show the text tool."/>
                        <RadioButton x:Name="CategoryRedactBtn" Style="{StaticResource ToolButton}" GroupName="Category"
                                     Tag="Redact" Content="&#xE7E6;" Checked="OnCategoryChecked" ToolTip="Redact (X)"
                                     AutomationProperties.Name="Redaction tools"
                                     AutomationProperties.HelpText="Show the redaction and spotlight tools."/>
                        <RadioButton x:Name="CategoryImageBtn" Style="{StaticResource ToolButton}" GroupName="Category"
                                     Tag="Image" Content="&#xEE71;" Checked="OnCategoryChecked" ToolTip="Image"
                                     AutomationProperties.Name="Image tools"
                                     AutomationProperties.HelpText="Show crop, add image and add background. Shortcuts C, I and B."/>
                    </StackPanel>
                </StackPanel>

                <!-- The active tool's own controls, inline in this row. Every panel
                     hides rather than greys, so the row shrinks to what is relevant.
                     The fill child scrolls rather than being cut off: below 1152 DIP the
                     crop group's last ~150 DIP (rotate / flip / Image size / Snap) had no
                     route to it at all. The bar is the app's own 8 DIP slim one and only
                     appears when there is something past the edge. -->
                <ScrollViewer x:Name="ContextScroll" Focusable="False"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              VerticalAlignment="Center" PanningMode="HorizontalOnly">
                <StackPanel x:Name="ContextPanel" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Rectangle x:Name="ContextDivider" Style="{StaticResource ToolbarDivider}"/>

                    <StackPanel x:Name="ColorPanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                        <Button x:Name="CurrentColorIndicator" Style="{StaticResource ColorWellButton}"
                                Background="{StaticResource AnnotationRedBrush}" Click="OnColorWellClick"
                                ToolTip="Color" AutomationProperties.Name="Color"
                                AutomationProperties.HelpText="Open the color picker for the active tool."/>
                        <Popup x:Name="ColorPickerPopup" PlacementTarget="{Binding ElementName=CurrentColorIndicator}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Style="{StaticResource PopoverSurface}">
                                <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                                <StackPanel Width="252">
                                    <!-- Border and Fill are two colours on the same shape, so they
                                         are two tabs on one picker rather than two pickers. -->
                                    <StackPanel x:Name="ColorTargetTabs" Orientation="Horizontal" Margin="0,0,0,8">
                                        <RadioButton x:Name="BorderTabBtn" Style="{StaticResource SizePresetRow}" GroupName="ColorTarget"
                                                     Width="118" Content="Border" IsChecked="True" Click="OnColorTargetChanged"
                                                     AutomationProperties.Name="Border color"
                                                     AutomationProperties.HelpText="Pick the outline color."/>
                                        <RadioButton x:Name="FillTabBtn" Style="{StaticResource SizePresetRow}" GroupName="ColorTarget"
                                                     Width="118" Content="Fill" Click="OnColorTargetChanged"
                                                     AutomationProperties.Name="Fill color"
                                                     AutomationProperties.HelpText="Pick the fill color. Only shapes that can be filled use it."/>
                                    </StackPanel>

                                    <UniformGrid x:Name="ColorPickerGrid" Columns="8"/>

                                    <!-- Save stays docked right so saving the FIRST colour cannot move the
                                         button out from under the pointer; the row it creates eases in. -->
                                    <DockPanel Margin="0,12,0,0" LastChildFill="True">
                                        <Button x:Name="SaveColorBtn" DockPanel.Dock="Right" VerticalAlignment="Bottom"
                                                Style="{StaticResource ToolIconButton}"
                                                Width="{StaticResource SubToolButtonSize}"
                                                Height="{StaticResource SubToolButtonSize}"
                                                FontSize="{StaticResource GlyphBadge}" Content="&#xE710;" Click="OnSaveColor"
                                                ToolTip="Save this color" AutomationProperties.Name="Save color"
                                                AutomationProperties.HelpText="Keep the current color in My colors."/>
                                        <StackPanel x:Name="SavedColorsSection" Visibility="Collapsed">
                                            <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
                                            <TextBlock x:Name="SavedColorsHeading" Text="My colors" Style="{StaticResource FieldLabel}" Margin="2,0,2,4"/>
                                            <UniformGrid x:Name="SavedColorsGrid" Columns="8" Width="216" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12"/>

                                    <!-- Saturation across, value up, with hue and alpha under it. -->
                                    <Border x:Name="SvSquareBorder" Height="104" CornerRadius="{StaticResource RadiusChip}"
                                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                            MouseLeftButtonDown="OnSvSquareDown" MouseMove="OnSvSquareMove"
                                            MouseLeftButtonUp="OnSvSquareUp" LostMouseCapture="OnSvSquareLostCapture"
                                            SizeChanged="OnSvSquareSizeChanged" Cursor="Cross">
                                        <Grid ClipToBounds="True">
                                            <Rectangle x:Name="SvHueLayer"/>
                                            <Rectangle>
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#00000000" Offset="0"/>
                                                        <GradientStop Color="#FF000000" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <Canvas x:Name="SvThumbLayer" IsHitTestVisible="False">
                                                <!-- The ring is painted in RefreshPickerVisual, not here: the
                                                     square runs white to black, so a fixed white ring vanishes
                                                     in the corner people go to for white and light greys. -->
                                                <Ellipse x:Name="SvThumb" Width="12" Height="12" StrokeThickness="2"/>
                                            </Canvas>
                                        </Grid>
                                    </Border>

                                    <!-- The track IS the choice on both of these: a hue slider
                                         with no hue on it is drag-and-watch-the-square, and an
                                         alpha slider with no ramp says nothing about which end
                                         is see-through. The alpha ramp runs over the popover's
                                         own dark surface rather than a checkerboard — one less
                                         layer, and "less colour" still reads as "more
                                         transparent" — and the percentage beside it matches the
                                         toolbar's own opacity readout. -->
                                    <Slider x:Name="HueSlider" Style="{StaticResource SpectrumSlider}" Minimum="0" Maximum="360"
                                            Margin="0,12,0,0" ValueChanged="OnHueChanged"
                                            ToolTip="Hue" AutomationProperties.Name="Hue"
                                            AutomationProperties.HelpText="Rotate the color around the wheel.">
                                        <Slider.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#FF0000" Offset="0"/>
                                                <GradientStop Color="#FFFF00" Offset="0.1667"/>
                                                <GradientStop Color="#00FF00" Offset="0.3333"/>
                                                <GradientStop Color="#00FFFF" Offset="0.5"/>
                                                <GradientStop Color="#0000FF" Offset="0.6667"/>
                                                <GradientStop Color="#FF00FF" Offset="0.8333"/>
                                                <GradientStop Color="#FF0000" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Slider.Background>
                                    </Slider>
                                    <DockPanel Margin="0,6,0,0" LastChildFill="True">
                                        <TextBlock x:Name="AlphaValue" DockPanel.Dock="Right" Text="100%"
                                                   Style="{StaticResource ValueLabel}" MinWidth="38"
                                                   TextAlignment="Right" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        <Slider x:Name="AlphaSlider" Style="{StaticResource SpectrumSlider}" Minimum="0" Maximum="100" Value="100"
                                                ValueChanged="OnAlphaChanged"
                                                ToolTip="Opacity" AutomationProperties.Name="Color opacity"
                                                AutomationProperties.HelpText="How see-through the color is."/>
                                    </DockPanel>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <!-- A real focusable control, not a bare Rectangle: the
                                             "Copy as" formats hang off this, and a Shape can never
                                             take keyboard focus, so Shift+F10 went to the hex box
                                             instead and the whole feature was mouse-only. -->
                                        <Button x:Name="ColorPickerPreviewButton" Grid.Column="0"
                                                Style="{StaticResource SwatchButton}"
                                                Click="OnColorPickerPreviewClick"
                                                ToolTip="Copy this color in another format"
                                                AutomationProperties.Name="Copy as"
                                                AutomationProperties.HelpText="Open the list of color formats to copy.">
                                            <!-- 20 inside a 22 px cell: the palette swatches are
                                                 22 px of solid colour edge to edge, and a smaller
                                                 chip made the one swatch that says what colour is
                                                 CURRENT read a size below every swatch above it. -->
                                            <Rectangle x:Name="ColorPickerPreview" Width="20" Height="20" RadiusX="3" RadiusY="3"/>
                                        </Button>
                                        <TextBox x:Name="ColorPickerHex" Grid.Column="1" Style="{StaticResource DarkTextBox}" Margin="8,0"
                                                 KeyDown="OnColorPickerHexKeyDown" TextChanged="OnColorPickerHexChanged"
                                                 ToolTip="Type a hex color" AutomationProperties.Name="Hex color"/>
                                        <Button x:Name="PickerEyedropperBtn" Grid.Column="2" Style="{StaticResource ToolIconButton}"
                                                Width="{StaticResource SubToolButtonSize}"
                                                Height="{StaticResource SubToolButtonSize}"
                                                FontSize="{StaticResource GlyphBadge}" Content="&#xEF3C;"
                                                Click="OnPickerEyedropper" ToolTip="Pick a color from the image"
                                                AutomationProperties.Name="Eyedropper"
                                                AutomationProperties.HelpText="Sample a color from the image, then come back here."/>
                                        <Button x:Name="ColorPickerApply" Grid.Column="3" Style="{StaticResource PillButtonPrimary}"
                                                Content="Use" Click="OnColorPickerApply" AutomationProperties.Name="Use color"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <!-- Size: a typed whole number plus a preset menu, replacing the old
                         2 / 4 / 6 buttons. Any value 1-50 is reachable. -->
                    <StackPanel x:Name="ThicknessPanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                        <Border x:Name="SizeFieldBorder" Height="30" Width="70" CornerRadius="{StaticResource RadiusInput}"
                                Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" VerticalAlignment="Center" Margin="6,0,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SizeBox" Grid.Column="0" Style="{StaticResource BareTextBox}"
                                         Text="4" TextAlignment="Center" MaxLength="3"
                                         PreviewTextInput="OnSizeBoxPreviewTextInput"
                                         TextChanged="OnSizeBoxTextChanged" KeyDown="OnSizeBoxKeyDown"
                                         LostFocus="OnSizeBoxLostFocus"
                                         AutomationProperties.Name="Annotation size"
                                         AutomationProperties.HelpText="Type any whole number from 1 to 50, or choose a preset."/>
                                <Button x:Name="SizePresetButton" Grid.Column="1" Style="{StaticResource FieldChevronButton}"
                                        Content="&#xE70D;" Click="OnSizePresetClick" ToolTip="Size presets"
                                        AutomationProperties.Name="Size presets"/>
                            </Grid>
                        </Border>
                        <Popup x:Name="SizePresetPopup" PlacementTarget="{Binding ElementName=SizeFieldBorder}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Style="{StaticResource PopoverSurface}">
                                <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                                <StackPanel Width="168">
                                    <TextBlock x:Name="SizePresetHeading" Text="Width" Style="{StaticResource FieldLabel}" Margin="8,2,8,8"/>
                                    <StackPanel x:Name="SizePresetList"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <!-- One glyph and a popover, like arrow style / text style / crop ratio /
                         redaction style. Three inline 36 DIP chips cost 84 DIP that the row
                         does not have: measured, the shapes' controls needed 1120 DIP inside
                         a 922 DIP row and the right end was being clipped away silently. It
                         also takes the shapes and redact CATEGORY glyphs back off the fill
                         chips, which were showing the same mark three times in one strip. -->
                    <StackPanel x:Name="FillPanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                        <Button x:Name="FillStyleButton" Style="{StaticResource ToolIconButton}" Content="&#xE73B;"
                                Click="OnFillStyleClick" ToolTip="Shape fill"
                                AutomationProperties.Name="Shape fill"
                                AutomationProperties.HelpText="Choose no fill, a translucent 25 percent fill, or a solid fill."/>
                        <Popup x:Name="FillPopup" PlacementTarget="{Binding ElementName=FillStyleButton}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Style="{StaticResource PopoverSurface}">
                                <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                                <StackPanel Width="168">
                                    <TextBlock Text="Fill" Style="{StaticResource FieldLabel}" Margin="8,2,8,8"/>
                                    <StackPanel x:Name="FillStyleList">
                                        <RadioButton x:Name="FillNoneBtn" Style="{StaticResource SizePresetRow}" GroupName="Fill" Tag="None"
                                                     Content="No fill" IsChecked="True" Checked="OnFillChecked"
                                                     AutomationProperties.Name="No fill"
                                                     AutomationProperties.HelpText="Draw shapes with an outline and no fill."/>
                                        <RadioButton x:Name="FillQuarterBtn" Style="{StaticResource SizePresetRow}" GroupName="Fill" Tag="Quarter"
                                                     Content="25% fill" Checked="OnFillChecked"
                                                     AutomationProperties.Name="25 percent fill"
                                                     AutomationProperties.HelpText="Draw shapes with a translucent 25 percent fill."/>
                                        <RadioButton x:Name="FillSolidBtn" Style="{StaticResource SizePresetRow}" GroupName="Fill" Tag="Solid"
                                                     Content="Solid fill" Checked="OnFillChecked"
                                                     AutomationProperties.Name="Solid fill"
                                                     AutomationProperties.HelpText="Draw shapes with a solid fill."/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <!-- The outline's own choices. Their own panel, not the fill group's:
                         an arrow has an outline and no fill, and the hand-drawn line is
                         meaningless if it only reaches two of the six tools that draw one.

                         A popover with drawn previews, like arrow style and text style, not
                         two glyph toggles. Solid / dashed / dotted is three states, which a
                         two-state toggle can only express by cycling — the pressed chip and
                         the accessible name were identical for dashed and dotted, and only a
                         tooltip told them apart. The glyphs were worse than nothing: the dash
                         toggle wore MDL2 E72D, which is Share (the card menu has a real
                         Share… row), and the sketch toggle wore a pencil, which is what the
                         Draw category button means. A line drawn in the style it selects
                         cannot be mistaken for either. -->
                    <StackPanel x:Name="StrokePanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                        <Rectangle Style="{StaticResource ToolbarDivider}"/>
                        <!-- No glyph: the button draws the line it currently selects, so the
                             control that chooses an outline style is the one place the active
                             style is visible. SyncStrokeStyleButtons paints it. -->
                        <Button x:Name="StrokeStyleButton" Style="{StaticResource ToolIconButton}"
                                Click="OnStrokeStyleClick" ToolTip="Outline style"
                                AutomationProperties.Name="Outline style"
                                AutomationProperties.HelpText="Choose a solid, dashed or dotted outline, and whether it is ruled or hand-drawn."/>
                        <Popup x:Name="StrokeStylePopup" PlacementTarget="{Binding ElementName=StrokeStyleButton}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Style="{StaticResource PopoverSurface}">
                                <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                                <StackPanel Width="184">
                                    <TextBlock Text="Outline" Style="{StaticResource FieldLabel}" Margin="8,2,8,8"/>
                                    <StackPanel x:Name="StrokeDashList"/>
                                    <Rectangle Height="1" Margin="8,6" Fill="{StaticResource BorderBrush}"/>
                                    <CheckBox x:Name="SketchCheck" Style="{StaticResource DarkCheckBox}" Content="Hand-drawn"
                                              Margin="10,2,10,6" Click="OnSketchClick"
                                              ToolTip="Draw the line with a sketched wobble instead of a ruled one"
                                              AutomationProperties.Name="Hand-drawn outline"
                                              AutomationProperties.HelpText="Draw with a sketched, hand-drawn line instead of a ruled one."/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <StackPanel x:Name="MagnifyPanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                        <TextBlock x:Name="MagnifyValueLabel" Style="{StaticResource ValueLabel}"
                                   VerticalAlignment="Center" Margin="0,0,6,0" MinWidth="30"/>
                        <Slider x:Name="MagnifySlider" Style="{StaticResource DarkSlider}" Width="92"
                                Minimum="1.5" Maximum="8" Value="2" SmallChange="0.5" LargeChange="1"
                                ValueChanged="OnMagnifyChanged" PreviewMouseUp="OnMagnifyReleased"
                                LostMouseCapture="OnMagnifyReleased"
                                ToolTip="How much the callout magnifies"
                                AutomationProperties.Name="Magnification"
                                AutomationProperties.HelpText="How much of the picture the callout blows up, from 1.5 to 8 times."/>
                    </StackPanel>

                    <StackPanel x:Name="ArrowStylePanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                        <Button x:Name="ArrowStyleButton" Style="{StaticResource ToolIconButton}" Content="&#xE72A;"
                                Click="OnArrowStyleClick" ToolTip="Arrow style"
                                AutomationProperties.Name="Arrow style"
                                AutomationProperties.HelpText="Choose straight, double, thin, fancy or curved, previewed at real weight."/>
                        <Popup x:Name="ArrowStylePopup" PlacementTarget="{Binding ElementName=ArrowStyleButton}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Style="{StaticResource PopoverSurface}">
                                <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                                <StackPanel Width="176">
                                    <TextBlock Text="Arrow" Style="{StaticResource FieldLabel}" Margin="8,2,8,8"/>
                                    <StackPanel x:Name="ArrowStyleList"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <StackPanel x:Name="TextStylePanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                        <Button x:Name="TextStyleButton" Style="{StaticResource ToolIconButton}" Content="&#xE8D2;"
                                Click="OnTextStyleClick" ToolTip="Text style"
                                AutomationProperties.Name="Text style"
                                AutomationProperties.HelpText="Choose plain, bold, outline, pill or huge, previewed as the style itself."/>
                        <Popup x:Name="TextStylePopup" PlacementTarget="{Binding ElementName=TextStyleButton}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Style="{StaticResource PopoverSurface}">
                                <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                                <StackPanel Width="176">
                                    <TextBlock Text="Style" Style="{StaticResource FieldLabel}" Margin="8,2,8,8"/>
                                    <StackPanel x:Name="TextStyleList"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <StackPanel x:Name="StepModePanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                        <RadioButton x:Name="StepNumberBtn" Style="{StaticResource ToolButton}" GroupName="StepMode" Tag="Number" Content="1"
                                     FontFamily="Segoe UI" FontSize="{StaticResource TextBodyLg}" ToolTip="Number badges" Checked="OnStepModeChecked" IsChecked="True"
                                     AutomationProperties.Name="Number badges"
                                     AutomationProperties.HelpText="Number the counter badges 1, 2, 3."/>
                        <RadioButton x:Name="StepLetterBtn" Style="{StaticResource ToolButton}" GroupName="StepMode" Tag="Letter" Content="A"
                                     FontFamily="Segoe UI" FontSize="{StaticResource TextBodyLg}" ToolTip="Letter badges" Checked="OnStepModeChecked"
                                     AutomationProperties.Name="Letter badges"
                                     AutomationProperties.HelpText="Letter the counter badges A, B, C."/>
                        <Button x:Name="StepResetBtn" Style="{StaticResource PillButtonSecondary}" Content="Reset to 1" ToolTip="Reset counter"
                                Click="OnResetStepCounter" AutomationProperties.Name="Reset counter"/>
                    </StackPanel>

                    <StackPanel x:Name="RedactStylePanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                        <Button x:Name="RedactStyleButton" Style="{StaticResource ToolIconButton}" Content="&#xE7E6;"
                                Click="OnRedactStyleClick" ToolTip="Redaction style"
                                AutomationProperties.Name="Redaction style"
                                AutomationProperties.HelpText="Choose pixelate, blur (secure), blur (smooth) or black out. The style can be changed after the mark is drawn."/>
                        <Popup x:Name="RedactStylePopup" PlacementTarget="{Binding ElementName=RedactStyleButton}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Style="{StaticResource PopoverSurface}">
                                <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                                <StackPanel Width="184">
                                    <TextBlock Text="Hide with" Style="{StaticResource FieldLabel}" Margin="8,2,8,8"/>
                                    <StackPanel x:Name="RedactStyleList"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                        <!-- Text only belongs to the STYLE, not the strength: "black out
                             only the words" is one of the four things this row exists for,
                             and living inside the strength group made it vanish for the one
                             style that has no strength. -->
                        <CheckBox x:Name="RedactTextOnlyCheck" Style="{StaticResource DarkCheckBox}" Content="Text only"
                                  Margin="12,0,0,0" VerticalAlignment="Center"
                                  ToolTip="Cover only the words in the region, leaving pictures visible"
                                  AutomationProperties.Name="Redact text only"
                                  AutomationProperties.HelpText="Read the region and cover each word it finds, leaving photos and graphics visible."/>
                    </StackPanel>

                    <!-- Continuous, and gone entirely for Black Out — there is no such
                         thing as a stronger or weaker black rectangle. -->
                    <StackPanel x:Name="RedactStrengthPanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center"
                                Margin="12,0,0,0">
                        <!-- The margin the "Text only" checkbox beside it carries: without it
                             the last glyph of "only" and the first pixel of the slider's
                             track were adjacent, where every other group in this row is
                             separated by a divider or a gap. -->
                        <Slider x:Name="RedactStrengthSlider" Style="{StaticResource DarkSlider}" Width="110"
                                Minimum="1" Maximum="100" Value="45" SmallChange="1" LargeChange="10"
                                ValueChanged="OnRedactStrengthChanged" PreviewMouseUp="OnRedactStrengthReleased"
                                LostMouseCapture="OnRedactStrengthReleased" KeyUp="OnRedactStrengthReleased"
                                ToolTip="Redaction strength" AutomationProperties.Name="Redaction strength"
                                AutomationProperties.HelpText="How coarse the mosaic or how wide the blur is."/>
                        <TextBlock x:Name="RedactStrengthValue" Text="45" Style="{StaticResource ValueLabel}" MinWidth="28"
                                   TextAlignment="Right" Margin="6,0,0,0"/>
                    </StackPanel>

                    <StackPanel x:Name="CropRatioPanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                        <Button x:Name="CropRatioButton" Style="{StaticResource ToolIconButton}" Content="&#xE799;"
                                Click="OnCropRatioClick" ToolTip="Crop ratio"
                                AutomationProperties.Name="Crop ratio"
                                AutomationProperties.HelpText="Constrain the crop to a fixed aspect ratio, or leave it free."/>
                        <Popup x:Name="CropRatioPopup" PlacementTarget="{Binding ElementName=CropRatioButton}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Style="{StaticResource PopoverSurface}">
                                <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                                <StackPanel Width="160">
                                    <TextBlock Text="Ratio" Style="{StaticResource FieldLabel}" Margin="8,2,8,8"/>
                                    <StackPanel x:Name="CropRatioList"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <!-- The image transforms belong with the crop, not in a "more" popup:
                         they are the same "reshape the picture" job. -->
                    <StackPanel x:Name="CropToolsPanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                        <Rectangle Style="{StaticResource ToolbarDivider}"/>
                        <Button x:Name="RotateCcwBtn" Style="{StaticResource ToolIconButton}" Content="&#xE7AD;"
                                ToolTip="Rotate 90° counter-clockwise" Click="OnRotateCcw"
                                AutomationProperties.Name="Rotate counter-clockwise"
                                AutomationProperties.HelpText="Rotate the source image 90 degrees counter-clockwise."/>
                        <Button x:Name="RotateCwBtn" Style="{StaticResource ToolIconButton}" Content="&#xE7AD;"
                                RenderTransformOrigin="0.5,0.5" ToolTip="Rotate 90° clockwise" Click="OnRotateCw"
                                AutomationProperties.Name="Rotate clockwise"
                                AutomationProperties.HelpText="Rotate the source image 90 degrees clockwise.">
                            <Button.RenderTransform><ScaleTransform ScaleX="-1"/></Button.RenderTransform>
                        </Button>
                        <Button x:Name="FlipHorizontalBtn" Style="{StaticResource ToolIconButton}" Content="&#xE13C;"
                                ToolTip="Flip horizontal" Click="OnFlipHorizontal" AutomationProperties.Name="Flip horizontal"
                                AutomationProperties.HelpText="Flip the source image from left to right."/>
                        <Button x:Name="FlipVerticalBtn" Style="{StaticResource ToolIconButton}" Content="&#xE174;"
                                ToolTip="Flip vertical" Click="OnFlipVertical" AutomationProperties.Name="Flip vertical"
                                AutomationProperties.HelpText="Flip the source image from top to bottom."/>
                        <Button x:Name="ResizeImageBtn" Style="{StaticResource PillButtonSecondary}"
                                Click="OnResizeImage" ToolTip="Image size…" AutomationProperties.Name="Image size"
                                AutomationProperties.HelpText="Open local source-image resize controls.">
                            <TextBlock x:Name="ImageSizeLabel" Text="Image size"/>
                        </Button>
                        <CheckBox x:Name="SnapToEdgesCheck" Style="{StaticResource DarkCheckBox}" Content="Snap"
                                  IsChecked="True" Margin="8,0,0,0"
                                  ToolTip="Snap crop edges to the image edge — hold Ctrl to override"
                                  AutomationProperties.Name="Snap to edges"
                                  AutomationProperties.HelpText="Snap crop edges to the image edge. Hold Ctrl while dragging to override."/>
                    </StackPanel>

                    <StackPanel x:Name="OpacityPanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                        <Rectangle Style="{StaticResource ToolbarDivider}"/>
                        <Slider x:Name="OpacitySlider" Style="{StaticResource DarkSlider}" Width="92" Minimum="25" Maximum="100" Value="100"
                                SmallChange="5" LargeChange="25" TickFrequency="25" IsSnapToTickEnabled="False"
                                ValueChanged="OnOpacityChanged" PreviewMouseUp="OnOpacitySliderReleased" LostMouseCapture="OnOpacitySliderReleased"
                                KeyUp="OnOpacitySliderReleased" ToolTip="Annotation opacity" AutomationProperties.Name="Annotation opacity"/>
                        <TextBlock x:Name="OpacityValue" Text="100%" Style="{StaticResource ValueLabel}" MinWidth="38"
                                   TextAlignment="Right" Margin="6,0,0,0"/>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid x:Name="Viewport" Grid.Row="1" Background="{StaticResource WindowBgBrush}" ClipToBounds="True"
              MouseWheel="OnViewportMouseWheel" MouseDown="OnViewportMouseDown" MouseMove="OnViewportMouseMove"
              MouseUp="OnViewportMouseUp" MouseRightButtonUp="OnViewportRightClick"
              AutomationProperties.Name="Annotation canvas"
              AutomationProperties.HelpText="Source-resolution image canvas. Hold Space or middle-drag to pan; Ctrl+mouse wheel zooms.">
            <Canvas x:Name="SurfaceHost">
                <Grid x:Name="EditorSurface" HorizontalAlignment="Left" VerticalAlignment="Top"
                      Background="Transparent" Cursor="Cross" RenderTransformOrigin="0,0">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ViewScale"/>
                            <TranslateTransform x:Name="ViewTranslate"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Grid x:Name="CanvasHost">
                        <StackPanel x:Name="BaseTiles" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Canvas x:Name="AnnotationCanvas" Background="Transparent" ClipToBounds="True"/>
                    </Grid>
                    <Canvas x:Name="InteractionCanvas" IsHitTestVisible="False" ClipToBounds="True">
                        <Path x:Name="CropDim" Fill="{StaticResource GuideStrokeShadowBrush}" Visibility="Collapsed"/>
                        <Rectangle x:Name="DragRect" Stroke="{StaticResource InfoBrush}" StrokeThickness="1.5"
                                   StrokeDashArray="4 3" Fill="#110A84FF" Visibility="Collapsed"/>
                        <Rectangle x:Name="SelectionRect" Stroke="{StaticResource InfoBrush}" StrokeThickness="1.5"
                                   StrokeDashArray="4 3" Visibility="Collapsed"/>
                        <!-- A selected arrow reads as a wide translucent copy of its own
                             geometry; a dashed box around a diagonal line never did. -->
                        <Path x:Name="ArrowSelectionGlow" Visibility="Collapsed" IsHitTestVisible="False"/>
                        <!-- Rubber band. Stroke/fill are set per drag: blue solid dragging
                             right (window), green dashed dragging left (crossing). -->
                        <Rectangle x:Name="MarqueeRect" StrokeThickness="1" Visibility="Collapsed"/>
                        <!-- Union frame around a marquee group; softer than a single selection. -->
                        <Rectangle x:Name="GroupRect" Stroke="{StaticResource InfoBrush}" StrokeThickness="1.5"
                                   StrokeDashArray="4 3" Opacity="0.6" Visibility="Collapsed"/>
                        <Ellipse x:Name="CurveHandle" Width="10" Height="10" Fill="{StaticResource InfoBrush}"
                                 Stroke="White" StrokeThickness="1.5" Visibility="Collapsed"/>
                        <!-- What a selected magnifier callout is looking at. Hollow, so the
                             pixels it is pointing at stay visible under it, and joined to
                             the bubble by a leader so the pair reads as one mark. -->
                        <Line x:Name="MagnifierLeader" Stroke="{StaticResource InfoBrush}" StrokeThickness="1"
                              StrokeDashArray="3 3" Opacity="0.8" Visibility="Collapsed"/>
                        <Ellipse x:Name="MagnifierFocusHandle" Width="12" Height="12"
                                 Stroke="{StaticResource InfoBrush}" StrokeThickness="2"
                                 Fill="Transparent" Visibility="Collapsed"/>
                        <Canvas x:Name="HandleLayer" Visibility="Collapsed"/>
                        <Border x:Name="EyedropSwatch" Visibility="Collapsed" Background="{StaticResource FloatingBgBrush}"
                                CornerRadius="4" Padding="5" RenderTransformOrigin="0,0">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle x:Name="EyedropColorRect" Width="14" Height="14" RadiusX="2" RadiusY="2"
                                           Stroke="#88FFFFFF" StrokeThickness="1"/>
                                <TextBlock x:Name="EyedropHexText" Foreground="White" FontSize="{StaticResource TextCaption}" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Magnified eyedropper loupe: the selector's nearest-neighbour grid,
                             pointed at the source bitmap instead of the screen. -->
                        <Canvas x:Name="EyedropLoupe" Visibility="Collapsed" IsHitTestVisible="False"/>
                        <!-- Rule-of-thirds guides inside the crop rectangle. -->
                        <!-- Two-tone: a dark hairline one screen pixel under a light one, so
                             the guides read over a white region as well as a dark one. -->
                        <Canvas x:Name="CropGuides" Visibility="Collapsed" IsHitTestVisible="False">
                            <Line x:Name="ThirdV1Shadow" Stroke="{StaticResource GuideStrokeShadowBrush}"/>
                            <Line x:Name="ThirdV2Shadow" Stroke="{StaticResource GuideStrokeShadowBrush}"/>
                            <Line x:Name="ThirdH1Shadow" Stroke="{StaticResource GuideStrokeShadowBrush}"/>
                            <Line x:Name="ThirdH2Shadow" Stroke="{StaticResource GuideStrokeShadowBrush}"/>
                            <Line x:Name="ThirdV1" Stroke="{StaticResource GuideStrokeBrush}"/>
                            <Line x:Name="ThirdV2" Stroke="{StaticResource GuideStrokeBrush}"/>
                            <Line x:Name="ThirdH1" Stroke="{StaticResource GuideStrokeBrush}"/>
                            <Line x:Name="ThirdH2" Stroke="{StaticResource GuideStrokeBrush}"/>
                        </Canvas>
                    </Canvas>
                </Grid>
            </Canvas>

            <!-- Where you are in a zoomed-in image. Indicators, never controls: the
                 editor pans an infinite canvas, so there is no track to drag. -->
            <Canvas x:Name="ScrollOverlay" IsHitTestVisible="False" Opacity="0">
                <!-- The ground under these is the user's screenshot, not a theme surface, so
                     a light bar alone composites to nothing over a white region. Same pairing
                     the thirds guides use: a dark bar one pixel down-right, under the light
                     one, which reads on any picture. -->
                <Rectangle x:Name="ScrollBarHShadow" RadiusX="2" RadiusY="2" Visibility="Collapsed"
                           Fill="{StaticResource GuideStrokeShadowBrush}"/>
                <Rectangle x:Name="ScrollBarVShadow" RadiusX="2" RadiusY="2" Visibility="Collapsed"
                           Fill="{StaticResource GuideStrokeShadowBrush}"/>
                <Rectangle x:Name="ScrollBarH" RadiusX="2" RadiusY="2" Visibility="Collapsed"
                           Fill="{StaticResource TextSecondaryBrush}"/>
                <Rectangle x:Name="ScrollBarV" RadiusX="2" RadiusY="2" Visibility="Collapsed"
                           Fill="{StaticResource TextSecondaryBrush}"/>
            </Canvas>

            <!-- The active category's tools, floating over the canvas rather than
                 pushing it down: switching category must not move the image. -->
            <Border x:Name="CategoryToolRow" Style="{StaticResource FloatingToolbar}"
                    Height="{StaticResource CategoryRowHeight}" Padding="6,0"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"
                    Visibility="Collapsed"
                    AutomationProperties.Name="Category tools">
                <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                <Grid VerticalAlignment="Center">
                    <StackPanel x:Name="DrawToolRow" Orientation="Horizontal" Visibility="Collapsed">
                        <RadioButton x:Name="FreehandToolBtn" Style="{StaticResource SubToolButton}" GroupName="Tool"
                                     Tag="Freehand" Content="&#xE70F;" Checked="OnToolChecked" ToolTip="Draw (P)"
                                     AutomationProperties.Name="Draw"
                                     AutomationProperties.HelpText="Draw a smoothed freehand line. Shortcut P."/>
                        <RadioButton x:Name="HighlighterToolBtn" Style="{StaticResource SubToolButton}" GroupName="Tool"
                                     Tag="Highlighter" Content="&#xE891;" Checked="OnToolChecked" ToolTip="Draw highlight (H)"
                                     AutomationProperties.Name="Draw highlight"
                                     AutomationProperties.HelpText="Draw a translucent freehand highlight. Shortcut H."/>
                        <RadioButton x:Name="EyedropperToolBtn" Style="{StaticResource SubToolButton}" GroupName="Tool"
                                     Tag="Eyedropper" Content="&#xEF3C;" Checked="OnToolChecked" ToolTip="Eyedropper"
                                     AutomationProperties.Name="Eyedropper"
                                     AutomationProperties.HelpText="Sample a source pixel and make it the current annotation color."/>
                    </StackPanel>

                    <StackPanel x:Name="ShapesToolRow" Orientation="Horizontal" Visibility="Collapsed">
                        <RadioButton x:Name="RectangleToolBtn" Style="{StaticResource SubToolButton}" GroupName="Tool"
                                     Tag="Rectangle" Content="&#xE739;" Checked="OnToolChecked"
                                     ToolTip="Rectangle (R)" AutomationProperties.Name="Rectangle"
                                     AutomationProperties.HelpText="Draw an outline rectangle. Shortcut R."/>
                        <RadioButton x:Name="FilledRectangleToolBtn" Style="{StaticResource SubToolButton}" GroupName="Tool"
                                     Tag="FilledRectangle" Content="&#xE73B;" Checked="OnFilledRectangleToolChecked"
                                     ToolTip="Filled rectangle" AutomationProperties.Name="Filled rectangle"
                                     AutomationProperties.HelpText="Draw a solid filled rectangle using the current color."/>
                        <RadioButton x:Name="EllipseToolBtn" Style="{StaticResource SubToolButton}" GroupName="Tool"
                                     Tag="Ellipse" Content="&#xEA3A;" Checked="OnToolChecked" ToolTip="Ellipse (E)"
                                     AutomationProperties.Name="Ellipse" AutomationProperties.HelpText="Draw an ellipse. Shortcut E."/>
                        <RadioButton x:Name="LineToolBtn" Style="{StaticResource SubToolButton}" GroupName="Tool"
                                     Tag="Line" Content="&#xE738;" Checked="OnToolChecked" ToolTip="Line (L)"
                                     AutomationProperties.Name="Line" AutomationProperties.HelpText="Draw a straight line. Shortcut L."/>
                        <RadioButton x:Name="ArrowToolBtn" Style="{StaticResource SubToolButton}" GroupName="Tool"
                                     Tag="Arrow" Content="&#xE72A;" Checked="OnToolChecked" ToolTip="Arrow (A)"
                                     AutomationProperties.Name="Arrow"
                                     AutomationProperties.HelpText="Draw an arrow. The arrow-style menu covers straight, double, thin, fancy and curved. Shortcut A."/>
                        <RadioButton x:Name="StepToolBtn" Style="{StaticResource SubToolButton}" GroupName="Tool"
                                     Tag="Step" Content="&#xE8EF;" Checked="OnToolChecked" ToolTip="Counter (S)"
                                     AutomationProperties.Name="Counter"
                                     AutomationProperties.HelpText="Place sequential number or letter badges. Shortcut S."/>
                    </StackPanel>

                    <StackPanel x:Name="TextToolRow" Orientation="Horizontal" Visibility="Collapsed">
                        <RadioButton x:Name="TextToolBtn" Style="{StaticResource SubToolButton}" GroupName="Tool"
                                     Tag="Text" Content="&#xE8D2;" Checked="OnToolChecked" ToolTip="Text (T)"
                                     AutomationProperties.Name="Text"
                                     AutomationProperties.HelpText="Place styled text. Enter commits and Escape cancels. Shortcut T."/>
                    </StackPanel>

                    <StackPanel x:Name="RedactToolRow" Orientation="Horizontal" Visibility="Collapsed">
                        <RadioButton x:Name="RedactToolBtn" Style="{StaticResource SubToolButton}" GroupName="Tool"
                                     Tag="Redact" Content="&#xE7E6;" Checked="OnToolChecked" ToolTip="Redact (X)"
                                     AutomationProperties.Name="Redact"
                                     AutomationProperties.HelpText="Cover a dragged region with a movable, re-styleable redaction. Shortcut X."/>
                        <RadioButton x:Name="SpotlightToolBtn" Style="{StaticResource SubToolButton}" GroupName="Tool"
                                     Tag="Spotlight" Content="&#xE8FB;" Checked="OnToolChecked" ToolTip="Spotlight (O)"
                                     AutomationProperties.Name="Spotlight"
                                     AutomationProperties.HelpText="Dim the image outside a dragged rectangular focus area. Shortcut O."/>
                        <RadioButton x:Name="MagnifierToolBtn" Style="{StaticResource SubToolButton}" GroupName="Tool"
                                     Tag="Magnifier" Content="&#xE71E;" Checked="OnToolChecked" ToolTip="Magnify (M)"
                                     AutomationProperties.Name="Magnify"
                                     AutomationProperties.HelpText="Drag a bubble that shows a piece of the picture blown up. Drag its ring to aim it somewhere else. Shortcut M."/>
                    </StackPanel>

                    <StackPanel x:Name="ImageToolRow" Orientation="Horizontal" Visibility="Collapsed">
                        <RadioButton x:Name="CropUtilityBtn" Style="{StaticResource SubModeToolButton}" GroupName="Tool"
                                     Tag="Crop" Content="&#xE7A8;" Checked="OnToolChecked"
                                     ToolTip="Crop &amp; resize (C)"
                                     AutomationProperties.Name="Crop and resize"
                                     AutomationProperties.HelpText="Crop the image. Rotate, flip and Image size live on the crop bar. Shortcut C."/>
                        <Button x:Name="AddImageBtn" Style="{StaticResource SubToolIconButton}" Content="&#xEE71;"
                                Click="OnAddImage" ToolTip="Add screenshot or image… (I)"
                                AutomationProperties.Name="Add screenshot or image"
                                AutomationProperties.HelpText="Insert one or more local image files as movable annotations. Shortcut I."/>
                        <Button x:Name="AddCaptureBtn" Style="{StaticResource SubToolIconButton}" Content="&#xE722;"
                                Click="OnAddCapture" ToolTip="Add capture…"
                                AutomationProperties.Name="Add capture"
                                AutomationProperties.HelpText="Hide the editor, take another region capture, and add it to this canvas."/>
                        <Button x:Name="AddBackgroundBtn" Style="{StaticResource SubToolIconButton}" Content="&#xE790;"
                                Click="OnAddBackground" ToolTip="Add background (B)"
                                AutomationProperties.Name="Add background"
                                AutomationProperties.HelpText="Open the local background composer with the current edited image. Shortcut B."/>
                        <Button x:Name="OcrRegionBtn" Style="{StaticResource SubToolIconButton}" Content="&#xE8E9;"
                                Click="OnExtractText" ToolTip="Extract text"
                                AutomationProperties.Name="Extract text"
                                AutomationProperties.HelpText="Read the text in the crop region, or the whole image, and copy it to the clipboard."/>
                        <!-- Appears only once there is an added image to flip between. A
                             before/after GIF of one frame is a PNG. -->
                        <Button x:Name="ExportGifBtn" Style="{StaticResource SubToolIconButton}" Content="&#xE786;"
                                Click="OnExportGif" ToolTip="Export before/after GIF…"
                                Visibility="Collapsed"
                                AutomationProperties.Name="Export before and after GIF"
                                AutomationProperties.HelpText="Save a two-frame animation flipping between the picture without the added images and with them."/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="EditorBottomBar" Grid.Row="2" Style="{StaticResource BottomUtilityBar}"
                Margin="12,6,12,12" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <!-- One control, and it always reads the live zoom. The old label + combo
                         pair went stale after any wheel zoom, and re-picking the entry it was
                         still showing fired no SelectionChanged, so the most common recovery
                         in the editor was a no-op. -->
                    <Button x:Name="ZoomMenuButton" Style="{StaticResource PillButtonSecondary}"
                            Click="OnZoomMenuClick" ToolTip="Zoom" AutomationProperties.Name="Zoom level"
                            AutomationProperties.HelpText="Jump to a zoom level. Ctrl+plus and Ctrl+minus step, Ctrl+0 is 100 percent and Ctrl+1 fits.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ZoomLabel" Text="100%" MinWidth="42" TextAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource TextMicro}"
                                       VerticalAlignment="Center" Opacity="0.7" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button x:Name="BtnDragOut" Grid.Column="1" Style="{StaticResource PillButtonSecondary}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="SizeAll"
                        PreviewMouseLeftButtonDown="OnDragOutMouseDown" PreviewMouseMove="OnDragOutMouseMove"
                        ToolTip="Drag this image into another app" AutomationProperties.Name="Drag me"
                        AutomationProperties.HelpText="Press and drag to drop the edited image as a file into another application.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE700;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource TextBody}"
                                   VerticalAlignment="Center" Opacity="0.7" Margin="{StaticResource ChipGutterMargin}"/>
                        <TextBlock Text="Drag me" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Name="BtnPin" Style="{StaticResource CircleActionButton}" Content="&#xE718;" ToolTip="Pin to screen"
                            Click="OnPin" AutomationProperties.Name="Pin to screen"
                            AutomationProperties.HelpText="Open the edited image in a local always-on-top pin window."/>
                    <Button x:Name="BtnCopy" Style="{StaticResource CircleActionButton}" Content="&#xE8C8;"
                            ToolTip="Copy to clipboard (Ctrl+C)" Click="OnCopy" AutomationProperties.Name="Copy"
                            AutomationProperties.HelpText="Copy the source-resolution edited image to the Windows clipboard. With marks selected, Ctrl+C copies those marks for pasting inside the editor instead."/>
                    <Button x:Name="BtnCenter" Style="{StaticResource CircleActionButton}" Content="&#xE9A6;"
                            ToolTip="Fit &amp; center (Ctrl+1)" Click="OnCenterView" AutomationProperties.Name="Fit and center"
                            AutomationProperties.HelpText="Fit and center the whole image. Shortcut Ctrl+1."/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
