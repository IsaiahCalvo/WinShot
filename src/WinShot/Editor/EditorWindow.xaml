                                                                <Grid Tag="center|top"><Rectangle Width="6" Height="6" RadiusX="1.5" RadiusY="1.5" Visibility="Collapsed" Fill="{StaticResource ChromeAccentHaloBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Rectangle Width="4" Height="4" RadiusX="1" RadiusY="1" Fill="{StaticResource ChromeDotOffBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                                                                <Grid Tag="right|top"><Rectangle Width="6" Height="6" RadiusX="1.5" RadiusY="1.5" Visibility="Collapsed" Fill="{StaticResource ChromeAccentHaloBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Rectangle Width="4" Height="4" RadiusX="1" RadiusY="1" Fill="{StaticResource ChromeDotOffBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                                                                <Grid Tag="left|middle"><Rectangle Width="6" Height="6" RadiusX="1.5" RadiusY="1.5" Visibility="Collapsed" Fill="{StaticResource ChromeAccentHaloBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Rectangle Width="4" Height="4" RadiusX="1" RadiusY="1" Fill="{StaticResource ChromeDotOffBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                                                                <Grid Tag="center|middle"><Rectangle Width="6" Height="6" RadiusX="1.5" RadiusY="1.5" Visibility="Collapsed" Fill="{StaticResource ChromeAccentHaloBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Rectangle Width="4" Height="4" RadiusX="1" RadiusY="1" Fill="{StaticResource ChromeDotOffBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                                                                <Grid Tag="right|middle"><Rectangle Width="6" Height="6" RadiusX="1.5" RadiusY="1.5" Visibility="Collapsed" Fill="{StaticResource ChromeAccentHaloBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Rectangle Width="4" Height="4" RadiusX="1" RadiusY="1" Fill="{StaticResource ChromeDotOffBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                                                                <Grid Tag="left|bottom"><Rectangle Width="6" Height="6" RadiusX="1.5" RadiusY="1.5" Visibility="Collapsed" Fill="{StaticResource ChromeAccentHaloBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Rectangle Width="4" Height="4" RadiusX="1" RadiusY="1" Fill="{StaticResource ChromeDotOffBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                                                                <Grid Tag="center|bottom"><Rectangle Width="6" Height="6" RadiusX="1.5" RadiusY="1.5" Visibility="Collapsed" Fill="{StaticResource ChromeAccentHaloBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Rectangle Width="4" Height="4" RadiusX="1" RadiusY="1" Fill="{StaticResource ChromeDotOffBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                                                                <Grid Tag="right|bottom"><Rectangle Width="6" Height="6" RadiusX="1.5" RadiusY="1.5" Visibility="Collapsed" Fill="{StaticResource ChromeAccentHaloBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Rectangle Width="4" Height="4" RadiusX="1" RadiusY="1" Fill="{StaticResource ChromeDotOffBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                                                            </UniformGrid>
