<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Survey src/Icons.jsx annotation glyphs, ported as WPF geometry.
         Stroke/fill bind to the parent control Foreground so the blue-selected
         state (white glyph) works. x:Shared=False because each button needs
         its own visual tree. -->

    <Style x:Key="SurveyIconStroke" TargetType="Shape">
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Fill" Value="Transparent"/>
    </Style>
    <Style x:Key="SurveyIconFill" TargetType="Shape">
        <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
        <Setter Property="Stroke" Value="{x:Null}"/>
    </Style>

    <Viewbox x:Key="SurveyIcon.Cursor" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}"
                  Data="M3,3 L10.07,19.97 L12.58,12.58 L19.97,10.07 Z"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M13,13 L19,19"/>
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SurveyIcon.Pen" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconFill}"
                  Data="M.75,17.5A.751.751,0,0,1,0,16.75V12.569a.755.755,0,0,1,.22-.53L11.461.8a2.72,2.72,0,0,1,3.848,0L16.7,2.191a2.72,2.72,0,0,1,0,3.848L5.462,17.28a.747.747,0,0,1-.531.22ZM1.5,12.879V16h3.12l7.91-7.91L9.41,4.97ZM13.591,7.03l2.051-2.051a1.223,1.223,0,0,0,0-1.727L14.249,1.858a1.222,1.222,0,0,0-1.727,0L10.47,3.91Z">
                <Path.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform X="3.25" Y="3.25"/>
                        <ScaleTransform ScaleY="-1" CenterX="12" CenterY="12"/>
                        <RotateTransform Angle="270" CenterX="12" CenterY="12"/>
                        <TranslateTransform Y="-0.3"/>
                    </TransformGroup>
                </Path.RenderTransform>
            </Path>
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SurveyIcon.Pan" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}"
                  Data="M5,9 L2,12 L5,15 M9,5 L12,2 L15,5 M19,9 L22,12 L19,15 M9,19 L12,22 L15,19"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M12,2 V22 M2,12 H22"/>
        </Canvas>
    </Viewbox>

    <!-- Chisel-tip marker over its swipe. Survey's own asset is a PNG mask, so this is
         drawn in the stroke language the rest of the set uses; a filled silhouette read
         as a second, fatter Pen. The barrel rotates ONCE — nested rotations are what
         mangled the old eraser. -->
    <Viewbox x:Key="SurveyIcon.Highlighter" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Canvas>
                <Canvas.RenderTransform>
                    <RotateTransform Angle="-20" CenterX="12" CenterY="11"/>
                </Canvas.RenderTransform>
                <!-- tall barrel, so the silhouette reads as a marker rather than a block -->
                <Path Style="{StaticResource SurveyIconStroke}"
                      Data="M10,1.8 h4.4 a1.4,1.4 0 0 1 1.4,1.4 v7.3 h-7.2 V3.2 A1.4,1.4 0 0 1 10,1.8 Z"/>
                <!-- collar between barrel and nib -->
                <Path Style="{StaticResource SurveyIconStroke}" Data="M8.6,10.5 h7.2"/>
                <!-- chisel nib, flaring wider than the barrel -->
                <Path Style="{StaticResource SurveyIconStroke}"
                      Data="M8.6,10.5 h7.2 l1,4.5 a0.9,0.9 0 0 1 -0.9,1.1 H8.5 a0.9,0.9 0 0 1 -0.9,-1.1 Z"/>
            </Canvas>
            <!-- the highlighted swipe the marker is laying down -->
            <Path Style="{StaticResource SurveyIconStroke}" StrokeThickness="2.6" Data="M4.5,21 H17"/>
        </Canvas>
    </Viewbox>

    <!-- Angled eraser block rubbing along a baseline. The old one nested a 270 and a -45
         rotation on a tall rect, which rendered as an unreadable diamond. -->
    <Viewbox x:Key="SurveyIcon.Eraser" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}"
                  Data="M7.5,20.5 L3.2,16.2 a2,2 0 0 1 0,-2.8 L12.8,3.8 a2,2 0 0 1 2.8,0 L21.2,9.4 a2,2 0 0 1 0,2.8 L12.9,20.5 Z"/>
            <!-- the seam where the worn end meets the body -->
            <Path Style="{StaticResource SurveyIconStroke}" Data="M8.2,8.4 L16.8,17"/>
            <!-- baseline it erases against -->
            <Path Style="{StaticResource SurveyIconStroke}" Data="M7.5,20.5 H21.5"/>
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SurveyIcon.Text" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}" Data="M4,7 L4,4 L20,4 L20,7"/>
            <Line Style="{StaticResource SurveyIconStroke}" X1="9" Y1="20" X2="15" Y2="20"/>
            <Line Style="{StaticResource SurveyIconStroke}" X1="12" Y1="4" X2="12" Y2="20"/>
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SurveyIcon.Callout" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}"
                  Data="M20,4 H4 C2.9,4 2,4.9 2,6 V18 C2,19.1 2.9,20 4,20 H18 L22,24 V6 C22,4.9 21.1,4 20,4 Z"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M7,12 H17"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M7,8 H13"/>
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SurveyIcon.Rect" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Rectangle Style="{StaticResource SurveyIconStroke}"
                       Canvas.Left="3" Canvas.Top="3" Width="18" Height="18" RadiusX="2" RadiusY="2"/>
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SurveyIcon.FilledRect" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Rectangle Style="{StaticResource SurveyIconFill}"
                       Canvas.Left="3" Canvas.Top="3" Width="18" Height="18" RadiusX="2" RadiusY="2"/>
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SurveyIcon.Ellipse" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Ellipse Style="{StaticResource SurveyIconStroke}"
                     Canvas.Left="2" Canvas.Top="2" Width="20" Height="20"/>
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SurveyIcon.Line" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Line Style="{StaticResource SurveyIconStroke}" X1="5" Y1="19" X2="19" Y2="5"/>
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SurveyIcon.Arrow" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Line Style="{StaticResource SurveyIconStroke}" X1="5" Y1="19" X2="19" Y2="5"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M12,5 H19 V12"/>
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SurveyIcon.Counter" x:Shared="False" Width="18" Height="18">
        <Grid Width="24" Height="24">
            <Ellipse Style="{StaticResource SurveyIconStroke}"
                     Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Text="1" FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Padding="0,1,0,0"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
        </Grid>
    </Viewbox>

    <Viewbox x:Key="SurveyIcon.Undo" x:Shared="False" Width="16" Height="16">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}" Data="M9,5 L4,9 L9,13"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M4,9 H14 C17.3,9 20,11.7 20,15 C20,18.3 17.3,21 14,21 H10"/>
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SurveyIcon.Redo" x:Shared="False" Width="16" Height="16">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}" Data="M15,5 L20,9 L15,13"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M20,9 H10 C6.7,9 4,11.7 4,15 C4,18.3 6.7,21 10,21 H14"/>
        </Canvas>
    </Viewbox>

    <!-- Pipette: a bulb head with a squeezed neck and a drip tip. The old outline was a
         thin diagonal with a tiny cap, which read as a second Pen at 18px. -->
    <Viewbox x:Key="SurveyIcon.Eyedropper" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <!-- bulb -->
            <Path Style="{StaticResource SurveyIconStroke}"
                  Data="M14.6,2.9 a3,3 0 0 1 4.3,4.2 l-2,2 1.1,1.1 a1.6,1.6 0 0 1 0,2.3 l-0.6,0.6 a1.6,1.6 0 0 1 -2.3,0 L9.7,8.6 a1.6,1.6 0 0 1 0,-2.3 l0.6,-0.6 a1.6,1.6 0 0 1 2.3,0 l1.1,1.1 Z"/>
            <!-- stem down to the tip, with the drip -->
            <Path Style="{StaticResource SurveyIconStroke}" Data="M11.6,10.5 L4.6,17.5 3.5,21.2 7.2,20.1 14.2,13.1"/>
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SurveyIcon.Blur" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}"
                  Data="M12,3 C12,3 6.5,10.5 6.5,15 A5.5,5.5 0 0 0 17.5,15 C17.5,10.5 12,3 12,3 Z"/>
        </Canvas>
    </Viewbox>

    <!-- Source: Theme/Icons/pixelate.svg -->
    <Viewbox x:Key="SurveyIcon.Pixelate" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Rectangle Style="{StaticResource SurveyIconStroke}" Canvas.Left="3" Canvas.Top="3" Width="5" Height="5"/>
            <Rectangle Style="{StaticResource SurveyIconFill}" Canvas.Left="9.5" Canvas.Top="3" Width="5" Height="5"/>
            <Rectangle Style="{StaticResource SurveyIconStroke}" Canvas.Left="16" Canvas.Top="3" Width="5" Height="5"/>
            <Rectangle Style="{StaticResource SurveyIconFill}" Canvas.Left="3" Canvas.Top="9.5" Width="5" Height="5"/>
            <Rectangle Style="{StaticResource SurveyIconStroke}" Canvas.Left="9.5" Canvas.Top="9.5" Width="5" Height="5"/>
            <Rectangle Style="{StaticResource SurveyIconFill}" Canvas.Left="16" Canvas.Top="9.5" Width="5" Height="5"/>
            <Rectangle Style="{StaticResource SurveyIconStroke}" Canvas.Left="3" Canvas.Top="16" Width="5" Height="5"/>
            <Rectangle Style="{StaticResource SurveyIconFill}" Canvas.Left="9.5" Canvas.Top="16" Width="5" Height="5"/>
            <Rectangle Style="{StaticResource SurveyIconStroke}" Canvas.Left="16" Canvas.Top="16" Width="5" Height="5"/>
        </Canvas>
    </Viewbox>

    <!-- Source: Theme/Icons/select-all-svgrepo-com.svg (Timothée Giet / SVG Repo, CC BY-SA 4.0) -->
    <!-- Focus corners around a lit centre. The old glyph was a dashed ring on a 16-grid
         nudged into place with a huge translate, and read as a marquee, not a spotlight. -->
    <Viewbox x:Key="SurveyIcon.Spotlight" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}"
                  Data="M3.5,8.5 V5.5 a2,2 0 0 1 2,-2 h3 M15.5,3.5 h3 a2,2 0 0 1 2,2 v3 M20.5,15.5 v3 a2,2 0 0 1 -2,2 h-3 M8.5,20.5 h-3 a2,2 0 0 1 -2,-2 v-3"/>
            <Ellipse Style="{StaticResource SurveyIconFill}"
                     Canvas.Left="8.4" Canvas.Top="8.4" Width="7.2" Height="7.2"/>
        </Canvas>
    </Viewbox>
</ResourceDictionary>
