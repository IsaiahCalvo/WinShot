<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Survey src/Icons.jsx annotation glyphs, ported as WPF geometry.
         Stroke/fill bind to the parent control Foreground so the blue-selected
         state (white glyph) works. x:Shared=False because each button needs
         its own visual tree. -->

    <!-- Stroked circles and rects are Paths over geometry, never <Ellipse>/<Rectangle>: a WPF
         Shape's Width/Height INCLUDE its stroke (the pen is drawn inside the bounds), while an
         SVG circle's r is geometric with the pen straddling it. Ported as shapes, every ring
         came out StrokeThickness smaller than Survey's — the "a" in the Text group read as a dot. -->
    <!-- ONE weight for the whole family. 1.667 canvas units inside the 18-over-24 host is
         1.25 px painted, and every glyph below is set so it paints exactly that however its
         own grid is scaled. Nine different weights used to live here — 1.0 to 2.625 — and
         each consumer then nudged its HOST size to compensate, so the toolbar wrapped Undo at
         14 px, Crop at 20 and Select at 22 to fake a matching line. Two icons in one row at
         two weights is the loudest tell there is that a UI was not drawn by one hand. -->
    <Style x:Key="SurveyIconStroke" TargetType="Shape">
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
        <Setter Property="StrokeThickness" Value="1.667"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Fill" Value="Transparent"/>
    </Style>
    <Style x:Key="SurveyIconFill" TargetType="Shape">
        <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
        <Setter Property="Stroke" Value="{x:Null}"/>
    </Style>

    <!-- Survey src/assets/icons/selection-cursor-rounded.svg, verbatim. Drawn at the house weight, not
         the source file's 1.75. The file's own transform is translate(12 12) scale(1) translate(-12 -12),
         i.e. the identity, so it is dropped. Survey's Icons.jsx `cursor` renderer (the plain
         arrow this used to be) is not what the Select button renders — `selectCursor` is. -->
    <Viewbox x:Key="SurveyIcon.Cursor" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}"
                  Data="M9.80282 4.62973L15.8364 6.99069C19.3164 8.35243 21.0564 9.03329 20.9987 10.1133C20.941 11.1934 19.1251 11.6886 15.4933 12.6791C14.412 12.974 13.8713 13.1215 13.4964 13.4963C13.1215 13.8712 12.9741 14.4119 12.6791 15.4933C11.6887 19.125 11.1934 20.9409 10.1134 20.9986C9.03335 21.0563 8.35249 19.3163 6.99075 15.8363L4.62979 9.80276C3.20411 6.15934 2.49127 4.33764 3.41448 3.41442C4.3377 2.49121 6.15941 3.20405 9.80282 4.62973Z"/>
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SurveyIcon.Pen" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconFill}"
                  Data="M.75,17.5A.751.751,0,0,1,0,16.75V12.569a.755.755,0,0,1,.22-.53L11.461.8a2.72,2.72,0,0,1,3.848,0L16.7,2.191a2.72,2.72,0,0,1,0,3.848L5.462,17.28a.747.747,0,0,1-.531.22ZM1.5,12.879V16h3.12l7.91-7.91L9.41,4.97ZM13.591,7.03l2.051-2.051a1.223,1.223,0,0,0,0-1.727L14.249,1.858a1.222,1.222,0,0,0-1.727,0L10.47,3.91Z">
                <Path.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform X="3.25" Y="3.25"/>
                        <ScaleTransform ScaleY="-1" CenterX="12" CenterY="12"/>
                        <RotateTransform Angle="270" CenterX="12" CenterY="12"/>
                        <TranslateTransform Y="-0.3"/>
                    </TransformGroup>
                </Path.RenderTransform>
            </Path>
        </Canvas>
    </Viewbox>

