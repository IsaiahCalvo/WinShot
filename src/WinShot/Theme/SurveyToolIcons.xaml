            </Canvas>
        </Canvas>
    </Viewbox>

    <!-- Shape tool: Polyline. Survey src/Icons.jsx `polyline`, verbatim: an open four-point
         run with hollow vertices, authored on a 64-unit grid and scaled onto the 24 one. The
         strokes are the house weight divided by that group's own 0.4049 scale, so they
         paint the same 1.25 px as every other glyph. The source's 3.5 and 2.2 painted 1.06
         and 0.67 — the vertex rings two thirds the weight of their own segments. -->
    <Viewbox x:Key="SurveyIcon.Polyline" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Canvas>
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.4049" ScaleY="0.4049"/>
                        <TranslateTransform X="-0.956" Y="-0.755"/>
                    </TransformGroup>
                </Canvas.RenderTransform>
                <Path Style="{StaticResource SurveyIconStroke}" StrokeThickness="4.117" Data="M13.835,44.565 L22.165,24.435"/>
                <Path Style="{StaticResource SurveyIconStroke}" StrokeThickness="4.117" Data="M27.774,22.966 L34.226,28.034"/>
                <Path Style="{StaticResource SurveyIconStroke}" StrokeThickness="4.117" Data="M41.051,27.295 L48.949,17.705"/>
                <Path Style="{StaticResource SurveyIconStroke}" StrokeThickness="4.117">
                    <Path.Data><EllipseGeometry Center="12,49" RadiusX="3.6" RadiusY="3.6"/></Path.Data>
                </Path>
                <Path Style="{StaticResource SurveyIconStroke}" StrokeThickness="4.117">
                    <Path.Data><EllipseGeometry Center="24,20" RadiusX="3.6" RadiusY="3.6"/></Path.Data>
                </Path>
                <Path Style="{StaticResource SurveyIconStroke}" StrokeThickness="4.117">
                    <Path.Data><EllipseGeometry Center="38,31" RadiusX="3.6" RadiusY="3.6"/></Path.Data>
                </Path>
                <Path Style="{StaticResource SurveyIconStroke}" StrokeThickness="4.117">
                    <Path.Data><EllipseGeometry Center="52,14" RadiusX="3.6" RadiusY="3.6"/></Path.Data>
                </Path>
            </Canvas>
        </Canvas>
    </Viewbox>

    <!-- Survey src/Icons.jsx `arrowBothEnds`, verbatim: one shaft with a chevron head at each
         end, 24-grid, round caps and joins. It is the glyph on Survey's "Both
         ends" toggle (AppShell.jsx:2780); hosted at the family's 18 px, not 16, so it does
         not paint a lighter line than the Arrow glyph beside it. Not a unicode arrow
         and not a mirrored copy of SurveyIcon.Arrow: that one is a corner arrow. -->
    <Viewbox x:Key="SurveyIcon.ArrowBothEnds" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}"
                  Data="M4,12 H20 M9,7 L4,12 L9,17 M15,7 L20,12 L15,17"/>
        </Canvas>
    </Viewbox>

    <!-- Survey src/assets/icons/counter.svg, verbatim: the SOLID pin with the numeral
         knocked out. This replaces the hollow ring drawn from counter-outline.svg — that
         file is dead code in Survey (its live renderer uses this 936x934 mask), and a ring
         with a 1 in it reads as an info badge, not a numbered step.

         The SVG is one white blob plus a mask whose black numeral subtracts from it. WPF
         says the same thing with a GeometryGroup at FillRule EvenOdd: the numeral figure
         overlaps the blob, so it is removed. The numeral keeps its own source transform on
         its own PathGeometry rather than having it baked into the coordinates, so the path
         data below is byte-for-byte the file's.

         It paints far more ink than the outlined glyphs beside it in the shapes sub-row.
         That is Survey's own look for this mark and it stays. -->
    <Viewbox x:Key="SurveyIcon.Counter" x:Shared="False" Width="18" Height="18">
        <Canvas Width="936" Height="934">
