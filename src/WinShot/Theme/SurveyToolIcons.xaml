    <!-- Source: Theme/Icons/pixelate.svg -->
    <Viewbox x:Key="SurveyIcon.Pixelate" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Rectangle Style="{StaticResource SurveyIconStroke}" Canvas.Left="3" Canvas.Top="3" Width="5" Height="5"/>
            <Rectangle Style="{StaticResource SurveyIconFill}" Canvas.Left="9.5" Canvas.Top="3" Width="5" Height="5"/>
            <Rectangle Style="{StaticResource SurveyIconStroke}" Canvas.Left="16" Canvas.Top="3" Width="5" Height="5"/>
            <Rectangle Style="{StaticResource SurveyIconFill}" Canvas.Left="3" Canvas.Top="9.5" Width="5" Height="5"/>
            <Rectangle Style="{StaticResource SurveyIconStroke}" Canvas.Left="9.5" Canvas.Top="9.5" Width="5" Height="5"/>
            <Rectangle Style="{StaticResource SurveyIconFill}" Canvas.Left="16" Canvas.Top="9.5" Width="5" Height="5"/>
            <Rectangle Style="{StaticResource SurveyIconStroke}" Canvas.Left="3" Canvas.Top="16" Width="5" Height="5"/>
            <Rectangle Style="{StaticResource SurveyIconFill}" Canvas.Left="9.5" Canvas.Top="16" Width="5" Height="5"/>
            <Rectangle Style="{StaticResource SurveyIconStroke}" Canvas.Left="16" Canvas.Top="16" Width="5" Height="5"/>
        </Canvas>
    </Viewbox>

    <!-- Source: Theme/Icons/select-all-svgrepo-com.svg (Timothée Giet / SVG Repo, CC BY-SA 4.0) -->
    <!-- Focus corners around a lit centre. The old glyph was a dashed ring on a 16-grid
         nudged into place with a huge translate, and read as a marquee, not a spotlight. -->
    <Viewbox x:Key="SurveyIcon.Spotlight" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}"
                  Data="M3.5,8.5 V5.5 a2,2 0 0 1 2,-2 h3 M15.5,3.5 h3 a2,2 0 0 1 2,2 v3 M20.5,15.5 v3 a2,2 0 0 1 -2,2 h-3 M8.5,20.5 h-3 a2,2 0 0 1 -2,-2 v-3"/>
            <Ellipse Style="{StaticResource SurveyIconFill}"
                     Canvas.Left="8.4" Canvas.Top="8.4" Width="7.2" Height="7.2"/>
        </Canvas>
    </Viewbox>
    <Viewbox x:Key="SurveyIcon.More" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Ellipse Style="{StaticResource SurveyIconFill}" Canvas.Left="10.5" Canvas.Top="3.5" Width="3" Height="3"/>
            <Ellipse Style="{StaticResource SurveyIconFill}" Canvas.Left="10.5" Canvas.Top="10.5" Width="3" Height="3"/>
            <Ellipse Style="{StaticResource SurveyIconFill}" Canvas.Left="10.5" Canvas.Top="17.5" Width="3" Height="3"/>
        </Canvas>
    </Viewbox>
