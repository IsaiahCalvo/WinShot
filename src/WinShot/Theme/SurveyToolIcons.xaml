            <Path Style="{StaticResource SurveyIconStroke}"
                  Data="M7.84051 13.4813V4.98823C7.84051 4.1585 8.50582 3.48586 9.32652 3.48586C10.1472 3.48586 10.8125 4.15828 10.8125 4.98802M10.8125 9.97422V3.50238C10.8125 2.67264 11.4778 2 12.2986 2C13.1193 2 13.7846 2.67264 13.7846 3.50238V11.0057M13.7846 5.47656C13.7846 4.64306 14.4836 3.9678 15.308 3.9678C16.1324 3.9678 16.8008 4.64348 16.8008 5.47699V11.9989M16.8008 7.51562C16.8008 6.69224 17.461 6.02157 18.2754 6.02157C19.0898 6.02157 19.75 6.68905 19.75 7.51243V16.1246C19.75 17.1574 19.3743 18.3101 18.2322 19.6845C17.9 20.083 17.45 20.5 17 20.8M7.84051 8.85627C7.00785 9.63725 4.99016 11.6991 4.43639 12.8432C3.88262 13.9873 4.7059 15.3388 5.05201 15.8682L7.84008 19.5755C8.25 20.15 8.6 20.55 9 20.8C10.6 21.55 15.25 21.55 17 20.8"/>
        </Canvas>
    </Viewbox>

    <!-- Survey src/assets/icons/highlighter-tool.svg, verbatim. It is a mask icon there, so
         the file's stroke="#fff" carries no colour — every opaque pixel takes the icon
         colour. Kept on its native 128 grid so the numbers stay literal; the Viewbox
         normalises. Paths 2 and 3 are stroke-linecap="butt" in the source, not round. -->
    <Viewbox x:Key="SurveyIcon.Highlighter" x:Shared="False" Width="18" Height="18">
        <Canvas Width="128" Height="128">
            <Path Style="{StaticResource SurveyIconStroke}" StrokeThickness="8.889"
                  Data="M93 16.8 Q94.8 16.8 96.6 18.6 L112.5 34.5 Q116.2 38.2 112.8 42.3 L63.3 102.1 Q60.3 105.7 55.9 103 L52 100.6 Q46 96.9 37 103 L31 110 Q30 110 29.2 109.7 L15.5 102.8 L27 92 Q34 85 29.2 77.2 L27.1 73.9 Q24.5 69.2 29 65.4 L90.1 17.7 Q91.6 16.7 93 16.8Z"/>
            <Path Style="{StaticResource SurveyIconStroke}" StrokeThickness="8.889"
                  StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" Data="M40.7 55.5L70.4 90.1"/>
            <Path Style="{StaticResource SurveyIconStroke}" StrokeThickness="8.889"
                  StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" Data="M27 92L37 103"/>
        </Canvas>
    </Viewbox>

    <!-- The Draw GROUP button, distinct from the Pen sub-tool. Survey src/Icons.jsx
         `drawGroup`: lucide square-pen, pasted inline there (lucide-react is not a Survey
         dependency, so that file is the source). Lucide's own stroke 2 is dropped for the
         house weight: at 2 it read heavier than the Shapes chip beside it. -->
    <Viewbox x:Key="SurveyIcon.DrawGroup" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}"
                  Data="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
            <Path Style="{StaticResource SurveyIconStroke}"
                  Data="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z"/>
        </Canvas>
    </Viewbox>

    <!-- The Shapes GROUP button. Survey src/assets/icons/shapes.svg, verbatim. The composition (circle top-left, square right, triangle bottom) and the size
         asymmetry are the owner's overshoot rule, not slop: the circle's outer diameter is
         ~3% over the square's and the triangle is widest, so all three look the same size. -->
    <Viewbox x:Key="SurveyIcon.Shapes" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}">
                <Path.Data><EllipseGeometry Center="6.7,6.7" RadiusX="4.16" RadiusY="4.16"/></Path.Data>
            </Path>
            <Path Style="{StaticResource SurveyIconStroke}">
                <Path.Data><RectangleGeometry Rect="13.55,4.75,7.9,7.9" RadiusX="1" RadiusY="1"/></Path.Data>
            </Path>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M11 14.2 15.75 21.45 6.25 21.45Z"/>
        </Canvas>
    </Viewbox>

    <!-- The Text GROUP button, distinct from the Text sub-tool's serif T. Survey
         src/assets/icons/case-sensitive.svg (lucide case-sensitive), verbatim at the house weight. -->
    <Viewbox x:Key="SurveyIcon.TextGroup" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}" Data="m2 16 4.039-9.69a.5.5 0 0 1 .923 0L11 16"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M22 9v7"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M3.304 13h6.392"/>
            <Path Style="{StaticResource SurveyIconStroke}">
                <Path.Data><EllipseGeometry Center="18.5,12.5" RadiusX="3.5" RadiusY="3.5"/></Path.Data>
            </Path>
        </Canvas>
    </Viewbox>

