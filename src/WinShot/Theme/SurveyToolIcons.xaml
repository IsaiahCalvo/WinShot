<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Survey src/Icons.jsx annotation glyphs, ported as WPF geometry.
         Stroke/fill bind to the parent control Foreground so the blue-selected
         state (white glyph) works. x:Shared=False because each button needs
         its own visual tree. -->

    <Style x:Key="SurveyIconStroke" TargetType="Shape">
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Fill" Value="Transparent"/>
    </Style>
    <Style x:Key="SurveyIconFill" TargetType="Shape">
        <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
        <Setter Property="Stroke" Value="{x:Null}"/>
    </Style>

    <!-- Survey src/assets/icons/selection-cursor-rounded.svg, verbatim. Stroke 1.75, not the
         house 1.5. The file's own transform is translate(12 12) scale(1) translate(-12 -12),
         i.e. the identity, so it is dropped. Survey's Icons.jsx `cursor` renderer (the plain
         arrow this used to be) is not what the Select button renders — `selectCursor` is. -->
    <Viewbox x:Key="SurveyIcon.Cursor" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}" StrokeThickness="1.75"
                  Data="M9.80282 4.62973L15.8364 6.99069C19.3164 8.35243 21.0564 9.03329 20.9987 10.1133C20.941 11.1934 19.1251 11.6886 15.4933 12.6791C14.412 12.974 13.8713 13.1215 13.4964 13.4963C13.1215 13.8712 12.9741 14.4119 12.6791 15.4933C11.6887 19.125 11.1934 20.9409 10.1134 20.9986C9.03335 21.0563 8.35249 19.3163 6.99075 15.8363L4.62979 9.80276C3.20411 6.15934 2.49127 4.33764 3.41448 3.41442C4.3377 2.49121 6.15941 3.20405 9.80282 4.62973Z"/>
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SurveyIcon.Pen" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconFill}"
                  Data="M.75,17.5A.751.751,0,0,1,0,16.75V12.569a.755.755,0,0,1,.22-.53L11.461.8a2.72,2.72,0,0,1,3.848,0L16.7,2.191a2.72,2.72,0,0,1,0,3.848L5.462,17.28a.747.747,0,0,1-.531.22ZM1.5,12.879V16h3.12l7.91-7.91L9.41,4.97ZM13.591,7.03l2.051-2.051a1.223,1.223,0,0,0,0-1.727L14.249,1.858a1.222,1.222,0,0,0-1.727,0L10.47,3.91Z">
                <Path.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform X="3.25" Y="3.25"/>
                        <ScaleTransform ScaleY="-1" CenterX="12" CenterY="12"/>
                        <RotateTransform Angle="270" CenterX="12" CenterY="12"/>
                        <TranslateTransform Y="-0.3"/>
                    </TransformGroup>
                </Path.RenderTransform>
            </Path>
        </Canvas>
    </Viewbox>

    <!-- Survey src/assets/icons/pan-hand-closed.svg, verbatim: a closed hand, not a
         four-way arrow cross. Stroke 1.5, round caps and joins. -->
    <Viewbox x:Key="SurveyIcon.Pan" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}"
                  Data="M7.84051 13.4813V4.98823C7.84051 4.1585 8.50582 3.48586 9.32652 3.48586C10.1472 3.48586 10.8125 4.15828 10.8125 4.98802M10.8125 9.97422V3.50238C10.8125 2.67264 11.4778 2 12.2986 2C13.1193 2 13.7846 2.67264 13.7846 3.50238V11.0057M13.7846 5.47656C13.7846 4.64306 14.4836 3.9678 15.308 3.9678C16.1324 3.9678 16.8008 4.64348 16.8008 5.47699V11.9989M16.8008 7.51562C16.8008 6.69224 17.461 6.02157 18.2754 6.02157C19.0898 6.02157 19.75 6.68905 19.75 7.51243V16.1246C19.75 17.1574 19.3743 18.3101 18.2322 19.6845C17.9 20.083 17.45 20.5 17 20.8M7.84051 8.85627C7.00785 9.63725 4.99016 11.6991 4.43639 12.8432C3.88262 13.9873 4.7059 15.3388 5.05201 15.8682L7.84008 19.5755C8.25 20.15 8.6 20.55 9 20.8C10.6 21.55 15.25 21.55 17 20.8"/>
        </Canvas>
    </Viewbox>

    <!-- Survey src/assets/icons/highlighter-tool.svg, verbatim. It is a mask icon there, so
         the file's stroke="#fff" carries no colour — every opaque pixel takes the icon
         colour. Kept on its native 128 grid so the numbers stay literal; the Viewbox
         normalises. Paths 2 and 3 are stroke-linecap="butt" in the source, not round. -->
    <Viewbox x:Key="SurveyIcon.Highlighter" x:Shared="False" Width="18" Height="18">
        <Canvas Width="128" Height="128">
            <Path Style="{StaticResource SurveyIconStroke}" StrokeThickness="7.2"
                  Data="M93 16.8 Q94.8 16.8 96.6 18.6 L112.5 34.5 Q116.2 38.2 112.8 42.3 L63.3 102.1 Q60.3 105.7 55.9 103 L52 100.6 Q46 96.9 37 103 L31 110 Q30 110 29.2 109.7 L15.5 102.8 L27 92 Q34 85 29.2 77.2 L27.1 73.9 Q24.5 69.2 29 65.4 L90.1 17.7 Q91.6 16.7 93 16.8Z"/>
            <Path Style="{StaticResource SurveyIconStroke}" StrokeThickness="7.2"
                  StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" Data="M40.7 55.5L70.4 90.1"/>
            <Path Style="{StaticResource SurveyIconStroke}" StrokeThickness="7.2"
                  StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" Data="M27 92L37 103"/>
        </Canvas>
    </Viewbox>

    <!-- The Draw GROUP button, distinct from the Pen sub-tool. Survey src/Icons.jsx
         `drawGroup`: lucide square-pen, pasted inline there (lucide-react is not a Survey
         dependency, so that file is the source). Stroke 2 is lucide's own weight, kept
         deliberately so it does not read lighter than its top-row neighbours. -->
    <Viewbox x:Key="SurveyIcon.DrawGroup" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}" StrokeThickness="2"
                  Data="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
            <Path Style="{StaticResource SurveyIconStroke}" StrokeThickness="2"
                  Data="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z"/>
        </Canvas>
    </Viewbox>

    <!-- The Shapes GROUP button. Survey src/assets/icons/shapes.svg, verbatim. One weight,
         1.7. The composition (circle top-left, square right, triangle bottom) and the size
         asymmetry are the owner's overshoot rule, not slop: the circle's outer diameter is
         ~3% over the square's and the triangle is widest, so all three look the same size. -->
    <Viewbox x:Key="SurveyIcon.Shapes" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Ellipse Style="{StaticResource SurveyIconStroke}" StrokeThickness="1.7" Canvas.Left="2.54" Canvas.Top="2.54" Width="8.32" Height="8.32"/>
            <Rectangle Style="{StaticResource SurveyIconStroke}" StrokeThickness="1.7" Canvas.Left="13.55" Canvas.Top="4.75" Width="7.9" Height="7.9" RadiusX="1" RadiusY="1"/>
            <Path Style="{StaticResource SurveyIconStroke}" StrokeThickness="1.7" Data="M11 14.2 15.75 21.45 6.25 21.45Z"/>
        </Canvas>
    </Viewbox>

    <!-- The Text GROUP button, distinct from the Text sub-tool's serif T. Survey
         src/assets/icons/case-sensitive.svg (lucide case-sensitive), verbatim, stroke 2. -->
    <Viewbox x:Key="SurveyIcon.TextGroup" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}" StrokeThickness="2" Data="m2 16 4.039-9.69a.5.5 0 0 1 .923 0L11 16"/>
            <Path Style="{StaticResource SurveyIconStroke}" StrokeThickness="2" Data="M22 9v7"/>
            <Path Style="{StaticResource SurveyIconStroke}" StrokeThickness="2" Data="M3.304 13h6.392"/>
            <Ellipse Style="{StaticResource SurveyIconStroke}" StrokeThickness="2" Canvas.Left="15" Canvas.Top="9" Width="7" Height="7"/>
        </Canvas>
    </Viewbox>

    <!-- The Text SUB-TOOL. Survey src/assets/icons/text-box-selection.svg, verbatim: ten
         paths, four corner handles plus six lines. The file's #1C274C is dropped — it is a
         mask icon in Survey, so the colour there is meaningless. -->
    <Viewbox x:Key="SurveyIcon.TextBox" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}" Data="M9 9H15"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M12 15L12 9"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M6 4C6 5.10457 5.10457 6 4 6C2.89543 6 2 5.10457 2 4C2 2.89543 2.89543 2 4 2C5.10457 2 6 2.89543 6 4Z"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M6 20C6 21.1046 5.10457 22 4 22C2.89543 22 2 21.1046 2 20C2 18.8954 2.89543 18 4 18C5.10457 18 6 18.8954 6 20Z"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M22 4C22 5.10457 21.1046 6 20 6C18.8954 6 18 5.10457 18 4C18 2.89543 18.8954 2 20 2C21.1046 2 22 2.89543 22 4Z"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M22 20C22 21.1046 21.1046 22 20 22C18.8954 22 18 21.1046 18 20C18 18.8954 18.8954 18 20 18C21.1046 18 22 18.8954 22 20Z"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M6 20H18"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M18 4H6"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M20 18L20 6"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M4 6L4 18"/>
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SurveyIcon.Eraser" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Canvas Width="24" Height="24">
                <Canvas.RenderTransform>
                    <RotateTransform Angle="225" CenterX="12" CenterY="12"/>
                </Canvas.RenderTransform>
                <Rectangle Style="{StaticResource SurveyIconStroke}" Canvas.Left="7" Canvas.Top="4" Width="10" Height="16" RadiusX="2" RadiusY="2"/>
                <Path Style="{StaticResource SurveyIconStroke}" Data="M7,10 L17,10"/>
            </Canvas>
        </Canvas>
    </Viewbox>

    <!-- Survey src/Icons.jsx `text`. Its group transform translate(12 12) scale(1.2)
         translate(-12 -12) was missing here, so the serif T rendered 20% small. -->
    <Viewbox x:Key="SurveyIcon.Text" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Canvas Width="24" Height="24">
                <Canvas.RenderTransform>
                    <ScaleTransform ScaleX="1.2" ScaleY="1.2" CenterX="12" CenterY="12"/>
                </Canvas.RenderTransform>
                <Path Style="{StaticResource SurveyIconStroke}" Data="M4,7 L4,4 L20,4 L20,7"/>
                <Path Style="{StaticResource SurveyIconStroke}" Data="M9,20 L15,20"/>
                <Path Style="{StaticResource SurveyIconStroke}" Data="M12,4 L12,20"/>
            </Canvas>
        </Canvas>
    </Viewbox>

    <!-- Survey src/assets/icons/callout-arrow-outline.svg, verbatim. That file's owner rule:
         nothing inside the bubble — no underscore, no "T" — so the two inner lines this
         used to carry are gone, and the leader is a 5-unit, 90-degree open arrowhead. -->
    <Viewbox x:Key="SurveyIcon.Callout" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Rectangle Style="{StaticResource SurveyIconStroke}" Canvas.Left="6.75" Canvas.Top="2.95" Width="14.5" Height="11" RadiusX="2.5" RadiusY="2.5"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M9.6 13.95 2.95 21.05"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M7.95 20.89 2.95 21.05 2.79 16.05"/>
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SurveyIcon.Rect" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Rectangle Style="{StaticResource SurveyIconStroke}" Canvas.Left="3" Canvas.Top="3" Width="18" Height="18" RadiusX="2" RadiusY="2"/>
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SurveyIcon.FilledRect" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Rectangle Style="{StaticResource SurveyIconFill}"
                       Canvas.Left="3" Canvas.Top="3" Width="18" Height="18" RadiusX="2" RadiusY="2"/>
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SurveyIcon.Ellipse" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Ellipse Style="{StaticResource SurveyIconStroke}" Canvas.Left="2" Canvas.Top="2" Width="20" Height="20"/>
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SurveyIcon.Line" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}" Data="M5,19 L19,5"/>
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SurveyIcon.Arrow" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}" Data="M5,19 L19,5"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M12,5 H19 V12"/>
        </Canvas>
    </Viewbox>

    <!-- Survey src/assets/icons/counter-outline.svg, verbatim. All geometry now, no TextBlock:
         a font glyph in an icon neither scales nor recolours with the rest of the set.
         The ring is the Ellipse glyph's exact circle (12,12 r10) so the two read as
         siblings, and it stays hollow when selected (owner rule). The numeral is 2.0, not
         1.5 — the optical sizing rule for a small form — and its stem sits 0.7 right of the
         ring centre on purpose: the eye reads a "1" by its stem, so that is what centred
         looks like. -->
    <Viewbox x:Key="SurveyIcon.Counter" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Ellipse Style="{StaticResource SurveyIconStroke}" Canvas.Left="2" Canvas.Top="2" Width="20" Height="20"/>
            <Path Style="{StaticResource SurveyIconStroke}" StrokeThickness="2" Data="M10.7 9.5 12.7 7.6V16.4"/>
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SurveyIcon.Undo" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Canvas Width="24" Height="24">
                <Canvas.RenderTransform>
                    <RotateTransform Angle="180" CenterX="12" CenterY="12"/>
                </Canvas.RenderTransform>
                <Path Style="{StaticResource SurveyIconStroke}" Data="M15,14 H10 C6.68629,14 4,11.3137 4,8 C4,4.68629 6.68629,2 10,2 H15"/>
                <Path Style="{StaticResource SurveyIconStroke}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Data="M15,14 V19 L21,14 L15,9 V14 Z"/>
            </Canvas>
        </Canvas>
    </Viewbox>

    <!-- Survey's redo button wraps this in rotate(180deg) scaleX(-1): a vertical flip. -->
    <Viewbox x:Key="SurveyIcon.Redo" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Canvas Width="24" Height="24">
                <Canvas.RenderTransform>
                    <ScaleTransform ScaleY="-1" CenterX="12" CenterY="12"/>
                </Canvas.RenderTransform>
                <Path Style="{StaticResource SurveyIconStroke}" Data="M15,14 H10 C6.68629,14 4,11.3137 4,8 C4,4.68629 6.68629,2 10,2 H15"/>
                <Path Style="{StaticResource SurveyIconStroke}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Data="M15,14 V19 L21,14 L15,9 V14 Z"/>
            </Canvas>
        </Canvas>
    </Viewbox>

    <!-- Pipette: a bulb head with a squeezed neck and a drip tip. The old outline was a
         thin diagonal with a tiny cap, which read as a second Pen at 18px. -->
    <Viewbox x:Key="SurveyIcon.Eyedropper" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <!-- bulb -->
            <Path Style="{StaticResource SurveyIconStroke}"
                  Data="M14.6,2.9 a3,3 0 0 1 4.3,4.2 l-2,2 1.1,1.1 a1.6,1.6 0 0 1 0,2.3 l-0.6,0.6 a1.6,1.6 0 0 1 -2.3,0 L9.7,8.6 a1.6,1.6 0 0 1 0,-2.3 l0.6,-0.6 a1.6,1.6 0 0 1 2.3,0 l1.1,1.1 Z"/>
            <!-- stem down to the tip, with the drip -->
            <Path Style="{StaticResource SurveyIconStroke}" Data="M11.6,10.5 L4.6,17.5 3.5,21.2 7.2,20.1 14.2,13.1"/>
        </Canvas>
    </Viewbox>

    <!-- Effects group: svgrepo.com/svg/525418/magic-stick-3 (Isaiah's pick). -->
    <Viewbox x:Key="SurveyIcon.Effects" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconFill}" Data="M3.84453 3.84453C2.71849 4.97056 2.71849 6.79623 3.84453 7.92226L5.43227 9.51C5.44419 9.49622 5.45669 9.48276 5.46978 9.46967L9.46978 5.46967C9.48284 5.45662 9.49625 5.44415 9.50999 5.43226L7.92226 3.84453C6.79623 2.71849 4.97056 2.71849 3.84453 3.84453Z"/>
            <Path Style="{StaticResource SurveyIconFill}" Data="M10.5679 6.49012C10.556 6.50386 10.5435 6.51728 10.5304 6.53033L6.53044 10.5303C6.51735 10.5434 6.5039 10.5559 6.49011 10.5678L16.0777 20.1555C17.2038 21.2815 19.0294 21.2815 20.1555 20.1555C21.2815 19.0294 21.2815 17.2038 20.1555 16.0777L10.5679 6.49012Z"/>
            <Path Style="{StaticResource SurveyIconFill}" Data="M16.1 2.30719C16.261 1.8976 16.8385 1.8976 16.9994 2.30719L17.4298 3.40247C17.479 3.52752 17.5776 3.62651 17.7022 3.67583L18.7934 4.1078C19.2015 4.26934 19.2015 4.849 18.7934 5.01054L17.7022 5.44252C17.5776 5.49184 17.479 5.59082 17.4298 5.71587L16.9995 6.81115C16.8385 7.22074 16.261 7.22074 16.1 6.81116L15.6697 5.71587C15.6205 5.59082 15.5219 5.49184 15.3973 5.44252L14.3061 5.01054C13.898 4.849 13.898 4.26934 14.3061 4.1078L15.3973 3.67583C15.5219 3.62651 15.6205 3.52752 15.6697 3.40247L16.1 2.30719Z"/>
            <Path Style="{StaticResource SurveyIconFill}" Data="M19.9672 9.12945C20.1281 8.71987 20.7057 8.71987 20.8666 9.12945L21.0235 9.5288C21.0727 9.65385 21.1713 9.75284 21.2959 9.80215L21.6937 9.95965C22.1018 10.1212 22.1018 10.7009 21.6937 10.8624L21.2959 11.0199C21.1713 11.0692 21.0727 11.1682 21.0235 11.2932L20.8666 11.6926C20.7057 12.1022 20.1281 12.1022 19.9672 11.6926L19.8103 11.2932C19.7611 11.1682 19.6625 11.0692 19.5379 11.0199L19.14 10.8624C18.732 10.7009 18.732 10.1212 19.14 9.95965L19.5379 9.80215C19.6625 9.75284 19.7611 9.65385 19.8103 9.5288L19.9672 9.12945Z"/>
            <Path Style="{StaticResource SurveyIconFill}" Data="M5.1332 15.3072C5.29414 14.8976 5.87167 14.8976 6.03261 15.3072L6.18953 15.7065C6.23867 15.8316 6.33729 15.9306 6.46188 15.9799L6.85975 16.1374C7.26783 16.2989 7.26783 16.8786 6.85975 17.0401L6.46188 17.1976C6.33729 17.2469 6.23867 17.3459 6.18953 17.471L6.03261 17.8703C5.87167 18.2799 5.29414 18.2799 5.1332 17.8703L4.97628 17.471C4.92714 17.3459 4.82852 17.2469 4.70393 17.1976L4.30606 17.0401C3.89798 16.8786 3.89798 16.2989 4.30606 16.1374L4.70393 15.9799C4.82852 15.9306 4.92714 15.8316 4.97628 15.7065L5.1332 15.3072Z"/>
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SurveyIcon.Blur" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}"
                  Data="M12,3 C12,3 6.5,10.5 6.5,15 A5.5,5.5 0 0 0 17.5,15 C17.5,10.5 12,3 12,3 Z"/>
        </Canvas>
    </Viewbox>

    <!-- Source: Theme/Icons/pixelate.svg -->
    <Viewbox x:Key="SurveyIcon.Pixelate" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Rectangle Style="{StaticResource SurveyIconStroke}" Canvas.Left="3" Canvas.Top="3" Width="5" Height="5"/>
            <Rectangle Style="{StaticResource SurveyIconFill}" Canvas.Left="9.5" Canvas.Top="3" Width="5" Height="5"/>
            <Rectangle Style="{StaticResource SurveyIconStroke}" Canvas.Left="16" Canvas.Top="3" Width="5" Height="5"/>
            <Rectangle Style="{StaticResource SurveyIconFill}" Canvas.Left="3" Canvas.Top="9.5" Width="5" Height="5"/>
            <Rectangle Style="{StaticResource SurveyIconStroke}" Canvas.Left="9.5" Canvas.Top="9.5" Width="5" Height="5"/>
            <Rectangle Style="{StaticResource SurveyIconFill}" Canvas.Left="16" Canvas.Top="9.5" Width="5" Height="5"/>
            <Rectangle Style="{StaticResource SurveyIconStroke}" Canvas.Left="3" Canvas.Top="16" Width="5" Height="5"/>
            <Rectangle Style="{StaticResource SurveyIconFill}" Canvas.Left="9.5" Canvas.Top="16" Width="5" Height="5"/>
            <Rectangle Style="{StaticResource SurveyIconStroke}" Canvas.Left="16" Canvas.Top="16" Width="5" Height="5"/>
        </Canvas>
    </Viewbox>

    <!-- Source: Theme/Icons/select-all-svgrepo-com.svg (Timothée Giet / SVG Repo, CC BY-SA 4.0) -->
    <!-- Focus corners around a lit centre. The old glyph was a dashed ring on a 16-grid
         nudged into place with a huge translate, and read as a marquee, not a spotlight. -->
    <Viewbox x:Key="SurveyIcon.Spotlight" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}"
                  Data="M3.5,8.5 V5.5 a2,2 0 0 1 2,-2 h3 M15.5,3.5 h3 a2,2 0 0 1 2,2 v3 M20.5,15.5 v3 a2,2 0 0 1 -2,2 h-3 M8.5,20.5 h-3 a2,2 0 0 1 -2,-2 v-3"/>
            <Ellipse Style="{StaticResource SurveyIconFill}"
                     Canvas.Left="8.4" Canvas.Top="8.4" Width="7.2" Height="7.2"/>
        </Canvas>
    </Viewbox>
    <Viewbox x:Key="SurveyIcon.More" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
