<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Survey src/Icons.jsx annotation glyphs, ported as WPF geometry.
         Stroke/fill bind to the parent control Foreground so the blue-selected
         state (white glyph) works. x:Shared=False because each button needs
         its own visual tree. -->

    <Style x:Key="SurveyIconStroke" TargetType="Shape">
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Fill" Value="Transparent"/>
    </Style>
    <Style x:Key="SurveyIconFill" TargetType="Shape">
        <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
        <Setter Property="Stroke" Value="{x:Null}"/>
    </Style>

    <Viewbox x:Key="SurveyIcon.Cursor" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}" Data="M3,3 L10.07,19.97 L12.58,12.58 L19.97,10.07 Z"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M13,13 L19,19"/>
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SurveyIcon.Pen" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconFill}"
                  Data="M.75,17.5A.751.751,0,0,1,0,16.75V12.569a.755.755,0,0,1,.22-.53L11.461.8a2.72,2.72,0,0,1,3.848,0L16.7,2.191a2.72,2.72,0,0,1,0,3.848L5.462,17.28a.747.747,0,0,1-.531.22ZM1.5,12.879V16h3.12l7.91-7.91L9.41,4.97ZM13.591,7.03l2.051-2.051a1.223,1.223,0,0,0,0-1.727L14.249,1.858a1.222,1.222,0,0,0-1.727,0L10.47,3.91Z">
                <Path.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform X="3.25" Y="3.25"/>
                        <ScaleTransform ScaleY="-1" CenterX="12" CenterY="12"/>
                        <RotateTransform Angle="270" CenterX="12" CenterY="12"/>
                        <TranslateTransform Y="-0.3"/>
                    </TransformGroup>
                </Path.RenderTransform>
            </Path>
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SurveyIcon.Pan" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}" Data="M5,9 L2,12 L5,15 M9,5 L12,2 L15,5 M19,9 L22,12 L19,15 M9,19 L12,22 L15,19"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M2,12 H22 M12,2 V22"/>
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SurveyIcon.Highlighter" x:Shared="False" Width="18" Height="18">
        <Rectangle Width="24" Height="24" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="pack://application:,,,/WinShot;component/Theme/Icons/survey-highlighter-mask.png" Stretch="Uniform"/>
            </Rectangle.OpacityMask>
        </Rectangle>
    </Viewbox>

    <Viewbox x:Key="SurveyIcon.Eraser" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Canvas Width="24" Height="24">
                <Canvas.RenderTransform>
                    <RotateTransform Angle="225" CenterX="12" CenterY="12"/>
                </Canvas.RenderTransform>
                <Rectangle Style="{StaticResource SurveyIconStroke}" Canvas.Left="7" Canvas.Top="4" Width="10" Height="16" RadiusX="2" RadiusY="2"/>
                <Path Style="{StaticResource SurveyIconStroke}" Data="M7,10 L17,10"/>
            </Canvas>
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SurveyIcon.Text" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}" Data="M4,7 L4,4 L20,4 L20,7"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M9,20 L15,20"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M12,4 L12,20"/>
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SurveyIcon.Callout" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}" Data="M20,4 H4 C2.9,4 2,4.9 2,6 V18 C2,19.1 2.9,20 4,20 H18 L22,24 V6 C22,4.9 21.1,4 20,4 Z"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M7,12 H17"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M7,8 H13"/>
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SurveyIcon.Rect" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Rectangle Style="{StaticResource SurveyIconStroke}" Canvas.Left="3" Canvas.Top="3" Width="18" Height="18" RadiusX="2" RadiusY="2"/>
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SurveyIcon.FilledRect" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Rectangle Style="{StaticResource SurveyIconFill}"
                       Canvas.Left="3" Canvas.Top="3" Width="18" Height="18" RadiusX="2" RadiusY="2"/>
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SurveyIcon.Ellipse" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Ellipse Style="{StaticResource SurveyIconStroke}" Canvas.Left="2" Canvas.Top="2" Width="20" Height="20"/>
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SurveyIcon.Line" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}" Data="M5,19 L19,5"/>
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SurveyIcon.Arrow" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}" Data="M5,19 L19,5"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M12,5 H19 V12"/>
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SurveyIcon.Counter" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Ellipse Style="{StaticResource SurveyIconStroke}" Canvas.Left="5" Canvas.Top="3" Width="16" Height="16"/>
            <TextBlock Canvas.Left="5" Canvas.Top="3" Width="16" Height="16" Text="1" FontSize="10" FontWeight="Bold"
                       TextAlignment="Center" Padding="0,1,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SurveyIcon.Undo" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Canvas Width="24" Height="24">
                <Canvas.RenderTransform>
                    <ScaleTransform ScaleY="-1" CenterX="12" CenterY="12"/>
                </Canvas.RenderTransform>
                <Path Style="{StaticResource SurveyIconStroke}" Data="M9,14 H14 C17.3137,14 20,11.3137 20,8 C20,4.68629 17.3137,2 14,2 H9"/>
                <Path Style="{StaticResource SurveyIconStroke}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Data="M9,14 V19 L3,14 L9,9 V14 Z"/>
            </Canvas>
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SurveyIcon.Redo" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}" Data="M15,14 H10 C6.68629,14 4,11.3137 4,8 C4,4.68629 6.68629,2 10,2 H15"/>
            <Path Style="{StaticResource SurveyIconStroke}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Data="M15,14 V19 L21,14 L15,9 V14 Z"/>
        </Canvas>
    </Viewbox>

    <!-- Pipette: a bulb head with a squeezed neck and a drip tip. The old outline was a
         thin diagonal with a tiny cap, which read as a second Pen at 18px. -->
    <Viewbox x:Key="SurveyIcon.Eyedropper" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <!-- bulb -->
            <Path Style="{StaticResource SurveyIconStroke}"
                  Data="M14.6,2.9 a3,3 0 0 1 4.3,4.2 l-2,2 1.1,1.1 a1.6,1.6 0 0 1 0,2.3 l-0.6,0.6 a1.6,1.6 0 0 1 -2.3,0 L9.7,8.6 a1.6,1.6 0 0 1 0,-2.3 l0.6,-0.6 a1.6,1.6 0 0 1 2.3,0 l1.1,1.1 Z"/>
            <!-- stem down to the tip, with the drip -->
            <Path Style="{StaticResource SurveyIconStroke}" Data="M11.6,10.5 L4.6,17.5 3.5,21.2 7.2,20.1 14.2,13.1"/>
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SurveyIcon.Blur" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}"
                  Data="M12,3 C12,3 6.5,10.5 6.5,15 A5.5,5.5 0 0 0 17.5,15 C17.5,10.5 12,3 12,3 Z"/>
        </Canvas>
    </Viewbox>

    <!-- Source: Theme/Icons/pixelate.svg -->
    <Viewbox x:Key="SurveyIcon.Pixelate" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Rectangle Style="{StaticResource SurveyIconStroke}" Canvas.Left="3" Canvas.Top="3" Width="5" Height="5"/>
            <Rectangle Style="{StaticResource SurveyIconFill}" Canvas.Left="9.5" Canvas.Top="3" Width="5" Height="5"/>
            <Rectangle Style="{StaticResource SurveyIconStroke}" Canvas.Left="16" Canvas.Top="3" Width="5" Height="5"/>
            <Rectangle Style="{StaticResource SurveyIconFill}" Canvas.Left="3" Canvas.Top="9.5" Width="5" Height="5"/>
            <Rectangle Style="{StaticResource SurveyIconStroke}" Canvas.Left="9.5" Canvas.Top="9.5" Width="5" Height="5"/>
            <Rectangle Style="{StaticResource SurveyIconFill}" Canvas.Left="16" Canvas.Top="9.5" Width="5" Height="5"/>
            <Rectangle Style="{StaticResource SurveyIconStroke}" Canvas.Left="3" Canvas.Top="16" Width="5" Height="5"/>
            <Rectangle Style="{StaticResource SurveyIconFill}" Canvas.Left="9.5" Canvas.Top="16" Width="5" Height="5"/>
            <Rectangle Style="{StaticResource SurveyIconStroke}" Canvas.Left="16" Canvas.Top="16" Width="5" Height="5"/>
        </Canvas>
    </Viewbox>

    <!-- Source: Theme/Icons/select-all-svgrepo-com.svg (Timothée Giet / SVG Repo, CC BY-SA 4.0) -->
    <!-- Focus corners around a lit centre. The old glyph was a dashed ring on a 16-grid
         nudged into place with a huge translate, and read as a marquee, not a spotlight. -->
    <Viewbox x:Key="SurveyIcon.Spotlight" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}"
                  Data="M3.5,8.5 V5.5 a2,2 0 0 1 2,-2 h3 M15.5,3.5 h3 a2,2 0 0 1 2,2 v3 M20.5,15.5 v3 a2,2 0 0 1 -2,2 h-3 M8.5,20.5 h-3 a2,2 0 0 1 -2,-2 v-3"/>
            <Ellipse Style="{StaticResource SurveyIconFill}"
                     Canvas.Left="8.4" Canvas.Top="8.4" Width="7.2" Height="7.2"/>
        </Canvas>
    </Viewbox>
    <Viewbox x:Key="SurveyIcon.More" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Ellipse Style="{StaticResource SurveyIconFill}" Canvas.Left="10.5" Canvas.Top="3.5" Width="3" Height="3"/>
            <Ellipse Style="{StaticResource SurveyIconFill}" Canvas.Left="10.5" Canvas.Top="10.5" Width="3" Height="3"/>
            <Ellipse Style="{StaticResource SurveyIconFill}" Canvas.Left="10.5" Canvas.Top="17.5" Width="3" Height="3"/>
        </Canvas>
    </Viewbox>
    <Viewbox x:Key="SurveyIcon.Rotate" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}" Data="M1,4 V10 H7"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M23,20 V14 H17"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M20.49,9 C19.7967,7.04557 18.4615,5.36328 16.6618,4.21405 C14.8621,3.06482 12.6915,2.51013 10.5,2.63024 C8.30846,2.75035 6.19479,3.53998 4.5,4.9 M3.51,15 C4.20334,16.9544 5.53847,18.6367 7.33818,19.786 C9.13789,20.9352 11.3085,21.4899 13.5,21.3698 C15.6915,21.2496 17.8052,20.46 19.5,19.1"/>
        </Canvas>
    </Viewbox>
    <Viewbox x:Key="SurveyIcon.FlipH" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}" Data="M8,3 H3 C2.44772,3 2,3.44772 2,4 V20 C2,20.5523 2.44772,21 3,21 H8"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M16,3 H21 C21.5523,3 22,3.44772 22,4 V20 C22,20.5523 21.5523,21 21,21 H16"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M12,2 V22"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M8,7 L12,3 L16,7"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M8,17 L12,21 L16,17"/>
        </Canvas>
    </Viewbox>
    <Viewbox x:Key="SurveyIcon.FlipV" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}" Data="M3,8 V3 C3,2.44772 3.44772,2 4,2 H20 C20.5523,2 21,2.44772 21,3 V8"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M3,16 V21 C3,21.5523 3.44772,22 4,22 H20 C20.5523,22 21,21.5523 21,21 V16"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M2,12 H22"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M7,8 L3,12 L7,16"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M17,8 L21,12 L17,16"/>
        </Canvas>
    </Viewbox>
    <Viewbox x:Key="SurveyIcon.Plus" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}" Data="M12,5 V19"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M5,12 H19"/>
        </Canvas>
    </Viewbox>
    <Viewbox x:Key="SurveyIcon.Minus" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}" Data="M5,12 H19"/>
        </Canvas>
    </Viewbox>
    <Viewbox x:Key="SurveyIcon.ChevronDown" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}" Data="M6,9 L12,15 L18,9"/>
        </Canvas>
    </Viewbox>
    <Viewbox x:Key="SurveyIcon.ChevronUp" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}" Data="M18,15 L12,9 L6,15"/>
        </Canvas>
    </Viewbox>
    <Viewbox x:Key="SurveyIcon.Download" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource SurveyIconStroke}" Data="M21,15 V19 C21,19.5304 20.7893,20.0391 20.4142,20.4142 C20.0391,20.7893 19.5304,21 19,21 H5 C4.46957,21 3.96086,20.7893 3.58579,20.4142 C3.21071,20.0391 3,19.5304 3,19 V15"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M7,10 L12,15 L17,10"/>
            <Path Style="{StaticResource SurveyIconStroke}" Data="M12,15 V3"/>
        </Canvas>
    </Viewbox>
    <Viewbox x:Key="SurveyIcon.FitPage" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Rectangle Style="{StaticResource SurveyIconStroke}" StrokeThickness="1.7" Canvas.Left="6" Canvas.Top="3" Width="12" Height="18" RadiusX="1.5" RadiusY="1.5"/>
            <Path Style="{StaticResource SurveyIconStroke}" StrokeThickness="1.7" Data="M9,7 H15 M9,11 H15 M9,15 H13"/>
        </Canvas>
    </Viewbox>
    <Viewbox x:Key="SurveyIcon.FitWidth" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Rectangle Style="{StaticResource SurveyIconStroke}" StrokeThickness="1.7" Canvas.Left="4" Canvas.Top="5" Width="16" Height="14" RadiusX="1.5" RadiusY="1.5"/>
            <Path Style="{StaticResource SurveyIconStroke}" StrokeThickness="1.7" Data="M7,12 H17 M7,12 L10,9 M7,12 L10,15 M17,12 L14,9 M17,12 L14,15"/>
        </Canvas>
    </Viewbox>
    <Viewbox x:Key="SurveyIcon.FitHeight" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Rectangle Style="{StaticResource SurveyIconStroke}" StrokeThickness="1.7" Canvas.Left="5" Canvas.Top="4" Width="14" Height="16" RadiusX="1.5" RadiusY="1.5"/>
            <Path Style="{StaticResource SurveyIconStroke}" StrokeThickness="1.7" Data="M12,7 V17 M12,7 L9,10 M12,7 L15,10 M12,17 L9,14 M12,17 L15,14"/>
        </Canvas>
    </Viewbox>
</ResourceDictionary>
