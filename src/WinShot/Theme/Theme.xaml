<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ====================================================================
         WinShot Theme — CleanShot-X-inspired dark Win11 design system
         ====================================================================
         Single source of truth. Merge into App.xaml (see UI-SPEC.md).
         All windows reference these keys instead of inline literals.

         NAMING
           Color keys  : *Color   (raw Color, for animation/derivation)
           Brush keys  : *Brush   (SolidColorBrush, what styles consume)
           Style keys  : PascalCase semantic role
           Radius/size : numeric tokens as *Radius / *Thickness / sys:Double

         Glyph icons use "Segoe Fluent Icons" (Win11) with fallback to
         "Segoe MDL2 Assets" (Win10). Glyph codepoints live in the XAML that
         consumes ToolButton/CircleActionButton — see UI-SPEC.md for the map.
         ==================================================================== -->

    <!-- ============================ PALETTE ============================ -->
    <!-- "White acts, blue states, gray chrome" (design_handoff_ui_refresh). -->
    <!-- Surfaces (opaque gray chrome scale) -->
    <Color x:Key="WindowBgColor">#FF1C1C1E</Color>      <!-- deepest: window backdrop -->
    <Color x:Key="ToolbarBgColor">#FF262628</Color>     <!-- toolbar / HUD opaque fallback -->
    <Color x:Key="SurfaceColor">#FF2E2E30</Color>       <!-- legacy raised control surface -->
    <Color x:Key="SurfaceAltColor">#FF38383B</Color>    <!-- alt surface -->
    <Color x:Key="ElevatedColor">#FF323236</Color>      <!-- popups / flyouts -->
    <Color x:Key="SurfaceHoverColor">#FF45454A</Color>  <!-- hover / segmented-selected -->
    <Color x:Key="CardGroupColor">#FF232326</Color>     <!-- settings/dialog card groups -->
    <Color x:Key="ContextBarColor">#FF1F1F22</Color>    <!-- editor context row -->
    <Color x:Key="SidebarColor">#FF19191B</Color>       <!-- sidebar / statusbar -->
    <Color x:Key="CanvasColor">#FF141416</Color>        <!-- canvas desk behind captures -->

    <!-- Translucent floating-surface base (acrylic recipe fallback ~.94) -->
    <Color x:Key="FloatingBgColor">#F0262628</Color>

    <!-- Blue is STATE only (toggles ON, checks, slider fills, trim handles,
         selected chips). NEVER an action fill; actions are white (Action*). -->
    <Color x:Key="AccentColor">#FF2E6FC1</Color>
    <Color x:Key="AccentHoverColor">#FF3A7DD1</Color>
    <Color x:Key="AccentPressedColor">#FF275FA6</Color>
    <Color x:Key="BrandBlueColor">#FF0A84FF</Color>      <!-- app identity dot/icon only -->

    <!-- Selected-tint surfaces + selection rings + links -->
    <Color x:Key="SelectedTintBgColor">#402E6FC1</Color>
    <Color x:Key="SelectedTintBorderColor">#594E94E0</Color>
    <Color x:Key="SelectedTintTextColor">#FF9CC7FF</Color>
    <Color x:Key="SelectionRingColor">#B24E94E0</Color>
    <Color x:Key="LinkColor">#FF7FB0E8</Color>

    <!-- White action buttons — the only strong fill (Save/Stop/Done/Start/Edit/Export) -->
    <Color x:Key="ActionBgColor">#FFF2F2F4</Color>
    <Color x:Key="ActionBgHoverColor">#FFFFFFFF</Color>
    <Color x:Key="ActionTextColor">#FF111111</Color>

    <!-- Semantic info/heading (legacy; prefer LinkColor for new work) -->
    <Color x:Key="InfoColor">#FF7FB0E8</Color>

    <!-- Reds: annotation stroke + recording dot share #FF5252; destructive confirm
         is the only solid #C9403F; error/danger are tints. Paused is amber. -->
    <Color x:Key="AnnotationRedColor">#FFFF5252</Color>
    <Color x:Key="DestructiveColor">#FFC9403F</Color>
    <Color x:Key="RecordingRedColor">#FFFF5252</Color>
    <Color x:Key="PausedAmberColor">#FFFFB020</Color>
    <Color x:Key="ErrorBorderColor">#8CE85C5C</Color>
    <Color x:Key="ErrorTextColor">#FFE88585</Color>
    <Color x:Key="DangerTintBgColor">#24E85C5C</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#FFF2F2F4</Color>
    <Color x:Key="TextSecondaryColor">#FFB8B8BC</Color>
    <Color x:Key="TextMutedColor">#FF8A8A90</Color>      <!-- labels / captions / hints -->
    <Color x:Key="TextDisabledColor">#66FFFFFF</Color>

    <!-- Interaction fills (white-alpha ladder: ghost .08, pressed/secondary-hover .14) -->
    <Color x:Key="HoverFillColor">#14FFFFFF</Color>
    <Color x:Key="PressedFillColor">#24FFFFFF</Color>
    <Color x:Key="SecondaryBtnBgColor">#17FFFFFF</Color> <!-- secondary button .09 -->
    <Color x:Key="InputBgColor">#0FFFFFFF</Color>        <!-- inputs / combos .06 -->

    <!-- Hairlines: row dividers .06 · card borders .08 · control borders .14 · edge-light .2 -->
    <Color x:Key="DividerColor">#0FFFFFFF</Color>
    <Color x:Key="CardBorderColor">#14FFFFFF</Color>
    <Color x:Key="BorderColor">#24FFFFFF</Color>
    <Color x:Key="BorderStrongColor">#33FFFFFF</Color>
    <Color x:Key="TopHighlightColor">#33FFFFFF</Color>   <!-- acrylic top edge-light .2 -->

    <!-- Toggle OFF -->
    <Color x:Key="ToggleOffColor">#24FFFFFF</Color>
    <Color x:Key="ToggleKnobOffColor">#FF8A8A90</Color>

    <!-- ============================ BRUSHES ============================ -->
    <SolidColorBrush x:Key="WindowBgBrush"     Color="{StaticResource WindowBgColor}"/>
    <SolidColorBrush x:Key="ToolbarBgBrush"    Color="{StaticResource ToolbarBgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush"      Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush"   Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="ElevatedBrush"     Color="{StaticResource ElevatedColor}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>
    <SolidColorBrush x:Key="CardGroupBrush"    Color="{StaticResource CardGroupColor}"/>
    <SolidColorBrush x:Key="ContextBarBrush"   Color="{StaticResource ContextBarColor}"/>
    <SolidColorBrush x:Key="SidebarBrush"      Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="CanvasBrush"       Color="{StaticResource CanvasColor}"/>
    <SolidColorBrush x:Key="FloatingBgBrush"   Color="{StaticResource FloatingBgColor}"/>

    <SolidColorBrush x:Key="AccentBrush"        Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush"   Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}"/>
    <SolidColorBrush x:Key="BrandBlueBrush"     Color="{StaticResource BrandBlueColor}"/>
    <SolidColorBrush x:Key="SelectedTintBgBrush"     Color="{StaticResource SelectedTintBgColor}"/>
    <SolidColorBrush x:Key="SelectedTintBorderBrush" Color="{StaticResource SelectedTintBorderColor}"/>
    <SolidColorBrush x:Key="SelectedTintTextBrush"   Color="{StaticResource SelectedTintTextColor}"/>
    <SolidColorBrush x:Key="SelectionRingBrush" Color="{StaticResource SelectionRingColor}"/>
    <SolidColorBrush x:Key="LinkBrush"          Color="{StaticResource LinkColor}"/>
    <SolidColorBrush x:Key="ActionBgBrush"      Color="{StaticResource ActionBgColor}"/>
    <SolidColorBrush x:Key="ActionBgHoverBrush" Color="{StaticResource ActionBgHoverColor}"/>
    <SolidColorBrush x:Key="ActionTextBrush"    Color="{StaticResource ActionTextColor}"/>
    <SolidColorBrush x:Key="InfoBrush"          Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="AnnotationRedBrush" Color="{StaticResource AnnotationRedColor}"/>
    <SolidColorBrush x:Key="DestructiveBrush"   Color="{StaticResource DestructiveColor}"/>
    <SolidColorBrush x:Key="RecordingRedBrush"  Color="{StaticResource RecordingRedColor}"/>
    <SolidColorBrush x:Key="PausedAmberBrush"   Color="{StaticResource PausedAmberColor}"/>
    <SolidColorBrush x:Key="ErrorBorderBrush"   Color="{StaticResource ErrorBorderColor}"/>
    <SolidColorBrush x:Key="ErrorTextBrush"     Color="{StaticResource ErrorTextColor}"/>
    <SolidColorBrush x:Key="DangerTintBgBrush"  Color="{StaticResource DangerTintBgColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush"     Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush"  Color="{StaticResource TextDisabledColor}"/>

    <SolidColorBrush x:Key="HoverFillBrush"     Color="{StaticResource HoverFillColor}"/>
    <SolidColorBrush x:Key="PressedFillBrush"   Color="{StaticResource PressedFillColor}"/>
    <SolidColorBrush x:Key="SecondaryBtnBgBrush" Color="{StaticResource SecondaryBtnBgColor}"/>
    <SolidColorBrush x:Key="InputBgBrush"       Color="{StaticResource InputBgColor}"/>

    <SolidColorBrush x:Key="DividerBrush"       Color="{StaticResource DividerColor}"/>
    <SolidColorBrush x:Key="CardBorderBrush"    Color="{StaticResource CardBorderColor}"/>
    <SolidColorBrush x:Key="BorderBrush"        Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderStrongBrush"  Color="{StaticResource BorderStrongColor}"/>
    <SolidColorBrush x:Key="TopHighlightBrush"  Color="{StaticResource TopHighlightColor}"/>

    <SolidColorBrush x:Key="ToggleOffBrush"     Color="{StaticResource ToggleOffColor}"/>
    <SolidColorBrush x:Key="ToggleKnobOffBrush" Color="{StaticResource ToggleKnobOffColor}"/>

    <!-- ===================== TOKENS (radii / sizes) ==================== -->
    <CornerRadius x:Key="RadiusButton">8</CornerRadius>
    <CornerRadius x:Key="RadiusCard">12</CornerRadius>
    <CornerRadius x:Key="RadiusCardGroup">10</CornerRadius>
    <CornerRadius x:Key="RadiusInput">7</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius> <!-- clamped to height/2 by WPF -->

    <sys:Double x:Key="ToolButtonSize">32</sys:Double>
    <sys:Double x:Key="ToolGlyphSize">15</sys:Double>
    <sys:Double x:Key="CircleActionSize">30</sys:Double>
    <sys:Double x:Key="CircleGlyphSize">14</sys:Double>
    <sys:Double x:Key="PillHeight">30</sys:Double>

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Bundled UI fonts (pack-resource TTFs in Assets/Fonts). Manrope for all UI
         text; JetBrains Mono for timers, dimensions, hotkeys, filenames, counts.
         DarkTitleBar.Apply sets UiFontFamily as every themed window's default. -->
    <FontFamily x:Key="UiFontFamily">/WinShot;component/Assets/Fonts/#Manrope, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">/WinShot;component/Assets/Fonts/#JetBrains Mono, Consolas</FontFamily>

    <!-- ==================== LUCIDE ICON GEOMETRIES =====================
         24×24 viewBox path data, drawn as stroked Paths (1.85, round caps/
         joins) via the LucideIcon style. Shared icons only; single-use path
         data stays inline in the consuming XAML. -->
    <Geometry x:Key="LucideX">M6,6 L18,18 M18,6 L6,18</Geometry>
    <Geometry x:Key="LucideChevronDown">M6,9 L12,15 L18,9</Geometry>
    <Geometry x:Key="LucideCopy">M8,8 L17,8 A2,2 0 0 1 19,10 L19,17 A2,2 0 0 1 17,19 L10,19 A2,2 0 0 1 8,17 Z M16,8 L16,6 A2,2 0 0 0 14,4 L6,4 A2,2 0 0 0 4,6 L4,14 A2,2 0 0 0 6,16 L8,16</Geometry>
    <Geometry x:Key="LucidePencil">M4,20 L8.5,19 L19,8.5 L15.5,5 L5,15.5 L4,20 Z M13.5,7 L17,10.5</Geometry>
    <Geometry x:Key="LucideUndo">M9,14 L4,9 L9,4 M4,9 L14,9 A6,6 0 0 1 14,21 L11,21</Geometry>
    <Geometry x:Key="LucideRedo">M15,14 L20,9 L15,4 M20,9 L10,9 A6,6 0 0 0 10,21 L13,21</Geometry>
    <Geometry x:Key="LucideCheck">M4,12.5 L9.5,18 L20,6.5</Geometry>
    <Geometry x:Key="LucidePlus">M12,5 L12,19 M5,12 L19,12</Geometry>
    <Geometry x:Key="LucideArrowDown">M12,5 L12,19 M6,13 L12,19 L18,13</Geometry>
    <Geometry x:Key="LucidePlay">M7,4 L20,12 L7,20 Z</Geometry>
    <Geometry x:Key="LucidePause">M7,5 L7,19 M17,5 L17,19</Geometry>

    <!-- Stroke icon style: set Data + Width/Height at the use site; Stroke
         defaults to the current text color of the parent via inheritance-free
         fallback (secondary). Override Stroke when the state demands it. -->
    <Style x:Key="LucideIcon" TargetType="Path">
        <Setter Property="Stroke" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="StrokeThickness" Value="1.55"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Fill" Value="{x:Null}"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="SnapsToDevicePixels" Value="False"/>
        <Setter Property="UseLayoutRounding" Value="False"/>
    </Style>

    <!-- Shared drop shadow for floating surfaces (0 12px 32px -4px rgba(0,0,0,.6)) -->
    <DropShadowEffect x:Key="FloatingShadow" BlurRadius="32" ShadowDepth="12"
                      Direction="270" Opacity="0.60" RenderingBias="Performance"
                      Color="#FF000000"/>

    <!-- ====================================================================
         TOOL BUTTON  — 32px rounded-rect (8px) icon button.
         Usable on ToggleButton AND RadioButton (RadioButton derives from
         ToggleButton, so a ToggleButton-targeted Style applies to both).
         Rest: transparent, secondary glyph. Hover: ghost white .08.
         Checked: blue selected-tint fill + border, #9CC7FF glyph (blue = state).
         Set Content to a glyph; FontFamily is forced to the icon font.
         ==================================================================== -->
    <Style x:Key="ToolButton" TargetType="ToggleButton">
        <Setter Property="Width"  Value="{StaticResource ToolButtonSize}"/>
        <Setter Property="Height" Value="{StaticResource ToolButtonSize}"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="{StaticResource ToolGlyphSize}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="400"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="8"
                                BorderBrush="Transparent" BorderThickness="1"/>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                        <Border x:Name="FocusRing" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="2" CornerRadius="8" Margin="1"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverFillBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource PressedFillBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{StaticResource SelectionRingBrush}"/>
                        </Trigger>
                        <!-- ACTIVE / SELECTED TOOL = blue selected tint, light-blue glyph -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource SelectedTintBgBrush}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource SelectedTintBorderBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource SelectedTintTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A plain (non-toggle) round icon button variant for one-shot actions
         that live in the toolbar (e.g. undo/redo/rotate). Same look at rest. -->
    <Style x:Key="ToolIconButton" TargetType="Button">
        <Setter Property="Width"  Value="{StaticResource ToolButtonSize}"/>
        <Setter Property="Height" Value="{StaticResource ToolButtonSize}"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="{StaticResource ToolGlyphSize}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="8"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                        <Border x:Name="FocusRing" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="2" CornerRadius="8" Margin="1"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverFillBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource PressedFillBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{StaticResource SelectionRingBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================
         PILL BUTTON — PRIMARY (white). The affirmative/commit action
         (Save, Stop, Done, Start, Edit, Export). White is the only strong fill.
         ==================================================================== -->
    <Style x:Key="PillButtonPrimary" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource PillHeight}"/>
        <Setter Property="MinWidth" Value="64"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="Foreground" Value="{StaticResource ActionTextBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{StaticResource ActionBgBrush}"
                            BorderBrush="Transparent" BorderThickness="2"
                            CornerRadius="{StaticResource RadiusButton}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource ActionBgHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource TextSecondaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource SelectionRingBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================
         PILL BUTTON — SECONDARY. White-alpha .09 fill + .14 border (Cancel,
         Browse, Copy to, Open…).
         ==================================================================== -->
    <Style x:Key="PillButtonSecondary" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource PillHeight}"/>
        <Setter Property="MinWidth" Value="64"/>
        <Setter Property="Padding" Value="15,0"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{StaticResource SecondaryBtnBgBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusButton}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource PressedFillBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource BorderStrongBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource SelectionRingBrush}"/>
                            <Setter TargetName="Bg" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- PILL BUTTON — DANGER TINT. Destructive-adjacent action in a toolbar
         (History selection "Delete"): red tint bg + border, soft red text. -->
    <Style x:Key="PillButtonDanger" TargetType="Button" BasedOn="{StaticResource PillButtonSecondary}">
        <Setter Property="Foreground" Value="#F0A3A3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{StaticResource DangerTintBgBrush}"
                            BorderBrush="#59E85C5C" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusButton}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#38E85C5C"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#4DE85C5C"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- PILL BUTTON — DESTRUCTIVE CONFIRM. The ONLY solid red in the app:
         the confirm button of a destructive dialog. -->
    <Style x:Key="PillButtonDestructive" TargetType="Button" BasedOn="{StaticResource PillButtonPrimary}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{StaticResource DestructiveBrush}"
                            BorderBrush="Transparent" BorderThickness="2"
                            CornerRadius="{StaticResource RadiusButton}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#D64E4D"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#B23736"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================
         CIRCLE ACTION BUTTON — round bottom-utility-bar action
         (share / pin / copy / cloud). 34px, monochrome glyph, hover fill.
         ==================================================================== -->
    <Style x:Key="CircleActionButton" TargetType="Button">
        <Setter Property="Width"  Value="{StaticResource CircleActionSize}"/>
        <Setter Property="Height" Value="{StaticResource CircleActionSize}"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="{StaticResource CircleGlyphSize}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="Bg" Fill="{StaticResource SecondaryBtnBgBrush}"/>
                        <Ellipse x:Name="FocusRing" Stroke="{StaticResource BorderBrush}" StrokeThickness="1"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Fill" Value="{StaticResource PressedFillBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Fill" Value="{StaticResource BorderStrongBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Stroke" Value="{StaticResource SelectionRingBrush}"/>
                            <Setter TargetName="FocusRing" Property="StrokeThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================
         FLOATING TOOLBAR CONTAINER — apply to a Border.
         Dark charcoal, 14px corners, padding, soft drop shadow, top highlight.
         Use for the editor's floating top pill and any HUD/overlay card.
         ==================================================================== -->
    <Style x:Key="FloatingToolbar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource FloatingBgBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TopHighlightBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Effect" Value="{StaticResource FloatingShadow}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- BOTTOM UTILITY-BAR CONTAINER — same material, used for the editor's
         bottom bar (zoom dropdown · circular actions). -->
    <Style x:Key="BottomUtilityBar" TargetType="Border" BasedOn="{StaticResource FloatingToolbar}">
        <Setter Property="Padding" Value="8,5"/>
    </Style>

    <!-- A generic raised panel/sidebar surface (background composer left rail). -->
    <Style x:Key="PanelSurface" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ToolbarBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Thin vertical divider for separating tool clusters inside a toolbar.
         Use:  <Rectangle Style="{StaticResource ToolbarDivider}"/> -->
    <Style x:Key="ToolbarDivider" TargetType="Rectangle">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Margin" Value="6,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Fill" Value="{StaticResource BorderBrush}"/>
    </Style>

    <!-- ============================ LABELS ============================ -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Caps section label: 11/600, +.08em tracking, muted. Set Text in CAPS. -->
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,16,0,8"/>
    </Style>
    <Style x:Key="ValueLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ====================================================================
         DARK COMBOBOX — flat, used for the bottom-bar zoom dropdown and any
         settings combo. Single implementation (replaces the two divergent ones).
         ==================================================================== -->
    <!-- Hidden repeat-button used by the editable/non-editable toggle area -->
    <ControlTemplate x:Key="ComboToggleTemplate" TargetType="ToggleButton">
        <Border x:Name="Bg" Background="{StaticResource InputBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusInput}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="22"/>
                </Grid.ColumnDefinitions>
                <!-- Lucide chevron-down stroke, muted -->
                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="M0,0 L4.5,4.5 L9,0" Stroke="{StaticResource TextMutedBrush}"
                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverFillBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource PressedFillBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource SelectedTintBgBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource SelectedTintTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkComboBox" TargetType="ComboBox">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Template="{StaticResource ComboToggleTemplate}"
                                      Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="10,0,24,0"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"
                                          TextElement.Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False"
                               PopupAnimation="Fade">
                            <Border Background="{StaticResource ElevatedBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusInput}"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Margin="0,4,0,0" Padding="4"
                                    Effect="{StaticResource FloatingShadow}">
                                <ScrollViewer MaxHeight="280">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================
         DARK SLIDER — single implementation. Thin track, blue fill, white knob.
         ==================================================================== -->
    <Style x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse Fill="White" Stroke="{StaticResource AccentBrush}" StrokeThickness="0"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkSlider" TargetType="Slider">
        <Setter Property="Height" Value="20"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                Background="{StaticResource ToggleOffBrush}"/>
                        <!-- filled portion: a Track decorator is simplest via two repeat buttons -->
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                    Background="{StaticResource AccentBrush}"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================
         DARK TEXTBOX — single input treatment (replaces the divergent ones).
         ==================================================================== -->
    <Style x:Key="DarkTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bg" Background="{StaticResource InputBgBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusInput}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource SelectionRingBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================
         DARK CHECKBOX — macOS-style; checked = blue fill + white check.
         ==================================================================== -->
    <Style x:Key="DarkCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Border x:Name="Box" CornerRadius="4"
                                    Background="{StaticResource InputBgBrush}"
                                    BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1.5"/>
                            <Path x:Name="Check" Visibility="Collapsed"
                                  Stroke="White" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M3.5,8 L6.5,11.5 L12.5,4.5"/>
                        </Grid>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================
         TOGGLE SWITCH — 36×20 pill CheckBox. ON = blue track + white knob
         (blue is state); OFF = white-alpha track + gray knob.
         ==================================================================== -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="36" Height="20" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="10"
                                    Background="{StaticResource ToggleOffBrush}"
                                    BorderBrush="#1AFFFFFF" BorderThickness="1"/>
                            <Ellipse x:Name="Knob" Width="16" Height="16"
                                     Fill="{StaticResource ToggleKnobOffBrush}"
                                     HorizontalAlignment="Left" Margin="2,0,0,0"/>
                        </Grid>
                        <ContentPresenter x:Name="Label" Margin="10,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="Knob" Property="Fill" Value="White"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/>
                        </Trigger>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Label" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================
         DARK CONTEXT MENU + MENU ITEM — so History's native menus stop
         leaking light Windows chrome. Implicit-style ready; reference by key.
         ==================================================================== -->
    <Style x:Key="DarkContextMenu" TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource FloatingBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10" Padding="5"
                            Effect="{StaticResource FloatingShadow}">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" ContentSource="Header" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}"
                                       FontFamily="{StaticResource MonoFontFamily}" FontSize="10.5"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="20,0,0,0"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverFillBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================
         ANNOTATION COLOR SWATCH — RadioButton; 24px, inner dot = Background,
         selected ring = white, default group color is red (set in markup).
         Reusable for the editor color row and composer plain-color grid.
         ==================================================================== -->
    <Style x:Key="ColorSwatch" TargetType="RadioButton">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Ellipse x:Name="Ring" Stroke="{StaticResource BorderStrongBrush}" StrokeThickness="1.5"/>
                        <Ellipse Width="14" Height="14" Fill="{TemplateBinding Background}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource TextSecondaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="White"/>
                            <Setter TargetName="Ring" Property="StrokeThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource InfoBrush}"/>
                            <Setter TargetName="Ring" Property="StrokeThickness" Value="2.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================
         SLIM SCROLLBAR — thin (8px), rounded thumb, no arrow buttons. Applied
         app-wide so the settings / history scrollers read as a quiet rail
         instead of the chunky default Windows scrollbar.
         ==================================================================== -->
    <Style x:Key="SlimScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Th" CornerRadius="4" Margin="2"
                            Background="{StaticResource BorderStrongBrush}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Th" Property="Background" Value="{StaticResource TextSecondaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SlimScrollThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand"
                                              Style="{StaticResource ScrollPageButton}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand"
                                              Style="{StaticResource ScrollPageButton}"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto"/>
                            <Setter Property="MinWidth" Value="0"/>
                            <Setter Property="Height" Value="8"/>
                            <Setter Property="MinHeight" Value="8"/>
                            <Setter TargetName="PART_Track" Property="Orientation" Value="Horizontal"/>
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
