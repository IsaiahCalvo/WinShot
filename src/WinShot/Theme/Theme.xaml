<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ====================================================================
         WinShot Theme — CleanShot-X-inspired dark Win11 design system
         ====================================================================
         Single source of truth. Merge into App.xaml (see UI-SPEC.md).
         All windows reference these keys instead of inline literals.

         NAMING
           Color keys  : *Color   (raw Color, for animation/derivation)
           Brush keys  : *Brush   (SolidColorBrush, what styles consume)
           Style keys  : PascalCase semantic role
           Radius/size : numeric tokens as *Radius / *Thickness / sys:Double

         Glyph icons use "Segoe Fluent Icons" (Win11) with fallback to
         "Segoe MDL2 Assets" (Win10). Glyph codepoints live in the XAML that
         consumes ToolButton/CircleActionButton — see UI-SPEC.md for the map.
         ==================================================================== -->

    <!-- ============================ PALETTE ============================ -->
    <!-- Surfaces (a disciplined 5-step dark elevation scale) -->
    <Color x:Key="WindowBgColor">#FF1C1C1E</Color>      <!-- deepest: window/canvas backdrop -->
    <Color x:Key="ToolbarBgColor">#FF262628</Color>     <!-- floating toolbar / panel material -->
    <Color x:Key="SurfaceColor">#FF2E2E30</Color>       <!-- raised control surface (secondary pill, combo, slider track-fill region) -->
    <Color x:Key="SurfaceAltColor">#FF38383B</Color>    <!-- inputs / combo toggle / track -->
    <Color x:Key="ElevatedColor">#FF323236</Color>      <!-- popups / flyouts / context menus -->
    <!-- Active-tool chip: dark fill + bright ring. Neutral on purpose (the accent is
         reserved for modes). One filled neutral cannot do this job on its own — clearing
         3:1 (WCAG 1.4.11 for a state indicator) and carrying TextPrimary at 4.5:1 pull in
         opposite directions, and the hover and press washes stack on top of whatever we pick.
         So the FILL stays dark enough for the glyph (10.1:1, and still 8:1 under both washes)
         and the RING carries the state signal on its own.
         The ring is measured against EVERY ground a ToolButton lands on, not just the toolbar:
         four of them live in MoreToolsPopup, which is ElevatedBrush — the lightest ground and
         therefore the worst case. At #70707A the ring read 2.61:1 there, so the selected tool
         in that popup was effectively unmarked. #85858F clears 3:1 on all four grounds
         (Elevated 3.50, Toolbar/Floating 4.14, Window 4.66) and on its own chip fill (3.09),
         and stays brighter than anything a plain hover composites to. -->
    <Color x:Key="ToolChipColor">#FF3A3A40</Color>
    <Color x:Key="ToolChipRingColor">#FF85858F</Color>

    <!-- Translucent floating-surface base (one recipe for ALL overlays) -->
    <Color x:Key="FloatingBgColor">#F5262628</Color>    <!-- ~96% opaque toolbar charcoal -->

    <!-- Accent (single blue identity: active tool, primary action, selection) -->
    <Color x:Key="AccentColor">#FF0A84FF</Color>         <!-- macOS dark-mode system blue -->
    <!-- The same accent, deepened just enough that WHITE text on it clears 4.5:1 (it is
         3.65:1 on AccentColor). Fill of anything that carries a white label; never a
         border, a glyph or an indicator — those stay AccentColor. -->
    <Color x:Key="AccentDeepColor">#FF0A73E0</Color>
    <Color x:Key="AccentPressedColor">#FF0060DF</Color>  <!-- darker blue, pressed of accent -->

    <!-- Semantic info/heading (split out from accent-hover; was overloaded #4DA3FF) -->
    <Color x:Key="InfoColor">#FF6BB1FF</Color>

    <!-- Annotation / destructive red -->
    <Color x:Key="AnnotationRedColor">#FFFF453A</Color>  <!-- default stroke, step counter, record dot, destructive -->
    <!-- Same story as the accent's pressed shade: white on AnnotationRed is 3.4:1, so a destructive button's
         FILL deepens while the stroke/dot colour is untouched. Its hover and press are the
         shared HoverShade/PressedShade dips, NOT a brighter red: lightening the fill under
         white type is exactly the mistake documented below, and #FF6B60 measured 2.79:1 —
         a worse reading, hovered, than the 3.4:1 this deepening was here to fix. -->
    <Color x:Key="RedDeepColor">#FFD42B21</Color>
    <!-- A red that carries TYPE rather than sitting under it (TextErrorBrush). -->
    <Color x:Key="RedHoverColor">#FFFF6B60</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#FFF2F2F4</Color>    <!-- ~95% white -->
    <Color x:Key="TextSecondaryColor">#B3FFFFFF</Color>  <!-- ~70% white, labels/values -->
    <Color x:Key="TextDisabledColor">#66FFFFFF</Color>   <!-- ~40% white: DISABLED controls only (WCAG exempts them) -->
    <!-- Helper text is not disabled text. At 40% white it measured 3.67:1 on the card
         surface; 55% clears 4.5:1 and still reads clearly quieter than TextSecondary. -->
    <Color x:Key="TextHintColor">#8CFFFFFF</Color>

    <!-- Interaction fills. Hover lightens, press DARKENS — the same ladder
         DarkControlPalette.HoverPressLighten uses on the WinForms side (+18 hovering,
         -12 pressed). The templates that own both keep them as separate layers, so a
         press necessarily lands on top of a hover; a second lightening wash made every
         pressed surface the brightest thing on screen and drove the glyph on a checked
         tool button down to 2.56:1. Dipping on press reads as pressed and keeps the
         worst stack (chip + hover + press) at 8.8:1 for text.

         The one exception is a SATURATED fill — the blue pill button — where the wash is
         not a hint on a neutral ground but a change to the colour the label has to be read
         against. Lightening #0A84FF to #409CFF took white type to 2.83:1, below even the 3:1
         floor for graphics, on the primary action of every dialog. So a saturated fill
         hovers by dipping the same 12 %, which puts it at 4.44:1 — brighter contrast than
         the button at rest, in the direction the press already goes. -->
    <Color x:Key="HoverFillColor">#1FFFFFFF</Color>      <!-- ~12% white circular/row hover -->
    <Color x:Key="HoverShadeColor">#1F000000</Color>     <!-- ~12% black: hover on a SATURATED fill -->
    <Color x:Key="PressedShadeColor">#2E000000</Color>   <!-- ~18% black pressed -->

    <!-- ~85% of the darkest ground: a badge or caption sitting ON a thumbnail, where the
         picture underneath is whatever the user captured and only an opaque-ish scrim keeps
         white type legible over it. -->
    <Color x:Key="BadgeScrimColor">#D91D1D1D</Color>

    <!-- Hairlines / borders (one token for structure, one for emphasis) -->
    <Color x:Key="BorderColor">#1FFFFFFF</Color>         <!-- ~12% white: dividers, toolbar/panel edge, separators -->
    <Color x:Key="BorderStrongColor">#33FFFFFF</Color>   <!-- ~20% white: input focus / emphasis ring -->
    <!-- 9% white. The cross-fade idiom stacks a hover layer OVER the rest layer instead of
         replacing it, which is exact for an opaque fill and wrong for a translucent one: a
         BorderStrongColor ring drawn over a BorderColor ring composites to ~30% white, half
         again over its own token. Pre-divided so it lands on BorderStrongColor exactly:
         1-(1-0.12)(1-0.09) = 0.20. Use this, not BorderStrongBrush, for a ring that fades in
         on top of the resting BorderBrush ring. -->
    <Color x:Key="BorderStrongOverBorderColor">#17FFFFFF</Color>
    <Color x:Key="TopHighlightColor">#10FFFFFF</Color>   <!-- ~6% white: raised-glass inner top highlight -->

    <!-- ============================ BRUSHES ============================ -->
    <SolidColorBrush x:Key="WindowBgBrush"     Color="{StaticResource WindowBgColor}"/>
    <SolidColorBrush x:Key="ToolbarBgBrush"    Color="{StaticResource ToolbarBgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush"      Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush"   Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="ElevatedBrush"     Color="{StaticResource ElevatedColor}"/>
    <SolidColorBrush x:Key="ToolChipBrush"     Color="{StaticResource ToolChipColor}"/>
    <SolidColorBrush x:Key="ToolChipRingBrush" Color="{StaticResource ToolChipRingColor}"/>
    <SolidColorBrush x:Key="FloatingBgBrush"   Color="{StaticResource FloatingBgColor}"/>

    <SolidColorBrush x:Key="AccentBrush"        Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentDeepBrush"    Color="{StaticResource AccentDeepColor}"/>
    <SolidColorBrush x:Key="RedDeepBrush"       Color="{StaticResource RedDeepColor}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}"/>
    <SolidColorBrush x:Key="InfoBrush"          Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="AnnotationRedBrush" Color="{StaticResource AnnotationRedColor}"/>
    <!-- Red as TYPE, not as fill. AnnotationRedColor is a stroke/fill colour and only
         clears 4.5:1 on the darkest ground (4.99:1 on WindowBg, 4.43:1 on ToolbarBg),
         so a failure line on a dialog card - which is ToolbarBg - fell under the bar
         with exactly the message the user has to read. The brighter red clears every
         ground the app puts text on (5.41:1 on ToolbarBg, 6.09:1 on WindowBg). -->
    <SolidColorBrush x:Key="TextErrorBrush"     Color="{StaticResource RedHoverColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush"  Color="{StaticResource TextDisabledColor}"/>
    <SolidColorBrush x:Key="TextHintBrush"      Color="{StaticResource TextHintColor}"/>

    <SolidColorBrush x:Key="HoverFillBrush"     Color="{StaticResource HoverFillColor}"/>
    <SolidColorBrush x:Key="HoverShadeBrush"    Color="{StaticResource HoverShadeColor}"/>
    <SolidColorBrush x:Key="PressedShadeBrush"   Color="{StaticResource PressedShadeColor}"/>
    <SolidColorBrush x:Key="BadgeScrimBrush"    Color="{StaticResource BadgeScrimColor}"/>
    <!-- Plate behind a source app's own icon, which carries its own colours: a light
         ground is what keeps a dark monochrome icon legible over a screenshot. -->
    <SolidColorBrush x:Key="IconPlateBrush" Color="White"/>

    <SolidColorBrush x:Key="BorderBrush"        Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderStrongBrush"  Color="{StaticResource BorderStrongColor}"/>
    <SolidColorBrush x:Key="BorderStrongOverBorderBrush" Color="{StaticResource BorderStrongOverBorderColor}"/>
    <SolidColorBrush x:Key="TopHighlightBrush"  Color="{StaticResource TopHighlightColor}"/>

    <!-- ===================== TOKENS (radii / sizes) ==================== -->
    <CornerRadius x:Key="RadiusButton">8</CornerRadius>
    <CornerRadius x:Key="RadiusCard">14</CornerRadius>
    <CornerRadius x:Key="RadiusInput">8</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius> <!-- clamped to height/2 by WPF -->
    <CornerRadius x:Key="RadiusChip">6</CornerRadius>   <!-- 36px tool button: hover wash and active chip -->
    <!-- A layer sitting INSIDE a bordered parent: Border does not clip its child, so the
         overlay needs the parent radius minus the inset (border thickness, or a Margin) or
         its square corners poke past the arc. One token per parent+inset pair, named for the
         parent it belongs to - PillButtonSecondary borrowed RadiusInputInner because the
         number happened to match, which would have quietly broken the day RadiusButton moved. -->
    <CornerRadius x:Key="RadiusButtonInner">6</CornerRadius>  <!-- RadiusButton 8 - BorderThickness 2 -->
    <CornerRadius x:Key="RadiusButtonInner1">7</CornerRadius> <!-- RadiusButton 8 - BorderThickness 1 -->
    <CornerRadius x:Key="RadiusInputInner">7</CornerRadius>   <!-- RadiusInput  8 - BorderThickness 1 -->
    <CornerRadius x:Key="RadiusChipInner">5</CornerRadius>    <!-- RadiusChip   6 - Margin 1 (focus ring) -->
    <CornerRadius x:Key="RadiusThumb">4</CornerRadius>        <!-- 8px rail - 2px inset either side -->

    <sys:Double x:Key="ToolButtonSize">36</sys:Double>
    <sys:Double x:Key="ToolGlyphSize">17</sys:Double>
    <sys:Double x:Key="CircleActionSize">34</sys:Double>
    <sys:Double x:Key="CircleGlyphSize">17</sys:Double>
    <sys:Double x:Key="PillHeight">30</sys:Double>

    <!-- ============================ TYPE SCALE ============================
         Six steps, in DIP. Core/ThemePalette.cs carries the same six in points
         for the WinForms surfaces, so a WPF label and the owner-drawn one beside
         it are the same size. New UI picks a step; it does not invent a number.
         ==================================================================== -->
    <sys:Double x:Key="TextMicro">10</sys:Double>     <!-- dense list metadata, tray-adjacent chrome -->
    <sys:Double x:Key="TextCaption">11</sys:Double>   <!-- hints, field labels, secondary values -->
    <sys:Double x:Key="TextBody">12</sys:Double>      <!-- default running text -->
    <sys:Double x:Key="TextBodyLg">13</sys:Double>    <!-- buttons, inputs, list titles -->
    <sys:Double x:Key="TextTitle">16</sys:Double>     <!-- section and window headings -->
    <sys:Double x:Key="TextDisplay">22</sys:Double>   <!-- the one big number or wordmark on a pane -->

    <!-- Icon-font glyphs used as illustration rather than as type: empty-state art,
         a thumbnail placeholder, the badge on a selected card, the small chevron
         trailing a split button. Sized apart from the type scale — they are
         pictures, and matching them to a text step makes them read as too small. -->
    <sys:Double x:Key="GlyphMicro">9</sys:Double>
    <sys:Double x:Key="GlyphBadge">14</sys:Double>
    <sys:Double x:Key="GlyphAction">20</sys:Double>   <!-- the icon on an action button or a nav tab -->
    <sys:Double x:Key="GlyphIllustration">34</sys:Double>
    <sys:Double x:Key="GlyphHero">48</sys:Double>

    <!-- ========================== SPACING SCALE ==========================
         Every gap in the app is one of these five. Margins are Thickness and
         cannot be composed from a Double in XAML, so a layout that needs a
         non-uniform gap names a Thickness here rather than writing digits
         inline in four different files.
         ==================================================================== -->
    <sys:Double x:Key="Space1">4</sys:Double>
    <sys:Double x:Key="Space2">8</sys:Double>
    <sys:Double x:Key="Space3">12</sys:Double>
    <sys:Double x:Key="Space4">16</sys:Double>
    <sys:Double x:Key="Space5">24</sys:Double>

    <!-- The repeated gaps, as Thickness. XAML cannot compose a Thickness out of the
         Doubles above, so the numbers are spelled once here — beside the scale they
         come from — instead of inline in the windows. The derivation is in the name
         and in the comment; if a step moves, both halves move together right here. -->
    <Thickness x:Key="GroupLabelMargin">0,8,0,4</Thickness>   <!-- Space2 above, Space1 below -->
    <Thickness x:Key="GroupSepMargin">0,8,0,8</Thickness>     <!-- Space2 either side -->
    <Thickness x:Key="LabelGutterMargin">0,0,12,0</Thickness> <!-- Space3 between label and control -->
    <Thickness x:Key="ChipGutterMargin">0,0,8,0</Thickness>   <!-- Space2 between chips in a row -->
    <Thickness x:Key="HintGutterMargin">8,0,0,0</Thickness>   <!-- Space2 before a hint that TRAILS a control -->
    <!-- Body copy that wraps gets one ratio, not a per-block guess. 1.4x the largest body
         step (TextBodyLg 12) covers the caption sizes too: a hint and a notice paragraph
         breathe the same amount. -->
    <sys:Double x:Key="LineHeightBody">17</sys:Double>
    <Thickness x:Key="MatrixCellMargin">12,0,0,0</Thickness> <!-- Space3 from the after-capture matrix's checkbox column to its label -->
    <Thickness x:Key="ThumbInset">2</Thickness>               <!-- scrollbar thumb inside its 8px rail -->
    <Thickness x:Key="CaptionGapMargin">0,4,0,0</Thickness>   <!-- Space1 between a glyph and its caption -->
    <Thickness x:Key="LeadGutterMargin">8,0,0,0</Thickness>   <!-- Space2 before text that follows a glyph -->
    <Thickness x:Key="MediaBarPadding">8,4</Thickness>        <!-- Space2 across, Space1 down: a bar over a thumbnail -->
    <Thickness x:Key="ActionRowMargin">0,16,0,0</Thickness>   <!-- Space4 above a row of buttons -->

    <!-- Settings' two-column geometry. Everything under a labelled row starts at
         the control column: the label width plus one Space3 gutter. That sum was
         written out as a bare 162 in four places and described in a comment in a
         fifth, which is five things to remember the next time the label column
         moves. It is one number now. -->
    <sys:Double x:Key="SettingsRowLabelWidth">150</sys:Double>
    <sys:Double x:Key="SettingsRowIndent">162</sys:Double>
    <Thickness x:Key="SettingsRowIndentMargin">162,0,0,0</Thickness>
    <Thickness x:Key="SettingsSubHintMargin">162,1,0,2</Thickness>
    <Thickness x:Key="SettingsHintBelowMargin">162,4,0,0</Thickness>

    <!-- ============================= MOTION =============================
         Mirrors Core/Motion.cs's DURATIONS, so a WPF window and a WinForms overlay
         move at the same speed: Quick for hover/press tints, Swap for one pane
         replacing another in the same slot, Enter for a surface arriving on screen.
         The eases are only approximately the same curve — WPF's BackEase is
         t^3 - t*a*sin(pi*t) and Motion.EaseOutBack is the standard c1 = 1.70158
         cubic — so do not pair one with the other in a single composite move.
         ================================================================== -->
    <Duration x:Key="MotionQuick">0:0:0.14</Duration>
    <Duration x:Key="MotionSwap">0:0:0.22</Duration>
    <Duration x:Key="MotionEnter">0:0:0.28</Duration>
    <!-- A loop period, not a transition, so it sits well outside the 140/220/280 vocabulary: a
         sweep that reads as unhurried. Surfaces that use it gate it on Motion.AnimationsEnabled
         themselves — a Forever storyboard has no end state for the zeroing pass to land on. -->
    <Duration x:Key="MotionShimmer">0:0:1.2</Duration>

    <!-- The one long duration: a breath that repeats while the app waits on something it
         cannot put a percentage on. Not a transition, so it is not in Motion.cs's ladder. -->
    <Duration x:Key="MotionPulse">0:0:0.65</Duration>

    <CubicEase x:Key="EaseOutCubic" EasingMode="EaseOut"/>
    <BackEase  x:Key="EaseOutBack"  EasingMode="EaseOut" Amplitude="0.4"/>
    <SineEase  x:Key="EaseInOutSine" EasingMode="EaseInOut"/>

    <!-- The cross-fade every control template below shares. A template stacks a
         layer named Hover / Press / Chip / Check over its rest fill at Opacity 0
         and these fade it in and out, so no state change snaps. Triggers carry
         only these actions and no Setter, so the visual is animation-only and
         nothing fights over the same property. BeginStoryboard's default
         SnapshotAndReplace means a fast in-out picks up from wherever the last
         fade reached instead of jumping back to the start. -->
    <Storyboard x:Key="HoverIn">
        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                         To="1" Duration="{StaticResource MotionQuick}"
                         EasingFunction="{StaticResource EaseOutCubic}"/>
    </Storyboard>
    <Storyboard x:Key="HoverOut">
        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                         To="0" Duration="{StaticResource MotionQuick}"
                         EasingFunction="{StaticResource EaseOutCubic}"/>
    </Storyboard>
    <Storyboard x:Key="PressIn">
        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="Opacity"
                         To="1" Duration="{StaticResource MotionQuick}"
                         EasingFunction="{StaticResource EaseOutCubic}"/>
    </Storyboard>
    <Storyboard x:Key="PressOut">
        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="Opacity"
                         To="0" Duration="{StaticResource MotionQuick}"
                         EasingFunction="{StaticResource EaseOutCubic}"/>
    </Storyboard>
    <Storyboard x:Key="ChipIn">
        <DoubleAnimation Storyboard.TargetName="Chip" Storyboard.TargetProperty="Opacity"
                         To="1" Duration="{StaticResource MotionQuick}"
                         EasingFunction="{StaticResource EaseOutCubic}"/>
    </Storyboard>
    <Storyboard x:Key="ChipOut">
        <DoubleAnimation Storyboard.TargetName="Chip" Storyboard.TargetProperty="Opacity"
                         To="0" Duration="{StaticResource MotionQuick}"
                         EasingFunction="{StaticResource EaseOutCubic}"/>
    </Storyboard>
    <Storyboard x:Key="CheckIn">
        <DoubleAnimation Storyboard.TargetName="Check" Storyboard.TargetProperty="Opacity"
                         To="1" Duration="{StaticResource MotionQuick}"
                         EasingFunction="{StaticResource EaseOutCubic}"/>
    </Storyboard>
    <Storyboard x:Key="CheckOut">
        <DoubleAnimation Storyboard.TargetName="Check" Storyboard.TargetProperty="Opacity"
                         To="0" Duration="{StaticResource MotionQuick}"
                         EasingFunction="{StaticResource EaseOutCubic}"/>
    </Storyboard>

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Shared drop shadow for floating surfaces -->
    <DropShadowEffect x:Key="FloatingShadow" BlurRadius="12" ShadowDepth="4"
                      Direction="270" Opacity="0.30" RenderingBias="Performance"
                      Color="#FF000000"/>

    <!-- ====================================================================
         TOOL BUTTON  — round 36px icon button.
         Usable on ToggleButton AND RadioButton (RadioButton derives from
         ToggleButton, so a ToggleButton-targeted Style applies to both).
         Rest: transparent. Hover: subtle white wash. Checked: a NEUTRAL chip.
         The active tool used to go solid accent blue, which put the loudest
         colour in the app on whichever pen happened to be selected and left no
         colour for the states that are genuinely modal. Selection now reads as a
         raised chip; the chip paints with Background, so ModeToolButton below is
         a one-setter override rather than a second copy of this template.
         Set Content to a glyph; FontFamily is forced to the icon font.
         ==================================================================== -->
    <Style x:Key="ToolButton" TargetType="ToggleButton">
        <Setter Property="Background" Value="{StaticResource ToolChipBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ToolChipRingBrush}"/>
        <Setter Property="Width"  Value="{StaticResource ToolButtonSize}"/>
        <Setter Property="Height" Value="{StaticResource ToolButtonSize}"/>
        <Setter Property="Margin" Value="3,0"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="{StaticResource ToolGlyphSize}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="400"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <!-- Chip underneath, hover/press wash over it: the washes
                             are translucent (white to lighten on hover, black to
                             darken on press), so a checked button reacts the same
                             way an unchecked one does and no combination of states
                             needs spelling out in a MultiTrigger. -->
                        <Border x:Name="Chip"  Opacity="0" CornerRadius="{StaticResource RadiusChip}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
                        <Border x:Name="Hover" Opacity="0" CornerRadius="{StaticResource RadiusChip}"
                                Background="{StaticResource HoverFillBrush}"/>
                        <Border x:Name="Press" Opacity="0" CornerRadius="{StaticResource RadiusChip}"
                                Background="{StaticResource PressedShadeBrush}"/>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                        <Border x:Name="FocusRing" CornerRadius="{StaticResource RadiusChipInner}"
                                BorderBrush="Transparent" BorderThickness="2" Margin="1"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource PressIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}"/></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource ChipIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource ChipOut}"/></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{StaticResource InfoBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================
         MODE TOOL BUTTON — a ToolButton whose checked state IS worth the accent,
         because it puts the editor into a mode rather than picking a pen: crop,
         add image, add background. Everything else about it is ToolButton.
         ==================================================================== -->
    <Style x:Key="ModeToolButton" TargetType="ToggleButton" BasedOn="{StaticResource ToolButton}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <!-- No ring: accent already clears 3:1 over the toolbar on its own, and a grey
             ring around a blue chip would only dull the one mode signal in the app. -->
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        <Style.Triggers>
            <!-- The one glyph in the app that sits on accent. White clears 3.65:1 there;
                 TextPrimary only manages 3.26:1. Scoped to this style so the neutral
                 chip on ToolButton keeps its normal glyph colour. -->
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <!-- Last, so it outranks the White above: a Style trigger beats the template
                 trigger that greys ToolButton, and a checked-and-disabled mode button
                 would otherwise render at full white. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A plain (non-toggle) round icon button variant for one-shot actions
         that live in the toolbar (e.g. undo/redo/rotate). Same look at rest. -->
    <Style x:Key="ToolIconButton" TargetType="Button">
        <Setter Property="Width"  Value="{StaticResource ToolButtonSize}"/>
        <Setter Property="Height" Value="{StaticResource ToolButtonSize}"/>
        <Setter Property="Margin" Value="3,0"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="{StaticResource ToolGlyphSize}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Hover" Opacity="0" CornerRadius="{StaticResource RadiusChip}"
                                Background="{StaticResource HoverFillBrush}"/>
                        <Border x:Name="Press" Opacity="0" CornerRadius="{StaticResource RadiusChip}"
                                Background="{StaticResource PressedShadeBrush}"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                        <Border x:Name="FocusRing" CornerRadius="{StaticResource RadiusChipInner}"
                                BorderBrush="Transparent" BorderThickness="2" Margin="1"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource PressIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}"/></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{StaticResource InfoBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================
         COLOUR SWATCH — one cell of the editor's palette, of the "My colors"
         row, or the picker's own preview. Its whole appearance is its own
         Background, so it needs a template that draws nothing else: with the
         stock Aero2 chrome, an empty (disabled) slot picked up the built-in
         Button.Disabled.Background from a template-part trigger, which beats a
         locally-set Background, and the "outline only" placeholders rendered as
         ten near-white squares under a dark popup.
         ==================================================================== -->
    <Style x:Key="ColorSwatchButton" TargetType="Button">
        <Setter Property="Width"  Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Fill"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusChipInner}"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <!-- Above the content, not under it. The palette and My-colors cells
                             have empty content, so the order is invisible to them; the picker's
                             preview swatch centres an opaque 20 px rectangle in a 22 px cell,
                             and under the content the hover wash only ever showed in the 1 px
                             ring around it. -->
                        <Border x:Name="Hover" Opacity="0" IsHitTestVisible="False"
                                CornerRadius="{StaticResource RadiusChipInner}"
                                Background="{StaticResource HoverFillBrush}"/>
                        <Border x:Name="Press" Opacity="0" IsHitTestVisible="False"
                                CornerRadius="{StaticResource RadiusChipInner}"
                                Background="{StaticResource PressedShadeBrush}"/>
                        <Border x:Name="FocusRing" CornerRadius="{StaticResource RadiusChipInner}"
                                BorderBrush="Transparent" BorderThickness="2" Margin="-1"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Gated on IsEnabled: WPF still sets IsMouseOver on a disabled
                             element, so the ten empty My-colors placeholders used to light up
                             and press under a pointer they also set to Cursor=Arrow. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource PressIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}"/></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{StaticResource InfoBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================
         PILL BUTTON — PRIMARY (blue). The affirmative/commit action ("Done").
         ==================================================================== -->
    <Style x:Key="PillButtonPrimary" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource PillHeight}"/>
        <Setter Property="MinWidth" Value="64"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="{StaticResource TextBodyLg}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{StaticResource AccentDeepBrush}"
                            BorderBrush="Transparent" BorderThickness="2"
                            CornerRadius="{StaticResource RadiusButton}">
                        <Grid>
                            <Border x:Name="Hover" Opacity="0" CornerRadius="{StaticResource RadiusButtonInner}"
                                    Background="{StaticResource HoverShadeBrush}"/>
                            <Border x:Name="Press" Opacity="0" CornerRadius="{StaticResource RadiusButtonInner}"
                                    Background="{StaticResource AccentPressedBrush}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource PressIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}"/></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================
         PILL BUTTON — SECONDARY (gray). Neutral action ("Save as…", Cancel).
         ==================================================================== -->
    <Style x:Key="PillButtonSecondary" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource PillHeight}"/>
        <Setter Property="MinWidth" Value="64"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource TextBodyLg}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusButton}">
                        <Grid>
                            <Border x:Name="Hover" Opacity="0" CornerRadius="{StaticResource RadiusButtonInner1}"
                                    Background="{StaticResource SurfaceAltBrush}"/>
                            <Border x:Name="Press" Opacity="0" CornerRadius="{StaticResource RadiusButtonInner1}"
                                    Background="{StaticResource ElevatedBrush}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource PressIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}"/></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource InfoBrush}"/>
                            <Setter TargetName="Bg" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================
         PILL BUTTON — DESTRUCTIVE (red). Confirm buttons for delete-style
         actions in themed dialogs. Same shape/states as PillButtonPrimary.
         ==================================================================== -->
    <Style x:Key="PillButtonDestructive" TargetType="Button" BasedOn="{StaticResource PillButtonPrimary}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{StaticResource RedDeepBrush}"
                            BorderBrush="Transparent" BorderThickness="2"
                            CornerRadius="{StaticResource RadiusButton}">
                        <Grid>
                            <!-- A saturated fill dips to hover and dips further to press — the
                                 same ladder PillButtonPrimary uses, for the same reason: white
                                 13pt type has to stay readable on whatever the fill becomes. -->
                            <Border x:Name="Hover" Opacity="0" CornerRadius="{StaticResource RadiusButtonInner}"
                                    Background="{StaticResource HoverShadeBrush}"/>
                            <Border x:Name="Press" Opacity="0" CornerRadius="{StaticResource RadiusButtonInner}"
                                    Background="{StaticResource PressedShadeBrush}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource PressIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}"/></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================
         CIRCLE ACTION BUTTON — round bottom-utility-bar action
         (share / pin / copy / cloud). 34px, monochrome glyph, hover fill.
         ==================================================================== -->
    <Style x:Key="CircleActionButton" TargetType="Button">
        <Setter Property="Width"  Value="{StaticResource CircleActionSize}"/>
        <Setter Property="Height" Value="{StaticResource CircleActionSize}"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="{StaticResource CircleGlyphSize}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="Bg" Fill="{StaticResource SurfaceBrush}"/>
                        <Ellipse x:Name="Hover" Opacity="0" Fill="{StaticResource SurfaceAltBrush}"/>
                        <Ellipse x:Name="Press" Opacity="0" Fill="{StaticResource ElevatedBrush}"/>
                        <Ellipse x:Name="FocusRing" Stroke="{StaticResource BorderBrush}" StrokeThickness="1"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource PressIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}"/></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Stroke" Value="{StaticResource InfoBrush}"/>
                            <Setter TargetName="FocusRing" Property="StrokeThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================
         FLOATING TOOLBAR CONTAINER — apply to a Border.
         Dark charcoal, 14px corners, padding, soft drop shadow, top highlight.
         Use for the editor's floating top pill and any HUD/overlay card.
         ==================================================================== -->
    <Style x:Key="FloatingToolbar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource FloatingBgBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TopHighlightBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Effect" Value="{StaticResource FloatingShadow}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- BOTTOM UTILITY-BAR CONTAINER — same material, used for the editor's
         bottom bar (zoom dropdown · circular actions). -->
    <Style x:Key="BottomUtilityBar" TargetType="Border" BasedOn="{StaticResource FloatingToolbar}">
        <Setter Property="Padding" Value="8,5"/>
    </Style>

    <!-- A generic raised panel/sidebar surface (background composer left rail). -->
    <Style x:Key="PanelSurface" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ToolbarBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Thin vertical divider for separating tool clusters inside a toolbar.
         Use:  <Rectangle Style="{StaticResource ToolbarDivider}"/> -->
    <Style x:Key="ToolbarDivider" TargetType="Rectangle">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Margin" Value="6,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Fill" Value="{StaticResource BorderBrush}"/>
    </Style>

    <!-- ============================ LABELS ============================ -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,16,0,8"/>
    </Style>
    <Style x:Key="ValueLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ====================================================================
         DARK COMBOBOX — flat, used for the bottom-bar zoom dropdown and any
         settings combo. Single implementation (replaces the two divergent ones).
         ==================================================================== -->
    <!-- Hidden repeat-button used by the editable/non-editable toggle area -->
    <ControlTemplate x:Key="ComboToggleTemplate" TargetType="ToggleButton">
        <Border x:Name="Bg" Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusInput}">
            <Grid>
                <Border x:Name="Hover" Opacity="0" CornerRadius="{StaticResource RadiusInputInner}"
                        Background="{StaticResource ElevatedBrush}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="22"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M0,0 L8,0 L4,5 Z" Fill="{StaticResource TextSecondaryBrush}"/>
                </Grid>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- AccentDeep, not Accent: the label on top of this fill is white, and
                             white on AccentColor is 3.65:1. Same rule the WinForms menu renderer
                             follows, so both menus highlight in one blue. -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentDeepBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkComboBox" TargetType="ComboBox">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource TextBodyLg}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Template="{StaticResource ComboToggleTemplate}"
                                      Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="10,0,24,0"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"
                                          TextElement.Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False"
                               PopupAnimation="Fade">
                            <Border Background="{StaticResource ElevatedBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusInput}"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Margin="0,4,0,0" Padding="4"
                                    Effect="{StaticResource FloatingShadow}">
                                <ScrollViewer MaxHeight="280">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================
         DARK SLIDER — single implementation. Thin track, blue fill, white knob.
         ==================================================================== -->
    <Style x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse Fill="White" Stroke="{StaticResource AccentBrush}" StrokeThickness="0"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkSlider" TargetType="Slider">
        <Setter Property="Height" Value="20"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="3" CornerRadius="1.5" VerticalAlignment="Center"
                                Background="{StaticResource SurfaceAltBrush}"/>
                        <!-- filled portion: a Track decorator is simplest via two repeat buttons -->
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="3" CornerRadius="1.5" VerticalAlignment="Center"
                                                    Background="{StaticResource AccentBrush}"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================
         DARK TEXTBOX — single input treatment (replaces the divergent ones).
         ==================================================================== -->
    <Style x:Key="DarkTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource TextBodyLg}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bg" Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusInput}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================
         BARE TEXT BOX — no chrome of its own; the PARENT Border draws the
         field. Used where a text box shares one rounded field with a trailing
         chevron button (the annotation size field), so the two read as a
         single control instead of a box inside a box.
         ==================================================================== -->
    <Style x:Key="BareTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="{StaticResource TextBodyLg}"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                  VerticalAlignment="Center"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================
         FIELD CHEVRON BUTTON — the trailing preset-menu affordance inside a
         field. Divider on its left edge, icon-font glyph, hover highlight.
         ==================================================================== -->
    <Style x:Key="FieldChevronButton" TargetType="Button">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="{StaticResource TextMicro}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                        <Grid>
                            <Border x:Name="Hover" Opacity="0" Background="{StaticResource HoverFillBrush}"/>
                            <Border x:Name="Press" Opacity="0" Background="{StaticResource PressedShadeBrush}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.FontFamily="{TemplateBinding FontFamily}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <!-- The glyph colour still swaps; only the fill has a layer to fade.
                                 This button shares the annotation size field with ToolButtons that
                                 cross-fade, so an instant wash beside them was the odd one out. -->
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource PressIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}"/></Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================
         SIZE PRESET ROW — one row of the size menu: a preview bar drawn at the
         preset's real weight, then the number. Selected row = accent fill.
         ==================================================================== -->
    <Style x:Key="SizePresetRow" TargetType="RadioButton">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <!-- Same layered cross-fade as ToolButton: the selection used to
                             hard-cut to solid accent, which is the one snap left on the
                             primary selection signal of the size menu.
                             Check paints LAST, unlike ToolButton: its fill is the accent, and
                             a hover wash on top of it dropped the white label from 3.65:1 to
                             3.13:1. ToolButton stacks the other way round because its chip is
                             dark, where the wash only adds contrast. -->
                        <Border x:Name="Hover" Opacity="0" CornerRadius="{StaticResource RadiusChip}"
                                Background="{StaticResource HoverFillBrush}"/>
                        <Border x:Name="Check" Opacity="0" CornerRadius="{StaticResource RadiusChip}"
                                Background="{StaticResource AccentBrush}"/>
                        <ContentPresenter VerticalAlignment="Center" Margin="8,0"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="White"/>
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource CheckIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource CheckOut}"/></Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================
         DARK CHECKBOX — macOS-style; checked = blue fill + white check.
         ==================================================================== -->
    <Style x:Key="DarkCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource TextBodyLg}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="18" Height="18" VerticalAlignment="Center">
                            <Border x:Name="Box" CornerRadius="{StaticResource RadiusChipInner}"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                            <!-- Before the chip, so a checked box's accent covers it. The ring
                                 is the pre-divided brush: it lands ON Box's resting BorderBrush
                                 ring, same geometry and thickness, so the two composite. -->
                            <Border x:Name="Hover" Opacity="0" CornerRadius="{StaticResource RadiusChipInner}"
                                    BorderBrush="{StaticResource BorderStrongOverBorderBrush}" BorderThickness="1"/>
                            <Border x:Name="Chip" Opacity="0" CornerRadius="{StaticResource RadiusChipInner}"
                                    Background="{StaticResource AccentBrush}"
                                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"/>
                            <Path x:Name="Check" Opacity="0"
                                  Stroke="White" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M4,9 L8,13 L14,5"/>
                        </Grid>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource ChipIn}"/>
                                <BeginStoryboard Storyboard="{StaticResource CheckIn}"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource ChipOut}"/>
                                <BeginStoryboard Storyboard="{StaticResource CheckOut}"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================
         DARK CONTEXT MENU + MENU ITEM — so History's native menus stop
         leaking light Windows chrome. Implicit-style ready; reference by key.
         ==================================================================== -->
    <Style x:Key="DarkContextMenu" TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource ElevatedBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusInput}" Padding="4"
                            Effect="{StaticResource FloatingShadow}">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Leading glyph column is always reserved so checked and
                                     unchecked headers stay aligned. -->
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CheckGlyph" Grid.Column="0" Text="&#xE73E;"
                                       FontFamily="{StaticResource IconFont}" FontSize="{StaticResource TextBody}"
                                       VerticalAlignment="Center" Visibility="Hidden"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="20,0,0,0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <!-- AccentDeep for the same reason as DarkComboBoxItem, and the shortcut
                             column gets its own Foreground: TextSecondary over the highlight fill
                             is 2.51:1, and the row-level Foreground setter never reaches it. -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentDeepBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter TargetName="Gesture" Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================
         ANNOTATION COLOR SWATCH — RadioButton; 24px, inner dot = Background,
         selected ring = white, default group color is red (set in markup).
         Reusable for the editor color row and composer plain-color grid.
         ==================================================================== -->
    <!-- ====================================================================
         DISCLOSURE TOGGLE — a chevron + label row that reveals a block below it.
         The chevron rotates on the quick step, so the state change is visible even
         when the revealed content is off-screen.
         ==================================================================== -->
    <Style x:Key="DisclosureToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bg" Background="Transparent"
                            CornerRadius="{StaticResource RadiusChip}">
                        <Grid>
                            <!-- The hover wash is its own layer at zero opacity so it can be faded
                                 in, the way every other row in the theme does it. A bare Background
                                 setter here snapped beside the chevron it sits next to. -->
                            <Border x:Name="Hover" Opacity="0" Background="{StaticResource HoverFillBrush}"
                                    CornerRadius="{StaticResource RadiusChip}"/>
                            <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
                                <TextBlock x:Name="Chevron" Text="&#xE76C;" FontFamily="{StaticResource IconFont}"
                                           FontSize="{StaticResource GlyphMicro}" VerticalAlignment="Center"
                                           Margin="0,0,6,0" RenderTransformOrigin="0.5,0.5"
                                           Foreground="{TemplateBinding Foreground}">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform x:Name="ChevronSpin" Angle="0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ChevronSpin"
                                                         Storyboard.TargetProperty="Angle" To="90"
                                                         Duration="{StaticResource MotionQuick}"
                                                         EasingFunction="{StaticResource EaseOutCubic}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ChevronSpin"
                                                         Storyboard.TargetProperty="Angle" To="0"
                                                         Duration="{StaticResource MotionQuick}"
                                                         EasingFunction="{StaticResource EaseOutCubic}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ColorSwatch" TargetType="RadioButton">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <!-- Rings stack rather than swap Stroke on one ellipse, so the hover and
                         selected states cross-fade the way the swatch's neighbours in the
                         editor colour row do. Order is z-order, last on top: rest, hover,
                         checked, focus. Note that a wider ring does NOT cover a narrower one
                         — an Ellipse at Stretch=Fill insets its geometry by StrokeThickness/2,
                         so every ring shares the same OUTER edge and grows inward. Covering is
                         what the stacking order does; thickness only decides how far in a
                         layer reaches. -->
                    <Grid>
                        <Ellipse x:Name="Ring" Stroke="{StaticResource BorderStrongBrush}" StrokeThickness="1.5"/>
                        <Ellipse x:Name="Hover" Opacity="0" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5"/>
                        <Ellipse x:Name="Check" Opacity="0" Stroke="White" StrokeThickness="2"/>
                        <!-- Focus is its own topmost layer. As a thickness on the base ring it
                             was painted over by the 2px white checked ring stacked above it,
                             and checked+focused is the ordinary keyboard case here: the
                             swatches are one RadioButton group, so an arrow key moves focus
                             and the selection together. -->
                        <Ellipse x:Name="Focus" Opacity="0" Stroke="{StaticResource InfoBrush}" StrokeThickness="2.5"/>
                        <Ellipse Width="14" Height="14" Fill="{TemplateBinding Background}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource CheckIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource CheckOut}"/></Trigger.ExitActions>
                        </Trigger>
                        <!-- A focus ring appearing the instant focus lands is conventional, so
                             it stays a setter while the two fades animate — it just shows its
                             own layer instead of restyling one underneath them. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================
         SLIM SCROLLBAR — thin (8px), rounded thumb, no arrow buttons. Applied
         app-wide so the settings / history scrollers read as a quiet rail
         instead of the chunky default Windows scrollbar.
         ==================================================================== -->
    <Style x:Key="SlimScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid>
                        <!-- The two layers must stay geometrically identical or the hover
                             fill peeks past the rest fill, so both read the same tokens. -->
                        <Border x:Name="Th" CornerRadius="{StaticResource RadiusThumb}" Margin="{StaticResource ThumbInset}"
                                Background="{StaticResource BorderStrongBrush}"/>
                        <Border x:Name="Hover" Opacity="0" CornerRadius="{StaticResource RadiusThumb}" Margin="{StaticResource ThumbInset}"
                                Background="{StaticResource TextSecondaryBrush}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SlimScrollThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand"
                                              Style="{StaticResource ScrollPageButton}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand"
                                              Style="{StaticResource ScrollPageButton}"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto"/>
                            <Setter Property="MinWidth" Value="0"/>
                            <Setter Property="Height" Value="8"/>
                            <Setter Property="MinHeight" Value="8"/>
                            <Setter TargetName="PART_Track" Property="Orientation" Value="Horizontal"/>
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
