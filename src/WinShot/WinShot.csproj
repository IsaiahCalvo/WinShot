<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WinShot</RootNamespace>
    <AssemblyName>WinShot</AssemblyName>
    <!-- Local-build fallback; the release workflow overrides this with -p:Version=<tag> so the
         running assembly version matches the GitHub release tag the updater compares against. -->
    <Version>1.6.0</Version>
    <!-- Embedded app icon (the blue lens mark) so the exe, taskbar, Alt-Tab, and any
         desktop shortcut show the official icon instead of the generic .NET one. -->
    <ApplicationIcon>Assets\winshot.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <!-- ScreenRecorderLib ships native per-arch binaries and refuses AnyCPU. -->
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- DPI awareness is declared in app.manifest (PerMonitorV2); the WinForms analyzer hint doesn't apply to a WPF host. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms injects a global 'using System.Windows.Forms;' which collides with WPF types. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ScreenRecorderLib" Version="6.6.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="System.Text.Json" Version="9.0.1" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- MIT and Apache-2.0 attach their notice obligations to the DISTRIBUTED BINARY, not to
         the repository, so these travel into the publish output (and therefore into the
         installer payload, which copies publish\WinShot\*) and the About pane reads them
         from beside the exe. -->
    <Content Include="..\..\THIRD_PARTY_NOTICES.md"
             Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\licenses\*.txt"
             Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shutter sounds, synthesised by tools\make-sounds.ps1 (no sampled audio ships). -->
    <EmbeddedResource Include="Assets\sounds\shutter-default.wav"
                      LogicalName="WinShot.Assets.sounds.shutter-default.wav" />
    <EmbeddedResource Include="Assets\sounds\shutter-classic.wav"
                      LogicalName="WinShot.Assets.sounds.shutter-classic.wav" />
    <EmbeddedResource Include="Assets\sounds\shutter-subtle.wav"
                      LogicalName="WinShot.Assets.sounds.shutter-subtle.wav" />
    <!-- The one WinShot mark: exe icon (ApplicationIcon above), tray icon and About pane
         all read this file. Re-cut it with tools\make-icon.ps1. -->
    <EmbeddedResource Include="Assets\winshot.ico"
                      LogicalName="WinShot.Assets.winshot.ico" />
    <EmbeddedResource Include="Assets\quick-access-camcorder.svg"
                      LogicalName="WinShot.Assets.quick-access-camcorder.svg" />
    <EmbeddedResource Include="Assets\quick-access-close.svg"
                      LogicalName="WinShot.Assets.quick-access-close.svg" />
    <EmbeddedResource Include="Assets\quick-access-copy.svg"
                      LogicalName="WinShot.Assets.quick-access-copy.svg" />
    <EmbeddedResource Include="Assets\quick-access-edit.svg"
                      LogicalName="WinShot.Assets.quick-access-edit.svg" />
    <EmbeddedResource Include="Assets\quick-access-lock.svg"
                      LogicalName="WinShot.Assets.quick-access-lock.svg" />
    <EmbeddedResource Include="Assets\quick-access-pin.svg"
                      LogicalName="WinShot.Assets.quick-access-pin.svg" />
    <!-- The filled half of the pin's outline/filled pair: the pinned (active) state only.
         The outlined asset above is the default, matching the thirteen stroked siblings. -->
    <EmbeddedResource Include="Assets\quick-access-unlock.svg"
                      LogicalName="WinShot.Assets.quick-access-unlock.svg" />
    <EmbeddedResource Include="Assets\quick-access-save.svg"
                      LogicalName="WinShot.Assets.quick-access-save.svg" />
    <None Include="Theme\Icons\*.svg" CopyToOutputDirectory="PreserveNewest" />
    <!-- Context-menu glyphs for the quick-actions card's editing rows. -->
    <EmbeddedResource Include="Assets\quick-access-text.svg"
                      LogicalName="WinShot.Assets.quick-access-text.svg" />
    <EmbeddedResource Include="Assets\quick-access-background.svg"
                      LogicalName="WinShot.Assets.quick-access-background.svg" />
    <EmbeddedResource Include="Assets\quick-access-rotate-left.svg"
                      LogicalName="WinShot.Assets.quick-access-rotate-left.svg" />
    <EmbeddedResource Include="Assets\quick-access-rotate-right.svg"
                      LogicalName="WinShot.Assets.quick-access-rotate-right.svg" />
    <EmbeddedResource Include="Assets\quick-access-flip-horizontal.svg"
                      LogicalName="WinShot.Assets.quick-access-flip-horizontal.svg" />
    <EmbeddedResource Include="Assets\quick-access-flip-vertical.svg"
                      LogicalName="WinShot.Assets.quick-access-flip-vertical.svg" />
    <EmbeddedResource Include="Assets\quick-access-resize.svg"
                      LogicalName="WinShot.Assets.quick-access-resize.svg" />
  </ItemGroup>

</Project>
