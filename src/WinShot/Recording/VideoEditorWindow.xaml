<Window x:Class="WinShot.Recording.VideoEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinShot — Video Editor" Width="760" Height="600" MinWidth="620" MinHeight="480"
        Background="{StaticResource WindowBgBrush}" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" KeyDown="OnWindowKeyDown">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SecondaryBtnBgBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedFillBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="White"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{StaticResource ActionBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ActionTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ActionBgHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="White"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource DarkCheckBox}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{StaticResource InputBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="7">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,8,0" Data="M 0 0 L 4 4 L 8 0 Z" Fill="{StaticResource TextMutedBrush}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverFillBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="White"/>
                                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="8,0,24,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Slide"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="{StaticResource FloatingBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Margin="0,2,0,0" MaxHeight="220"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderRepeat" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderFill" TargetType="RepeatButton" BasedOn="{StaticResource SliderRepeat}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{StaticResource AccentBrush}" Height="4" CornerRadius="2" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="IsTabStop" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Border x:Name="FocusRing" Height="24" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="2">
                            <Grid Background="Transparent">
                                <Border Height="4" CornerRadius="2" Background="{StaticResource ToggleOffBrush}" VerticalAlignment="Center"/>
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource SliderFill}" Command="Slider.DecreaseLarge"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource SliderRepeat}" Command="Slider.IncreaseLarge"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Width="14" Height="14" Focusable="False">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Ellipse Fill="White" Stroke="{StaticResource AccentBrush}" StrokeThickness="1"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="BorderBrush" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource CanvasBrush}" CornerRadius="8" ClipToBounds="True">
            <MediaElement x:Name="Media" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                          ScrubbingEnabled="True" Stretch="Uniform"
                          AutomationProperties.Name="Video preview"
                          MediaOpened="OnMediaOpened" MediaEnded="OnMediaEnded" MediaFailed="OnMediaFailed"/>
        </Border>

        <DockPanel Grid.Row="1" Margin="0,12,0,0">
            <Button x:Name="BtnPlay" DockPanel.Dock="Left" Style="{StaticResource ActionButton}"
                    Width="72" Content="_Play" Click="OnPlayPause"
                    AutomationProperties.Name="Play or pause video"
                    AutomationProperties.HelpText="Plays or pauses the preview. Keyboard shortcut: Space."
                    AutomationProperties.AcceleratorKey="Space"/>
            <TextBlock x:Name="TimeLabel" DockPanel.Dock="Right" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12"
                       FontFamily="{StaticResource MonoFontFamily}" VerticalAlignment="Center" Margin="10,0,0,0" Text="0:00 / 0:00"
                       AutomationProperties.Name="Current position and video duration"/>
            <Slider x:Name="PositionSlider" Style="{StaticResource DarkSlider}" Margin="10,0,0,0"
                    Minimum="0" Maximum="1" SmallChange="0.1" LargeChange="5"
                    Focusable="True" IsTabStop="True"
                    AutomationProperties.Name="Preview position"
                    AutomationProperties.HelpText="Use Left and Right Arrow to seek. Page Up and Page Down seek farther."
                    ValueChanged="OnPositionSliderChanged"/>
        </DockPanel>

        <!-- Filmstrip trim timeline: a dark frame-thumbnail track with two
             draggable in/out handles and a live playhead. The two old trim
             sliders are gone; TrimStartSeconds/TrimEndSeconds now drive export. -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="TimelineTrack" Grid.Row="0" Height="56" CornerRadius="6"
                    Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                    ClipToBounds="True" SizeChanged="OnTimelineSizeChanged"
                    MouseLeftButtonDown="OnTimelineClicked">
                <Canvas x:Name="TimelineCanvas" ClipToBounds="True">
                    <!-- Frame thumbnails (best-effort) live here, added in code. -->
                    <ItemsControl x:Name="FilmstripItems" Canvas.Left="0" Canvas.Top="0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Dimmers over the trimmed-away head and tail regions. -->
                    <Rectangle x:Name="LeftDim" Canvas.Left="0" Canvas.Top="0" Height="54"
                               Fill="#B80A0A0C" Width="0" IsHitTestVisible="False"/>
                    <Rectangle x:Name="RightDim" Canvas.Top="0" Height="54"
                               Fill="#B80A0A0C" Width="0" IsHitTestVisible="False"/>

                    <!-- Accent border around the kept region. -->
                    <Border x:Name="SelectionBorder" Canvas.Top="0" Height="54" Width="0"
                            BorderBrush="{StaticResource SelectionRingBrush}" BorderThickness="2"
                            CornerRadius="4" IsHitTestVisible="False"/>

                    <!-- Playhead. -->
                    <Rectangle x:Name="Playhead" Canvas.Left="0" Canvas.Top="2" Width="2" Height="50"
                               Fill="White" IsHitTestVisible="False"/>

                    <!-- In / out drag handles. -->
                    <Thumb x:Name="TrimStartThumb" Canvas.Left="0" Canvas.Top="0" Width="12" Height="54"
                           Cursor="SizeWE" Focusable="True" IsTabStop="True"
                           AutomationProperties.Name="Trim start"
                           AutomationProperties.HelpText="Use Left and Right Arrow to adjust. Hold Shift for one-second steps or Control for five-second steps."
                           DragDelta="OnTrimStartDrag" KeyDown="OnTrimStartKeyDown">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Grid Background="Transparent">
                                    <Border x:Name="KeyboardFocusRing" BorderBrush="Transparent"
                                            BorderThickness="1" CornerRadius="3" Margin="1"/>
                                    <Border HorizontalAlignment="Right" Width="6" CornerRadius="3,0,0,3"
                                            Background="{StaticResource AccentBrush}"/>
                                    <Rectangle HorizontalAlignment="Right" Margin="0,0,2,0" Width="2" Height="18"
                                               RadiusX="1" RadiusY="1" Fill="White"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="KeyboardFocusRing" Property="BorderBrush" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                    <Thumb x:Name="TrimEndThumb" Canvas.Left="0" Canvas.Top="0" Width="12" Height="54"
                           Cursor="SizeWE" Focusable="True" IsTabStop="True"
                           AutomationProperties.Name="Trim end"
                           AutomationProperties.HelpText="Use Left and Right Arrow to adjust. Hold Shift for one-second steps or Control for five-second steps."
                           DragDelta="OnTrimEndDrag" KeyDown="OnTrimEndKeyDown">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Grid Background="Transparent">
                                    <Border x:Name="KeyboardFocusRing" BorderBrush="Transparent"
                                            BorderThickness="1" CornerRadius="3" Margin="1"/>
                                    <Border HorizontalAlignment="Left" Width="6" CornerRadius="0,3,3,0"
                                            Background="{StaticResource AccentBrush}"/>
                                    <Rectangle HorizontalAlignment="Left" Margin="2,0,0,0" Width="2" Height="18"
                                               RadiusX="1" RadiusY="1" Fill="White"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="KeyboardFocusRing" Property="BorderBrush" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Canvas>
            </Border>

            <Grid Grid.Row="1" Margin="0,6,0,0">
                <TextBlock x:Name="TrimStartLabel" HorizontalAlignment="Left" Style="{StaticResource FieldLabel}"
                           FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource SelectedTintTextBrush}" FontWeight="SemiBold" Text="In 0:00"/>
                <TextBlock x:Name="TrimRangeLabel" HorizontalAlignment="Center" Style="{StaticResource FieldLabel}"
                           FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Text="0:00"/>
                <TextBlock x:Name="TrimEndLabel" HorizontalAlignment="Right" Style="{StaticResource FieldLabel}"
                           FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource SelectedTintTextBrush}" FontWeight="SemiBold" Text="Out 0:00"/>
            </Grid>
        </Grid>

        <WrapPanel Grid.Row="3" Margin="0,10,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Margin="0,4,12,4">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Resolution"/>
                <ComboBox x:Name="ResolutionCombo" Width="86" Margin="8,0,0,0"
                          Style="{StaticResource DarkCombo}" SelectedIndex="0"
                          AutomationProperties.Name="Export resolution"
                          AutomationProperties.HelpText="Choose 100, 75, or 50 percent of the source resolution."
                          SelectionChanged="OnOutputSettingsChanged">
                    <ComboBoxItem Content="100%"/>
                    <ComboBoxItem Content="75%"/>
                    <ComboBoxItem Content="50%"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,12,4">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Quality"/>
                <ComboBox x:Name="QualityCombo" Width="96" Margin="8,0,0,0"
                          Style="{StaticResource DarkCombo}" SelectedIndex="0"
                          AutomationProperties.Name="Export quality"
                          SelectionChanged="OnOutputSettingsChanged">
                    <ComboBoxItem Content="High"/>
                    <ComboBoxItem Content="Medium"/>
                    <ComboBoxItem Content="Low"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,12,4">
                <TextBlock Style="{StaticResource FieldLabel}" Text="FPS"/>
                <ComboBox x:Name="FrameRateCombo" Width="86" Margin="8,0,0,0"
                          Style="{StaticResource DarkCombo}" SelectedIndex="0"
                          AutomationProperties.Name="Export frame rate"
                          SelectionChanged="OnOutputSettingsChanged">
                    <ComboBoxItem Content="Source"/>
                    <ComboBoxItem Content="60"/>
                    <ComboBoxItem Content="30"/>
                    <ComboBoxItem Content="15"/>
                </ComboBox>
            </StackPanel>
            <CheckBox x:Name="MuteCheck" Content="_Mute" Margin="0,4,10,4"
                      AutomationProperties.Name="Mute exported audio"
                      AutomationProperties.HelpText="Removes audio from the exported video."
                      Checked="OnMuteChanged" Unchecked="OnMuteChanged"/>
            <CheckBox x:Name="MonoCheck" Content="Mo_no" Margin="0,4,12,4"
                      AutomationProperties.Name="Export mono audio"
                      AutomationProperties.HelpText="Mixes exported audio down to one channel."
                      Checked="OnOutputSettingsChanged" Unchecked="OnOutputSettingsChanged"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Volume" Margin="0,0,8,0"/>
                <Slider x:Name="VolumeSlider" Width="90" Style="{StaticResource DarkSlider}" VerticalAlignment="Center"
                        Minimum="0" Maximum="1" Value="1" SmallChange="0.05" LargeChange="0.1"
                        Focusable="True" IsTabStop="True"
                        AutomationProperties.Name="Export volume"
                        AutomationProperties.HelpText="Use Left and Right Arrow to adjust export volume."
                        ValueChanged="OnVolumeChanged"/>
            </StackPanel>
        </WrapPanel>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock x:Name="OutputSummaryText" Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                           Margin="0,0,0,2" TextTrimming="CharacterEllipsis"
                           AutomationProperties.Name="Output summary"/>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"
                           AutomationProperties.Name="Export status"
                           AutomationProperties.LiveSetting="Polite"/>
                <ProgressBar x:Name="ExportProgress" Height="6" Margin="0,4,0,0" Maximum="100"
                             Background="{StaticResource ToggleOffBrush}" Foreground="{StaticResource AccentBrush}" BorderThickness="0"
                             AutomationProperties.Name="Export progress"
                             Visibility="Collapsed"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnClose" Style="{StaticResource ActionButton}"
                        Content="_Cancel" Margin="0,0,8,0"
                        AutomationProperties.Name="Cancel editing"
                        AutomationProperties.HelpText="Closes the editor without changing the source video."
                        Click="OnCloseEditor"/>
                <Button x:Name="BtnCancelExport" Style="{StaticResource ActionButton}"
                        Content="_Cancel export" Margin="0,0,8,0" Visibility="Collapsed"
                        AutomationProperties.Name="Cancel export"
                        AutomationProperties.HelpText="Stops the current export and removes any partial output. Keyboard shortcut: Escape."
                        AutomationProperties.AcceleratorKey="Escape"
                        Click="OnCancelExport"/>
                <Button x:Name="BtnExport" Style="{StaticResource AccentButton}"
                        Content="_Trim &amp; Export" Click="OnExport"
                        AutomationProperties.Name="Trim and export video"
                        AutomationProperties.HelpText="Trims and converts the edited video beside the source file. Keyboard shortcut: Control E."
                        AutomationProperties.AcceleratorKey="Control+E"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
