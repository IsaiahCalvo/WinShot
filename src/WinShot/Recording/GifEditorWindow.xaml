<Window x:Class="WinShot.Recording.GifEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinShot — Trim GIF" Width="700" Height="560" MinWidth="560" MinHeight="440"
        Background="{StaticResource WindowBgBrush}" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" KeyDown="OnWindowKeyDown">

    <!-- ShellRoot carries the entrance transform: a Window's own RenderTransform is never
         applied, so the scale has to live on the first child. -->
    <Grid x:Name="ShellRoot" Margin="16" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="ShellScale" ScaleX="1" ScaleY="1"/>
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource WindowBgBrush}" CornerRadius="8" ClipToBounds="True">
            <Image x:Name="Preview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                   AutomationProperties.Name="GIF preview"/>
        </Border>

        <DockPanel Grid.Row="1" Margin="0,12,0,0">
            <Button x:Name="BtnPlay" DockPanel.Dock="Left" Style="{StaticResource PillButtonSecondary}"
                    Width="72" Margin="0" Content="Play" Click="OnPlayPause"
                    AutomationProperties.Name="Play or pause the GIF"
                    AutomationProperties.HelpText="Plays or pauses the preview. Keyboard shortcut: Space."
                    AutomationProperties.AcceleratorKey="Space"/>
            <TextBlock x:Name="FrameLabel" DockPanel.Dock="Right"
                       Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource TextBody}"
                       FontFamily="{StaticResource MonoFamily}" VerticalAlignment="Center" Margin="10,0,0,0" Text="0 / 0"
                       AutomationProperties.Name="Current frame and frame count"/>
            <TextBlock x:Name="ScrubHint" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource TextCaption}"
                       TextTrimming="CharacterEllipsis" Margin="{StaticResource LabelGutterMargin}"
                       Text="Drag the strip to step through frames. Space plays and pauses."/>
        </DockPanel>

        <!-- Same filmstrip idiom as the video editor: a frame track with two draggable
             in/out handles, dimmed outside the kept range, and a live playhead. -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="TimelineTrack" Grid.Row="0" Height="56" CornerRadius="6"
                    Background="{StaticResource ToolbarBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    ClipToBounds="True" SizeChanged="OnTimelineSizeChanged"
                    MouseLeftButtonDown="OnTimelineClicked"
                    MouseMove="OnTimelineDragScrub"
                    MouseLeftButtonUp="OnTimelineScrubReleased"
                    LostMouseCapture="OnTimelineScrubReleased">
                <Canvas x:Name="TimelineCanvas" ClipToBounds="True">
                    <ItemsControl x:Name="FilmstripItems" Canvas.Left="0" Canvas.Top="0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Rectangle x:Name="LeftDim" Canvas.Left="0" Canvas.Top="0" Height="54"
                               Fill="{StaticResource BadgeScrimBrush}" Width="0" IsHitTestVisible="False"/>
                    <Rectangle x:Name="RightDim" Canvas.Top="0" Height="54"
                               Fill="{StaticResource BadgeScrimBrush}" Width="0" IsHitTestVisible="False"/>

                    <Border x:Name="SelectionBorder" Canvas.Top="0" Height="54" Width="0"
                            BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                            CornerRadius="4" IsHitTestVisible="False"/>

                    <Rectangle x:Name="Playhead" Canvas.Left="0" Canvas.Top="2" Width="2" Height="50"
                               Fill="{StaticResource TextPrimaryBrush}" IsHitTestVisible="False"/>

                    <Thumb x:Name="TrimStartThumb" Canvas.Left="0" Canvas.Top="0" Width="12" Height="54"
                           Cursor="SizeWE" Focusable="True" IsTabStop="True"
                           AutomationProperties.Name="First frame"
                           AutomationProperties.HelpText="Use Left and Right Arrow to move one frame. Hold Shift for ten frames."
                           DragDelta="OnTrimStartDrag" KeyDown="OnTrimStartKeyDown">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Grid Background="Transparent">
                                    <Border x:Name="KeyboardFocusRing" BorderBrush="Transparent"
                                            BorderThickness="1" CornerRadius="3" Margin="1"/>
                                    <Border HorizontalAlignment="Right" Width="6" CornerRadius="3,0,0,3"
                                            Background="{StaticResource AccentBrush}"/>
                                    <Rectangle HorizontalAlignment="Right" Margin="0,0,2,0" Width="2" Height="18"
                                               RadiusX="1" RadiusY="1" Fill="{StaticResource TextPrimaryBrush}"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="KeyboardFocusRing" Property="BorderBrush" Value="{StaticResource InfoBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                    <Thumb x:Name="TrimEndThumb" Canvas.Left="0" Canvas.Top="0" Width="12" Height="54"
                           Cursor="SizeWE" Focusable="True" IsTabStop="True"
                           AutomationProperties.Name="Last frame"
                           AutomationProperties.HelpText="Use Left and Right Arrow to move one frame. Hold Shift for ten frames."
                           DragDelta="OnTrimEndDrag" KeyDown="OnTrimEndKeyDown">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Grid Background="Transparent">
                                    <Border x:Name="KeyboardFocusRing" BorderBrush="Transparent"
                                            BorderThickness="1" CornerRadius="3" Margin="1"/>
                                    <Border HorizontalAlignment="Left" Width="6" CornerRadius="0,3,3,0"
                                            Background="{StaticResource AccentBrush}"/>
                                    <Rectangle HorizontalAlignment="Left" Margin="2,0,0,0" Width="2" Height="18"
                                               RadiusX="1" RadiusY="1" Fill="{StaticResource TextPrimaryBrush}"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="KeyboardFocusRing" Property="BorderBrush" Value="{StaticResource InfoBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Canvas>
            </Border>

            <Grid Grid.Row="1" Margin="0,6,0,0">
                <TextBlock x:Name="TrimStartLabel" HorizontalAlignment="Left" Style="{StaticResource FieldLabel}"
                           FontFamily="{StaticResource MonoFamily}" Text="In 0"/>
                <TextBlock x:Name="TrimRangeLabel" HorizontalAlignment="Center" Style="{StaticResource FieldLabel}"
                           FontFamily="{StaticResource MonoFamily}" Text="0 frames"/>
                <TextBlock x:Name="TrimEndLabel" HorizontalAlignment="Right" Style="{StaticResource FieldLabel}"
                           FontFamily="{StaticResource MonoFamily}" Text="Out 0"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="{StaticResource LabelGutterMargin}">
                <TextBlock x:Name="OutputSummaryText" Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="{StaticResource TextCaption}" Margin="0,0,0,2"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.Name="Output summary"/>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis"
                           AutomationProperties.Name="Trim status"
                           AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnClose" Style="{StaticResource PillButtonSecondary}"
                        Content="Cancel" Margin="{StaticResource ChipGutterMargin}"
                        AutomationProperties.Name="Cancel editing"
                        AutomationProperties.HelpText="Closes the editor without changing the GIF."
                        Click="OnCloseEditor"/>
                <Button x:Name="BtnSave" Style="{StaticResource PillButtonPrimary}"
                        Content="Save trimmed" Margin="0" Click="OnSave"
                        AutomationProperties.Name="Save the trimmed GIF"
                        AutomationProperties.HelpText="Writes the kept frames beside the original. Keyboard shortcut: Control S."
                        AutomationProperties.AcceleratorKey="Control+S"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
