<Window x:Class="WinShot.SettingsUi.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinShot.SettingsUi"
        Title="WinShot - Settings" Width="660" Height="720" MinWidth="620" MinHeight="560"
        Background="{StaticResource WindowBgBrush}" ResizeMode="CanResize" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="WinShot settings"
        AutomationProperties.HelpText="Configure local WinShot capture, recording, and keyboard behavior.">
    <Window.Resources>
        <Style x:Key="SettingsFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3" RadiusX="10" RadiusY="10" StrokeThickness="2"
                                   Stroke="{StaticResource InfoBrush}"
                                   SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Row label: fixed-width, LEFT-aligned caption forming a clean left column. Left
             alignment (not right) makes labels start at the card's left edge — same line the
             card border/dividers start at — with controls forming their own left-aligned
             column to the right, instead of both hugging the center with a dead left gutter. -->
        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Width" Value="{StaticResource SettingsRowLabelWidth}"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="Margin" Value="{StaticResource LabelGutterMargin}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <!-- Matches DarkComboBox's disabled opacity, so a row whose control is gated
                     dims as one object instead of leaving a full-strength label beside a
                     ghosted control. Rows carry IsEnabled on the DockPanel; every future
                     gated row inherits this for free. -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Hint: muted helper text, sits under or beside a control. -->
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextHintBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="LineHeight" Value="{StaticResource LineHeightBody}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <!-- LEADING gutter: an un-overridden hint trails the control it explains inside a
                 horizontal row, so the gap belongs on its left. -->
            <Setter Property="Margin" Value="{StaticResource HintGutterMargin}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- Full-width hint that sits below a control, indented to the control column. -->
        <Style x:Key="SubHint" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="Margin" Value="{StaticResource SettingsSubHintMargin}"/>
        </Style>

        <!-- Implicit input styling so every box/combo/checkbox in the sections inherits
             the themed treatment without per-control Style= attributes.
             Foreground / CaretBrush / SelectionBrush are set EXPLICITLY here (not only via
             BasedOn) because this style replaces the template; that guarantees typed text is
             light and clearly visible on the dark input surface. -->
        <Style x:Key="SettingsTextBox" TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource TextBodyLg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bg" Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusInput}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource SettingsTextBox}"/>
        <!-- HotkeyBox inherits the readable input look but adds a muted "Record shortcut"
             placeholder when no gesture is assigned (matches CleanShot's recorder pills). -->
        <Style TargetType="{x:Type local:HotkeyBox}" BasedOn="{StaticResource SettingsTextBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type local:HotkeyBox}">
                        <Border x:Name="Bg" Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusInput}">
                            <Grid>
                                <TextBlock x:Name="Placeholder" Text="Record shortcut"
                                           Margin="8,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextHintBrush}"
                                           FontSize="{StaticResource TextBody}" FontWeight="Normal"
                                           IsHitTestVisible="False" Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource DarkCheckBox}">
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource DarkComboBox}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Slider" BasedOn="{StaticResource DarkSlider}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/>
        </Style>

        <!-- A grouped settings card. Compact padding for CleanShot-tight rhythm. -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ToolbarBgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
            <Setter Property="Padding" Value="14,8,14,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- One settings row: label + control, tight vertical rhythm. -->
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="LastChildFill" Value="True"/>
        </Style>

        <!-- Category header used on the Shortcuts list (small, muted, all-caps feel). -->
        <Style x:Key="ShortcutCategory" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,2,0,6"/>
        </Style>

        <!-- Hairline separator between groups within a card (CleanShot's inset dividers). -->
        <Style x:Key="GroupSep" TargetType="Rectangle">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Fill" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Margin" Value="{StaticResource GroupSepMargin}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- The tab strip's text half of the selection cross-fade. The chip half is the theme's
             ChipIn/ChipOut; these are the same MotionQuick step on the label's colour, so the
             pill and the word it holds arrive together instead of the word hard-cutting.
             Both target "Fg", the unfrozen brush each tab template declares. -->
        <Storyboard x:Key="TabTextSelect">
            <ColorAnimation Storyboard.TargetName="Fg" Storyboard.TargetProperty="Color"
                            To="{StaticResource AccentColor}" Duration="{StaticResource MotionQuick}"
                            EasingFunction="{StaticResource EaseOutCubic}"/>
        </Storyboard>
        <Storyboard x:Key="TabTextDeselect">
            <ColorAnimation Storyboard.TargetName="Fg" Storyboard.TargetProperty="Color"
                            To="{StaticResource TextSecondaryColor}" Duration="{StaticResource MotionQuick}"
                            EasingFunction="{StaticResource EaseOutCubic}"/>
        </Storyboard>
        <Storyboard x:Key="SubTabTextSelect">
            <ColorAnimation Storyboard.TargetName="Fg" Storyboard.TargetProperty="Color"
                            To="White" Duration="{StaticResource MotionQuick}"
                            EasingFunction="{StaticResource EaseOutCubic}"/>
        </Storyboard>
        <Storyboard x:Key="SubTabTextDeselect">
            <ColorAnimation Storyboard.TargetName="Fg" Storyboard.TargetProperty="Color"
                            To="{StaticResource TextSecondaryColor}" Duration="{StaticResource MotionQuick}"
                            EasingFunction="{StaticResource EaseOutCubic}"/>
        </Storyboard>

        <!-- Top tab: Fluent glyph stacked above a small label. Active tab tints accent,
             matching CleanShot's icon-over-label tab strip. -->
        <Style x:Key="NavTab" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                Padding="10,6" MinWidth="62">
                            <!-- Named, template-local, therefore UNFROZEN: a StaticResource brush
                                 is shared and immutable, so its Color cannot be animated. This is
                                 what carries the label from secondary to accent. It sits nearer
                                 the content than the style's own Foreground, so it wins. -->
                            <TextElement.Foreground>
                                <SolidColorBrush x:Name="Fg" Color="{StaticResource TextSecondaryColor}"/>
                            </TextElement.Foreground>
                            <Grid>
                                <Border x:Name="Hover" Opacity="0" CornerRadius="8"
                                        Background="{StaticResource HoverFillBrush}"/>
                                <Border x:Name="Chip" Opacity="0" CornerRadius="8"
                                        Background="{StaticResource HoverFillBrush}"/>
                                <ContentPresenter HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource ChipIn}"/>
                                    <BeginStoryboard Storyboard="{StaticResource TabTextSelect}"/>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource ChipOut}"/>
                                    <BeginStoryboard Storyboard="{StaticResource TabTextDeselect}"/>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A single icon-over-label tab cell. -->
        <!-- The rail's marks are DRAWN, so this styles the box rather than a face. Hosted at the
             family's own 18, not the 20-DIP glyph step it used to type at: the family authors its
             glyphs on a 24-unit grid at 1.667 units and hosts them at 18, which is what paints the
             house's 1.25 px line. A 20 px host would make this rail the one place in the app whose
             icons are a heavier stroke than everything else. -->
        <Style x:Key="NavTabIcon" TargetType="ContentControl">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,1,0,5"/>
        </Style>
        <Style x:Key="NavTabLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <!-- Sub-tab pill (Recording: General / Video / GIF). -->
        <Style x:Key="SubTab" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                Padding="14,4" Margin="2,0">
                            <TextElement.Foreground>
                                <SolidColorBrush x:Name="Fg" Color="{StaticResource TextSecondaryColor}"/>
                            </TextElement.Foreground>
                            <Grid>
                                <Border x:Name="Hover" Opacity="0" CornerRadius="6"
                                        Background="{StaticResource HoverFillBrush}"/>
                                <!-- AccentDeep, not Accent: the selected pill's label is white. -->
                                <Border x:Name="Chip" Opacity="0" CornerRadius="6"
                                        Background="{StaticResource AccentDeepBrush}"/>
                                <ContentPresenter HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource ChipIn}"/>
                                    <BeginStoryboard Storyboard="{StaticResource SubTabTextSelect}"/>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource ChipOut}"/>
                                    <BeginStoryboard Storyboard="{StaticResource SubTabTextDeselect}"/>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Column header for the "After capture" matrix. -->
        <Style x:Key="MatrixColHead" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Section scroller with an OVERLAY scrollbar: the 8px slim bar floats pinned to the
             far-right edge instead of taking layout space, so (a) content never reflows when
             the bar appears/disappears and (b) the bar sits the same distance from the app edge
             as the cards sit from the left edge, with a small gap before the cards. The right
             padding reserves that gutter so the bar never covers card content. -->
        <Style x:Key="SectionScroll" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <!-- 20px symmetric inset centers the cards in the window. -->
            <Setter Property="Padding" Value="20,0,20,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter Margin="{TemplateBinding Padding}"/>
                            <!-- 6px right margin centers the 8px bar within the 20px right
                                 margin: 6px gap to the cards, 6px gap to the app edge. -->
                            <ScrollBar x:Name="PART_VerticalScrollBar" Orientation="Vertical"
                                       HorizontalAlignment="Right" Margin="0,0,6,0" Minimum="0"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A centered, label-less checkbox for the matrix cells. Uses its OWN template (just
             the box) rather than DarkCheckBox: DarkCheckBox reserves an 8px content gutter, so
             centering it left-shifted the box ~4px off the column center where the "—" dashes
             sit. Box-only keeps checkbox and dash on the exact same centerline.
             The LAYERS and the storyboards are DarkCheckBox's, verbatim — Box / Hover / Chip /
             Check at zero opacity plus ChipIn/Out, CheckIn/Out, HoverIn/Out — so these eleven
             boxes tick with the same cross-fade as every other checkbox on the same pane.
             Opacity, never Visibility: Visibility cannot be animated. -->
        <Style x:Key="MatrixCheck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="18" Height="18">
                            <Border x:Name="Box" CornerRadius="5"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                            <Border x:Name="Hover" Opacity="0" CornerRadius="5"
                                    BorderBrush="{StaticResource BorderStrongOverBorderBrush}" BorderThickness="1"/>
                            <Border x:Name="Chip" Opacity="0" CornerRadius="5"
                                    Background="{StaticResource AccentBrush}"
                                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"/>
                            <Path x:Name="Check" Opacity="0"
                                  Stroke="White" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Data="M4,9 L8,13 L14,5"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource ChipIn}"/>
                                    <BeginStoryboard Storyboard="{StaticResource CheckIn}"/>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource ChipOut}"/>
                                    <BeginStoryboard Storyboard="{StaticResource CheckOut}"/>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A file-name token in the legend: reads as body text until you point at it. -->
        <Style x:Key="TokenLink" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="TextDecorations" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <!-- Info, not Accent: the raw accent is a fill colour and reads 4.14:1 as
                         type on the card, under the 4.5:1 floor. -->
                    <Setter Property="Foreground" Value="{StaticResource InfoBrush}"/>
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The "not available for this column" placeholder, centered on the SAME line as the box. -->
        <Style x:Key="MatrixNA" TargetType="TextBlock">
            <Setter Property="Text" Value="—"/>
            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- ShellRoot carries the entrance transform: a Window's own RenderTransform never
         reaches the HWND, so the scale-up has to ride on the root content element. -->
    <DockPanel x:Name="ShellRoot" Margin="0" RenderTransformOrigin="0.5,0.5">
        <DockPanel.RenderTransform>
            <ScaleTransform x:Name="ShellScale" ScaleX="1" ScaleY="1"/>
        </DockPanel.RenderTransform>

        <!-- =============================== TOP TAB BAR =============================== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource WindowBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <ListBox x:Name="SectionList" Background="Transparent" BorderThickness="0"
                     Padding="8,10" HorizontalAlignment="Center"
                     KeyboardNavigation.TabNavigation="Once"
                     AutomationProperties.Name="Settings categories"
                     AutomationProperties.HelpText="Use the arrow keys to choose a settings category."
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource NavTab}"
                     SelectedIndex="0" SelectionChanged="OnSectionChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBoxItem x:Name="GeneralNavItem" AutomationProperties.Name="General settings">
                    <StackPanel>
                        <ContentControl Style="{StaticResource NavTabIcon}" Content="{StaticResource SurveyIcon.Gear}"/>
                        <TextBlock Style="{StaticResource NavTabLabel}" Text="General"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem x:Name="ShortcutsNavItem" AutomationProperties.Name="Shortcut settings">
                    <StackPanel>
                        <ContentControl Style="{StaticResource NavTabIcon}" Content="{StaticResource SurveyIcon.Keyboard}"/>
                        <TextBlock Style="{StaticResource NavTabLabel}" Text="Shortcuts"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem x:Name="QuickAccessNavItem"
                             AutomationProperties.Name="Quick Access settings">
                    <StackPanel>
                        <ContentControl Style="{StaticResource NavTabIcon}" Content="{StaticResource SurveyIcon.TaskView}"/>
                        <TextBlock Style="{StaticResource NavTabLabel}" Text="Quick Access"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem x:Name="RecordingNavItem" AutomationProperties.Name="Recording settings">
                    <StackPanel>
                        <ContentControl Style="{StaticResource NavTabIcon}" Content="{StaticResource SurveyIcon.Video}"/>
                        <TextBlock Style="{StaticResource NavTabLabel}" Text="Recording"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem x:Name="ScreenshotsNavItem" AutomationProperties.Name="Screenshot settings">
                    <StackPanel>
                        <ContentControl Style="{StaticResource NavTabIcon}" Content="{StaticResource SurveyIcon.Camera}"/>
                        <TextBlock Style="{StaticResource NavTabLabel}" Text="Screenshots"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem x:Name="AnnotateNavItem" AutomationProperties.Name="Annotate settings">
                    <StackPanel>
                        <ContentControl Style="{StaticResource NavTabIcon}" Content="{StaticResource SurveyIcon.Pen}"/>
                        <TextBlock Style="{StaticResource NavTabLabel}" Text="Annotate"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem x:Name="AdvancedNavItem" AutomationProperties.Name="Advanced settings">
                    <StackPanel>
                        <ContentControl Style="{StaticResource NavTabIcon}" Content="{StaticResource SurveyIcon.Sliders}"/>
                        <TextBlock Style="{StaticResource NavTabLabel}" Text="Advanced"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem x:Name="AboutNavItem" AutomationProperties.Name="About WinShot">
                    <StackPanel>
                        <ContentControl Style="{StaticResource NavTabIcon}" Content="{StaticResource SurveyIcon.Info}"/>
                        <TextBlock Style="{StaticResource NavTabLabel}" Text="About"/>
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </Border>

        <!-- =============================== CONTENT PANE =============================== -->
        <!-- No horizontal margin here: the content pane spans edge-to-edge so the section
             cards can be centered (20px each side, via SectionScroll's symmetric padding) AND
             the overlay scrollbar can sit CENTERED in the 20px right margin (6px of gap on
             each side of the bar). The footer is inset 20px to match the cards. -->
        <DockPanel Margin="0,12,0,12">
            <!-- Footer action bar (inset to line up with the section cards) -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="20,6,20,0">
                <Grid>
                    <Button x:Name="RestoreDefaultsButton" Content="Restore defaults"
                            HorizontalAlignment="Left"
                            FocusVisualStyle="{StaticResource SettingsFocusVisual}"
                            AutomationProperties.Name="Restore defaults for this tab"
                            AutomationProperties.HelpText="Reset every setting on the tab you are looking at to its default."
                            Style="{StaticResource PillButtonSecondary}" Click="OnRestoreDefaults"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- "Close", not "Cancel": toggles apply as they change, so there is
                         nothing here to cancel. Only typed fields wait for Done. -->
                    <Button x:Name="CancelButton" Content="Close" IsCancel="True"
                            FocusVisualStyle="{StaticResource SettingsFocusVisual}"
                            AutomationProperties.Name="Close settings"
                            AutomationProperties.HelpText="Close Settings. Checkboxes and lists have already applied; typed fields need Done."
                            Style="{StaticResource PillButtonSecondary}" Click="OnCancel"/>
                    <Button x:Name="SaveButton" Content="Done" IsDefault="True"
                            FocusVisualStyle="{StaticResource SettingsFocusVisual}"
                            AutomationProperties.Name="Apply settings and close"
                            AutomationProperties.HelpText="Validate and apply the visible settings, then close this window."
                            Style="{StaticResource PillButtonPrimary}" Click="OnSave"/>
                </StackPanel>
                </Grid>
            </Border>

            <!-- Sections (only one visible at a time; toggled from OnSectionChanged) -->
            <Grid>
                <!-- ===================== GENERAL ===================== -->
                <ScrollViewer x:Name="SectionGeneral" Style="{StaticResource SectionScroll}">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="App behavior"/>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Startup"/>
                                    <CheckBox x:Name="StartupCheck" Content="Start at login"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Updates"/>
                                    <CheckBox x:Name="UpdatesCheck" Content="Check for updates on startup"/>
                                </DockPanel>
                                <DockPanel x:Name="SoundsRow" Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Sounds"/>
                                    <CheckBox x:Name="PlaySoundsCheck" Content="Play sounds"/>
                                </DockPanel>
                                <DockPanel x:Name="ShutterSoundRow" Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Shutter sound"/>
                                    <ComboBox x:Name="ShutterSoundCombo" HorizontalAlignment="Stretch"
                                              SelectionChanged="OnShutterSoundChanged">
                                        <ComboBoxItem Content="Default" Tag="default"/>
                                        <ComboBoxItem Content="Classic" Tag="classic"/>
                                        <ComboBoxItem Content="Subtle" Tag="subtle"/>
                                        <ComboBoxItem Content="Silent" Tag="silent"/>
                                    </ComboBox>
                                </DockPanel>
                                <DockPanel x:Name="TrayIconRow" Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="System tray"/>
                                    <CheckBox x:Name="ShowTrayIconCheck" Content="Show icon"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource SubHint}" TextWrapping="Wrap"
                                           Text="With the icon hidden, your shortcuts still work and winshot://settings reopens this window."/>

                                <Rectangle Style="{StaticResource GroupSep}"/>

                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Export location"/>
                                    <Button x:Name="BrowseSaveFolderButton" DockPanel.Dock="Right" Content="Browse..." MinWidth="84"
                                            FocusVisualStyle="{StaticResource SettingsFocusVisual}"
                                            AutomationProperties.Name="Browse for export location"
                                            AutomationProperties.HelpText="Choose the folder where WinShot saves captures."
                                            Style="{StaticResource PillButtonSecondary}" Click="OnBrowse"/>
                                    <TextBox x:Name="SaveFolderBox" Margin="{StaticResource ChipGutterMargin}"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Desktop icons"/>
                                    <CheckBox x:Name="HideIconsCheck" Content="Hide while capturing"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="AfterCaptureMatrix" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="After capture"/>
                                <TextBlock Style="{StaticResource SubHint}" Margin="0,0,0,2"
                                           TextWrapping="Wrap"
                                           Text="Every action you tick runs. Nothing is exclusive."/>

                                <Border Margin="0,10,0,0" HorizontalAlignment="Center"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="{StaticResource RadiusInput}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="82"/>
                                            <ColumnDefinition Width="82"/>
                                            <ColumnDefinition Width="210"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="30"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header row -->
                                        <Border Grid.Row="0" Grid.ColumnSpan="3"
                                                Background="{StaticResource SurfaceBrush}"
                                                CornerRadius="8,8,0,0"/>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource MatrixColHead}" Text="Screenshot"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource MatrixColHead}" Text="Recording"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource MatrixColHead}"
                                                   HorizontalAlignment="Left" Margin="{StaticResource MatrixCellMargin}" Text="Action"/>

                                        <!-- Row: Show Quick Access Overlay -->
                                        <CheckBox Grid.Row="1" Grid.Column="0" x:Name="ScreenshotShowOverlayCheck" Style="{StaticResource MatrixCheck}"/>
                                        <CheckBox Grid.Row="1" Grid.Column="1" x:Name="RecordingShowOverlayCheck" Style="{StaticResource MatrixCheck}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="{StaticResource TextBody}" VerticalAlignment="Center" Margin="{StaticResource MatrixCellMargin}" Text="Show the Quick Access card"/>

                                        <!-- Row: Copy file to clipboard -->
                                        <CheckBox Grid.Row="2" Grid.Column="0" x:Name="ScreenshotCopyCheck" Style="{StaticResource MatrixCheck}"/>
                                        <CheckBox Grid.Row="2" Grid.Column="1" x:Name="RecordingCopyCheck" Style="{StaticResource MatrixCheck}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="{StaticResource TextBody}" VerticalAlignment="Center" Margin="{StaticResource MatrixCellMargin}" Text="Copy file to clipboard"/>

                                        <!-- Row: Save -->
                                        <CheckBox Grid.Row="3" Grid.Column="0" x:Name="ScreenshotSaveCheck" Style="{StaticResource MatrixCheck}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource MatrixNA}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="2" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="{StaticResource TextBody}" VerticalAlignment="Center" Margin="{StaticResource MatrixCellMargin}" Text="Save to export location"/>

                                        <!-- Row: Open Annotate tool (screenshot only) -->
                                        <CheckBox Grid.Row="4" Grid.Column="0" x:Name="ScreenshotOpenAnnotateCheck" Style="{StaticResource MatrixCheck}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource MatrixNA}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="2" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="{StaticResource TextBody}" VerticalAlignment="Center" Margin="{StaticResource MatrixCellMargin}" Text="Open the annotation editor"/>

                                        <!-- Row: Pin to the screen (screenshot only) -->
                                        <CheckBox Grid.Row="5" Grid.Column="0" x:Name="ScreenshotPinCheck" Style="{StaticResource MatrixCheck}"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource MatrixNA}"/>
                                        <TextBlock Grid.Row="5" Grid.Column="2" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="{StaticResource TextBody}" VerticalAlignment="Center" Margin="{StaticResource MatrixCellMargin}" Text="Pin to the screen"/>

                                        <!-- Row: Open Video Editor (recording only) -->
                                        <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource MatrixNA}"/>
                                        <CheckBox Grid.Row="6" Grid.Column="1" x:Name="RecordingOpenEditorCheck" Style="{StaticResource MatrixCheck}"/>
                                        <TextBlock Grid.Row="6" Grid.Column="2" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="{StaticResource TextBody}" VerticalAlignment="Center" Margin="{StaticResource MatrixCellMargin}" Text="Open the video editor"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===================== SHORTCUTS ===================== -->
                <ScrollViewer x:Name="SectionShortcuts" Visibility="Collapsed"
                              Style="{StaticResource SectionScroll}">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Global shortcuts"/>
                                <!-- Rows are generated from the shortcut catalog in
                                     SettingsWindow.Shortcuts.cs (BuildShortcutsTab). -->
                                <StackPanel x:Name="ShortcutsHost"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,2"
                                           Text="Click a field and press the keys. Esc cancels, Backspace clears."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===================== QUICK ACCESS (overlay) ===================== -->
                <ScrollViewer x:Name="SectionQuickAccess" Visibility="Collapsed"
                              Style="{StaticResource SectionScroll}">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Placement"/>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Position on screen"/>
                                    <ComboBox x:Name="OverlayPositionCombo" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="Left" Tag="left"/>
                                        <ComboBoxItem Content="Right" Tag="right"/>
                                        <ComboBoxItem Content="Top" Tag="top"/>
                                        <ComboBoxItem Content="Bottom" Tag="bottom"/>
                                        <ComboBoxItem Content="Bottom left" Tag="bottom-left"/>
                                        <ComboBoxItem Content="Bottom right" Tag="bottom-right"/>
                                    </ComboBox>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Multi-display"/>
                                    <CheckBox x:Name="OverlayMoveToActiveScreenCheck" Content="Move to active screen"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource SubHint}"
                                           Text="Active screen is the screen where your cursor is pointing."/>
                                <DockPanel Style="{StaticResource Row}" Margin="{StaticResource GroupLabelMargin}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Overlay size"/>
                                    <Slider x:Name="OverlaySizeSlider" HorizontalAlignment="Stretch"
                                            Minimum="0" Maximum="100" Value="50"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Dismissal"/>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Auto-close"/>
                                    <CheckBox x:Name="OverlayAutoCloseCheck" Content="Enable"
                                              Checked="OnOverlayAutoCloseToggled" Unchecked="OnOverlayAutoCloseToggled"/>
                                </DockPanel>
                                <DockPanel x:Name="OverlayActionRow" Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Action"/>
                                    <ComboBox x:Name="OverlayActionCombo" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="Save and close" Tag="save-close"/>
                                        <ComboBoxItem Content="Copy and close" Tag="copy-close"/>
                                        <ComboBoxItem Content="Close" Tag="close"/>
                                    </ComboBox>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Interval"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="OverlayCloseBox" Width="80"/>
                                        <TextBlock Style="{StaticResource Hint}" Text="seconds before it closes"/>
                                    </StackPanel>
                                </DockPanel>

                                <Rectangle Style="{StaticResource GroupSep}"/>

                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Drag &amp; drop"/>
                                    <CheckBox x:Name="OverlayCloseAfterDragCheck" Content="Close after dragging"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource SubHint}"
                                           Text="Hold Alt to keep the item on the card after dragging."/>
                                <DockPanel Style="{StaticResource Row}" Margin="{StaticResource GroupLabelMargin}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Save button behavior"/>
                                    <ComboBox x:Name="OverlaySaveBehaviorCombo" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="Save to &quot;Export location&quot;" Tag="export"/>
                                        <ComboBoxItem Content="Always ask where to save" Tag="ask"/>
                                    </ComboBox>
                                </DockPanel>
                                <TextBlock Style="{StaticResource SubHint}"
                                           Text="Press with Alt to choose the destination."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===================== RECORDING ===================== -->
                <ScrollViewer x:Name="SectionRecording" Visibility="Collapsed"
                              Style="{StaticResource SectionScroll}">
                    <StackPanel>
                        <!-- Sub-tab strip: General / Video / GIF -->
                        <ListBox x:Name="RecordingSubList" Background="Transparent" BorderThickness="0"
                                 HorizontalAlignment="Center" Margin="0,0,0,10"
                                 KeyboardNavigation.TabNavigation="Once"
                                 AutomationProperties.Name="Recording categories"
                                 AutomationProperties.HelpText="Use the arrow keys to choose general, video, or GIF settings."
                                 ItemContainerStyle="{StaticResource SubTab}"
                                 SelectedIndex="0" SelectionChanged="OnRecordingSubChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBoxItem Content="General" AutomationProperties.Name="General recording settings"/>
                            <ListBoxItem Content="Video" AutomationProperties.Name="Video recording settings"/>
                            <ListBoxItem Content="GIF" AutomationProperties.Name="GIF recording settings"/>
                        </ListBox>

                        <!-- The three sub-panels overlap in a Grid rather than stacking in
                             the parent StackPanel: the cross-fade keeps the outgoing panel
                             visible for its whole fade, and as siblings in a column that
                             doubled the scroll content and made the incoming panel arrive
                             below the fold before snapping back. -->
                        <Grid>
                        <!-- Recording > General -->
                        <StackPanel x:Name="RecordingGeneralPanel" VerticalAlignment="Top">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="While recording"/>
                                    <DockPanel x:Name="RecordingControlsRow" Style="{StaticResource Row}">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Controls"/>
                                        <CheckBox x:Name="ShowRecordingControlsCheck" Content="Show controls while recording"/>
                                    </DockPanel>
                                    <DockPanel x:Name="RecordingTimerRow" Style="{StaticResource Row}">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="System tray"/>
                                        <CheckBox x:Name="ShowRecordingTimerCheck" Content="Display recording time"/>
                                    </DockPanel>
                                    <DockPanel x:Name="RecordingScaleRow" Style="{StaticResource Row}">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="HiDPI"/>
                                        <CheckBox x:Name="ScaleHiDpiVideoCheck" Content="Scale HiDPI videos to 1x"/>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource Row}">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Notifications"/>
                                        <CheckBox x:Name="DoNotDisturbCheck" Content="Silence notifications while recording"/>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource SubHint}"
                                               Text="Notification banners are turned back on when the recording ends."/>

                                    <Rectangle Style="{StaticResource GroupSep}"/>

                                    <DockPanel Style="{StaticResource Row}">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Cursor"/>
                                        <CheckBox x:Name="CaptureCursorCheck" Content="Show cursor"/>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource Row}">
                                        <TextBlock Style="{StaticResource RowLabel}" Text=""/>
                                        <CheckBox x:Name="ClickHighlightsCheck" Content="Highlight clicks"/>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource Row}">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Keyboard"/>
                                        <CheckBox x:Name="KeystrokesCheck" Content="Show keystrokes"
                                                  Checked="OnKeystrokesToggled" Unchecked="OnKeystrokesToggled"/>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource Row}">
                                        <TextBlock Style="{StaticResource RowLabel}" Text=""/>
                                        <CheckBox x:Name="KeystrokesCommandOnlyCheck" Content="Show only command keys"/>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource SubHint}"
                                               Text="Shortcuts are shown; plain typing is not."/>
                                    <DockPanel Style="{StaticResource Row}">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Keystrokes at"/>
                                        <ComboBox x:Name="KeystrokePositionCombo" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Top left" Tag="top-left"/>
                                            <ComboBoxItem Content="Top center" Tag="top-center"/>
                                            <ComboBoxItem Content="Top right" Tag="top-right"/>
                                            <ComboBoxItem Content="Bottom left" Tag="bottom-left"/>
                                            <ComboBoxItem Content="Bottom center" Tag="bottom-center"/>
                                            <ComboBoxItem Content="Bottom right" Tag="bottom-right"/>
                                        </ComboBox>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource Row}">
                                        <TextBlock Style="{StaticResource RowLabel}" Text=""/>
                                        <CheckBox x:Name="HideCursorWhenTypingCheck" Content="Hide the cursor while typing"/>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource SubHint}"
                                               Text="Keeps the pointer out of the recording while you type, and brings it back when you stop."/>

                                    <Rectangle Style="{StaticResource GroupSep}"/>

                                    <DockPanel x:Name="RememberRecordingAreaRow" Style="{StaticResource Row}">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Recording area"/>
                                        <CheckBox x:Name="RememberLastSelectionCheck" Content="Remember last selection"/>
                                    </DockPanel>
                                    <DockPanel x:Name="DimScreenRow" Style="{StaticResource Row}">
                                        <TextBlock Style="{StaticResource RowLabel}" Text=""/>
                                        <CheckBox x:Name="DimScreenCheck" Content="Dim screen while recording"/>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource Row}">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Countdown"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="CountdownBox" Width="80"/>
                                            <TextBlock Style="{StaticResource Hint}" Text="seconds, 0 = start immediately"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <Rectangle Style="{StaticResource GroupSep}"/>

                                    <DockPanel Style="{StaticResource Row}">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Webcam"/>
                                        <ComboBox x:Name="WebcamCombo" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Off" Tag="off"/>
                                            <ComboBoxItem Content="Top left" Tag="top-left"/>
                                            <ComboBoxItem Content="Top right" Tag="top-right"/>
                                            <ComboBoxItem Content="Bottom left" Tag="bottom-left"/>
                                            <ComboBoxItem Content="Bottom right" Tag="bottom-right"/>
                                            <ComboBoxItem Content="Fullscreen" Tag="fullscreen"/>
                                        </ComboBox>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource Row}">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Webcam size"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="WebcamSizeBox" Width="80"/>
                                            <TextBlock Style="{StaticResource Hint}" Text="10-45%"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource Row}">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Camera"/>
                                        <ComboBox x:Name="WebcamDeviceCombo" HorizontalAlignment="Stretch"/>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource SubHint}"
                                               Text="Cameras are re-listed each time this pane opens."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Recording > Video -->
                        <StackPanel x:Name="RecordingVideoPanel" Visibility="Collapsed" VerticalAlignment="Top">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="Video output"/>
                                    <DockPanel x:Name="MaxResolutionRow" Style="{StaticResource Row}">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Max resolution"/>
                                        <ComboBox x:Name="MaxResolutionCombo" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Original" Tag="original"/>
                                            <ComboBoxItem Content="4K" Tag="4k"/>
                                            <ComboBoxItem Content="1440p" Tag="1440p"/>
                                            <ComboBoxItem Content="1080p" Tag="1080p"/>
                                            <ComboBoxItem Content="720p" Tag="720p"/>
                                            <ComboBoxItem Content="480p" Tag="480p"/>
                                        </ComboBox>
                                    </DockPanel>
                                    <TextBlock x:Name="MaxResolutionHint" Style="{StaticResource SubHint}"
                                               Text="Set maximum resolution to reduce file size and upload time."/>

                                    <DockPanel Style="{StaticResource Row}" Margin="{StaticResource GroupLabelMargin}">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Video frames per second"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="RecordingFpsBox" Width="80"/>
                                            <TextBlock Style="{StaticResource Hint}" Text="10-60 fps"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource Row}">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Quality"/>
                                        <ComboBox x:Name="VideoQualityCombo" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="High" Tag="85"/>
                                            <ComboBoxItem Content="Medium" Tag="70"/>
                                            <ComboBoxItem Content="Low" Tag="50"/>
                                        </ComboBox>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource SubHint}"
                                               Text="Lower quality writes a smaller file at the same resolution."/>

                                    <Rectangle Style="{StaticResource GroupSep}"/>

                                    <DockPanel Style="{StaticResource Row}">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Audio"/>
                                        <CheckBox x:Name="RecordAudioCheck" Content="Capture microphone while recording"/>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource Row}">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Microphone"/>
                                        <ComboBox x:Name="MicrophoneDeviceCombo" HorizontalAlignment="Stretch"/>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource Row}">
                                        <TextBlock Style="{StaticResource RowLabel}" Text=""/>
                                        <CheckBox x:Name="SystemAudioCheck" Content="Capture system sound while recording"/>
                                    </DockPanel>
                                    <DockPanel x:Name="RecordMonoRow" Style="{StaticResource Row}">
                                        <TextBlock Style="{StaticResource RowLabel}" Text=""/>
                                        <CheckBox x:Name="RecordAudioMonoCheck" Content="Record audio in mono"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Recording > GIF -->
                        <StackPanel x:Name="RecordingGifPanel" Visibility="Collapsed" VerticalAlignment="Top">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="GIF output"/>
                                    <DockPanel Style="{StaticResource Row}">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="GIF frames per second"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="GifFpsBox" Width="80"/>
                                            <TextBlock Style="{StaticResource Hint}" Text="5-20 fps"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <DockPanel x:Name="GifQualityRow" Style="{StaticResource Row}" Margin="{StaticResource GroupLabelMargin}">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="GIF quality"/>
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel Width="180">
                                                <Slider x:Name="GifQualitySlider" Minimum="0" Maximum="100" Value="80"/>
                                                <Grid Margin="2,1,2,0">
                                                    <TextBlock Style="{StaticResource Hint}" Margin="0" HorizontalAlignment="Left" Text="Low"/>
                                                    <TextBlock Style="{StaticResource Hint}" Margin="0" HorizontalAlignment="Right" Text="High"/>
                                                </Grid>
                                            </StackPanel>
                                            <CheckBox x:Name="OptimizeGifsCheck" Content="Optimize GIFs" Margin="14,0,0,0" VerticalAlignment="Top"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock x:Name="GifQualityHint" Style="{StaticResource SubHint}"
                                               Text="Setting the quality to maximum can speed up the processing time, but it will increase file size."/>

                                    <DockPanel x:Name="GifSizeRow" Style="{StaticResource Row}" Margin="{StaticResource GroupLabelMargin}">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="GIF size"/>
                                        <ComboBox x:Name="GifSizeCombo" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="800 x auto (default)" Tag="800"/>
                                            <ComboBoxItem Content="640 x auto" Tag="640"/>
                                            <ComboBoxItem Content="480 x auto" Tag="480"/>
                                            <ComboBoxItem Content="Original" Tag="auto"/>
                                        </ComboBox>
                                    </DockPanel>
                                    <TextBlock x:Name="GifSizeHint" Style="{StaticResource SubHint}"
                                               Text="Set maximum resolution of your GIFs. Changing it will affect file size and quality. WinShot will only downscale the GIF if needed."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===================== SCREENSHOTS ===================== -->
                <ScrollViewer x:Name="SectionScreenshots" Visibility="Collapsed"
                              Style="{StaticResource SectionScroll}">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Output"/>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="File format"/>
                                    <ComboBox x:Name="FormatCombo" HorizontalAlignment="Stretch"
                                              SelectionChanged="OnFormatChanged">
                                        <ComboBoxItem Content="PNG" Tag="png"/>
                                        <ComboBoxItem Content="JPG" Tag="jpg"/>
                                        <ComboBoxItem Content="WEBP" Tag="webp"/>
                                        <ComboBoxItem Content="Automatic" Tag="auto"/>
                                    </ComboBox>
                                </DockPanel>
                                <TextBlock x:Name="FormatAutoHint" Style="{StaticResource SubHint}"
                                           Visibility="Collapsed"
                                           Text="Automatic saves screenshots of text and interfaces as PNG, and photographic captures as JPEG."/>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="HiDPI"/>
                                    <CheckBox x:Name="HiDpiCheck" Content="Scale HiDPI screenshots to 1x"/>
                                </DockPanel>
                                <DockPanel x:Name="ScreenshotBackgroundRow" Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Background"/>
                                    <ComboBox x:Name="BackgroundCombo" HorizontalAlignment="Stretch"
                                              SelectionChanged="OnBackgroundModeChanged">
                                        <ComboBoxItem Content="None" Tag="none"/>
                                        <ComboBoxItem Content="Wallpaper" Tag="wallpaper"/>
                                        <ComboBoxItem Content="Gradient" Tag="gradient"/>
                                        <ComboBoxItem Content="Solid color" Tag="color"/>
                                    </ComboBox>
                                </DockPanel>
                                <DockPanel x:Name="ScreenshotBackgroundColorRow" Style="{StaticResource Row}" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Color"/>
                                    <Border x:Name="BackgroundColorSwatch" Width="22" Height="22" CornerRadius="4"
                                            DockPanel.Dock="Right" Margin="8,0,0,0"
                                            BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"/>
                                    <TextBox x:Name="BackgroundColorBox" Style="{StaticResource SettingsTextBox}"
                                             TextChanged="OnBackgroundColorChanged"/>
                                </DockPanel>
                                <DockPanel x:Name="ScreenshotBackgroundShadowRow" Style="{StaticResource Row}" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Shadow"/>
                                    <CheckBox x:Name="BackgroundShadowCheck" Content="Drop a shadow under the screenshot"/>
                                </DockPanel>
                                <TextBlock x:Name="ScreenshotBackgroundHint" Style="{StaticResource SubHint}"
                                           Visibility="Collapsed"
                                           Text="Every screenshot is padded and placed on this background as it is taken. The Quick Access card's background button still composes one capture at a time."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Self-timer"/>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Self-timer interval"/>
                                    <ComboBox x:Name="SelfTimerCombo" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="3 seconds" Tag="3"/>
                                        <ComboBoxItem Content="5 seconds" Tag="5"/>
                                        <ComboBoxItem Content="10 seconds" Tag="10"/>
                                        <ComboBoxItem Content="15 seconds" Tag="15"/>
                                    </ComboBox>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Cursor"/>
                                    <CheckBox x:Name="CursorOnScreenshotsCheck" Content="Show on screenshots"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource SubHint}"
                                           Text="Applies to captures taken without the selection overlay."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Selection"/>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Freeze screen"/>
                                    <CheckBox x:Name="FreezeScreenCheck" Content="Freeze screen when taking a screenshot"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Crosshair mode"/>
                                    <ComboBox x:Name="CrosshairModeCombo" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="Always show" Tag="always"/>
                                        <ComboBoxItem Content="When Ctrl is held" Tag="command"/>
                                        <ComboBoxItem Content="Never" Tag="never"/>
                                    </ComboBox>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text=""/>
                                    <CheckBox x:Name="ShowMagnifierCheck" Content="Show magnifier"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Region capture"/>
                                    <CheckBox x:Name="AdjustSelectionCheck" Content="Adjust selection before capturing"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource SubHint}"
                                           Text="When off, releasing the drag takes the shot. Hold Ctrl as you release to get the other behavior once."/>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Window capture"/>
                                    <ComboBox x:Name="WindowBackgroundCombo" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="On the wallpaper" Tag="wallpaper"/>
                                        <ComboBoxItem Content="Bare window" Tag="none"/>
                                    </ComboBox>
                                </DockPanel>
                                <TextBlock Style="{StaticResource SubHint}"
                                           Text="Hold Shift while taking a window shot to get the bare window this once."/>
                                <DockPanel x:Name="WindowPaddingRow" Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Padding"/>
                                    <ComboBox x:Name="WindowPaddingCombo" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="Min" Tag="min"/>
                                        <ComboBoxItem Content="Default" Tag="default"/>
                                        <ComboBoxItem Content="Max" Tag="max"/>
                                    </ComboBox>
                                </DockPanel>
                                <DockPanel x:Name="TrimWindowShadowRow" Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Window shadow"/>
                                    <CheckBox x:Name="TrimWindowShadowCheck" Content="Trim the shadow from rounded corners"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource SubHint}"
                                           Text="Windows 11 rounds a window and draws its shadow behind those corners. Trimming leaves them transparent instead of keeping a grey wedge of whatever was underneath."/>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Measure tolerance"/>
                                    <ComboBox x:Name="MeasureToleranceCombo" HorizontalAlignment="Stretch"
                                              SelectionChanged="OnMeasureToleranceChanged">
                                        <ComboBoxItem Content="Low" Tag="15"/>
                                        <ComboBoxItem Content="Medium (default)" Tag="30"/>
                                        <ComboBoxItem Content="High" Tag="60"/>
                                    </ComboBox>
                                </DockPanel>
                                <TextBlock Style="{StaticResource SubHint}"
                                           Text="How far a pixel may drift and still count as the same object. The mouse wheel changes it live while measuring."/>
                                <!-- Legacy "Show crosshair" toggle kept for persistence; folded into Crosshair mode. -->
                                <CheckBox x:Name="ShowCrosshairCheck" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===================== ANNOTATE ===================== -->
                <ScrollViewer x:Name="SectionAnnotate" Visibility="Collapsed"
                              Style="{StaticResource SectionScroll}">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Editor"/>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Arrow tool"/>
                                    <CheckBox x:Name="InverseArrowCheck" Content="Inverse arrow direction"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource SubHint}"
                                           Text="Press Alt when drawing to invert the behavior."/>
                                <DockPanel Style="{StaticResource Row}" Margin="{StaticResource GroupLabelMargin}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Pencil tool"/>
                                    <CheckBox x:Name="SmoothPencilCheck" Content="Smooth drawing"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource SubHint}"
                                           Text="Turns a scribble into a smooth curve when you let go. Turn it off to keep the line exactly as drawn."/>
                                <DockPanel Style="{StaticResource Row}" Margin="{StaticResource GroupLabelMargin}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Canvas"/>
                                    <CheckBox x:Name="AutoExpandCanvasCheck" Content="Automatically expand"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource SubHint}"
                                           Text="Ensures all annotations fit by dynamically resizing canvas."/>
                                <!-- "Editor behavior" was its own bordered card for this one row:
                                     a header, 14,8,14,10 of padding and a 10 px margin around a
                                     single checkbox, which reads as a pane that lost something.
                                     It is a group inside this card, separated the same way the
                                     three rows above it are. -->
                                <DockPanel Style="{StaticResource Row}" Margin="{StaticResource GroupLabelMargin}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Window"/>
                                    <CheckBox x:Name="AlwaysOnTopCheck" Content="Always on top"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource SubHint}"
                                           Text="Keeps the editor above other windows while you annotate."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===================== ADVANCED ===================== -->
                <ScrollViewer x:Name="SectionAdvanced" Visibility="Collapsed"
                              Style="{StaticResource SectionScroll}">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="File names"/>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="File name"/>
                                    <TextBox x:Name="TemplateBox" TextChanged="OnTemplateChanged"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Preview"/>
                                    <TextBlock x:Name="TemplatePreviewText" Foreground="{StaticResource InfoBrush}"
                                               FontSize="{StaticResource TextBody}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <DockPanel x:Name="AskForNameRow" Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text=""/>
                                    <CheckBox x:Name="AskForNameCheck" Content="Ask for a name when a capture saves automatically"/>
                                </DockPanel>
                                <!-- Every token is a link that inserts itself at the caret. A
                                     legend you have to retype is a legend you read once and
                                     then guess at. -->
                                <TextBlock x:Name="TemplateLegend" FontSize="{StaticResource TextCaption}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           LineHeight="{StaticResource LineHeightBody}" Margin="{StaticResource SettingsHintBelowMargin}">
                                    <Hyperlink Style="{StaticResource TokenLink}" Tag="{}{date}" Click="OnInsertToken"><Run Text="{}{date}"/></Hyperlink><Run Text="  current date"/><LineBreak/>
                                    <Hyperlink Style="{StaticResource TokenLink}" Tag="{}{time}" Click="OnInsertToken"><Run Text="{}{time}"/></Hyperlink><Run Text="  current time"/><LineBreak/>
                                    <Hyperlink Style="{StaticResource TokenLink}" Tag="{}{n}" Click="OnInsertToken"><Run Text="{}{n}"/></Hyperlink><Run Text="  auto-incrementing counter"/><LineBreak/>
                                    <Hyperlink Style="{StaticResource TokenLink}" Tag="{}{app}" Click="OnInsertToken"><Run Text="{}{app}"/></Hyperlink><Run Text="  active application name"/><LineBreak/>
                                    <Hyperlink Style="{StaticResource TokenLink}" Tag="{}{title}" Click="OnInsertToken"><Run Text="{}{title}"/></Hyperlink><Run Text="  active window title"/><LineBreak/>
                                    <Run Text="Click a token to insert it."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border x:Name="NotificationsCard" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Confirmations"/>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Text captured"/>
                                    <ComboBox x:Name="NotifyOcrCombo" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="In WinShot (default)" Tag="in-app"/>
                                        <ComboBoxItem Content="Windows notification" Tag="system"/>
                                        <ComboBoxItem Content="Nothing" Tag="off"/>
                                    </ComboBox>
                                </DockPanel>
                                <Rectangle Style="{StaticResource GroupSep}"/>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Copied"/>
                                    <ComboBox x:Name="NotifyCopyCombo" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="In WinShot (default)" Tag="in-app"/>
                                        <ComboBoxItem Content="Windows notification" Tag="system"/>
                                        <ComboBoxItem Content="Nothing" Tag="off"/>
                                    </ComboBox>
                                </DockPanel>
                                <Rectangle Style="{StaticResource GroupSep}"/>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Saved"/>
                                    <ComboBox x:Name="NotifySaveCombo" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="In WinShot (default)" Tag="in-app"/>
                                        <ComboBoxItem Content="Windows notification" Tag="system"/>
                                        <ComboBoxItem Content="Nothing" Tag="off"/>
                                    </ComboBox>
                                </DockPanel>
                                <TextBlock Style="{StaticResource SubHint}"
                                           Text="Windows notifications can be held back by Focus assist and carry no buttons. Nothing also stops the tray icon's confirmation. Failures are always shown."/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="PinnedStyleCard" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Pinned screenshots"/>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Pinned screenshots"/>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox x:Name="PinnedRoundedCornersCheck" Content="Rounded corners" Margin="{StaticResource LabelGutterMargin}"/>
                                        <CheckBox x:Name="PinnedShadowCheck" Content="Shadow" Margin="{StaticResource LabelGutterMargin}"/>
                                        <CheckBox x:Name="PinnedBorderCheck" Content="Border"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Capture history"/>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Keep history"/>
                                    <Slider x:Name="HistorySlider" HorizontalAlignment="Stretch"
                                            Minimum="0" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True"
                                            ValueChanged="OnHistorySliderChanged"/>
                                </DockPanel>
                                <!-- Half-width end columns: the six labels then centre on i/5 of the
                                     row, which is where the slider puts stop i. Six equal columns put
                                     every interior label a twentieth of the track off its own tick. -->
                                <Grid Margin="{StaticResource SettingsRowIndentMargin}" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.5*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="0.5*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Never" Foreground="{StaticResource TextHintBrush}" FontSize="{StaticResource TextMicro}" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Column="1" Text="No age limit" Foreground="{StaticResource TextHintBrush}" FontSize="{StaticResource TextMicro}" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="1 day" Foreground="{StaticResource TextHintBrush}" FontSize="{StaticResource TextMicro}" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="3 days" Foreground="{StaticResource TextHintBrush}" FontSize="{StaticResource TextMicro}" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="1 week" Foreground="{StaticResource TextHintBrush}" FontSize="{StaticResource TextMicro}" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="1 month" Foreground="{StaticResource TextHintBrush}" FontSize="{StaticResource TextMicro}" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock x:Name="HistoryRetentionHint" Style="{StaticResource SubHint}" Margin="{StaticResource SettingsHintBelowMargin}"
                                           Text="Age cleanup is separate from the item limit shown in capture history."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Capture behavior"/>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="All-In-One"/>
                                    <CheckBox x:Name="AllInOneRememberCheck" Content="Remember last selection"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Text recognition"/>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Text recognition"/>
                                    <!-- Filled at load time from the recognizer packs this machine
                                         actually has; a hard-coded list offers languages that would
                                         silently fall back. -->
                                    <ComboBox x:Name="OcrLanguageCombo" HorizontalAlignment="Stretch"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text=""/>
                                    <StackPanel>
                                        <CheckBox x:Name="OcrJoinLinesCheck" Content="Join recognized lines"/>
                                        <CheckBox x:Name="OcrDetectLinksCheck" Content="Offer to open a detected link" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Hidden: retention is now driven by the Keep-history slider above. -->
                        <TextBox x:Name="RetentionDaysBox" Visibility="Collapsed"/>
                        <TextBox x:Name="HistoryLimitBox" Visibility="Collapsed"/>
                        <TextBox x:Name="SelfTimerBox" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===================== ABOUT ===================== -->
                <ScrollViewer x:Name="SectionAbout" Visibility="Collapsed"
                              Style="{StaticResource SectionScroll}">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Margin="4,8" HorizontalAlignment="Center">
                                <!-- The shipped mark itself, not a stand-in glyph: About, the tray
                                     and the exe all show one WinShot icon. -->
                                <Image x:Name="AboutIconImage" Width="{StaticResource GlyphHero}"
                                       Height="{StaticResource GlyphHero}" HorizontalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       AutomationProperties.Name="WinShot icon"/>
                                <TextBlock Text="WinShot" FontSize="{StaticResource TextDisplay}" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="AboutVersionText" HorizontalAlignment="Center"
                                           Margin="0,2,0,0" FontSize="{StaticResource TextBodyLg}"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="A fast, lightweight screenshot &amp; recording tool for Windows."
                                           HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="{StaticResource TextBody}"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="What's new"/>
                                <TextBlock x:Name="AboutReleaseNotesStatus" Style="{StaticResource SubHint}"
                                           Margin="0,0,0,4" Text="Checking GitHub for the latest release notes…"/>
                                <ScrollViewer x:Name="AboutReleaseNotesScroll" MaxHeight="150"
                                              Visibility="Collapsed"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock x:Name="AboutReleaseNotesText" TextWrapping="Wrap"
                                               LineHeight="{StaticResource LineHeightBody}" Margin="{StaticResource ChipGutterMargin}"
                                               FontSize="{StaticResource TextBody}"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Build"/>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Version"/>
                                    <TextBlock x:Name="AboutVersionValue" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </DockPanel>

                                <ToggleButton x:Name="AboutDiagnosticsToggle" Style="{StaticResource DisclosureToggle}"
                                              Content="Diagnostics"
                                              AutomationProperties.Name="Show diagnostics"
                                              AutomationProperties.HelpText="Show the runtime, Windows version, and install folder."
                                              Checked="OnDiagnosticsToggled" Unchecked="OnDiagnosticsToggled"/>
                                <StackPanel x:Name="AboutDiagnosticsPanel" Visibility="Collapsed">
                                    <DockPanel Style="{StaticResource Row}">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Runtime"/>
                                        <TextBlock x:Name="AboutRuntimeValue" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource Row}">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Windows"/>
                                        <TextBlock x:Name="AboutOsValue" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource Row}">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Install folder"/>
                                        <TextBlock x:Name="AboutInstallValue" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Third-party notices"/>
                                <TextBlock Style="{StaticResource SubHint}" Margin="0,0,0,4" TextWrapping="Wrap"
                                           Text="WinShot ships thirteen MIT packages and one under Apache-2.0. Their notices travel with the app."/>
                                <ToggleButton x:Name="AboutNoticesToggle" Style="{StaticResource DisclosureToggle}"
                                              Content="Read the notices"
                                              AutomationProperties.Name="Show third-party notices"
                                              AutomationProperties.HelpText="Show the licence notices for the packages WinShot ships."
                                              Checked="OnNoticesToggled" Unchecked="OnNoticesToggled"/>
                                <StackPanel x:Name="AboutNoticesPanel" Visibility="Collapsed">
                                    <ScrollViewer MaxHeight="220" Margin="0,4,0,6"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <TextBlock x:Name="AboutNoticesText" TextWrapping="Wrap"
                                                   LineHeight="{StaticResource LineHeightBody}" Margin="{StaticResource ChipGutterMargin}"
                                                   FontSize="{StaticResource TextCaption}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </ScrollViewer>
                                    <Button x:Name="AboutLicensesButton" Content="Open the licence files"
                                            MinWidth="170" HorizontalAlignment="Left"
                                            FocusVisualStyle="{StaticResource SettingsFocusVisual}"
                                            AutomationProperties.Name="Open the licence files"
                                            AutomationProperties.HelpText="Open the folder holding the full licence texts shipped with WinShot."
                                            Style="{StaticResource PillButtonSecondary}" Click="OnAboutOpenLicenses"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Updates and links"/>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Updates"/>
                                    <Button x:Name="AboutCheckUpdatesButton" Content="Check for updates"
                                             MinWidth="160" HorizontalAlignment="Left"
                                             FocusVisualStyle="{StaticResource SettingsFocusVisual}"
                                             AutomationProperties.Name="Check for WinShot updates"
                                             AutomationProperties.HelpText="Check GitHub Releases for a newer WinShot version."
                                             Style="{StaticResource PillButtonSecondary}" Click="OnAboutCheckUpdates"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Project"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="AboutRepositoryButton" Content="GitHub repository" MinWidth="160"
                                                 HorizontalAlignment="Left"
                                                 FocusVisualStyle="{StaticResource SettingsFocusVisual}"
                                                 AutomationProperties.Name="Open WinShot GitHub repository"
                                                 AutomationProperties.HelpText="Open the WinShot source repository in your browser."
                                                 Style="{StaticResource PillButtonSecondary}" Click="OnAboutOpenRepo"/>
                                        <Button x:Name="AboutLogsButton" Content="Open logs folder" MinWidth="140" Margin="8,0,0,0"
                                                 HorizontalAlignment="Left"
                                                 FocusVisualStyle="{StaticResource SettingsFocusVisual}"
                                                 AutomationProperties.Name="Open WinShot logs folder"
                                                 AutomationProperties.HelpText="Open the local WinShot diagnostic logs folder."
                                                 Style="{StaticResource PillButtonSecondary}" Click="OnAboutOpenLogs"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </DockPanel>
</Window>
