<Window x:Class="WinShot.SettingsUi.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinShot.SettingsUi"
        Title="WinShot - Settings" Width="860" Height="700" MinWidth="780" MinHeight="560"
        Background="{StaticResource WindowBgBrush}" ResizeMode="CanResize" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="WinShot settings"
        AutomationProperties.HelpText="Configure local WinShot capture, recording, and keyboard behavior.">
    <Window.Resources>
        <Style x:Key="SettingsFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3" StrokeThickness="2" StrokeDashArray="1,1"
                                   Stroke="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                                   SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Row label: fixed-width, LEFT-aligned caption forming a clean left column. Left
             alignment (not right) makes labels start at the card's left edge — same line the
             card border/dividers start at — with controls forming their own left-aligned
             column to the right, instead of both hugging the center with a dead left gutter. -->
        <!-- Row primary text: 13px light, fills the left side of a card row
             (design: "text left / control right"). -->
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- Hint: muted helper text, sits under or beside a control. -->
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- Full-width hint that sits below the row's primary text. -->
        <Style x:Key="SubHint" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="Margin" Value="0,-2,0,4"/>
        </Style>

        <!-- Implicit input styling so every box/combo/checkbox in the sections inherits
             the themed treatment without per-control Style= attributes.
             Foreground / CaretBrush / SelectionBrush are set EXPLICITLY here (not only via
             BasedOn) because this style replaces the template; that guarantees typed text is
             light and clearly visible on the dark input surface. -->
        <Style x:Key="SettingsTextBox" TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bg" Background="{StaticResource InputBgBrush}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusInput}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource SelectionRingBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource SettingsTextBox}"/>
        <!-- HotkeyBox inherits the readable input look but adds a muted "Record shortcut"
             placeholder when no gesture is assigned (matches CleanShot's recorder pills). -->
        <Style TargetType="{x:Type local:HotkeyBox}" BasedOn="{StaticResource SettingsTextBox}">
            <!-- Hotkeys read in mono per the design language. -->
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type local:HotkeyBox}">
                        <Border x:Name="Bg" Background="{StaticResource InputBgBrush}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusInput}">
                            <Grid>
                                <TextBlock x:Name="Placeholder" Text="Record shortcut"
                                           Margin="8,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextDisabledBrush}"
                                           FontSize="12" FontWeight="Normal"
                                           IsHitTestVisible="False" Visibility="Collapsed"/>
                                <TextBlock x:Name="Listening" Text="Press keys…"
                                           Margin="8,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource SelectedTintTextBrush}"
                                           FontSize="12" FontWeight="SemiBold"
                                           IsHitTestVisible="False" Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <!-- Focused = listening: blue tint (design 4f); empty + focused
                                 shows "Press keys…" instead of the muted placeholder. -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#332E6FC1"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#804E94E0"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsKeyboardFocused" Value="True"/>
                                    <Condition Property="Text" Value=""/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Listening" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Settings rows use toggle switches (blue = state), not checkboxes. -->
        <Style TargetType="CheckBox" BasedOn="{StaticResource ToggleSwitch}">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource DarkComboBox}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Slider" BasedOn="{StaticResource DarkSlider}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/>
        </Style>

        <!-- A grouped settings card: #232326, 10px radius, .08 hairline. -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardGroupBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusCardGroup}"/>
            <Setter Property="Padding" Value="14,7,14,7"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- One settings row: primary text left, control docked right. -->
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="LastChildFill" Value="True"/>
        </Style>

        <!-- Category header used on the Shortcuts list (caps, muted, tracked). -->
        <Style x:Key="ShortcutCategory" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,4,0,6"/>
        </Style>

        <!-- Row divider inside a card: .06 hairline running edge to edge. -->
        <Style x:Key="GroupSep" TargetType="Rectangle">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Fill" Value="{StaticResource DividerBrush}"/>
            <Setter Property="Margin" Value="-14,6,-14,6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Sidebar row: 32px, 8px radius, text-only. Selected = blue tint. -->
        <Style x:Key="NavTab" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                BorderBrush="Transparent" BorderThickness="1"
                                Height="32" Padding="11,0">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0FFFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedTintBgBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SelectedTintBorderBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Legacy keys kept for the nav items' inner text (icon hidden by design). -->
        <Style x:Key="NavTabIcon" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        <Style x:Key="NavTabLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="TextAlignment" Value="Left"/>
        </Style>

        <!-- Sub-tab pill (Recording: General / Video / GIF). -->
        <Style x:Key="SubTab" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                Padding="14,4" Margin="2,0">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverFillBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Column header for the "After capture" matrix. -->
        <Style x:Key="MatrixColHead" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Section scroller with an OVERLAY scrollbar: the 8px slim bar floats pinned to the
             far-right edge instead of taking layout space, so (a) content never reflows when
             the bar appears/disappears and (b) the bar sits the same distance from the app edge
             as the cards sit from the left edge, with a small gap before the cards. The right
             padding reserves that gutter so the bar never covers card content. -->
        <Style x:Key="SectionScroll" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <!-- 20px symmetric inset centers the cards in the window. -->
            <Setter Property="Padding" Value="20,0,20,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter Margin="{TemplateBinding Padding}"/>
                            <!-- 6px right margin centers the 8px bar within the 20px right
                                 margin: 6px gap to the cards, 6px gap to the app edge. -->
                            <ScrollBar x:Name="PART_VerticalScrollBar" Orientation="Vertical"
                                       HorizontalAlignment="Right" Margin="0,0,6,0" Minimum="0"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A centered, label-less checkbox for the matrix cells. Uses its OWN template (just
             the box) rather than DarkCheckBox: DarkCheckBox reserves an 8px content gutter, so
             centering it left-shifted the box ~4px off the column center where the "—" dashes
             sit. Box-only keeps checkbox and dash on the exact same centerline. -->
        <Style x:Key="MatrixCheck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="18" Height="18">
                            <Border x:Name="Box" CornerRadius="5"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                            <Path x:Name="Check" Visibility="Collapsed"
                                  Stroke="White" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Data="M4,9 L8,13 L14,5"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The "not available for this column" placeholder, centered on the SAME line as the box. -->
        <Style x:Key="MatrixNA" TargetType="TextBlock">
            <Setter Property="Text" Value="—"/>
            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Page title at the top of each section (design: 16/600). -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,2,0,12"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="0">

        <!-- =============================== SIDEBAR =============================== -->
        <!-- 192px text-only section rail (design 1e): #19191B, 32px rows, blue-tint
             selection, About pinned to the bottom. -->
        <Border DockPanel.Dock="Left" Width="192" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
            <ListBox x:Name="SectionList" Background="Transparent" BorderThickness="0"
                     Padding="8,12"
                     KeyboardNavigation.TabNavigation="Once"
                     AutomationProperties.Name="Settings categories"
                     AutomationProperties.HelpText="Use the arrow keys to choose a settings category."
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource NavTab}"
                     SelectedIndex="0" SelectionChanged="OnSectionChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <DockPanel LastChildFill="False"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBoxItem x:Name="GeneralNavItem" DockPanel.Dock="Top" Content="General"
                             AutomationProperties.Name="General settings"/>
                <ListBoxItem x:Name="ShortcutsNavItem" DockPanel.Dock="Top" Content="Shortcuts"
                             AutomationProperties.Name="Shortcut settings"/>
                <ListBoxItem x:Name="QuickAccessNavItem" DockPanel.Dock="Top" Content="Quick Access"
                             AutomationProperties.Name="Quick Access settings"/>
                <ListBoxItem x:Name="RecordingNavItem" DockPanel.Dock="Top" Content="Recording"
                             AutomationProperties.Name="Recording settings"/>
                <ListBoxItem x:Name="ScreenshotsNavItem" DockPanel.Dock="Top" Content="Screenshots"
                             AutomationProperties.Name="Screenshot settings"/>
                <ListBoxItem x:Name="AnnotateNavItem" DockPanel.Dock="Top" Content="Annotate" Visibility="Collapsed"
                             AutomationProperties.Name="Annotate settings unavailable"/>
                <ListBoxItem x:Name="AdvancedNavItem" DockPanel.Dock="Top" Content="Advanced"
                             AutomationProperties.Name="Advanced settings"/>
                <ListBoxItem x:Name="AboutNavItem" DockPanel.Dock="Bottom" Content="About"
                             AutomationProperties.Name="About WinShot"/>
            </ListBox>
        </Border>

        <!-- =============================== CONTENT PANE =============================== -->
        <!-- No horizontal margin here: the content pane spans edge-to-edge so the section
             cards can be centered (20px each side, via SectionScroll's symmetric padding) AND
             the overlay scrollbar can sit CENTERED in the 20px right margin (6px of gap on
             each side of the bar). The footer is inset 20px to match the cards. -->
        <DockPanel Margin="0,12,0,12">
            <!-- Footer action bar (inset to line up with the section cards) -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="20,6,20,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="Cancel" IsCancel="True"
                            FocusVisualStyle="{StaticResource SettingsFocusVisual}"
                            AutomationProperties.Name="Cancel settings changes"
                            AutomationProperties.HelpText="Close Settings without applying changes."
                            Style="{StaticResource PillButtonSecondary}" Click="OnCancel"/>
                    <Button x:Name="SaveButton" Content="Done" IsDefault="True"
                            FocusVisualStyle="{StaticResource SettingsFocusVisual}"
                            AutomationProperties.Name="Apply settings and close"
                            AutomationProperties.HelpText="Validate and apply the visible settings, then close this window."
                            Style="{StaticResource PillButtonPrimary}" Click="OnSave"/>
                </StackPanel>
            </Border>

            <!-- Sections (only one visible at a time; toggled from OnSectionChanged) -->
            <Grid>
                <!-- ===================== GENERAL ===================== -->
                <ScrollViewer x:Name="SectionGeneral" Style="{StaticResource SectionScroll}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="General"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <CheckBox x:Name="StartupCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Start WinShot at login"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <CheckBox x:Name="UpdatesCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Check for updates on startup"/>
                                </DockPanel>
                                <DockPanel x:Name="UnavailableSoundsRow" Style="{StaticResource Row}" Visibility="Collapsed">
                                    <CheckBox x:Name="PlaySoundsCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Play sounds"/>
                                </DockPanel>
                                <DockPanel x:Name="UnavailableShutterSoundRow" Style="{StaticResource Row}" Visibility="Collapsed">
                                    <ComboBox x:Name="ShutterSoundCombo" DockPanel.Dock="Right" MinWidth="150" HorizontalAlignment="Right">
                                    
                                        <ComboBoxItem Content="Default" Tag="default"/>
                                        <ComboBoxItem Content="Classic" Tag="classic"/>
                                        <ComboBoxItem Content="Subtle" Tag="subtle"/>
                                        <ComboBoxItem Content="Silent" Tag="silent"/>
                                    </ComboBox>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Shutter sound"/>
                                </DockPanel>
                                <DockPanel x:Name="UnavailableTrayIconRow" Style="{StaticResource Row}" Visibility="Collapsed">
                                    <CheckBox x:Name="ShowTrayIconCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Show icon"/>
                                </DockPanel>

                                <Rectangle Style="{StaticResource GroupSep}"/>

                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Export location"/>
                                    <Button x:Name="BrowseSaveFolderButton" DockPanel.Dock="Right" Content="Browse..." MinWidth="84"
                                            FocusVisualStyle="{StaticResource SettingsFocusVisual}"
                                            AutomationProperties.Name="Browse for export location"
                                            AutomationProperties.HelpText="Choose the folder where WinShot saves captures."
                                            Style="{StaticResource PillButtonSecondary}" Click="OnBrowse"/>
                                    <TextBox x:Name="SaveFolderBox" Margin="0,0,8,0"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <CheckBox x:Name="HideIconsCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Hide desktop icons while capturing"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <ComboBox x:Name="PostCaptureActionCombo" DockPanel.Dock="Right" MinWidth="150" HorizontalAlignment="Right">
                                    
                                        <ComboBoxItem Content="Show Quick Access" Tag="overlay"/>
                                        <ComboBoxItem Content="Copy to clipboard" Tag="copy"/>
                                        <ComboBoxItem Content="Save to export location" Tag="save"/>
                                        <ComboBoxItem Content="Open Annotate" Tag="edit"/>
                                        <ComboBoxItem Content="Pin to screen" Tag="pin"/>
                                        <ComboBoxItem Content="Add background" Tag="background"/>
                                    </ComboBox>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="After screenshot"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <CheckBox x:Name="PostCaptureCopyCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Also copy after other actions"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource SubHint}"
                                           Text="Recording output is chosen in the recording window."/>
                            </StackPanel>
                        </Border>

                        <!-- Kept only as a migration bridge for older saved matrix values. -->
                        <Border x:Name="LegacyAfterCaptureMatrix" Style="{StaticResource Card}" Visibility="Collapsed">
                            <StackPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="After capture"
                                               VerticalAlignment="Top"/>
                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                               TextWrapping="Wrap" VerticalAlignment="Top"
                                               Text="Here you can decide what should happen after taking a screenshot or recording a video."/>
                                </DockPanel>

                                <Border Margin="0,10,0,0" HorizontalAlignment="Center"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="{StaticResource RadiusInput}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="82"/>
                                            <ColumnDefinition Width="82"/>
                                            <ColumnDefinition Width="210"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="30"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header row -->
                                        <Border Grid.Row="0" Grid.ColumnSpan="3"
                                                Background="{StaticResource SurfaceBrush}"
                                                CornerRadius="8,8,0,0"/>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource MatrixColHead}" Text="Screenshot"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource MatrixColHead}" Text="Recording"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource MatrixColHead}"
                                                   HorizontalAlignment="Left" Margin="10,0,0,0" Text="Action"/>

                                        <!-- Row: Show Quick Access Overlay -->
                                        <CheckBox Grid.Row="1" Grid.Column="0" x:Name="ScreenshotShowOverlayCheck" Style="{StaticResource MatrixCheck}"/>
                                        <CheckBox Grid.Row="1" Grid.Column="1" x:Name="LegacyRecordingShowOverlayCheck" Style="{StaticResource MatrixCheck}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" Text="Show Quick Access Overlay"/>

                                        <!-- Row: Copy file to clipboard -->
                                        <CheckBox Grid.Row="2" Grid.Column="0" x:Name="ScreenshotCopyCheck" Style="{StaticResource MatrixCheck}"/>
                                        <CheckBox Grid.Row="2" Grid.Column="1" x:Name="LegacyRecordingCopyCheck" Style="{StaticResource MatrixCheck}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" Text="Copy file to clipboard"/>

                                        <!-- Row: Save -->
                                        <CheckBox Grid.Row="3" Grid.Column="0" x:Name="ScreenshotSaveCheck" Style="{StaticResource MatrixCheck}"/>
                                        <CheckBox Grid.Row="3" Grid.Column="1" x:Name="RecordingSaveCheck" Style="{StaticResource MatrixCheck}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="2" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" Text="Save"/>

                                        <!-- Row: Open Annotate tool (screenshot only) -->
                                        <CheckBox Grid.Row="4" Grid.Column="0" x:Name="ScreenshotOpenAnnotateCheck" Style="{StaticResource MatrixCheck}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource MatrixNA}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="2" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" Text="Open Annotate tool"/>

                                        <!-- Row: Pin to the screen (screenshot only) -->
                                        <CheckBox Grid.Row="5" Grid.Column="0" x:Name="ScreenshotPinCheck" Style="{StaticResource MatrixCheck}"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource MatrixNA}"/>
                                        <TextBlock Grid.Row="5" Grid.Column="2" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" Text="Pin to the screen"/>

                                        <!-- Row: Open Video Editor (recording only) -->
                                        <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource MatrixNA}"/>
                                        <CheckBox Grid.Row="6" Grid.Column="1" x:Name="RecordingOpenEditorCheck" Style="{StaticResource MatrixCheck}"/>
                                        <TextBlock Grid.Row="6" Grid.Column="2" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" Text="Open Video Editor"/>

                                        <!-- Hidden screenshot-editor checkbox kept for parity/persistence (Open Annotate == screenshot editor). -->
                                        <CheckBox x:Name="ScreenshotOpenEditorCheck" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===================== SHORTCUTS ===================== -->
                <ScrollViewer x:Name="SectionShortcuts" Visibility="Collapsed"
                              Style="{StaticResource SectionScroll}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="Shortcuts"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <!-- Rows are generated from the shortcut catalog in
                                     SettingsWindow.Shortcuts.cs (BuildShortcutsTab). -->
                                <StackPanel x:Name="ShortcutsHost"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,2"
                                           Text="Click a field and press the keys. Esc cancels, Backspace clears."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===================== QUICK ACCESS (overlay) ===================== -->
                <ScrollViewer x:Name="SectionQuickAccess" Visibility="Collapsed"
                              Style="{StaticResource SectionScroll}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="Quick Access"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <ComboBox x:Name="OverlayPositionCombo" DockPanel.Dock="Right" MinWidth="150" HorizontalAlignment="Right">
                                    
                                        <ComboBoxItem Content="Left" Tag="left"/>
                                        <ComboBoxItem Content="Right" Tag="right"/>
                                        <ComboBoxItem Content="Top" Tag="top"/>
                                        <ComboBoxItem Content="Bottom" Tag="bottom"/>
                                        <ComboBoxItem Content="Bottom Left" Tag="bottom-left"/>
                                        <ComboBoxItem Content="Bottom Right" Tag="bottom-right"/>
                                    </ComboBox>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Position"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <CheckBox x:Name="OverlayMoveToActiveScreenCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Move to the active screen"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource SubHint}"
                                           Text="Active screen is the screen where your cursor is pointing."/>
                                <DockPanel Style="{StaticResource Row}" Margin="0,8,0,4">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Size"/>
                                    <Slider x:Name="OverlaySizeSlider" HorizontalAlignment="Stretch"
                                            Minimum="0" Maximum="100" Value="50"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <CheckBox x:Name="OverlayAutoCloseCheck" Checked="OnOverlayAutoCloseToggled" Unchecked="OnOverlayAutoCloseToggled" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Close automatically"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <ComboBox x:Name="OverlayActionCombo" DockPanel.Dock="Right" MinWidth="150" HorizontalAlignment="Right">
                                    
                                        <ComboBoxItem Content="Save and Close" Tag="save-close"/>
                                        <ComboBoxItem Content="Copy and Close" Tag="copy-close"/>
                                        <ComboBoxItem Content="Close" Tag="close"/>
                                    </ComboBox>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Action"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Interval"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="OverlayCloseBox" Width="80"/>
                                        <TextBlock Style="{StaticResource Hint}" Text="seconds before it closes"/>
                                    </StackPanel>
                                </DockPanel>

                                <Rectangle Style="{StaticResource GroupSep}"/>

                                <DockPanel Style="{StaticResource Row}">
                                    <CheckBox x:Name="OverlayCloseAfterDragCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Close after dragging out"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource SubHint}"
                                           Text="Hold Alt to keep the item on the Overlay after dragging."/>
                                <DockPanel Style="{StaticResource Row}" Margin="0,8,0,4">
                                    <ComboBox x:Name="OverlaySaveBehaviorCombo" DockPanel.Dock="Right" MinWidth="150" HorizontalAlignment="Right">
                                    
                                        <ComboBoxItem Content="Save to &quot;Export location&quot;" Tag="export"/>
                                        <ComboBoxItem Content="Always ask where to save" Tag="ask"/>
                                    </ComboBox>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Save button behavior"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource SubHint}"
                                           Text="Press with Alt to choose the destination."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===================== RECORDING ===================== -->
                <ScrollViewer x:Name="SectionRecording" Visibility="Collapsed"
                              Style="{StaticResource SectionScroll}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="Recording"/>
                        <!-- Sub-tab strip: General / Video / GIF -->
                        <ListBox x:Name="RecordingSubList" Background="Transparent" BorderThickness="0"
                                 HorizontalAlignment="Center" Margin="0,0,0,10"
                                 KeyboardNavigation.TabNavigation="Once"
                                 AutomationProperties.Name="Recording categories"
                                 AutomationProperties.HelpText="Use the arrow keys to choose General, Video, or GIF settings."
                                 ItemContainerStyle="{StaticResource SubTab}"
                                 SelectedIndex="0" SelectionChanged="OnRecordingSubChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBoxItem Content="General" AutomationProperties.Name="General recording settings"/>
                            <ListBoxItem Content="Video" AutomationProperties.Name="Video recording settings"/>
                            <ListBoxItem Content="GIF" AutomationProperties.Name="GIF recording settings"/>
                        </ListBox>

                        <!-- Recording > General -->
                        <StackPanel x:Name="RecordingGeneralPanel">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel x:Name="RecordingControlsRow" Style="{StaticResource Row}">
                                        <CheckBox x:Name="ShowRecordingControlsCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Show controls while recording"/>
                                </DockPanel>
                                    <DockPanel x:Name="RecordingTimerRow" Style="{StaticResource Row}">
                                        <CheckBox x:Name="ShowRecordingTimerCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Display recording time"/>
                                </DockPanel>
                                    <DockPanel x:Name="RecordingScaleRow" Style="{StaticResource Row}">
                                        <CheckBox x:Name="ScaleHiDpiVideoCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Scale HiDPI videos to 1x"/>
                                </DockPanel>
                                    <DockPanel x:Name="UnavailableDoNotDisturbRow" Style="{StaticResource Row}" Visibility="Collapsed">
                                        <CheckBox x:Name="DoNotDisturbCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Silence notifications while recording"/>
                                </DockPanel>

                                    <Rectangle Style="{StaticResource GroupSep}"/>

                                    <DockPanel Style="{StaticResource Row}">
                                        <CheckBox x:Name="CaptureCursorCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Show cursor"/>
                                </DockPanel>
                                    <DockPanel Style="{StaticResource Row}">
                                        <CheckBox x:Name="ClickHighlightsCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Highlight clicks"/>
                                </DockPanel>
                                    <DockPanel Style="{StaticResource Row}">
                                        <CheckBox x:Name="KeystrokesCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Show keystrokes"/>
                                </DockPanel>

                                    <Rectangle Style="{StaticResource GroupSep}"/>

                                    <DockPanel x:Name="RememberRecordingAreaRow" Style="{StaticResource Row}">
                                        <CheckBox x:Name="RememberLastSelectionCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Remember last selection"/>
                                </DockPanel>
                                    <DockPanel x:Name="DimScreenRow" Style="{StaticResource Row}">
                                        <CheckBox x:Name="DimScreenCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Dim screen while recording"/>
                                </DockPanel>
                                    <DockPanel x:Name="UnavailableShowCountdownRow" Style="{StaticResource Row}" Visibility="Collapsed">
                                        <CheckBox x:Name="ShowCountdownCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Show countdown"/>
                                </DockPanel>
                                    <DockPanel Style="{StaticResource Row}">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Countdown"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="CountdownBox" Width="80"/>
                                            <TextBlock Style="{StaticResource Hint}" Text="seconds, 0 = start immediately"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <Rectangle Style="{StaticResource GroupSep}"/>

                                    <DockPanel Style="{StaticResource Row}">
                                        <ComboBox x:Name="WebcamCombo" DockPanel.Dock="Right" MinWidth="150" HorizontalAlignment="Right">
                                    
                                            <ComboBoxItem Content="Off" Tag="off"/>
                                            <ComboBoxItem Content="Top left" Tag="top-left"/>
                                            <ComboBoxItem Content="Top right" Tag="top-right"/>
                                            <ComboBoxItem Content="Bottom left" Tag="bottom-left"/>
                                            <ComboBoxItem Content="Bottom right" Tag="bottom-right"/>
                                            <ComboBoxItem Content="Fullscreen" Tag="fullscreen"/>
                                        </ComboBox>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Webcam"/>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource Row}">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Webcam size"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="WebcamSizeBox" Width="80"/>
                                            <TextBlock Style="{StaticResource Hint}" Text="10-45%"/>
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel Style="{StaticResource Row}">
                                        <CheckBox x:Name="RecordingShowOverlayCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Show Quick Access"/>
                                </DockPanel>
                                    <DockPanel Style="{StaticResource Row}">
                                        <CheckBox x:Name="RecordingCopyCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Copy file to clipboard"/>
                                </DockPanel>
                                    <TextBlock Style="{StaticResource SubHint}"
                                               Text="Completed recordings stay local and are added to History."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Recording > Video -->
                        <StackPanel x:Name="RecordingVideoPanel" Visibility="Collapsed">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel x:Name="MaxResolutionRow" Style="{StaticResource Row}">
                                        <ComboBox x:Name="MaxResolutionCombo" DockPanel.Dock="Right" MinWidth="150" HorizontalAlignment="Right">
                                    
                                            <ComboBoxItem Content="Original" Tag="original"/>
                                            <ComboBoxItem Content="4K" Tag="4k"/>
                                            <ComboBoxItem Content="1080p" Tag="1080p"/>
                                            <ComboBoxItem Content="720p" Tag="720p"/>
                                        </ComboBox>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Max resolution"/>
                                    </DockPanel>
                                    <TextBlock x:Name="MaxResolutionHint" Style="{StaticResource SubHint}"
                                               Text="Set maximum resolution to reduce file size and upload time."/>

                                    <DockPanel Style="{StaticResource Row}" Margin="0,8,0,4">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Video FPS"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="RecordingFpsBox" Width="80"/>
                                            <TextBlock Style="{StaticResource Hint}" Text="10-60 fps"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <Rectangle Style="{StaticResource GroupSep}"/>

                                    <DockPanel Style="{StaticResource Row}">
                                        <CheckBox x:Name="RecordAudioCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Capture microphone while recording"/>
                                </DockPanel>
                                    <DockPanel Style="{StaticResource Row}">
                                        <CheckBox x:Name="SystemAudioCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Capture system sound while recording"/>
                                </DockPanel>
                                    <DockPanel x:Name="RecordMonoRow" Style="{StaticResource Row}">
                                        <CheckBox x:Name="RecordAudioMonoCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Record audio in mono"/>
                                </DockPanel>

                                    <Rectangle x:Name="VideoEditorSeparator" Style="{StaticResource GroupSep}"/>

                                    <DockPanel x:Name="VideoEditorRow" Style="{StaticResource Row}">
                                        <CheckBox x:Name="OpenVideoEditorCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Open Video Editor after recording"/>
                                </DockPanel>
                                    <TextBlock x:Name="VideoEditorHint" Style="{StaticResource SubHint}"
                                               Text="Open the local editor to trim and export the finished video."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Recording > GIF -->
                        <StackPanel x:Name="RecordingGifPanel" Visibility="Collapsed">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel Style="{StaticResource Row}">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="GIF FPS"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="GifFpsBox" Width="80"/>
                                            <TextBlock Style="{StaticResource Hint}" Text="5-20 fps"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <DockPanel x:Name="GifQualityRow" Style="{StaticResource Row}" Margin="0,8,0,4">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="GIF quality"/>
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel Width="180">
                                                <Slider x:Name="GifQualitySlider" Minimum="0" Maximum="100" Value="80"/>
                                                <Grid Margin="2,1,2,0">
                                                    <TextBlock Style="{StaticResource Hint}" Margin="0" HorizontalAlignment="Left" Text="Low"/>
                                                    <TextBlock Style="{StaticResource Hint}" Margin="0" HorizontalAlignment="Right" Text="High"/>
                                                </Grid>
                                            </StackPanel>
                                            <CheckBox x:Name="OptimizeGifsCheck" Content="Optimize GIFs" Margin="14,0,0,0" VerticalAlignment="Top"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock x:Name="GifQualityHint" Style="{StaticResource SubHint}"
                                               Text="Setting the quality to maximum can speed up the processing time, but it will increase file size."/>

                                    <DockPanel x:Name="GifSizeRow" Style="{StaticResource Row}" Margin="0,8,0,4">
                                        <ComboBox x:Name="GifSizeCombo" DockPanel.Dock="Right" MinWidth="150" HorizontalAlignment="Right">
                                    
                                            <ComboBoxItem Content="800 x auto (default)" Tag="800"/>
                                            <ComboBoxItem Content="640 x auto" Tag="640"/>
                                            <ComboBoxItem Content="480 x auto" Tag="480"/>
                                            <ComboBoxItem Content="Original" Tag="auto"/>
                                        </ComboBox>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="GIF size"/>
                                    </DockPanel>
                                    <TextBlock x:Name="GifSizeHint" Style="{StaticResource SubHint}"
                                               Text="Set maximum resolution of your GIFs. Changing it will affect file size and quality. WinShot will only downscale the GIF if needed."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===================== SCREENSHOTS ===================== -->
                <ScrollViewer x:Name="SectionScreenshots" Visibility="Collapsed"
                              Style="{StaticResource SectionScroll}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="Screenshots"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <ComboBox x:Name="FormatCombo"
                                              SelectionChanged="OnFormatChanged" DockPanel.Dock="Right" MinWidth="150" HorizontalAlignment="Right">
                                    
                                        <ComboBoxItem Content="PNG" Tag="png"/>
                                        <ComboBoxItem Content="JPG" Tag="jpg"/>
                                        <ComboBoxItem Content="WEBP" Tag="webp"/>
                                    </ComboBox>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="File format"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <CheckBox x:Name="HiDpiCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Scale HiDPI screenshots to 1x"/>
                                </DockPanel>
                                <DockPanel x:Name="UnavailableSrgbRow" Style="{StaticResource Row}" Visibility="Collapsed">
                                    <CheckBox x:Name="ConvertToSrgbCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Convert to sRGB profile"/>
                                </DockPanel>
                                <DockPanel x:Name="UnavailablePixelBorderRow" Style="{StaticResource Row}" Visibility="Collapsed">
                                    <CheckBox x:Name="AddPixelBorderCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Add 1px border to all screenshots"/>
                                </DockPanel>
                                <DockPanel x:Name="UnavailableScreenshotBackgroundRow" Style="{StaticResource Row}" Visibility="Collapsed">
                                    <ComboBox x:Name="BackgroundCombo" DockPanel.Dock="Right" MinWidth="150" HorizontalAlignment="Right">
                                    
                                        <ComboBoxItem Content="None" Tag="none"/>
                                        <ComboBoxItem Content="Wallpaper" Tag="wallpaper"/>
                                        <ComboBoxItem Content="Gradient" Tag="gradient"/>
                                        <ComboBoxItem Content="Solid color" Tag="color"/>
                                    </ComboBox>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Background"/>
                                </DockPanel>
                                <TextBlock x:Name="UnavailableScreenshotBackgroundHint" Style="{StaticResource SubHint}" Visibility="Collapsed"
                                           Text="Apply Background Tool to all screenshots. Create presets in Annotate. Hold Shift while taking a screenshot to disable."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <ComboBox x:Name="SelfTimerCombo" DockPanel.Dock="Right" MinWidth="150" HorizontalAlignment="Right">
                                    
                                        <ComboBoxItem Content="3 Seconds" Tag="3"/>
                                        <ComboBoxItem Content="5 Seconds" Tag="5"/>
                                        <ComboBoxItem Content="10 Seconds" Tag="10"/>
                                        <ComboBoxItem Content="15 Seconds" Tag="15"/>
                                    </ComboBox>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Self-Timer interval"/>
                                </DockPanel>
                                <DockPanel x:Name="UnavailableScreenshotCursorRow" Style="{StaticResource Row}" Visibility="Collapsed">
                                    <CheckBox x:Name="CursorOnScreenshotsCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Show on screenshots"/>
                                </DockPanel>
                                <TextBlock x:Name="UnavailableScreenshotCursorHint" Style="{StaticResource SubHint}" Visibility="Collapsed"
                                           Text="This works in Fullscreen or Self-Timer modes only."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <CheckBox x:Name="FreezeScreenCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Freeze screen when taking a screenshot"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <ComboBox x:Name="CrosshairModeCombo" DockPanel.Dock="Right" MinWidth="150" HorizontalAlignment="Right">
                                    
                                        <ComboBoxItem Content="Always show" Tag="always"/>
                                        <ComboBoxItem Content="When Ctrl is pressed" Tag="command"/>
                                        <ComboBoxItem Content="Never" Tag="never"/>
                                    </ComboBox>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Crosshair mode"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <CheckBox x:Name="ShowMagnifierCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Show magnifier"/>
                                </DockPanel>
                                <!-- Legacy "Show crosshair" toggle kept for persistence; folded into Crosshair mode. -->
                                <CheckBox x:Name="ShowCrosshairCheck" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===================== ANNOTATE ===================== -->
                <ScrollViewer x:Name="SectionAnnotate" Visibility="Collapsed"
                              Style="{StaticResource SectionScroll}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="Annotate"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <CheckBox x:Name="InverseArrowCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Inverse arrow direction"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource SubHint}"
                                           Text="Press Alt when drawing to invert the behavior."/>
                                <DockPanel Style="{StaticResource Row}" Margin="0,8,0,4">
                                    <CheckBox x:Name="SmoothPencilCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Smooth drawing"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <CheckBox x:Name="RememberLastToolCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Remember if tool was opened"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <CheckBox x:Name="DrawShadowCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Draw shadow on objects"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <CheckBox x:Name="AutoExpandCanvasCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Automatically expand"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource SubHint}"
                                           Text="Ensures all annotations fit by dynamically resizing canvas."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <CheckBox x:Name="ShowColorNamesCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Show color names"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <CheckBox x:Name="AlwaysOnTopCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Always on top"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <CheckBox x:Name="ShowDockIconCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Show taskbar icon"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===================== ADVANCED ===================== -->
                <ScrollViewer x:Name="SectionAdvanced" Visibility="Collapsed"
                              Style="{StaticResource SectionScroll}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="Advanced"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="File name"/>
                                    <TextBox x:Name="TemplateBox" TextChanged="OnTemplateChanged"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Preview"/>
                                    <TextBlock x:Name="TemplatePreviewText" Foreground="{StaticResource AccentBrush}"
                                               FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <DockPanel x:Name="UnavailableAskForNameRow" Style="{StaticResource Row}" Visibility="Collapsed">
                                    <CheckBox x:Name="AskForNameCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Ask for name after every capture"/>
                                </DockPanel>
                                <DockPanel x:Name="UnavailableRetinaSuffixRow" Style="{StaticResource Row}" Visibility="Collapsed">
                                    <CheckBox x:Name="AddRetinaSuffixCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Add &quot;@2x&quot; suffix to HiDPI screenshots"/>
                                </DockPanel>
                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                           LineHeight="17" Margin="162,4,0,0">
                                    <Run Foreground="{StaticResource TextPrimaryBrush}" Text="{}{date}"/><Run Text="  current date"/><LineBreak/>
                                    <Run Foreground="{StaticResource TextPrimaryBrush}" Text="{}{time}"/><Run Text="  current time"/><LineBreak/>
                                    <Run Foreground="{StaticResource TextPrimaryBrush}" Text="{}{n}"/><Run Text="  auto-incrementing counter"/><LineBreak/>
                                    <Run Foreground="{StaticResource TextPrimaryBrush}" Text="{}{app}"/><Run Text="  active application name"/><LineBreak/>
                                    <Run Foreground="{StaticResource TextPrimaryBrush}" Text="{}{title}"/><Run Text="  active window title"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border x:Name="UnavailableCopyFormatCard" Style="{StaticResource Card}" Visibility="Collapsed">
                            <StackPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <ComboBox x:Name="CopyFormatCombo" DockPanel.Dock="Right" MinWidth="150" HorizontalAlignment="Right">
                                    
                                        <ComboBoxItem Content="File &amp; image (default)" Tag="file-image"/>
                                        <ComboBoxItem Content="File only" Tag="file"/>
                                        <ComboBoxItem Content="Image only" Tag="image"/>
                                    </ComboBox>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Copy to clipboard"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource SubHint}"
                                           Text="Adjust this option if you've encountered any issues with pasting from clipboard or clipboard managers."/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="PinnedStyleCard" Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Pinned screenshots"/>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox x:Name="PinnedRoundedCornersCheck" Content="Rounded corners" Margin="0,0,12,0"/>
                                        <CheckBox x:Name="PinnedShadowCheck" Content="Shadow" Margin="0,0,12,0"/>
                                        <CheckBox x:Name="PinnedBorderCheck" Content="Border"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Keep history"/>
                                    <Slider x:Name="HistorySlider" HorizontalAlignment="Stretch"
                                            Minimum="0" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True"
                                            ValueChanged="OnHistorySliderChanged"/>
                                </DockPanel>
                                <Grid Margin="162,0,0,0" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="No age limit" Foreground="{StaticResource TextDisabledBrush}" FontSize="10" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Column="1" Text="1 day" Foreground="{StaticResource TextDisabledBrush}" FontSize="10" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="3 days" Foreground="{StaticResource TextDisabledBrush}" FontSize="10" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="1 week" Foreground="{StaticResource TextDisabledBrush}" FontSize="10" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="1 month" Foreground="{StaticResource TextDisabledBrush}" FontSize="10" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Style="{StaticResource SubHint}" Margin="162,6,0,0"
                                           Text="Age cleanup is separate from the local item limit shown in Capture History."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <CheckBox x:Name="AllInOneRememberCheck" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Remember last selection"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel x:Name="UnavailableOcrLanguageRow" Style="{StaticResource Row}" Visibility="Collapsed">
                                    <ComboBox x:Name="OcrLanguageCombo" DockPanel.Dock="Right" MinWidth="150" HorizontalAlignment="Right">
                                    
                                        <ComboBoxItem Content="Automatically Detect Language" Tag="auto"/>
                                        <ComboBoxItem Content="English" Tag="en"/>
                                        <ComboBoxItem Content="Spanish" Tag="es"/>
                                        <ComboBoxItem Content="French" Tag="fr"/>
                                        <ComboBoxItem Content="German" Tag="de"/>
                                        <ComboBoxItem Content="Italian" Tag="it"/>
                                        <ComboBoxItem Content="Portuguese" Tag="pt"/>
                                    </ComboBox>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Text recognition"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text=""/>
                                    <StackPanel>
                                        <CheckBox x:Name="OcrJoinLinesCheck" Content="Join recognized lines"/>
                                        <CheckBox x:Name="OcrDetectLinksCheck" Content="Detect links" Margin="0,6,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="UnavailableResetWarningsCard" Style="{StaticResource Card}" Visibility="Collapsed">
                            <StackPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Dialogs"/>
                                    <Button Content="Reset All Warning Dialogs" MinWidth="160"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource PillButtonSecondary}" Click="OnResetWarnings"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Hidden: retention is now driven by the Keep-history slider above. -->
                        <TextBox x:Name="RetentionDaysBox" Visibility="Collapsed"/>
                        <TextBox x:Name="HistoryLimitBox" Visibility="Collapsed"/>
                        <TextBox x:Name="SelfTimerBox" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===================== ABOUT ===================== -->
                <ScrollViewer x:Name="SectionAbout" Visibility="Collapsed"
                              Style="{StaticResource SectionScroll}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="About"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Margin="4,8" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE722;" FontFamily="{StaticResource IconFont}"
                                           FontSize="44" HorizontalAlignment="Center"
                                           Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="WinShot" FontSize="22" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="AboutVersionText" HorizontalAlignment="Center"
                                           Margin="0,2,0,0" FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="A fast, lightweight screenshot &amp; recording tool for Windows."
                                           HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Version"/>
                                    <TextBlock x:Name="AboutVersionValue" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Runtime"/>
                                    <TextBlock x:Name="AboutRuntimeValue" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Windows"/>
                                    <TextBlock x:Name="AboutOsValue" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Install folder"/>
                                    <TextBlock x:Name="AboutInstallValue" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Updates"/>
                                    <Button x:Name="AboutCheckUpdatesButton" Content="Check for updates"
                                             MinWidth="160" HorizontalAlignment="Left"
                                             FocusVisualStyle="{StaticResource SettingsFocusVisual}"
                                             AutomationProperties.Name="Check for WinShot updates"
                                             AutomationProperties.HelpText="Check GitHub Releases for a newer WinShot version."
                                             Style="{StaticResource PillButtonSecondary}" Click="OnAboutCheckUpdates"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Project"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="AboutRepositoryButton" Content="GitHub repository" MinWidth="160"
                                                 HorizontalAlignment="Left"
                                                 FocusVisualStyle="{StaticResource SettingsFocusVisual}"
                                                 AutomationProperties.Name="Open WinShot GitHub repository"
                                                 AutomationProperties.HelpText="Open the WinShot source repository in your browser."
                                                 Style="{StaticResource PillButtonSecondary}" Click="OnAboutOpenRepo"/>
                                        <Button x:Name="AboutLogsButton" Content="Open logs folder" MinWidth="140" Margin="8,0,0,0"
                                                 HorizontalAlignment="Left"
                                                 FocusVisualStyle="{StaticResource SettingsFocusVisual}"
                                                 AutomationProperties.Name="Open WinShot logs folder"
                                                 AutomationProperties.HelpText="Open the local WinShot diagnostic logs folder."
                                                 Style="{StaticResource PillButtonSecondary}" Click="OnAboutOpenLogs"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </DockPanel>
</Window>
