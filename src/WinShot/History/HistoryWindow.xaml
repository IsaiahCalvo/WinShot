<Window x:Class="WinShot.History.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinShot History" Width="1200" Height="760" MinWidth="720" MinHeight="480"
        Background="{StaticResource WindowBgBrush}" ShowInTaskbar="True" WindowStartupLocation="Manual"
        AutomationProperties.Name="WinShot history"
        AutomationProperties.HelpText="Browse, sort, select, restore, copy, edit, pin, share, reveal, or delete local captures.">
    <Window.Resources>
        <!-- Compact toolbar button: 26px, white-alpha .07 fill + .12 border (design 1f). -->
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="#12FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedFillBrush}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource BorderStrongBrush}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SelectionRingBrush}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- White action mini-button (Done in selection mode): the strong fill. -->
        <Style x:Key="AccentToolbarButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Foreground" Value="{StaticResource ActionTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource ActionBgBrush}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource ActionBgHoverBrush}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger-tint toolbar button (Delete in selection mode, design 4g). -->
        <Style x:Key="DangerToolbarButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Foreground" Value="#F0A3A3"/>
            <Setter Property="Background" Value="{StaticResource DangerTintBgBrush}"/>
            <Setter Property="BorderBrush" Value="#59E85C5C"/>
        </Style>

        <!-- Filter chip: 26px pill; selected = solid state blue (design 1f). -->
        <Style x:Key="FilterChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                CornerRadius="13" Height="26" Padding="13,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#21FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SelectionRingBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Circular hover action on a tile: 26px, white-alpha face (design 1f). -->
        <Style x:Key="OverlayActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F7F9FC"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Bd" Fill="#1AFFFFFF" Stroke="#26FFFFFF" StrokeThickness="1"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Fill" Value="#33FFFFFF"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="Stroke" Value="{StaticResource SelectionRingBrush}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header (design 1f): chips centered, sort + Select on the right. -->
        <Border x:Name="CategoryRow" Grid.Row="0" Background="{StaticResource WindowBgBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="16,9,16,9">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <RadioButton x:Name="ChipAll" Content="All" IsChecked="True" Style="{StaticResource FilterChip}" Checked="OnFilterChanged"/>
                    <RadioButton x:Name="ChipImages" Content="Images" Style="{StaticResource FilterChip}" Checked="OnFilterChanged"/>
                    <RadioButton x:Name="ChipScrolling" Content="Scrolling" Style="{StaticResource FilterChip}" Checked="OnFilterChanged"/>
                    <RadioButton x:Name="ChipVideo" Content="Video" Style="{StaticResource FilterChip}" Checked="OnFilterChanged"/>
                    <RadioButton x:Name="ChipGif" Content="GIF" Style="{StaticResource FilterChip}" Checked="OnFilterChanged"/>
                </StackPanel>

                <StackPanel x:Name="SortControls" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="SortFieldButton" Style="{StaticResource ToolbarButton}" Click="OnSortFieldMenu">
                        <StackPanel Orientation="Horizontal"><TextBlock x:Name="SortFieldText" Text="Date"/><Path Style="{StaticResource LucideIcon}" Data="{StaticResource LucideChevronDown}" Width="10" Height="10" StrokeThickness="2.2" Stroke="{StaticResource TextMutedBrush}" Margin="6,1,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="SortDirectionButton" Style="{StaticResource ToolbarButton}" Click="OnToggleSortDirection" Margin="6,0,0,0" Padding="6,0" Width="26"
                            AutomationProperties.Name="Sort descending"><Path x:Name="SortDirectionGlyph" Style="{StaticResource LucideIcon}" Data="{StaticResource LucideArrowDown}" Width="12" Height="12"/></Button>
                    <StackPanel x:Name="NormalToolbar" Orientation="Horizontal">
                        <Button x:Name="SelectButton" Content="Select" Style="{StaticResource ToolbarButton}" Margin="6,0,0,0"
                                Click="OnToggleSelectionMode" AutomationProperties.Name="Select history items"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Selection-mode command row (design 4g). -->
        <Border x:Name="SelectionCommandRow" Grid.Row="1" Background="{StaticResource WindowBgBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Visibility="Collapsed">
            <StackPanel x:Name="SelectionToolbar" Orientation="Horizontal" Visibility="Collapsed" Margin="14,8,14,8">
                <Button x:Name="DoneButton" Content="Done" Style="{StaticResource AccentToolbarButton}" Click="OnToggleSelectionMode"/>
                <TextBlock x:Name="SelectionCountText" Text="0 selected" Foreground="{StaticResource SelectedTintTextBrush}"
                           FontFamily="{StaticResource MonoFontFamily}" FontWeight="SemiBold"
                           FontSize="12" VerticalAlignment="Center" Margin="10,0,10,0"/>
                <TextBlock Text="·" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button x:Name="AllSelectionButton" Content="All" Style="{StaticResource ToolbarButton}" Click="OnShowAllFromSelection"
                        AutomationProperties.Name="Select or clear all visible history items"/>
                <Button x:Name="SelectAllButton" Content="Select all" Style="{StaticResource ToolbarButton}" Margin="6,0,0,0" Click="OnSelectAll"
                        AutomationProperties.Name="Select all visible history items"/>
                <Button x:Name="CopyToButton" Content="Copy to" Style="{StaticResource ToolbarButton}" Margin="18,0,0,0" Click="OnCopySelected" IsEnabled="False"
                        AutomationProperties.Name="Copy selected files"/>
                <Button x:Name="PinSelectedButton" Content="Pin" Style="{StaticResource ToolbarButton}" Margin="6,0,0,0" Click="OnPinSelected" IsEnabled="False"
                        AutomationProperties.Name="Pin selected screenshots"/>
                <Button x:Name="ShareButton" Content="Share" Style="{StaticResource ToolbarButton}" Margin="6,0,0,0" Click="OnShareSelected" IsEnabled="False"
                        AutomationProperties.Name="Share selected files"/>
                <Button x:Name="DeleteSelectedButton" Content="Delete" Style="{StaticResource DangerToolbarButton}" Margin="6,0,0,0" Click="OnDeleteSelected" IsEnabled="False"
                        AutomationProperties.Name="Delete selected history items"/>
            </StackPanel>
        </Border>

        <!-- Status bar (design 1f): #19191B, muted counts left, Load-more link right. -->
        <Border Grid.Row="3" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="20,7">
            <DockPanel>
                <Button x:Name="LoadMoreButton" DockPanel.Dock="Right" Content="Load more"
                        Click="OnLoadMore" Visibility="Collapsed" Cursor="Hand"
                        AutomationProperties.Name="Load more history items"
                        AutomationProperties.HelpText="Shows the next 200 local history items without loading the entire library at once.">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock x:Name="LinkText" Text="{TemplateBinding Content}" FontSize="11.5"
                                       Foreground="{StaticResource LinkBrush}" VerticalAlignment="Center"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="LinkText" Property="Foreground" Value="#A8CCF2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource ToolbarButton}" Click="OnRefresh" Margin="0,0,14,0"
                        AutomationProperties.Name="Refresh history"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="CountText" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="·" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" VerticalAlignment="Center" Margin="8,0"/>
                    <TextBlock x:Name="SelectionSummaryText" Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <ListBox x:Name="ItemsList" Tag="False" SelectionMode="Single"
                     Background="Transparent" BorderThickness="0" Padding="14,2,14,14"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="False" KeyboardNavigation.TabNavigation="Continue"
                     AutomationProperties.Name="Capture history"
                     AutomationProperties.HelpText="Use arrow keys to select, Enter to open, Space to preview, and Tab to reach item actions.">
                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="True"/><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                        <Setter Property="AutomationProperties.HelpText" Value="{Binding AccessibleHelpText}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="SelectionRing" Margin="6" BorderBrush="Transparent" BorderThickness="2" CornerRadius="12" Background="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectionRing" Property="BorderBrush" Value="{StaticResource SelectionRingBrush}"/></Trigger>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SelectionRing" Property="BorderBrush" Value="{StaticResource SelectionRingBrush}"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Card" Width="260" Background="Transparent" MouseLeftButtonDown="OnTileMouseDown" MouseMove="OnTileMouseMove" MouseEnter="OnTileMouseEnter">
                            <Border.ContextMenu>
                                <ContextMenu Style="{StaticResource DarkContextMenu}">
                                    <MenuItem Header="Restore to Quick Access" Click="OnRestore" Visibility="{Binding ImageOnlyVisibility}" Style="{StaticResource DarkMenuItem}"/>
                                    <MenuItem Header="Copy" Click="OnCopy" Visibility="{Binding ImageOnlyVisibility}" Style="{StaticResource DarkMenuItem}"/>
                                    <MenuItem Header="Edit" Click="OnEdit" Visibility="{Binding ImageOnlyVisibility}" Style="{StaticResource DarkMenuItem}"/>
                                    <MenuItem Header="Pin" Click="OnPin" Visibility="{Binding PinVisibility}" Style="{StaticResource DarkMenuItem}"/>
                                    <MenuItem Header="Open" Click="OnOpen" Style="{StaticResource DarkMenuItem}"/>
                                    <MenuItem Header="Reveal in Explorer" Click="OnReveal" Style="{StaticResource DarkMenuItem}"/>
                                    <Separator/><MenuItem Header="Delete" Click="OnDelete" Style="{StaticResource DarkMenuItem}"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="164"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border Grid.Row="0" CornerRadius="10" ClipToBounds="True" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid x:Name="ThumbnailSurface">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" Visibility="{Binding ThumbnailVisibility}"/>
                                            <Grid Visibility="{Binding MediaFallbackVisibility}" Background="{StaticResource SurfaceBrush}">
                                                <TextBlock Text="{Binding ExtensionLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Border Background="{StaticResource SurfaceBrush}" Opacity="0.72" Visibility="{Binding MissingThumbnailVisibility}">
                                                <TextBlock Text="&#xE91B;" FontFamily="{StaticResource IconFont}" FontSize="34" Foreground="{StaticResource TextDisabledBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border x:Name="HoverScrim" Background="#8C0F1219" Visibility="Collapsed"/>
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="7,2.5" CornerRadius="4" Background="#8C000000" Visibility="{Binding ScrollingVisibility}">
                                                <TextBlock Text="SCROLL" Foreground="White" FontSize="9" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" Padding="7,2.5" CornerRadius="4" Background="#8C000000" Visibility="{Binding VideoBadgeVisibility}">
                                                <Path Style="{StaticResource LucideIcon}" Width="11" Height="11" Stroke="{x:Null}" Fill="White" Data="{StaticResource LucidePlay}"/>
                                            </Border>
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" Padding="7,2.5" CornerRadius="4" Background="#8C000000" Visibility="{Binding GifBadgeVisibility}">
                                                <TextBlock Text="GIF" Foreground="White" FontSize="9" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>

                                        <!-- Hover actions: circular white-alpha icon buttons (design 1f). -->
                                        <StackPanel x:Name="OverlayActions" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                            <Button Style="{StaticResource OverlayActionButton}" Click="OnRestore" Visibility="{Binding ImageOnlyVisibility}" ToolTip="Restore to Quick Access" AutomationProperties.Name="Restore to Quick Access">
                                                <Path Style="{StaticResource LucideIcon}" Width="13" Height="13" Stroke="#F7F9FC" Data="M3,12 A9,9 0 1 1 6,18.7 M3,12 L3,7 M3,12 L8,12"/>
                                            </Button>
                                            <Button Style="{StaticResource OverlayActionButton}" Click="OnCopy" Visibility="{Binding ImageOnlyVisibility}" ToolTip="Copy" AutomationProperties.Name="Copy screenshot">
                                                <Path Style="{StaticResource LucideIcon}" Width="13" Height="13" Stroke="#F7F9FC" Data="{StaticResource LucideCopy}"/>
                                            </Button>
                                            <Button Style="{StaticResource OverlayActionButton}" Click="OnEdit" Visibility="{Binding ImageOnlyVisibility}" ToolTip="Edit" AutomationProperties.Name="Edit screenshot">
                                                <Path Style="{StaticResource LucideIcon}" Width="13" Height="13" Stroke="#F7F9FC" Data="{StaticResource LucidePencil}"/>
                                            </Button>
                                            <Button Style="{StaticResource OverlayActionButton}" Click="OnPin" Visibility="{Binding PinVisibility}" ToolTip="Pin" AutomationProperties.Name="Pin screenshot">
                                                <Path Style="{StaticResource LucideIcon}" Width="13" Height="13" Stroke="#F7F9FC" Data="M12,17 L12,22 M5,17 L19,17 L17,10 L18,5 L19,3 L5,3 L6,5 L7,10 Z"/>
                                            </Button>
                                            <Button Style="{StaticResource OverlayActionButton}" Click="OnDelete" ToolTip="Delete" AutomationProperties.Name="Delete history item">
                                                <Path Style="{StaticResource LucideIcon}" Width="13" Height="13" Stroke="#F7F9FC" Data="{StaticResource LucideX}"/>
                                            </Button>
                                        </StackPanel>

                                        <!-- Selection check: 18px circle, blue = state (design 4g). -->
                                        <Grid x:Name="SelectionCheck" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7" Visibility="Collapsed">
                                            <Ellipse Fill="{StaticResource AccentBrush}"/>
                                            <Path Style="{StaticResource LucideIcon}" Width="9" Height="9" Stroke="White" StrokeThickness="2.4" Data="{StaticResource LucideCheck}"/>
                                        </Grid>
                                        <!-- Empty ring on unselected tiles while selection mode is on. -->
                                        <Grid x:Name="SelectionEmptyDot" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7" Visibility="Collapsed">
                                            <Ellipse Fill="#4D000000" Stroke="#80FFFFFF" StrokeThickness="1.5"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="2,7,2,10">
                                    <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/>
                                    <TextBlock Text="{Binding MetadataText}" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True"/>
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="OverlayActions" Property="Visibility" Value="Visible"/><Setter TargetName="HoverScrim" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ThumbnailSurface" Property="Effect"><Setter.Value><BlurEffect Radius="5"/></Setter.Value></Setter>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True"/>
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="OverlayActions" Property="Visibility" Value="Visible"/><Setter TargetName="HoverScrim" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ThumbnailSurface" Property="Effect"><Setter.Value><BlurEffect Radius="5"/></Setter.Value></Setter>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="True"/>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="SelectionCheck" Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="True"/>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="SelectionEmptyDot" Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock Text="&#xE91B;" FontFamily="{StaticResource IconFont}" FontSize="48" Foreground="{StaticResource TextDisabledBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="No captures yet" Foreground="{StaticResource TextSecondaryBrush}" FontSize="15" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                <TextBlock Text="Screenshots and recordings you take will show up here." Foreground="{StaticResource TextDisabledBrush}" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
