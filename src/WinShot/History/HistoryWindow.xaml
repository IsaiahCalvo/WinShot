<Window x:Class="WinShot.History.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinShot.History"
        Title="WinShot History" Width="1200" Height="760" MinWidth="720" MinHeight="480"
        Background="{StaticResource WindowBgBrush}" ShowInTaskbar="True" WindowStartupLocation="Manual"
        AutomationProperties.Name="WinShot history"
        AutomationProperties.HelpText="Browse, sort, select, restore, copy, edit, pin, share, reveal, or delete local captures.">
    <Window.Resources>
        <Style x:Key="FilterChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource TextBodyLg}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource RadiusButton}" Padding="16,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceBrush}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="White"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="Bd" Property="BorderThickness" Value="1"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Not a fork of PillButtonPrimary/Secondary: these sit ON the thumbnail, so they are
             white-on-image with a translucent hover wash. A grey pill here would cover the
             picture the user is trying to identify. -->
        <Style x:Key="OverlayActionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusButton}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverFillBrush}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InfoBrush}"/><Setter TargetName="Bd" Property="BorderThickness" Value="1"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="SelectionCommandRow" Grid.Row="1" Background="{StaticResource ToolbarBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <StackPanel x:Name="NormalToolbar" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="SelectButton" Content="Select" Style="{StaticResource PillButtonPrimary}"
                            Click="OnToggleSelectionMode" AutomationProperties.Name="Select history items"/>
                </StackPanel>

                <StackPanel x:Name="SelectionToolbar" Orientation="Horizontal" HorizontalAlignment="Left" Visibility="Collapsed">
                    <Button x:Name="DoneButton" Style="{StaticResource PillButtonPrimary}" Click="OnToggleSelectionMode">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" Margin="{StaticResource ChipGutterMargin}"/><TextBlock Text="Done"/></StackPanel>
                    </Button>
                    <TextBlock x:Name="SelectionCountText" Text="0 selected" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="{StaticResource TextBodyLg}" VerticalAlignment="Center" Margin="20,0,16,0"/>
                    <Border Width="1" Background="{StaticResource BorderBrush}" Margin="0,2,8,2"/>
                    <!-- MinWidth is sized for "Clear selection", the longer of the two labels this
                         one button toggles between: without it every button to its right slid
                         ~35 DIP sideways and back on every press. It belongs on the button, not on
                         the label: the pill sizes to its content and centres it, so a wide label
                         inside a shrink-wrapped pill left the glyph-and-text group sitting ~16 DIP
                         off the pill's optical centre with the slack all on the right. Widening the
                         pill instead keeps the content centred whatever the label says. -->
                    <Button x:Name="AllSelectionButton" MinWidth="148" Style="{StaticResource PillButtonSecondary}" Click="OnToggleSelectAll" AutomationProperties.Name="Select all">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE762;" FontFamily="{StaticResource IconFont}" Margin="{StaticResource ChipGutterMargin}"/><TextBlock x:Name="SelectAllText" Text="Select all"/></StackPanel>
                    </Button>
                    <Button x:Name="CopyToButton" Style="{StaticResource PillButtonSecondary}" Click="OnCopySelected" IsEnabled="False" AutomationProperties.Name="Copy selected files">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B0;" FontFamily="{StaticResource IconFont}" Margin="{StaticResource ChipGutterMargin}"/><TextBlock Text="Copy to"/></StackPanel>
                    </Button>
                    <Button x:Name="PinSelectedButton" Style="{StaticResource PillButtonSecondary}" Click="OnPinSelected" IsEnabled="False" AutomationProperties.Name="Pin selected screenshots">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE840;" FontFamily="{StaticResource IconFont}" Margin="{StaticResource ChipGutterMargin}"/><TextBlock Text="Pin"/></StackPanel>
                    </Button>
                    <Button x:Name="ShareButton" Style="{StaticResource PillButtonSecondary}" Click="OnShareSelected" IsEnabled="False" AutomationProperties.Name="Share selected files">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72D;" FontFamily="{StaticResource IconFont}" Margin="{StaticResource ChipGutterMargin}"/><TextBlock Text="Share"/><TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource GlyphMicro}" Margin="8,1,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="DeleteSelectedButton" Style="{StaticResource PillButtonSecondary}" Click="OnDeleteSelected" IsEnabled="False" AutomationProperties.Name="Delete selected history items">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" Margin="{StaticResource ChipGutterMargin}"/><TextBlock Text="Delete"/></StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel x:Name="SortControls" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Sort by:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="{StaticResource ChipGutterMargin}"/>
                    <Button x:Name="SortFieldButton" Style="{StaticResource PillButtonSecondary}" Click="OnSortFieldMenu">
                        <StackPanel Orientation="Horizontal"><TextBlock x:Name="SortFieldText" Text="Date"/><TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource GlyphMicro}" Margin="12,2,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="SortDirectionButton" Style="{StaticResource PillButtonSecondary}" MinWidth="40" Click="OnToggleSortDirection"
                            AutomationProperties.Name="Sort descending"><TextBlock x:Name="SortDirectionGlyph" Text="&#xE74B;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource TextTitle}"/></Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="CategoryRow" Grid.Row="0" Background="{StaticResource WindowBgBrush}" Padding="16,12,16,10">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <RadioButton x:Name="ChipAll" Content="All" IsChecked="True" Style="{StaticResource FilterChip}" Checked="OnFilterChanged"/>
                    <RadioButton x:Name="ChipImages" Content="Screenshots" Style="{StaticResource FilterChip}" Checked="OnFilterChanged"/>
                    <RadioButton x:Name="ChipScrolling" Content="Scrolling" Style="{StaticResource FilterChip}" Checked="OnFilterChanged"/>
                    <RadioButton x:Name="ChipVideo" Content="Videos" Style="{StaticResource FilterChip}" Checked="OnFilterChanged"/>
                    <RadioButton x:Name="ChipGif" Content="GIFs" Style="{StaticResource FilterChip}" Checked="OnFilterChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource ToolbarBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <Button x:Name="LoadMoreButton" DockPanel.Dock="Right" Content="Load more" Style="{StaticResource PillButtonSecondary}"
                        Click="OnLoadMore" Visibility="Collapsed" AutomationProperties.Name="Load more history items"
                        AutomationProperties.HelpText="Shows the next 200 local history items without loading the entire library at once."/>
                <Button DockPanel.Dock="Right" Style="{StaticResource PillButtonSecondary}" Click="OnRefresh" AutomationProperties.Name="Refresh history">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" Margin="0,0,7,0"/><TextBlock Text="Refresh"/></StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="CountText" Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource TextBody}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                    <Border Width="1" Height="18" Background="{StaticResource BorderBrush}" Margin="16,0"/>
                    <TextBlock x:Name="SelectionSummaryText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource TextBody}" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <ListBox x:Name="ItemsList" Tag="False" SelectionMode="Single"
                     Background="Transparent" BorderThickness="0" Padding="14,2,14,14"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="False" KeyboardNavigation.TabNavigation="Continue"
                     AutomationProperties.Name="Capture history"
                     AutomationProperties.HelpText="Use arrow keys to select, Enter to restore, Ctrl+C to copy, Space to preview, and Tab to reach item actions.">
                <ListBox.ItemsPanel><ItemsPanelTemplate><local:ReflowWrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="True"/><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                        <Setter Property="AutomationProperties.HelpText" Value="{Binding AccessibleHelpText}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <!-- Ring radius = thumbnail frame radius (8) + 2px border inset so they stay concentric. -->
                                    <Border x:Name="SelectionRing" Margin="6" BorderBrush="Transparent" BorderThickness="2" CornerRadius="10" Background="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectionRing" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SelectionRing" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Card" Width="260" Background="Transparent" Cursor="Hand"
                                MouseLeftButtonDown="OnTileMouseDown" MouseLeftButtonUp="OnTileMouseUp" MouseMove="OnTileMouseMove" MouseEnter="OnTileMouseEnter">
                            <Border.ContextMenu>
                                <ContextMenu Style="{StaticResource DarkContextMenu}">
                                    <MenuItem Header="Restore to Quick Access" Click="OnRestore" Visibility="{Binding ImageOnlyVisibility}" Style="{StaticResource DarkMenuItem}"/>
                                    <MenuItem Header="Copy" Click="OnCopy" Visibility="{Binding ImageOnlyVisibility}" Style="{StaticResource DarkMenuItem}"/>
                                    <MenuItem Header="Edit" Click="OnEdit" Visibility="{Binding EditableVisibility}" Style="{StaticResource DarkMenuItem}"/>
                                    <MenuItem Header="Pin" Click="OnPin" Visibility="{Binding PinVisibility}" Style="{StaticResource DarkMenuItem}"/>
                                    <Separator/>
                                    <MenuItem Header="Rotate left" Click="OnRotate" Tag="rotate-left" Visibility="{Binding ImageOnlyVisibility}" Style="{StaticResource DarkMenuItem}"/>
                                    <MenuItem Header="Rotate right" Click="OnRotate" Tag="rotate-right" Visibility="{Binding ImageOnlyVisibility}" Style="{StaticResource DarkMenuItem}"/>
                                    <MenuItem Header="Rename…" Click="OnRename" Style="{StaticResource DarkMenuItem}"/>
                                    <MenuItem Header="Print…" Click="OnPrint" Visibility="{Binding ImageOnlyVisibility}" Style="{StaticResource DarkMenuItem}"/>
                                    <Separator/>
                                    <MenuItem Header="Open" Click="OnOpen" Style="{StaticResource DarkMenuItem}"/>
                                    <MenuItem Header="Open with…" Click="OnOpenWith" Style="{StaticResource DarkMenuItem}"/>
                                    <MenuItem Header="Reveal in Explorer" Click="OnReveal" Style="{StaticResource DarkMenuItem}"/>
                                    <Separator/><MenuItem Header="Delete" Click="OnDelete" Style="{StaticResource DarkMenuItem}"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="164"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border Grid.Row="0" CornerRadius="{StaticResource RadiusButton}" ClipToBounds="True" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid x:Name="ThumbnailSurface">
                                            <Image x:Name="ThumbnailImage" Source="{Binding Thumbnail}" Stretch="UniformToFill" Visibility="{Binding ThumbnailVisibility}"/>
                                            <Grid Visibility="{Binding MediaFallbackVisibility}" Background="{StaticResource SurfaceBrush}">
                                                <TextBlock Text="{Binding ExtensionLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource TextDisplay}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <!-- Placeholder while the thumbnail decodes. The highlight sweeping
                                                 across it says "loading" without a spinner; it is bound off when
                                                 the user has animation turned off system-wide, and off again once
                                                 the decode has been tried and failed — a sweep with no terminating
                                                 condition promises a picture that is never coming, so the tile
                                                 settles on the warning glyph and says so instead. -->
                                            <Border Background="{StaticResource SurfaceBrush}" Opacity="0.72" Visibility="{Binding MissingThumbnailVisibility}">
                                                <Grid ClipToBounds="True">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PlaceholderGlyph}" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource GlyphIllustration}" Foreground="{StaticResource TextDisabledBrush}" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Can't read this picture" Visibility="{Binding UnreadableVisibility}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource TextCaption}"
                                                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="{StaticResource CaptionGapMargin}"/>
                                                    </StackPanel>
                                                    <!-- 110 wide, swept from -110 to 270 below: both numbers are
                                                         derived from the 260 DIP card (TileThumbnailWidth) this
                                                         template draws, so a change to the card width has to move
                                                         the sweep's From/To with it or the highlight stops short
                                                         of the right edge. It is clipped, so getting it wrong is
                                                         silent. -->
                                                    <Rectangle x:Name="Shimmer" Width="110" HorizontalAlignment="Left" Visibility="{Binding ShimmerVisibility}">
                                                        <Rectangle.Fill>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#00FFFFFF" Offset="0"/>
                                                                <GradientStop Color="{StaticResource BorderColor}" Offset="0.5"/>
                                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Rectangle.Fill>
                                                        <Rectangle.RenderTransform>
                                                            <TranslateTransform X="-110"/>
                                                        </Rectangle.RenderTransform>
                                                    </Rectangle>
                                                </Grid>
                                            </Border>
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="7" Padding="7,3" CornerRadius="4" Background="{StaticResource BadgeScrimBrush}" Visibility="{Binding ScrollingVisibility}">
                                                <TextBlock Text="SCROLLING" Foreground="White" FontSize="{StaticResource TextMicro}" FontWeight="SemiBold"/>
                                            </Border>
                                            <!-- Video tiles get a full-width bar instead of a corner glyph: the
                                                 length is what tells two recordings apart, and a bare camcorder
                                                 mark does not. -->
                                            <Border x:Name="MediaBar" VerticalAlignment="Bottom" Padding="{StaticResource MediaBarPadding}"
                                                    Background="{StaticResource BadgeScrimBrush}" Visibility="{Binding MediaBarVisibility}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" Foreground="White" FontSize="{StaticResource GlyphBadge}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding MediaBarText}" Foreground="White" FontSize="{StaticResource TextCaption}" Margin="{StaticResource LeadGutterMargin}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="7" Padding="7,4" CornerRadius="4" Background="{StaticResource BadgeScrimBrush}" Visibility="{Binding GifBadgeVisibility}">
                                                <TextBlock Text="GIF" Foreground="White" FontSize="{StaticResource TextMicro}" FontWeight="SemiBold"/>
                                            </Border>

                                            <!-- Source-app badge: which app the capture was taken over, the strongest
                                                 identity cue on a wall of look-alike screenshots. Resolved after the
                                                 tile is up, so it fades in rather than popping. -->
                                            <Border x:Name="SourceAppBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Margin="7" Width="26" Height="26" CornerRadius="13" Opacity="0"
                                                    Background="{StaticResource IconPlateBrush}" BorderBrush="{StaticResource BadgeScrimBrush}" BorderThickness="1"
                                                    Visibility="{Binding SourceAppVisibility}"
                                                    ToolTip="{Binding SourceApp}">
                                                <Image Source="{Binding SourceAppIcon}" Width="16" Height="16"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>
                                        </Grid>

                                        <!-- Bottom-anchored gradient scrim holding the action row: hover adds
                                             controls without blurring or blacking out the preview itself. -->
                                        <!-- Opacity, not Visibility, is what the hover state drives: two separate triggers
                                             (mouse and keyboard) each animating the same property fought each
                                             other, so hovering a tile that already had focus restarted the fade
                                             and the row blinked. The single trigger below fades it both ways.
                                             The base here is the SHOWN state and the trigger's setters push it
                                             down, never the other way round: a container generated while the
                                             pointer is already inside its slot evaluates the "not hovered"
                                             condition as false, and WPF runs neither EnterActions nor
                                             ExitActions on that first evaluation — so whatever the base says
                                             is what the tile keeps until the pointer leaves and comes back.
                                             With a hidden base that left an undrawn but fully clickable Delete
                                             button across the bottom of the tile. Setters do apply on the first
                                             evaluation, so the hidden state belongs in them. -->
                                        <Border x:Name="OverlayActions" VerticalAlignment="Bottom" Height="56" Opacity="1" IsHitTestVisible="True">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#00000000" Offset="0"/>
                                                    <GradientStop Color="#B3000000" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3">
                                                <Button Style="{StaticResource OverlayActionButton}" Click="OnRestore" Visibility="{Binding ImageOnlyVisibility}" AutomationProperties.Name="Restore to Quick Access">
                                                    <StackPanel><TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource TextTitle}" HorizontalAlignment="Center"/><TextBlock Text="Restore" FontSize="{StaticResource TextMicro}" Margin="0,3,0,0"/></StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource OverlayActionButton}" Click="OnCopy" Visibility="{Binding ImageOnlyVisibility}" AutomationProperties.Name="Copy screenshot">
                                                    <StackPanel><TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource TextTitle}" HorizontalAlignment="Center"/><TextBlock Text="Copy" FontSize="{StaticResource TextMicro}" Margin="0,3,0,0"/></StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource OverlayActionButton}" Click="OnEdit" Visibility="{Binding EditableVisibility}" AutomationProperties.Name="Edit capture">
                                                    <StackPanel><TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource TextTitle}" HorizontalAlignment="Center"/><TextBlock Text="Edit" FontSize="{StaticResource TextMicro}" Margin="0,3,0,0"/></StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource OverlayActionButton}" Click="OnPin" Visibility="{Binding PinVisibility}" AutomationProperties.Name="Pin screenshot">
                                                    <StackPanel><TextBlock Text="&#xE840;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource TextTitle}" HorizontalAlignment="Center"/><TextBlock Text="Pin" FontSize="{StaticResource TextMicro}" Margin="0,3,0,0"/></StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource OverlayActionButton}" Click="OnDelete" AutomationProperties.Name="Delete history item">
                                                    <StackPanel><TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource TextTitle}" HorizontalAlignment="Center"/><TextBlock Text="Delete" FontSize="{StaticResource TextMicro}" Margin="0,3,0,0"/></StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                        <!-- Photo-picker pattern: selection mode shows an empty ring on every tile;
                                             selecting fills it accent with the check glyph. -->
                                        <Border x:Name="SelectionCheck" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                                Background="#66000000" BorderBrush="White" BorderThickness="1.5" CornerRadius="5" Visibility="Collapsed">
                                            <TextBlock x:Name="SelectionCheckGlyph" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" Foreground="White" FontSize="{StaticResource TextBodyLg}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="7,7,7,10" ToolTip="{Binding DragHint}">
                                    <TextBlock Text="{Binding RelativeTime}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource TextBody}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding MetadataText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource TextCaption}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding ShimmerVisibility}" Value="Visible">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="ShimmerLoop">
                                        <Storyboard RepeatBehavior="Forever">
                                            <!-- Linear, deliberately: an ease on a Forever sweep hitches at
                                                 every loop boundary. MotionShimmer is the shared loop
                                                 period, longer than any transition in the vocabulary. -->
                                            <DoubleAnimation Storyboard.TargetName="Shimmer"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             From="-110" To="270" Duration="{StaticResource MotionShimmer}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="ShimmerLoop"/>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            <!-- The trigger above is the only thing that stops a Forever clock, and it
                                 only goes false when the decode lands. A tile deleted or filtered out
                                 while it is still shimmering loses its container with the clock still
                                 running, and the grid is deliberately non-virtualizing so nothing
                                 recycles it. Unloaded is the container's own end; ReflowWrapPanel's
                                 CancelReflow and the window's fade disposal are the same idea. -->
                            <EventTrigger RoutedEvent="FrameworkElement.Unloaded" SourceName="Card">
                                <StopStoryboard BeginStoryboardName="ShimmerLoop"/>
                            </EventTrigger>
                            <!-- A decoded thumbnail fades up over the tile's surface instead of popping.
                                 From is explicit: the Setter above is unapplied the instant the trigger
                                 goes false, so an animation with only a To would interpolate from the
                                 base value of 1 and land as a hard cut. The placeholder and the "MP4"
                                 card are driven by Visibility bindings that collapse them on the same
                                 assignment, so there is nothing left underneath to animate out. -->
                            <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                <Setter TargetName="ThumbnailImage" Property="Opacity" Value="0"/>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbnailImage" Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="{StaticResource MotionSwap}"
                                                             EasingFunction="{StaticResource EaseOutCubic}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SourceAppVisibility}" Value="Visible">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SourceAppBadge" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="{StaticResource MotionSwap}"
                                                             EasingFunction="{StaticResource EaseOutCubic}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                            <!-- Written as the HIDDEN state, because "hovered OR focused" is not a
                                 condition WPF can express but "neither" is - and one trigger owning the
                                 property is what stops the two from restarting each other's fade. Its
                                 setters carry the hidden state (opacity 0, no hit-testing) so a tile whose
                                 container is built under the pointer still lands somewhere defined; the
                                 storyboards below carry the same two states as fades once a real hover
                                 transition happens, and an animation outranks a setter so the two never
                                 argue. Leaving fades back up; re-entering fades back down. Entrance and
                                 exit are the same 140 ms, which the Visibility setter could not do
                                 (WPF collapses the element before an exit animation can run). Hit-testing
                                 goes with it so the invisible scrim never eats a click. -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="False"/>
                                    <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="OverlayActions" Property="Opacity" Value="0"/>
                                <Setter TargetName="OverlayActions" Property="IsHitTestVisible" Value="False"/>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="OverlayActions" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource MotionQuick}"
                                                             EasingFunction="{StaticResource EaseOutCubic}"/>
                                            <!-- The media bar and the action row are both bottom-anchored inside the
                                                 thumbnail, so on hover the duration/size line sat under the Edit and
                                                 Delete labels on a double scrim (bar + gradient ≈ 96 % black). The bar
                                                 hands the band over on the same trigger and the same 140 ms rather
                                                 than sharing it. Still tiles have no bar, so this is a no-op there. -->
                                            <DoubleAnimation Storyboard.TargetName="MediaBar" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource MotionQuick}"
                                                             EasingFunction="{StaticResource EaseOutCubic}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                                <MultiDataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="OverlayActions" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource MotionQuick}"
                                                             EasingFunction="{StaticResource EaseOutCubic}"/>
                                            <DoubleAnimation Storyboard.TargetName="MediaBar" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource MotionQuick}"
                                                             EasingFunction="{StaticResource EaseOutCubic}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.ExitActions>
                            </MultiDataTrigger>
                            <!-- Selection mode: check rings on, action row away outright. Visibility is
                                 independent of the opacity the trigger above holds, so the two never argue. -->
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="True">
                                <Setter TargetName="OverlayActions" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="SelectionCheck" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="True"/>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="SelectionCheck" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="SelectionCheck" Property="BorderThickness" Value="1"/>
                                <Setter TargetName="SelectionCheckGlyph" Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- One panel, three stories: nothing captured yet, nothing matching this filter,
                 or the folder could not be read. It is clickable, because the answer to an
                 empty grid is usually "take one now". -->
            <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                <TextBlock x:Name="EmptyStateGlyph" Text="&#xE91B;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource GlyphHero}" Foreground="{StaticResource TextDisabledBrush}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyStateTitle" Text="No captures yet" Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource TextTitle}" Margin="0,12,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock x:Name="EmptyStateBody" Text="Screenshots and recordings you take will show up here." Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource TextBody}" Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                <!-- Collapsed with its children: "History is turned off", and the Videos/GIFs/
                     Scrolling filtered states, show no button at all, and a zero-height row still
                     spent its 16 DIP top margin — dropping those panels lower in the centred
                     block than the ones that do have a button. -->
                <StackPanel x:Name="EmptyStateActions" Orientation="Horizontal" HorizontalAlignment="Center" Margin="{StaticResource ActionRowMargin}">
                    <Button x:Name="NewCaptureButton" Content="New capture" Style="{StaticResource PillButtonPrimary}"
                            Click="OnNewCapture" Visibility="Collapsed"
                            AutomationProperties.Name="Take a new region capture"/>
                    <Button x:Name="RetryLoadButton" Content="Try again" Style="{StaticResource PillButtonSecondary}"
                            Click="OnRefresh" Visibility="Collapsed"
                            AutomationProperties.Name="Read the history folder again"/>
                    <Button x:Name="OpenSettingsButton" Content="Open settings" Style="{StaticResource PillButtonPrimary}"
                            Click="OnOpenSettings" Visibility="Collapsed"
                            AutomationProperties.Name="Open settings to turn history back on"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
