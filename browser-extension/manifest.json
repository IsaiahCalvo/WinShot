{
  "manifest_version": 3,
  "name": "WinShot Capture",
  "short_name": "WinShot",
  "description": "Reliable, local-first webpage capture for WinShot.",
  "version": "0.1.0",
  "minimum_chrome_version": "109",
  "action": {
    "default_title": "Capture with WinShot",
    "default_popup": "src/popup.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "activeTab",
    "alarms",
    "contextMenus",
    "downloads",
    "scripting",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "optional_permissions": [
    "nativeMessaging",
    "tabs"
  ],
  "commands": {
    "capture-full-page": {
      "suggested_key": {
        "default": "Alt+Shift+1"
      },
      "description": "Capture the entire page"
    },
    "capture-visible": {
      "suggested_key": {
        "default": "Alt+Shift+3"
      },
      "description": "Capture the visible viewport"
    },
    "capture-region": {
      "suggested_key": {
        "default": "Alt+Shift+4"
      },
      "description": "Capture a selection"
    },
    "last-used-action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S"
      },
      "description": "Repeat the last capture (or stop a running one)"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
